local Items = {}
Items.List = list
Items.ById = {} :: { [string]: Item }
for _, item in list do
	Items.ById[item.id] = item
end

function Items.get(id: string): Item?
	return Items.ById[id]
end

-- Which equip slot an item uses (nil for things you don't wear).
function Items.slot(item: Item): string?
	if item.kind == "hat" or item.kind == "face" or item.kind == "balloon" then
		return item.kind
	end
	return nil
end

return Items
