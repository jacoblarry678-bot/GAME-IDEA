---------------------------------------------------------------------------
-- Shows
---------------------------------------------------------------------------

export type Show = {
	id: string,
	name: string,
	land: string,
	venue: string,
	description: string,
	times: { number }, -- park minutes after midnight
	duration: number, -- real seconds
	center: Vector3, -- where the action is
	viewing: Vector3, -- where the audience stands
	viewRadius: number,
}

