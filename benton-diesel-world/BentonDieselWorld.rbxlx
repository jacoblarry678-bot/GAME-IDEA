-- Builds everything; returns the props' footprints {x, z, radius}.
function Theming.build(parent: Instance): { { number } }
	local f = Kit.folder("Theming", parent)
	local rng = Random.new(2026)
	local footprints = {}
	for _, p in Theming.PROPS do
		local land = Config.landById(p[1] :: string)
		local builder = BUILDERS[p[2] :: string]
		if land and builder then
			local y = if p[2] == "rowboat" then 0 else 0.25
			local cf = CFrame.new(p[3] :: number, y, p[4] :: number) * CFrame.Angles(0, math.rad(p[5] :: number), 0)
			local holder = Kit.folder(p[2] :: string, f)
			builder(holder, cf, land.color, rng)
			if p[2] == "popcorn_cart" or p[2] == "balloon_cart" then
				-- a vendor minding the cart, by its push handle
				local at = (cf * CFrame.new(4.4, 0.15, 1.0)).Position
				local look = cf:VectorToWorldSpace(Vector3.new(-0.5, 0, -1))
				local vendor = Staff.place(holder, "vendor", land.id, 5200 + #footprints * 11, CFrame.lookAt(at, at + look))
				vendor:SetAttribute("Kind", p[2] :: string)
			end
			table.insert(footprints, { p[3] :: number, p[4] :: number, (Theming.RADIUS[p[2] :: string] or 2) + 1 })
		end
	end
	mainStreetLights(Kit.folder("MainStreetLights", f))
	backwoodsLights(Kit.folder("BackwoodsLights", f))
	walkOfFame(Kit.folder("WalkOfFame", f))
	redCarpet(Kit.folder("RedCarpet", f))
	return footprints
end

return Theming
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[-- Ride vehicles. Each car is a Model whose PrimaryPart ("Base") sits
-- exactly at the car's motion CFrame, so clients can animate it with
-- Model:PivotTo(pose). Vehicle parts never collide with players.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local RideMotion = require(Shared.RideMotion)
local Kit = require(script.Parent.Kit)

local M = Enum.Material
local HALF_PI = math.pi / 2

local Vehicles = {}

type Ride = Config.Ride

local DARK = Color3.fromRGB(30, 30, 34)
local SEAT_BLACK = Color3.fromRGB(36, 36, 40)

-- Part helpers in car space (cf = car origin).
local function blk(model: Model, cf: CFrame, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
	return Kit.block(model, size, cf * offset, color, material)
end

local function wheel(model: Model, cf: CFrame, offset: Vector3, diameter: number, width: number, color: Color3?): Part
	return Kit.cyl(model, width, diameter, cf * CFrame.new(offset), color or DARK, M.SmoothPlastic)
end

-- Lap bars and harnesses are named so the clients can raise and lower them
-- (they are built closed, over the rider).
local function restraint(p: Part): Part
	p.Name = "Restraint"
	return p
end

local function seatPieces(model: Model, cf: CFrame, seat: CFrame, cushion: Color3, bar: Color3?)
	-- seat CFrame is the rider's root; cushion sits under it
	blk(model, cf, Vector3.new(1.9, 0.5, 1.7), seat * CFrame.new(0, -1.55, 0.1), cushion, M.Fabric)
	blk(model, cf, Vector3.new(1.9, 2.1, 0.45), seat * CFrame.new(0, -0.55, 1.0), cushion, M.Fabric)
	if bar then
		restraint(blk(model, cf, Vector3.new(1.7, 0.3, 0.3), seat * CFrame.new(0, -0.6, -0.85), bar, M.Metal))
	end
end

local function coasterCar(model: Model, ride: Ride, cf: CFrame, index: number, seats: { CFrame })
	local body, seatColor, accent = ride.colors[1], ride.colors[2] or SEAT_BLACK, ride.colors[3] or Color3.new(1, 1, 1)
	local mine = ride.carStyle == "mine"
	blk(model, cf, Vector3.new(4.9, 0.6, 6.6), CFrame.new(0, 0.85, 0), DARK, M.Metal)
	for _, sx in { -1, 1 } do
		blk(model, cf, Vector3.new(0.4, 1.7, 6.6), CFrame.new(sx * 2.55, 1.85, 0), body, if mine then M.WoodPlanks else M.SmoothPlastic)
		blk(model, cf, Vector3.new(0.45, 0.3, 6.62), CFrame.new(sx * 2.55, 2.75, 0), accent, M.Metal)
		for _, sz in { -2.3, 2.3 } do
			wheel(model, cf, Vector3.new(sx * 1.6, 0.25, sz), 0.9, 0.5)
		end
	end
	blk(model, cf, Vector3.new(5.5, 1.7, 0.4), CFrame.new(0, 1.85, -3.2), body, if mine then M.WoodPlanks else M.SmoothPlastic)
	if index == 1 then
		local nose = Kit.wedge(model, Vector3.new(5.4, 1.8, 2.6), cf * CFrame.new(0, 1.8, -4.6), body, M.SmoothPlastic)
		nose.Name = "Nose"
		local lamp = blk(model, cf, Vector3.new(3, 0.5, 0.2), CFrame.new(0, 1.4, -5.95), Color3.fromRGB(255, 240, 200), M.Neon)
		lamp.Name = "Headlamp"
		if mine then
			-- Old Rusty's tow hook and beacon
			blk(model, cf, Vector3.new(0.4, 3, 0.4), CFrame.new(0, 3.4, -4.6) * CFrame.Angles(math.rad(-30), 0, 0), Color3.fromRGB(90, 70, 50), M.Metal)
			Kit.ball(model, 0.9, (cf * CFrame.new(0, 3.2, -2.8)).Position, Color3.fromRGB(255, 160, 30), M.Neon)
		end
	end
	for _, seat in seats do
		seatPieces(model, cf, seat, seatColor, accent)
	end
end

local function logBoat(model: Model, ride: Ride, cf: CFrame, seats: { CFrame })
	local bark, inner = ride.colors[1], ride.colors[2] or Color3.fromRGB(90, 62, 40)
	Kit.cyl(model, 10, 3.6, cf * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, HALF_PI, 0), bark, M.Wood)
	blk(model, cf, Vector3.new(2.4, 0.4, 9.2), CFrame.new(0, 2.4, 0), inner, M.WoodPlanks)
	for _, sx in { -1, 1 } do
		blk(model, cf, Vector3.new(0.5, 1.2, 10), CFrame.new(sx * 1.5, 2.6, 0), bark, M.Wood)
	end
	Kit.wedge(model, Vector3.new(3, 1.2, 2), cf * CFrame.new(0, 2.6, -5.4), bark, M.Wood)
	for _, seat in seats do
		blk(model, cf, Vector3.new(2.2, 0.4, 0.4), seat * CFrame.new(0, -1.2, 0.9), inner, M.Wood)
	end
end

local function locomotive(model: Model, ride: Ride, cf: CFrame)
	local green, red, gold = ride.colors[1], ride.colors[2] or Color3.fromRGB(200, 40, 40), ride.colors[3] or Color3.fromRGB(240, 196, 64)
	blk(model, cf, Vector3.new(4.6, 0.8, 11), CFrame.new(0, 0.8, 0), DARK, M.Metal)
	Kit.cyl(model, 7.5, 3.8, cf * CFrame.new(0, 3.3, -1.2) * CFrame.Angles(0, HALF_PI, 0), green, M.Metal)
	Kit.cyl(model, 0.4, 4.0, cf * CFrame.new(0, 3.3, -3) * CFrame.Angles(0, HALF_PI, 0), gold, M.Metal)
	Kit.cyl(model, 0.4, 4.0, cf * CFrame.new(0, 3.3, 0.6) * CFrame.Angles(0, HALF_PI, 0), gold, M.Metal)
	blk(model, cf, Vector3.new(4.8, 5.2, 3.6), CFrame.new(0, 3.9, 3.6), red, M.SmoothPlastic)
	blk(model, cf, Vector3.new(5.4, 0.5, 4.4), CFrame.new(0, 6.7, 3.6), DARK, M.Metal)
	for _, sx in { -1, 1 } do
		local w = blk(model, cf, Vector3.new(0.2, 1.6, 2.2), CFrame.new(sx * 2.45, 4.8, 3.6), Color3.fromRGB(150, 200, 230), M.Glass)
		w.Transparency = 0.3
	end
	-- smokestack with a smoke emitter
	local stack = Kit.cyl(model, 2.6, 1.3, cf * CFrame.new(0, 6.2, -3.6) * CFrame.Angles(0, 0, HALF_PI), DARK, M.Metal)
	Kit.cyl(model, 0.6, 2.0, cf * CFrame.new(0, 7.6, -3.6) * CFrame.Angles(0, 0, HALF_PI), DARK, M.Metal)
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(220, 220, 220)
	smoke.Opacity = 0.15
	smoke.RiseVelocity = 6
	smoke.Size = 1.5
	smoke.Parent = stack
	Kit.ball(model, 1.6, (cf * CFrame.new(0, 5.4, -0.6)).Position, gold, M.Metal)
	local lamp = blk(model, cf, Vector3.new(1.2, 1.2, 0.4), CFrame.new(0, 4.4, -5.1), Color3.fromRGB(255, 240, 200), M.Neon)
	Kit.light(lamp, Color3.fromRGB(255, 230, 180), 18, 1)
	Kit.wedge(model, Vector3.new(4.4, 1.6, 2), cf * CFrame.new(0, 1.2, -6.2), red, M.Metal)
	for _, sx in { -1, 1 } do
		for _, sz in { -3.4, -0.6, 2.6 } do
			local d = if sz > 0 then 2.6 else 2.0
			wheel(model, cf, Vector3.new(sx * 2.1, d / 2 - 0.4, sz), d, 0.5, red)
		end
	end
	Kit.sign(model, "BENTON", Vector3.new(0.2, 1.2, 3.4), cf * CFrame.new(-2.5, 4.8, 3.6) * CFrame.Angles(0, HALF_PI, 0), { transparentBg = true, fg = gold, font = Enum.Font.GothamBlack })
end

local function coach(model: Model, ride: Ride, cf: CFrame, seats: { CFrame })
	local green, red, gold = ride.colors[1], ride.colors[2] or Color3.fromRGB(200, 40, 40), ride.colors[3] or Color3.fromRGB(240, 196, 64)
	blk(model, cf, Vector3.new(5, 0.6, 10.5), CFrame.new(0, 1.8, 0), green, M.WoodPlanks)
	blk(model, cf, Vector3.new(4.4, 0.6, 10), CFrame.new(0, 1.2, 0), DARK, M.Metal)
	for _, sx in { -1, 1 } do
		blk(model, cf, Vector3.new(0.3, 1.4, 10.5), CFrame.new(sx * 2.5, 2.8, 0), red, M.Wood)
		for _, sz in { -4.9, 4.9 } do
			blk(model, cf, Vector3.new(0.3, 5, 0.3), CFrame.new(sx * 2.4, 4.6, sz), gold, M.Metal)
			wheel(model, cf, Vector3.new(sx * 2.0, 0.6, sz * 0.75), 1.6, 0.4)
		end
	end
	blk(model, cf, Vector3.new(5.6, 0.4, 11.2), CFrame.new(0, 7.2, 0), red, M.SmoothPlastic)
	blk(model, cf, Vector3.new(5.0, 0.3, 10.6), CFrame.new(0, 7.5, 0), Color3.fromRGB(250, 243, 224), M.SmoothPlastic)
	for _, seat in seats do
		seatPieces(model, cf, seat, Color3.fromRGB(150, 100, 60), nil)
	end
end

local function tramCar(model: Model, ride: Ride, cf: CFrame, index: number, seats: { CFrame })
	local cream, purple, gold = ride.colors[1], ride.colors[2] or Color3.fromRGB(150, 110, 200), ride.colors[3] or Color3.fromRGB(240, 196, 64)
	blk(model, cf, Vector3.new(5.4, 0.8, 11.6), CFrame.new(0, 1.6, 0), purple, M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		blk(model, cf, Vector3.new(0.3, 1.2, 11.6), CFrame.new(sx * 2.7, 2.6, 0), cream, M.SmoothPlastic)
		for _, sz in { -5.4, 5.4 } do
			blk(model, cf, Vector3.new(0.3, 4.6, 0.3), CFrame.new(sx * 2.6, 4.3, sz), gold, M.Metal)
		end
		for _, sz in { -3.8, 3.8 } do
			wheel(model, cf, Vector3.new(sx * 2.4, 0.9, sz), 1.8, 0.7)
		end
	end
	blk(model, cf, Vector3.new(6, 0.4, 12.2), CFrame.new(0, 6.6, 0), purple, M.SmoothPlastic)
	for i = -5, 5, 2 do
		blk(model, cf, Vector3.new(6.02, 0.42, 1), CFrame.new(0, 6.6, i), cream, M.SmoothPlastic)
	end
	if index == 1 then
		blk(model, cf, Vector3.new(5.4, 3.4, 2.6), CFrame.new(0, 3.6, -7.2), cream, M.SmoothPlastic)
		local glass = blk(model, cf, Vector3.new(4.6, 1.6, 0.2), CFrame.new(0, 4.6, -8.5), Color3.fromRGB(150, 200, 230), M.Glass)
		glass.Transparency = 0.3
		Kit.sign(model, "STUDIO TOURS", Vector3.new(5, 0.9, 0.2), cf * CFrame.new(0, 6.0, -8.55), { bg = purple, fg = gold, font = Enum.Font.GothamBlack })
	end
	for _, seat in seats do
		seatPieces(model, cf, seat, purple, nil)
	end
end

local function bigRig(model: Model, ride: Ride, cf: CFrame, index: number, seats: { CFrame })
	local palette = ride.colors
	local color = palette[(index - 1) % #palette + 1]
	-- open-top cab so riders are visible
	blk(model, cf, Vector3.new(3.8, 0.6, 8.8), CFrame.new(0, 0.9, 0.6), DARK, M.Metal)
	blk(model, cf, Vector3.new(3.8, 1.6, 2.2), CFrame.new(0, 1.8, -3.4), color, M.SmoothPlastic)
	local grille = blk(model, cf, Vector3.new(2.6, 1.0, 0.2), CFrame.new(0, 1.9, -4.55), Color3.fromRGB(200, 200, 205), M.Metal)
	grille.Name = "Grille"
	for _, sx in { -1, 1 } do
		blk(model, cf, Vector3.new(0.3, 1.8, 3.2), CFrame.new(sx * 1.75, 2.1, -1.4), color, M.SmoothPlastic)
		Kit.ball(model, 0.5, (cf * CFrame.new(sx * 1.2, 2.1, -4.6)).Position, Color3.fromRGB(255, 240, 200), M.Neon)
		local stack = Kit.cyl(model, 3.4, 0.4, cf * CFrame.new(sx * 1.95, 3.4, 0.2) * CFrame.Angles(0, 0, HALF_PI), Color3.fromRGB(200, 200, 205), M.Metal)
		stack.Name = "Stack"
		for _, sz in { -3.2, 1.2, 3.8 } do
			wheel(model, cf, Vector3.new(sx * 1.7, 0.7, sz), 1.5, 0.6)
		end
	end
	blk(model, cf, Vector3.new(3.8, 1.4, 0.3), CFrame.new(0, 2.0, 0.3), color, M.SmoothPlastic)
	-- little trailer
	blk(model, cf, Vector3.new(3.6, 2.2, 4.4), CFrame.new(0, 2.3, 3.2), Color3.fromRGB(240, 240, 236), M.SmoothPlastic)
	Kit.sign(model, "LITTLE HAULERS", Vector3.new(0.2, 1.2, 4.2), cf * CFrame.new(-1.82, 2.4, 3.2) * CFrame.Angles(0, HALF_PI, 0), { transparentBg = true, fg = color, font = Enum.Font.GothamBlack })
	for _, seat in seats do
		seatPieces(model, cf, seat, SEAT_BLACK, nil)
	end
end

local function kart(model: Model, ride: Ride, cf: CFrame, index: number, seats: { CFrame })
	local color = ride.colors[(index - 1) % #ride.colors + 1]
	blk(model, cf, Vector3.new(3.4, 0.5, 5.4), CFrame.new(0, 0.7, 0), color, M.SmoothPlastic)
	Kit.wedge(model, Vector3.new(3.0, 0.8, 1.6), cf * CFrame.new(0, 1.2, -2.4), color, M.SmoothPlastic)
	blk(model, cf, Vector3.new(4.4, 0.4, 0.6), CFrame.new(0, 0.9, -2.9), DARK, M.Rubber)
	blk(model, cf, Vector3.new(4.4, 0.6, 0.5), CFrame.new(0, 1.1, 2.7), DARK, M.Rubber)
	for _, sx in { -1, 1 } do
		for _, sz in { -1.8, 1.8 } do
			wheel(model, cf, Vector3.new(sx * 1.85, 0.6, sz), 1.2, 0.7)
		end
	end
	Kit.cyl(model, 0.2, 1.1, cf * CFrame.new(0, 1.8, -0.9) * CFrame.Angles(math.rad(60), 0, 0) * CFrame.Angles(0, 0, HALF_PI), DARK, M.SmoothPlastic)
	Kit.sign(model, tostring(index), Vector3.new(1.2, 1.0, 0.2), cf * CFrame.new(0, 1.3, -3.2), { bg = Color3.new(1, 1, 1), fg = DARK, font = Enum.Font.GothamBlack })
	for _, seat in seats do
		seatPieces(model, cf, seat, SEAT_BLACK, nil)
	end
end

local function dropRing(model: Model, ride: Ride, cf: CFrame, seats: { CFrame })
	local blue, dark, orange = ride.colors[1], ride.colors[2] or DARK, ride.colors[3] or Color3.fromRGB(255, 140, 26)
	-- ring frame around the tower
	for k = 0, 11 do
		local a = k * math.pi / 6
		local seg = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.6, -6.2)
		Kit.block(model, Vector3.new(3.4, 1.2, 1.4), seg, dark, M.Metal)
		Kit.block(model, Vector3.new(3.4, 0.4, 1.5), seg * CFrame.new(0, 0.8, 0), orange, M.Neon)
	end
	for _, seat in seats do
		blk(model, cf, Vector3.new(1.9, 0.5, 1.7), seat * CFrame.new(0, -1.55, 0.1), blue, M.SmoothPlastic)
		blk(model, cf, Vector3.new(1.9, 3.2, 0.5), seat * CFrame.new(0, -0.1, 1.0), blue, M.SmoothPlastic)
		restraint(blk(model, cf, Vector3.new(1.6, 1.6, 0.4), seat * CFrame.new(0, 0.2, -0.6), Color3.fromRGB(220, 220, 225), M.Metal))
	end
end

local function horse(model: Model, ride: Ride, cf: CFrame, index: number, seats: { CFrame })
	local coats = { Color3.fromRGB(250, 248, 240), Color3.fromRGB(140, 90, 50), Color3.fromRGB(60, 40, 30), Color3.fromRGB(220, 180, 120) }
	local coat = coats[(index - 1) % #coats + 1]
	local saddle = ride.colors[(index - 1) % #ride.colors + 1]
	Kit.ellipsoid(model, Vector3.new(1.8, 1.9, 4.2), cf * CFrame.new(0, 0, 0), coat, M.SmoothPlastic)
	Kit.block(model, Vector3.new(1.2, 2.4, 1.2), cf * CFrame.new(0, 1.4, -1.9) * CFrame.Angles(math.rad(25), 0, 0), coat, M.SmoothPlastic)
	Kit.block(model, Vector3.new(1.0, 1.0, 2.0), cf * CFrame.new(0, 2.5, -2.7), coat, M.SmoothPlastic)
	Kit.block(model, Vector3.new(0.4, 1.4, 1.6), cf * CFrame.new(0, 2.6, -1.8), Color3.fromRGB(240, 196, 64), M.SmoothPlastic)
	for _, sx in { -0.55, 0.55 } do
		for _, sz in { -1.4, 1.4 } do
			Kit.block(model, Vector3.new(0.5, 2.4, 0.5), cf * CFrame.new(sx, -1.6, sz) * CFrame.Angles(math.rad(if sz < 0 then -25 else 25), 0, 0), coat, M.SmoothPlastic)
		end
	end
	Kit.block(model, Vector3.new(1.9, 0.5, 1.6), cf * CFrame.new(0, 0.95, 0.3), saddle, M.Fabric)
	Kit.cyl(model, 0.8, 0.5, cf * CFrame.new(0, 0, 2.2) * CFrame.Angles(0, HALF_PI, 0) * CFrame.Angles(0, 0, 0), Color3.fromRGB(240, 196, 64), M.Metal)
	local _ = seats
end

local function pistonCup(model: Model, ride: Ride, cf: CFrame, index: number, seats: { CFrame })
	local color = ride.colors[(index - 1) % #ride.colors + 1]
	Kit.cyl(model, 3.2, 7.2, cf * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, HALF_PI), color, M.SmoothPlastic)
	Kit.cyl(model, 0.5, 7.6, cf * CFrame.new(0, 3.3, 0) * CFrame.Angles(0, 0, HALF_PI), Color3.fromRGB(220, 220, 225), M.Metal)
	Kit.cyl(model, 1.8, 1.6, cf * CFrame.new(0, 3.6, 0) * CFrame.Angles(0, 0, HALF_PI), Color3.fromRGB(200, 200, 205), M.Metal)
	Kit.cyl(model, 0.5, 2.6, cf * CFrame.new(0, 4.6, 0) * CFrame.Angles(0, 0, HALF_PI), DARK, M.Metal)
	for _, seat in seats do
		blk(model, cf, Vector3.new(1.8, 1.8, 0.4), seat * CFrame.new(0, -0.7, 0.9), Color3.fromRGB(250, 243, 224), M.Fabric)
		restraint(blk(model, cf, Vector3.new(1.7, 0.3, 0.3), seat * CFrame.new(0, -0.6, -0.85), Color3.fromRGB(220, 220, 225), M.Metal))
	end
end

local function gondola(model: Model, ride: Ride, cf: CFrame, seats: { CFrame })
	local orange, dark, gold = ride.colors[1], ride.colors[2] or DARK, ride.colors[3] or Color3.fromRGB(240, 196, 64)
	Kit.cyl(model, 1.2, 12, cf * CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, HALF_PI), dark, M.Metal)
	Kit.cyl(model, 0.4, 12.4, cf * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, HALF_PI), gold, M.Neon)
	Kit.cyl(model, 3.0, 4, cf * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, HALF_PI), orange, M.Metal)
	for _, seat in seats do
		blk(model, cf, Vector3.new(1.9, 0.5, 1.7), seat * CFrame.new(0, -1.55, 0.1), orange, M.SmoothPlastic)
		blk(model, cf, Vector3.new(1.9, 3.0, 0.5), seat * CFrame.new(0, -0.2, 1.0), orange, M.SmoothPlastic)
		restraint(blk(model, cf, Vector3.new(1.6, 1.4, 0.4), seat * CFrame.new(0, 0.2, -0.6), Color3.fromRGB(220, 220, 225), M.Metal))
	end
end

-- Build car `index` of a ride at pose `cf`.
function Vehicles.build(ride: Ride, motion: RideMotion.Motion, index: number, cf: CFrame, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = "Car" .. index
	local base = Kit.block(model, Vector3.new(0.4, 0.4, 0.4), cf, Color3.new(1, 1, 1), M.SmoothPlastic)
	base.Name = "Base"
	base.Transparency = 1
	model.PrimaryPart = base
	-- seat CFrames in car space (the builders below apply `cf`)
	local seats = motion.seats[index]
	local style = ride.carStyle
	if ride.kind == "coaster" then
		coasterCar(model, ride, cf, index, seats)
	elseif ride.kind == "flume" then
		logBoat(model, ride, cf, seats)
	elseif ride.kind == "train" then
		if index == 1 and ride.firstCarSeats == 0 then
			locomotive(model, ride, cf)
		else
			coach(model, ride, cf, seats)
		end
	elseif ride.kind == "tram" then
		tramCar(model, ride, cf, index, seats)
	elseif ride.kind == "trucks" then
		bigRig(model, ride, cf, index, seats)
	elseif ride.kind == "karts" then
		kart(model, ride, cf, index, seats)
	elseif ride.kind == "droptower" then
		dropRing(model, ride, cf, seats)
	elseif ride.kind == "carousel" then
		horse(model, ride, cf, index, seats)
	elseif ride.kind == "spinner" then
		pistonCup(model, ride, cf, index, seats)
	elseif ride.kind == "pendulum" then
		gondola(model, ride, cf, seats)
	end
	local _ = style
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local p = d :: BasePart
			p.CanCollide = false
			p.CanTouch = false
			p.Anchored = true
		end
	end
	model.Parent = parent
	return model
end

return Vehicles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Venues</string>
            <string name="Source"><![CDATA[-- Shops and restaurants: open-front buildings with a counter, a prompt,
-- item displays, a menu board and (for restaurants) patio seating.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Props = require(Shared.Props)
local Staff = require(Shared.Staff)
local Kit = require(script.Parent.Kit)

local M = Enum.Material
local C = Config.Colors

local Venues = {}

local AWNINGS = {
	Plaza = C.Red,
	Diesel = C.Orange,
	Haulers = C.Gold,
	Backwoods = Color3.fromRGB(70, 110, 60),
	Studios = Color3.fromRGB(150, 110, 200),
	Velocity = C.Blue,
	Family = Color3.fromRGB(70, 170, 160),
}

local MATERIALS = {
	Plaza = M.Brick,
	Diesel = M.Brick,
	Haulers = M.SmoothPlastic,
	Backwoods = M.WoodPlanks,
	Studios = M.Concrete,
	Velocity = M.Glass,
	Family = M.WoodPlanks,
}

export type VenueInfo = {
	venue: Config.Venue,
	model: Model,
	prompt: ProximityPrompt,
}

local function menuBoard(parent: Instance, venue: Config.Venue, cf: CFrame)
	local board = Kit.block(parent, Vector3.new(9, 7, 0.4), cf, Color3.fromRGB(28, 28, 32), M.SmoothPlastic)
	board.Name = "MenuBoard"
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 36
	gui.LightInfluence = 0.2
	gui.Parent = board
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0.02, 0)
	layout.Parent = gui
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.22)
	title.BackgroundTransparency = 1
	title.Text = if venue.kind == "restaurant" then "MENU" else "TODAY'S DEALS"
	title.TextScaled = true
	title.TextColor3 = C.Gold
	title.FontFace = Font.fromEnum(Enum.Font.GothamBlack)
	title.Parent = gui
	for _, id in venue.items do
		local item = Items.get(id)
		if item then
			local row = Instance.new("TextLabel")
			row.Size = UDim2.fromScale(1, 0.16)
			row.BackgroundTransparency = 1
			row.Text = string.format("%s  -  %s%d", item.name, Config.CurrencyShort, item.price)
			row.TextScaled = true
			row.TextColor3 = C.Cream
			row.FontFace = Font.fromEnum(Enum.Font.GothamBold)
			row.Parent = gui
		end
	end
end

local function build(parent: Instance, venue: Config.Venue): VenueInfo
	local facing = Config.facingVector(venue.facing)
	local pos = venue.position
	local front = Vector3.new(pos.X, 0.4, pos.Z)
	local cf = CFrame.lookAt(front, front + facing)
	local model = Kit.building(parent, cf, {
		size = venue.size,
		wall = venue.color,
		trim = C.Cream,
		roof = Color3.fromRGB(60, 56, 56),
		material = MATERIALS[venue.land] or M.Brick,
		windows = true,
		awning = AWNINGS[venue.land] or C.Red,
		sign = string.upper(venue.name),
		signColors = { C.Navy, C.Cream },
		open = true,
	})
	model.Name = venue.id
	model:SetAttribute("VenueId", venue.id)
	local counter = model:FindFirstChild("Counter") :: Part
	local prompt = Kit.prompt(counter, if venue.kind == "restaurant" then "Order Food" else "Browse Shop", venue.name, Enum.KeyCode.E, 14)
	prompt.Name = "VenuePrompt"
	prompt:SetAttribute("VenueId", venue.id)
	local hz = venue.size.Z / 2
	-- show the goods on the counter
	local n = #venue.items
	for i, id in venue.items do
		local item = Items.get(id)
		if item and item.kind ~= "pass" then
			local preview = Props.preview(item)
			local x = (i - (n + 1) / 2) * math.min(5, (venue.size.X - 10) / n)
			local lift = if item.kind == "balloon" then 4.5 else 4.4
			preview:PivotTo(cf * CFrame.new(x, lift, -hz + 3))
			preview.Parent = model
		end
	end
	-- cashiers behind the counter, facing out
	for k, x in { venue.size.X / 4, -venue.size.X / 5 } do
		local cashier = Staff.place(model, "cashier", venue.land, #venue.id * 31 + k * 7, cf * CFrame.new(x, 0.55, -hz + 5.5))
		cashier.Name = "Cashier"
		cashier:SetAttribute("VenueId", venue.id)
		cashier:SetAttribute("Kind", venue.kind)
	end
	-- sidewalk menu board on legs
	local boardCF = cf * CFrame.new(-venue.size.X / 2 + 4, 0, -hz - 5)
	for _, sx in { -4, 4 } do
		Kit.block(model, Vector3.new(0.4, 5, 0.4), boardCF * CFrame.new(sx, 2.5, 0), Color3.fromRGB(60, 60, 66), M.Metal)
	end
	menuBoard(model, venue, boardCF * CFrame.new(0, 6, 0))
	if venue.kind == "restaurant" then
		local umbrella = AWNINGS[venue.land] or C.Red
		for i = 0, 3 do
			local lateral = (i - 1.5) * 10
			local p = cf * Vector3.new(lateral, 0.4, -hz - 13 - (i % 2) * 7)
			Kit.cafeTable(model, p, umbrella)
		end
	end
	Kit.lamp(model, (cf * CFrame.new(venue.size.X / 2 + 3, 0, -hz - 4)).Position)
	return { venue = venue, model = model, prompt = prompt }
end

function Venues.build(root: Instance): { [string]: VenueInfo }
	local folder = Kit.folder("Venues", root)
	local infos = {}
	for _, venue in Config.Venues do
		infos[venue.id] = build(folder, venue)
	end
	return infos
end

return Venues
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[-- Player profiles: Benton Bucks, souvenirs, Express Passes, passport
-- stamps and stats. Saved with DataStoreService when it is available
-- (in Studio, turn on "Enable Studio Access to API Services" to test saving).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local PlayerData = {}

export type Profile = {
	Bucks: number,
	Passes: number,
	Owned: { string },
	Equipped: { [string]: string },
	Stamps: { string },
	Stats: { [string]: number },
	LastDaily: number,
	Version: number,
}

local STORE_NAME = "BentonDieselWorld_v1"
local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[BentonDieselWorld] DataStore unavailable, progress will not be saved:", result)
	end
end

local profiles: { [Player]: Profile } = {}
local canSave: { [Player]: boolean } = {}

local function defaultProfile(): Profile
	return {
		Bucks = Config.Economy.StartingBucks,
		Passes = Config.Economy.StartingPasses,
		Owned = {},
		Equipped = { hat = "", face = "", balloon = "" },
		Stamps = {},
		Stats = { Rides = 0, Shows = 0, Meals = 0, Playtime = 0 },
		LastDaily = 0,
		Version = 1,
	}
end

-- Fill in any fields missing from older saves.
local function reconcile(data: any): Profile
	local p = defaultProfile()
	if type(data) ~= "table" then
		return p
	end
	if type(data.Bucks) == "number" then
		p.Bucks = math.max(0, math.floor(data.Bucks))
	end
	if type(data.Passes) == "number" then
		p.Passes = math.max(0, math.floor(data.Passes))
	end
	if type(data.Owned) == "table" then
		for _, id in data.Owned do
			if type(id) == "string" then
				table.insert(p.Owned, id)
			end
		end
	end
	if type(data.Equipped) == "table" then
		for slot, id in data.Equipped do
			if type(slot) == "string" and type(id) == "string" then
				p.Equipped[slot] = id
			end
		end
	end
	if type(data.Stamps) == "table" then
		for _, id in data.Stamps do
			if type(id) == "string" then
				table.insert(p.Stamps, id)
			end
		end
	end
	if type(data.Stats) == "table" then
		for k, v in data.Stats do
			if type(k) == "string" and type(v) == "number" then
				p.Stats[k] = v
			end
		end
	end
	if type(data.LastDaily) == "number" then
		p.LastDaily = data.LastDaily
	end
	return p
end

local function key(player: Player): string
	return "player_" .. player.UserId
end

function PlayerData.get(player: Player): Profile?
	return profiles[player]
end

local function snapshot(p: Profile)
	return {
		Bucks = p.Bucks,
		Passes = p.Passes,
		Owned = table.clone(p.Owned),
		Equipped = table.clone(p.Equipped),
		Stamps = table.clone(p.Stamps),
		Stats = table.clone(p.Stats),
	}
end

-- Push the profile to the client (attributes for quick reads + a full
-- snapshot for the app) and refresh leaderstats.
function PlayerData.sync(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	player:SetAttribute("Bucks", p.Bucks)
	player:SetAttribute("Passes", p.Passes)
	player:SetAttribute("Stamps", #p.Stamps)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local bucks = stats:FindFirstChild(Config.CurrencyShort) :: IntValue?
		if bucks then
			bucks.Value = p.Bucks
		end
		local rides = stats:FindFirstChild("Rides") :: IntValue?
		if rides then
			rides.Value = p.Stats.Rides or 0
		end
	end
	Net.remote("Profile"):FireClient(player, snapshot(p))
end

function PlayerData.notify(player: Player, text: string, kind: string?, amount: number?)
	Net.remote("Notify"):FireClient(player, { text = text, kind = kind or "info", amount = amount })
end

function PlayerData.addBucks(player: Player, amount: number, reason: string?)
	local p = profiles[player]
	if not p then
		return
	end
	p.Bucks += amount
	PlayerData.sync(player)
	if reason then
		PlayerData.notify(player, reason, "reward", amount)
	end
end

function PlayerData.spend(player: Player, amount: number): boolean
	local p = profiles[player]
	if not p or p.Bucks < amount then
		return false
	end
	p.Bucks -= amount
	PlayerData.sync(player)
	return true
end

function PlayerData.owns(player: Player, itemId: string): boolean
	local p = profiles[player]
	return p ~= nil and table.find(p.Owned, itemId) ~= nil
end

function PlayerData.give(player: Player, itemId: string)
	local p = profiles[player]
	if p and not table.find(p.Owned, itemId) then
		table.insert(p.Owned, itemId)
		PlayerData.sync(player)
	end
end

function PlayerData.bumpStat(player: Player, stat: string, by: number?)
	local p = profiles[player]
	if p then
		p.Stats[stat] = (p.Stats[stat] or 0) + (by or 1)
	end
end

-- Returns true if this is a new stamp.
function PlayerData.stamp(player: Player, rideId: string): boolean
	local p = profiles[player]
	if not p or table.find(p.Stamps, rideId) then
		return false
	end
	table.insert(p.Stamps, rideId)
	return true
end

local function save(player: Player)
	local p = profiles[player]
	if not p or not store or not canSave[player] then
		return
	end
	local data = snapshot(p) :: any
	data.LastDaily = p.LastDaily
	data.Version = p.Version
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):SetAsync(key(player), data)
		end)
		if ok then
			return
		end
		warn("[BentonDieselWorld] save failed (attempt " .. attempt .. "):", err)
		task.wait(1 + attempt)
	end
end
PlayerData.save = save

local function load(player: Player)
	local data = nil
	local loaded = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(key(player))
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn("[BentonDieselWorld] load failed (attempt " .. attempt .. "):", result)
			task.wait(1)
		end
	end
	if not player.Parent then
		return
	end
	-- only save if we successfully read (never overwrite a save we could not load)
	canSave[player] = loaded
	local profile = reconcile(data)
	profiles[player] = profile

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local bucks = Instance.new("IntValue")
	bucks.Name = Config.CurrencyShort
	bucks.Parent = stats
	local rides = Instance.new("IntValue")
	rides.Name = "Rides"
	rides.Parent = stats
	stats.Parent = player

	player:SetAttribute("Hunger", Config.Hunger.Max)
	player:SetAttribute("DataReady", true)
	PlayerData.sync(player)

	-- daily visit bonus
	local today = math.floor(os.time() / 86400)
	if profile.LastDaily ~= today then
		profile.LastDaily = today
		task.delay(4, function()
			if player.Parent then
				PlayerData.addBucks(player, Config.Economy.DailyBonus, "Welcome to Benton Diesel World! Daily visit bonus")
			end
		end)
	end
	if not loaded and RunService:IsStudio() then
		task.delay(6, function()
			if player.Parent then
				PlayerData.notify(player, "Saving is off in Studio. Enable Studio Access to API Services to test saves.", "warn")
			end
		end)
	end
end

local readyCallbacks: { (Player) -> () } = {}
function PlayerData.onReady(fn: (Player) -> ())
	table.insert(readyCallbacks, fn)
end

function PlayerData.start()
	local function added(player: Player)
		load(player)
		if profiles[player] then
			for _, fn in readyCallbacks do
				task.spawn(fn, player)
			end
		end
	end
	Players.PlayerAdded:Connect(added)
	for _, player in Players:GetPlayers() do
		task.spawn(added, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		canSave[player] = nil
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
		task.wait(2)
	end)
	-- autosave + playtime rewards
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(Config.Economy.PlaytimeInterval)
			elapsed += Config.Economy.PlaytimeInterval
			for _, player in Players:GetPlayers() do
				if profiles[player] then
					PlayerData.bumpStat(player, "Playtime", Config.Economy.PlaytimeInterval)
					PlayerData.addBucks(player, Config.Economy.PlaytimeReward, "Thanks for spending time at the park!")
					if elapsed % 240 == 0 then
						task.spawn(save, player)
					end
				end
			end
		end
	end)
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">RideService</string>
          <string name="Source"><![CDATA[-- Ride operations: queue lines shared by real players and simulated guests,
-- posted wait times, dispatch cycles, seating riders, rewards, and the
-- occasional "temporarily closed" breakdown.
--
-- Every ride has a physical queue maze (see QueueLine). The order of the
-- line is published as ReplicatedStorage.BentonState.Rides.<RideId>.Line so
-- each client can draw the guests standing in it; players walk the line
-- themselves and leave it if they walk out of the maze.
--
-- Vehicles are animated on each client from the dispatch time published in
-- ReplicatedStorage.BentonState.Rides.<RideId> (see RideAnimator). The
-- server only anchors riders in place and moves them on/off the ride.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Net = require(Shared.Net)
local RideMotion = require(Shared.RideMotion)
local QueueLine = require(Shared.QueueLine)

local PlayerData = require(script.Parent.PlayerData)
local Wearables = require(script.Parent.Wearables)

type RideInfo = {
	ride: Config.Ride,
	model: Model,
	motion: RideMotion.Motion,
	nameLabel: TextLabel,
	waitLabel: TextLabel,
	statusLabel: TextLabel,
	joinPrompt: ProximityPrompt,
	expressPrompt: ProximityPrompt,
}

type Entry = {
	id: number,
	player: Player?,
	express: boolean,
	seed: number,
	joined: number, -- Clock.now() when a player joined
}

type Rider = {
	player: Player?,
	character: Model?,
	car: number,
	seat: number,
	seed: number,
}

type RideState = {
	info: RideInfo,
	ride: Config.Ride,
	motion: RideMotion.Motion,
	folder: Folder,
	queue: { Entry },
	status: string, -- Open | Boarding | Running | Closed
	cycleId: number,
	cycleEnds: number,
	downUntil: number,
	riders: { Rider },
	rng: Random,
}

local RideService = {}

local states: { [string]: RideState } = {}
local order: { RideState } = {}
local boardRows: { { [string]: TextLabel } } = {}
local riding: { [Player]: string } = {}
local nextEntryId = 0

local function newEntry(player: Player?, express: boolean, seed: number): Entry
	nextEntryId += 1
	return { id = nextEntryId, player = player, express = express, seed = seed, joined = Clock.now() }
end

-- Line order for the clients: "id:seed" per simulated guest, "p<UserId>"
-- for a player, front of the line first.
local function publishLine(s: RideState)
	local tokens = table.create(#s.queue)
	for i, e in s.queue do
		local p = e.player
		tokens[i] = if p then "p" .. p.UserId else e.id .. ":" .. e.seed
	end
	s.folder:SetAttribute("Line", table.concat(tokens, ","))
end

local function rootOf(character: Model?): BasePart?
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function cycleTotal(s: RideState): number
	return Config.BoardingTime + s.motion.duration + Config.UnloadTime
end

local function roundUp5(minutes: number): number
	return math.max(5, math.ceil(minutes / 5) * 5)
end

-- Seconds until a guest at queue position `pos` (1-based) boards.
local function etaFor(s: RideState, pos: number): number
	local cap = math.max(1, s.motion.capacity)
	local cyclesAhead = math.floor((pos - 1) / cap)
	local now = Clock.now()
	local current = 0
	if s.status == "Boarding" or s.status == "Running" then
		current = math.max(0, s.cycleEnds - now)
	end
	return current + cyclesAhead * cycleTotal(s)
end

local function postedWait(s: RideState): number
	return roundUp5(etaFor(s, #s.queue + 1) / 60 * 60) -- seconds == park minutes
end

local function queuePosition(s: RideState, player: Player): number?
	for i, e in s.queue do
		if e.player == player then
			return i
		end
	end
	return nil
end

local function refreshQueueAttributes(s: RideState)
	for i, e in s.queue do
		local p = e.player
		if p then
			p:SetAttribute("QueueRide", s.ride.id)
			p:SetAttribute("QueuePos", i)
			p:SetAttribute("QueueEta", math.ceil(etaFor(s, i)))
		end
	end
end

local function findQueue(player: Player): (RideState?, number?)
	for _, s in order do
		local pos = queuePosition(s, player)
		if pos then
			return s, pos
		end
	end
	return nil, nil
end

function RideService.leave(player: Player, quiet: boolean?)
	local s, pos = findQueue(player)
	if s and pos then
		table.remove(s.queue, pos)
		refreshQueueAttributes(s)
		publishLine(s)
		if not quiet then
			PlayerData.notify(player, "You left the line for " .. s.ride.name .. ".", "info")
		end
	end
	player:SetAttribute("QueueRide", "")
	player:SetAttribute("QueuePos", 0)
	player:SetAttribute("QueueEta", 0)
end

function RideService.join(player: Player, rideId: string, express: boolean)
	local s = states[rideId]
	if not s then
		return
	end
	if riding[player] then
		PlayerData.notify(player, "Finish your current ride first!", "warn")
		return
	end
	local current = findQueue(player)
	if current == s and not express then
		PlayerData.notify(player, "You're already in line for " .. s.ride.name .. ".", "info")
		return
	end
	if current then
		RideService.leave(player, true)
	end
	local entry = newEntry(player, express, player.UserId % 100000)
	if express then
		local profile = PlayerData.get(player)
		if not profile or profile.Passes <= 0 then
			PlayerData.notify(player, "You don't have any Express Passes. Buy them at the shops!", "warn")
			return
		end
		profile.Passes -= 1
		PlayerData.sync(player)
		-- behind other express guests, ahead of everyone else
		local at = 1
		for i, e in s.queue do
			if e.express then
				at = i + 1
			end
		end
		table.insert(s.queue, at, entry)
		PlayerData.notify(player, "Express Pass used! Head past the line to the front for " .. s.ride.name .. ".", "reward")
	else
		table.insert(s.queue, entry)
		local wait = math.ceil(etaFor(s, #s.queue))
		PlayerData.notify(player, string.format("You joined the line for %s - about %d min. Stand still and you'll move up with the line.", s.ride.name, math.max(1, wait)), "info")
	end
	if s.status == "Closed" then
		PlayerData.notify(player, s.ride.name .. " is temporarily closed. Hang tight - you'll keep your place!", "warn")
	end
	refreshQueueAttributes(s)
	publishLine(s)
end

-- Players walk the queue maze themselves; walking out of it (or back out
-- past the entrance sign) gives up their place.
local function checkLines()
	for _, s in order do
		local line = QueueLine.get(s.ride.id)
		if not line then
			continue
		end
		for i = #s.queue, 1, -1 do
			local e = s.queue[i]
			local p = e.player
			if p and Clock.now() - e.joined > 5 then
				local root = rootOf(p.Character)
				local away = true
				if root then
					local along, off = QueueLine.project(line, root.Position)
					away = off > 5 or along > math.max(line.signAt, QueueLine.slot(i)) + 10
				end
				if away then
					RideService.leave(p, true)
					PlayerData.notify(p, "You stepped out of the line for " .. s.ride.name .. ".", "warn")
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Seating and unloading
---------------------------------------------------------------------------

local function humanoidOf(character: Model?): Humanoid?
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function seatPlayer(s: RideState, rider: Rider, rest: { CFrame })
	local character = rider.character
	local root = rootOf(character)
	local hum = humanoidOf(character)
	if not character or not root or not hum then
		return
	end
	Wearables.hideBalloon(character)
	local seatCF = rest[rider.car] * s.motion.seats[rider.car][rider.seat]
	hum.Sit = true
	root.Anchored = true
	character:PivotTo(seatCF)
end

local function releasePlayer(s: RideState, rider: Rider, index: number)
	local player = rider.player
	local character = rider.character
	if not player then
		return
	end
	riding[player] = nil
	player:SetAttribute("Riding", "")
	if not player.Parent or player.Character ~= character then
		return
	end
	local root = rootOf(character)
	local hum = humanoidOf(character)
	local exit = s.ride.exit
	local away = Vector3.new(exit.X - s.ride.origin.X, 0, exit.Z - s.ride.origin.Z)
	away = if away.Magnitude > 0.1 then away.Unit else Vector3.new(0, 0, 1)
	local side = away:Cross(Vector3.yAxis)
	local offset = side * (((index - 1) % 5) - 2) * 2.5 + away * (math.floor((index - 1) / 5) * 2.5 + 2)
	local target = Vector3.new(exit.X, 3.5, exit.Z) + offset
	if root then
		root.Anchored = false
	end
	if hum then
		hum.Sit = false
	end
	if character then
		character:PivotTo(CFrame.lookAt(target, target + away))
		Wearables.showBalloon(player)
	end
end

local function reward(s: RideState, player: Player)
	PlayerData.bumpStat(player, "Rides")
	local first = PlayerData.stamp(player, s.ride.id)
	local amount = Config.Economy.RideReward + (if first then Config.Economy.FirstRideBonus else 0)
	if first then
		PlayerData.addBucks(player, amount, "New passport stamp: " .. s.ride.name .. "!")
		-- land complete bonus
		local profile = PlayerData.get(player)
		if profile then
			local all = true
			for _, ride in Config.Rides do
				if ride.land == s.ride.land and not table.find(profile.Stamps, ride.id) then
					all = false
				end
			end
			if all then
				local land = Config.landById(s.ride.land)
				PlayerData.addBucks(player, Config.Economy.LandCompleteBonus, "You rode everything in " .. (if land then land.name else "this land") .. "!")
			end
		end
	else
		PlayerData.addBucks(player, amount, "Thanks for riding " .. s.ride.name .. "!")
	end
end

---------------------------------------------------------------------------
-- Ride cycle
---------------------------------------------------------------------------
local function publish(s: RideState)
	local f = s.folder
	f:SetAttribute("Status", s.status)
	f:SetAttribute("Queue", #s.queue)
	f:SetAttribute("Wait", if s.status == "Closed" then -1 else postedWait(s))
end

local function encodeRiders(riders: { Rider }): string
	local list = {}
	for _, r in riders do
		local p = r.player
		table.insert(list, { c = r.car, s = r.seat, u = if p then p.UserId else 0, n = r.seed })
	end
	return HttpService:JSONEncode(list)
end

local function runCycle(s: RideState)
	local seats: { { number } } = RideMotion.seatList(s.motion) -- front car first
	local capacity = #seats
	local riders: { Rider } = {}
	while #riders < capacity and #s.queue > 0 do
		local entry = table.remove(s.queue, 1) :: Entry
		local player = entry.player
		if player then
			if player.Parent and rootOf(player.Character) and not riding[player] then
				table.insert(riders, { player = player, character = player.Character, car = 0, seat = 0, seed = entry.seed })
				player:SetAttribute("QueueRide", "")
				player:SetAttribute("QueuePos", 0)
				player:SetAttribute("QueueEta", 0)
			end
		else
			table.insert(riders, { player = nil, character = nil, car = 0, seat = 0, seed = entry.seed })
		end
	end
	-- players get the front seats; simulated guests fill the rest at random
	local used: { [string]: boolean } = {}
	local nextSeat = 1
	for _, r in riders do
		if r.player then
			local seat = seats[nextSeat]
			nextSeat += 1
			r.car, r.seat = seat[1], seat[2]
			used[seat[1] .. ":" .. seat[2]] = true
		end
	end
	local free: { { number } } = {}
	for _, seat in seats do
		if not used[seat[1] .. ":" .. seat[2]] then
			table.insert(free, seat)
		end
	end
	s.rng:Shuffle(free)
	local fi = 1
	for _, r in riders do
		if not r.player then
			local seat = free[fi]
			fi += 1
			if seat then
				r.car, r.seat = seat[1], seat[2]
			end
		end
	end
	refreshQueueAttributes(s)
	publishLine(s)
	if #riders == 0 then
		return
	end

	local now = Clock.now()
	s.cycleId += 1
	s.riders = riders
	s.status = "Boarding"
	s.cycleEnds = now + cycleTotal(s)
	local start = now + Config.BoardingTime
	s.folder:SetAttribute("CycleId", s.cycleId)
	s.folder:SetAttribute("CycleStart", start)
	s.folder:SetAttribute("Riders", encodeRiders(riders))
	publish(s)

	local rest = s.motion.pose(0)
	for _, r in riders do
		local p = r.player
		if p then
			riding[p] = s.ride.id
			p:SetAttribute("Riding", s.ride.id)
			seatPlayer(s, r, rest)
			PlayerData.notify(p, "Now boarding " .. s.ride.name .. "! Keep your arms and legs inside the vehicle.", "info")
		end
	end
	task.wait(Config.BoardingTime)
	s.status = "Running"
	publish(s)
	task.wait(s.motion.duration)
	s.status = "Open"
	for i, r in riders do
		local p = r.player
		if p then
			releasePlayer(s, r, i)
			if p.Parent then
				reward(s, p)
			end
		end
	end
	s.riders = {}
	s.folder:SetAttribute("Riders", "[]")
	publish(s)
	task.wait(Config.UnloadTime)
end

local function rideLoop(s: RideState)
	while true do
		local now = Clock.now()
		if s.status == "Open" and now < s.downUntil then
			-- closed (see RideService.closeFor) while a cycle was running
			s.status = "Closed"
			publish(s)
		end
		if s.status == "Closed" then
			if now >= s.downUntil then
				s.status = "Open"
				publish(s)
				for _, e in s.queue do
					local p = e.player
					if p then
						PlayerData.notify(p, s.ride.name .. " has reopened!", "info")
					end
				end
			else
				task.wait(1)
				continue
			end
		end
		if #s.queue > 0 then
			local ok, err = pcall(runCycle, s)
			if not ok then
				warn("[BentonDieselWorld] ride cycle error on " .. s.ride.id .. ": " .. tostring(err))
				-- release anybody left on board
				for i, r in s.riders do
					pcall(releasePlayer, s, r, i)
				end
				s.riders = {}
				s.status = "Open"
				s.folder:SetAttribute("Riders", "[]")
				task.wait(2)
			end
		else
			task.wait(0.5)
		end
	end
end

---------------------------------------------------------------------------
-- Simulated crowd
---------------------------------------------------------------------------
local function simulateCrowd()
	local minute = Clock.minutes()
	local crowd = Clock.crowd(minute)
	local t = Clock.now()
	for i, s in order do
		local wobble = 0.8 + 0.4 * (math.noise(i * 7.31, t / 90) + 0.5)
		local target = s.ride.baseWait * crowd * wobble
		local desired = math.floor(target / cycleTotal(s) * s.motion.capacity)
		local npcs = 0
		for _, e in s.queue do
			if not e.player then
				npcs += 1
			end
		end
		if npcs < desired then
			local add = math.min(desired - npcs, math.max(1, math.ceil(s.motion.capacity / 4)))
			for _ = 1, add do
				table.insert(s.queue, newEntry(nil, false, s.rng:NextInteger(1, 1000000)))
			end
			publishLine(s)
		elseif npcs > desired + s.motion.capacity then
			-- a few guests give up and leave from the back of the line
			for k = #s.queue, 1, -1 do
				if not s.queue[k].player then
					table.remove(s.queue, k)
					break
				end
			end
			publishLine(s)
		end
		-- rare breakdowns (only between cycles)
		if s.status == "Open" and s.rng:NextNumber() < 0.004 then
			s.status = "Closed"
			s.downUntil = t + s.rng:NextNumber(40, 80)
			for _, e in s.queue do
				local p = e.player
				if p then
					PlayerData.notify(p, s.ride.name .. " is temporarily closed. Our mechanics are on it!", "warn")
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Signs and boards
---------------------------------------------------------------------------
local function setupBoard(board: Part)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Brightness = 1.3
	gui.MaxDistance = 300
	gui.Parent = board
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 2)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = gui
	local rows: { [string]: TextLabel } = {}
	for i, ride in Config.Rides do
		local land = Config.landById(ride.land) :: Config.Land
		local row = Instance.new("Frame")
		row.Name = ride.id
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 1 / (#Config.Rides + 0.6), -2)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(26, 34, 52) else Color3.fromRGB(20, 26, 42)
		row.BorderSizePixel = 0
		row.Parent = gui
		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, 10, 0.6, 0)
		dot.Position = UDim2.new(0, 4, 0.2, 0)
		dot.BackgroundColor3 = land.color
		dot.BorderSizePixel = 0
		dot.Parent = row
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Position = UDim2.new(0, 20, 0, 0)
		name.Size = UDim2.new(0.72, -20, 1, 0)
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.Text = ride.name
		name.TextScaled = true
		name.TextColor3 = Config.Colors.Cream
		name.FontFace = Font.fromEnum(Enum.Font.GothamBold)
		name.Parent = row
		local wait = Instance.new("TextLabel")
		wait.Name = "Wait"
		wait.BackgroundTransparency = 1
		wait.Position = UDim2.new(0.72, 0, 0, 0)
		wait.Size = UDim2.new(0.28, 0, 1, 0)
		wait.TextXAlignment = Enum.TextXAlignment.Right
		wait.Text = "--"
		wait.TextScaled = true
		wait.TextColor3 = Config.Colors.Orange
		wait.FontFace = Font.fromEnum(Enum.Font.GothamBlack)
		wait.Parent = row
		rows[ride.id] = wait
	end
	table.insert(boardRows, rows)
end

local GREEN = Color3.fromRGB(90, 220, 110)
local YELLOW = Color3.fromRGB(250, 210, 60)
local ORANGE = Color3.fromRGB(255, 140, 26)
local RED = Color3.fromRGB(240, 70, 60)

local function waitColor(minutes: number): Color3
	if minutes <= 15 then
		return GREEN
	elseif minutes <= 30 then
		return YELLOW
	elseif minutes <= 45 then
		return ORANGE
	end
	return RED
end

local function updateSigns()
	for _, s in order do
		publish(s)
		local info = s.info
		local closed = s.status == "Closed"
		local wait = postedWait(s)
		local text = if closed then "CLOSED" else (wait .. " MIN")
		local color = if closed then RED else waitColor(wait)
		info.waitLabel.Text = text
		info.waitLabel.TextColor3 = color
		if closed then
			info.statusLabel.Text = "TEMPORARILY CLOSED"
			info.statusLabel.TextColor3 = RED
		elseif s.status == "Running" then
			info.statusLabel.Text = "RIDE IN PROGRESS"
			info.statusLabel.TextColor3 = YELLOW
		else
			info.statusLabel.Text = "NOW BOARDING"
			info.statusLabel.TextColor3 = GREEN
		end
		info.joinPrompt.ActionText = if closed then "Join Line (closed)" else string.format("Join Line (%d min)", wait)
		for _, rows in boardRows do
			local label = rows[s.ride.id]
			if label then
				label.Text = text
				label.TextColor3 = color
			end
		end
		refreshQueueAttributes(s)
	end
end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
-- Take a ride out of service for a while, as soon as the current cycle
-- ends (Studio helper and tests; guests in line keep their places).
function RideService.closeFor(rideId: string, seconds: number)
	local s = states[rideId]
	if s then
		s.downUntil = Clock.now() + seconds
		if s.status == "Open" then
			s.status = "Closed"
			publish(s)
		end
	end
end

function RideService.isRiding(player: Player): boolean
	return riding[player] ~= nil
end

function RideService.start(infos: { [string]: RideInfo }, boards: { Part })
	local stateFolder = Net.state():WaitForChild("Rides")
	for _, ride in Config.Rides do
		local info = infos[ride.id]
		local folder = stateFolder:FindFirstChild(ride.id) :: Folder?
		if not folder then
			local f = Instance.new("Folder")
			f.Name = ride.id
			f.Parent = stateFolder
			folder = f
		end
		local rideFolder = folder :: Folder
		local s: RideState = {
			info = info,
			ride = ride,
			motion = info.motion,
			folder = rideFolder,
			queue = {},
			status = "Open",
			cycleId = 0,
			cycleEnds = 0,
			downUntil = 0,
			riders = {},
			rng = Random.new(#ride.id * 977 + math.floor(os.clock() * 1000) % 1000),
		}
		s.folder:SetAttribute("Duration", info.motion.duration)
		s.folder:SetAttribute("Capacity", info.motion.capacity)
		s.folder:SetAttribute("CycleId", 0)
		s.folder:SetAttribute("CycleStart", 0)
		s.folder:SetAttribute("Riders", "[]")
		states[ride.id] = s
		table.insert(order, s)
		info.joinPrompt.Triggered:Connect(function(player)
			RideService.join(player, ride.id, false)
		end)
		info.expressPrompt.Triggered:Connect(function(player)
			RideService.join(player, ride.id, true)
		end)
	end
	for _, board in boards do
		setupBoard(board)
	end
	-- warm up the queues so waits look realistic from the first second
	for _ = 1, 20 do
		simulateCrowd()
	end
	for _, s in order do
		task.spawn(rideLoop, s)
	end
	task.spawn(function()
		while true do
			simulateCrowd()
			task.wait(2)
		end
	end)
	task.spawn(function()
		while true do
			updateSigns()
			task.wait(1)
		end
	end)
	task.spawn(function()
		while true do
			checkLines()
			task.wait(0.5)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		RideService.leave(player, true)
		riding[player] = nil
	end)
end

return RideService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Shops, restaurants, eating, hunger and food boosts.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Clock = require(Shared.Clock)
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Props = require(Shared.Props)

local PlayerData = require(script.Parent.PlayerData)
local Wearables = require(script.Parent.Wearables)

local ShopService = {}

type VenueInfo = {
	venue: Config.Venue,
	model: Model,
	prompt: ProximityPrompt,
}

type Buff = { kind: string, amount: number, expires: number }

local buffs: { [Player]: { Buff } } = {}
local MAX_FOOD = 3
local SHOP_RANGE = 45

local function humanoid(player: Player): Humanoid?
	local c = player.Character
	return if c then c:FindFirstChildOfClass("Humanoid") else nil
end

-- Walk speed / jump from hunger and active food boosts.
local function refreshMovement(player: Player)
	local hum = humanoid(player)
	if not hum then
		return
	end
	local hunger = player:GetAttribute("Hunger") :: number? or Config.Hunger.Max
	local speed = if hunger <= 0 then Config.Hunger.HungrySpeed else Config.Hunger.NormalSpeed
	local jump = 7.2
	local now = Clock.now()
	local active = {}
	for _, b in buffs[player] or {} do
		if b.expires > now then
			table.insert(active, b)
			if b.kind == "speed" then
				speed += b.amount
			elseif b.kind == "jump" then
				jump += b.amount * 0.5
			end
		end
	end
	buffs[player] = active
	hum.WalkSpeed = speed
	hum.UseJumpPower = false
	hum.JumpHeight = jump
	local boost = ""
	for _, b in active do
		boost = b.kind
	end
	player:SetAttribute("Boost", boost)
end

local function foodCount(player: Player): number
	local n = 0
	for _, holder in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if holder then
			for _, t in holder:GetChildren() do
				local id = t:GetAttribute("ItemId")
				local item = if type(id) == "string" then Items.get(id) else nil
				if t:IsA("Tool") and item and item.kind == "food" then
					n += 1
				end
			end
		end
	end
	return n
end

local function giveFood(player: Player, item: Items.Item)
	local tool = Props.tool(item)
	tool.ToolTip = item.name .. " - click to take a bite"
	tool:SetAttribute("Bites", item.bites or 3)
	local busy = false
	tool.Activated:Connect(function()
		if busy then
			return
		end
		busy = true
		local owner = Players:GetPlayerFromCharacter(tool.Parent :: any)
		if owner then
			local bites = (tool:GetAttribute("Bites") :: number?) or 1
			local per = math.ceil((item.hunger or 20) / (item.bites or 3))
			local hunger = (owner:GetAttribute("Hunger") :: number?) or 0
			owner:SetAttribute("Hunger", math.min(Config.Hunger.Max, hunger + per))
			if item.buff and bites == (item.bites or 3) then
				local list = buffs[owner] or {}
				table.insert(list, { kind = item.buff.kind, amount = item.buff.amount, expires = Clock.now() + item.buff.duration })
				buffs[owner] = list
				PlayerData.notify(owner, string.format("%s boost for %d seconds!", if item.buff.kind == "speed" then "Speed" else "Jump", item.buff.duration), "reward")
			end
			bites -= 1
			if bites <= 0 then
				PlayerData.bumpStat(owner, "Meals")
				PlayerData.notify(owner, "Yum! You finished your " .. item.name .. ".", "info")
				tool:Destroy()
			else
				tool:SetAttribute("Bites", bites)
			end
			refreshMovement(owner)
		end
		task.wait(0.6)
		busy = false
	end)
	tool.Parent = player:FindFirstChildOfClass("Backpack")
end

local function nearVenue(player: Player, venue: Config.Venue): boolean
	local c = player.Character
	local root = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	local d = (root.Position - venue.position) * Vector3.new(1, 0, 1)
	return d.Magnitude <= SHOP_RANGE + math.max(venue.size.X, venue.size.Z) / 2
end

local function buy(player: Player, venueId: string, itemId: string)
	local venue = Config.VenueById[venueId]
	local item = Items.get(itemId)
	if not venue or not item or not table.find(venue.items, itemId) then
		return
	end
	if not nearVenue(player, venue) then
		PlayerData.notify(player, "Walk up to the counter at " .. venue.name .. " to buy that.", "warn")
		return
	end
	local slot = Items.slot(item)
	if (slot or item.kind == "held") and PlayerData.owns(player, item.id) then
		PlayerData.notify(player, "You already own the " .. item.name .. ". Equip it from your Bag!", "info")
		return
	end
	if item.kind == "food" and foodCount(player) >= MAX_FOOD then
		PlayerData.notify(player, "Your hands are full! Finish some food first.", "warn")
		return
	end
	if not PlayerData.spend(player, item.price) then
		PlayerData.notify(player, "Not enough " .. Config.Currency .. ". Ride rides and watch shows to earn more!", "warn")
		return
	end
	if item.kind == "pass" then
		local profile = PlayerData.get(player)
		if profile then
			profile.Passes += 1
			PlayerData.sync(player)
		end
		PlayerData.notify(player, "Express Pass added! Use it with [F] at any ride entrance.", "reward")
	elseif item.kind == "food" then
		giveFood(player, item)
		PlayerData.notify(player, "Order up! " .. item.name .. " is in your backpack.", "info")
	elseif item.kind == "held" then
		PlayerData.give(player, item.id)
		Wearables.giveTools(player)
		PlayerData.notify(player, "You bought the " .. item.name .. "! It's in your backpack.", "reward")
	elseif slot then
		PlayerData.give(player, item.id)
		local profile = PlayerData.get(player)
		if profile then
			profile.Equipped[slot] = item.id
			PlayerData.sync(player)
		end
		Wearables.apply(player)
		PlayerData.notify(player, "You bought the " .. item.name .. " and put it on!", "reward")
	end
end

local function equip(player: Player, slot: string, itemId: string?)
	local profile = PlayerData.get(player)
	if not profile or (slot ~= "hat" and slot ~= "face" and slot ~= "balloon") then
		return
	end
	if itemId and itemId ~= "" then
		local item = Items.get(itemId)
		if not item or Items.slot(item) ~= slot or not PlayerData.owns(player, itemId) then
			return
		end
		profile.Equipped[slot] = itemId
	else
		profile.Equipped[slot] = ""
	end
	PlayerData.sync(player)
	Wearables.apply(player)
end

function ShopService.start(venues: { [string]: VenueInfo }, onAction: (Player, any) -> ())
	for id, info in venues do
		info.prompt.Triggered:Connect(function(player)
			Net.remote("OpenVenue"):FireClient(player, id)
		end)
	end
	local action = Net.remote("Action")
	local lastAction: { [Player]: number } = {}
	action.OnServerEvent:Connect(function(player, payload)
		if type(payload) ~= "table" or type(payload.type) ~= "string" then
			return
		end
		-- light rate limit
		local now = Clock.now()
		if lastAction[player] and now - lastAction[player] < 0.15 then
			return
		end
		lastAction[player] = now
		local t = payload.type
		if t == "Buy" and type(payload.venue) == "string" and type(payload.item) == "string" then
			buy(player, payload.venue, payload.item)
		elseif t == "Equip" and type(payload.slot) == "string" then
			equip(player, payload.slot, if type(payload.item) == "string" then payload.item else nil)
		else
			onAction(player, payload)
		end
	end)
	-- hunger drain and movement refresh
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(1)
			tick += 1
			for _, player in Players:GetPlayers() do
				if player:GetAttribute("DataReady") then
					if tick % Config.Hunger.DrainInterval == 0 then
						local h = (player:GetAttribute("Hunger") :: number?) or Config.Hunger.Max
						local nh = math.max(0, h - 1)
						player:SetAttribute("Hunger", nh)
						if nh == Config.Hunger.HungryAt then
							PlayerData.notify(player, "Your tummy is rumbling! Grab a bite at one of the park's restaurants.", "warn")
						elseif nh == 0 and h > 0 then
							PlayerData.notify(player, "You're too hungry to hurry. Eat something to get your speed back!", "warn")
						end
					end
					refreshMovement(player)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		buffs[player] = nil
		lastAction[player] = nil
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ShowService</string>
          <string name="Source"><![CDATA[-- Runs the show schedule. When a show starts the server publishes its start
-- time in ReplicatedStorage.BentonState.Shows.<ShowId>; every client plays
-- the show locally in sync (see ShowPlayer). Guests watching from the
-- viewing area earn Benton Bucks.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Net = require(Shared.Net)

local PlayerData = require(script.Parent.PlayerData)

local ShowService = {}

local function watchers(show: Config.Show): { Player }
	local out = {}
	for _, player in Players:GetPlayers() do
		local c = player.Character
		local root = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local d = (root.Position - show.viewing) * Vector3.new(1, 0, 1)
			if d.Magnitude <= show.viewRadius then
				table.insert(out, player)
			end
		end
	end
	return out
end

local function run(show: Config.Show, folder: Folder)
	local start = Clock.now()
	folder:SetAttribute("Start", start)
	folder:SetAttribute("Running", true)
	for _, player in Players:GetPlayers() do
		PlayerData.notify(player, string.format("%s is starting now at %s!", show.name, show.venue), "show")
	end
	local watched: { [Player]: boolean } = {}
	-- check who is watching a few times during the show
	for _, part in { 0.35, 0.35, 0.3 } do
		task.wait(show.duration * part)
		for _, p in watchers(show) do
			watched[p] = true
		end
	end
	folder:SetAttribute("Running", false)
	for player in watched do
		if player.Parent then
			PlayerData.bumpStat(player, "Shows")
			PlayerData.addBucks(player, Config.Economy.ShowReward, "Bravo! Thanks for watching " .. show.name .. ".")
		end
	end
end

-- Start a show right away (used by the Studio test hook in init).
function ShowService.startNow(showId: string)
	local show = Config.ShowById[showId]
	local f = Net.state():WaitForChild("Shows"):FindFirstChild(showId) :: Folder?
	if show and f and not f:GetAttribute("Running") then
		task.spawn(run, show, f)
	end
end

function ShowService.start()
	local folder = Net.state():WaitForChild("Shows")
	local played: { [string]: boolean } = {}
	for _, show in Config.Shows do
		local f = folder:FindFirstChild(show.id) :: Folder?
		if not f then
			local nf = Instance.new("Folder")
			nf.Name = show.id
			nf.Parent = folder
			f = nf
		end
		(f :: Folder):SetAttribute("Start", 0);
		(f :: Folder):SetAttribute("Running", false);
		(f :: Folder):SetAttribute("Duration", show.duration)
	end
	task.spawn(function()
		while true do
			local now = Clock.now()
			local minute = Clock.minutes()
			local cycle = math.floor((now - (Net.state():GetAttribute("ClockEpoch") :: number? or 0)) / Clock.CYCLE_SECONDS)
			for _, show in Config.Shows do
				for _, t in show.times do
					local key = show.id .. ":" .. cycle .. ":" .. t
					if not played[key] and minute >= t and minute < t + 2 then
						played[key] = true
						local f = folder:FindFirstChild(show.id) :: Folder
						if not f:GetAttribute("Running") then
							task.spawn(run, show, f)
						end
					end
				end
			end
			task.wait(0.5)
		end
	end)
end

return ShowService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Wearables</string>
          <string name="Source"><![CDATA[-- Puts purchased souvenirs on characters: hats and shades as Accessories,
-- balloons floating on a rope from the left hand, and held souvenirs as
-- Tools in the Backpack.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Items = require(Shared.Items)
local Props = require(Shared.Props)

local PlayerData = require(script.Parent.PlayerData)

local Wearables = {}

local TAG = "BentonWearable"

local function clear(character: Model, onlyBalloon: boolean?)
	for _, child in character:GetChildren() do
		if child:GetAttribute(TAG) then
			if not onlyBalloon or child:GetAttribute(TAG) == "balloon" then
				child:Destroy()
			end
		end
	end
end

local function attachBalloon(character: Model, item: Items.Item)
	local hand = character:FindFirstChild("LeftGripAttachment", true) :: Attachment?
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hand or not root then
		return
	end
	local model = Props.balloon(item)
	model:SetAttribute(TAG, "balloon")
	local balloon = model.PrimaryPart :: BasePart
	model:PivotTo(root.CFrame * CFrame.new(-1.5, 7, 1))
	local rope = Instance.new("RopeConstraint")
	rope.Attachment0 = hand
	rope.Attachment1 = balloon:FindFirstChild("StringAttachment") :: Attachment
	rope.Length = 7
	rope.Visible = true
	rope.Thickness = 0.06
	rope.Color = BrickColor.new("Institutional white")
	rope.Parent = balloon
	local center = Instance.new("Attachment")
	center.Name = "LiftAttachment"
	center.Parent = balloon
	local lift = Instance.new("VectorForce")
	lift.Attachment0 = center
	lift.RelativeTo = Enum.ActuatorRelativeTo.World
	lift.ApplyAtCenterOfMass = true
	lift.Force = Vector3.new(0, balloon:GetMass() * workspace.Gravity * 1.35, 0)
	lift.Parent = balloon
	model.Parent = character
	pcall(function()
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			balloon:SetNetworkOwner(player)
		end
	end)
end

function Wearables.apply(player: Player)
	local character = player.Character
	local profile = PlayerData.get(player)
	if not character or not profile then
		return
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	clear(character)
	for _, slot in { "hat", "face" } do
		local id = profile.Equipped[slot]
		local item = if id and id ~= "" then Items.get(id) else nil
		if item and PlayerData.owns(player, item.id) then
			local acc = Props.accessory(item)
			acc:SetAttribute(TAG, slot)
			hum:AddAccessory(acc)
		end
	end
	if not player:GetAttribute("Riding") or player:GetAttribute("Riding") == "" then
		local id = profile.Equipped.balloon
		local item = if id and id ~= "" then Items.get(id) else nil
		if item and PlayerData.owns(player, item.id) then
			attachBalloon(character, item)
		end
	end
end

function Wearables.hideBalloon(character: Model)
	clear(character, true)
end

function Wearables.showBalloon(player: Player)
	local character = player.Character
	local profile = PlayerData.get(player)
	if not character or not profile then
		return
	end
	clear(character, true)
	local id = profile.Equipped.balloon
	local item = if id and id ~= "" then Items.get(id) else nil
	if item and PlayerData.owns(player, item.id) then
		attachBalloon(character, item)
	end
end

-- Give the player Tools for every held souvenir they own.
function Wearables.giveTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local profile = PlayerData.get(player)
	if not backpack or not profile then
		return
	end
	for _, id in profile.Owned do
		local item = Items.get(id)
		if item and item.kind == "held" then
			local has = false
			for _, holder in { backpack, player.Character } do
				if holder then
					for _, t in holder:GetChildren() do
						if t:IsA("Tool") and t:GetAttribute("ItemId") == id then
							has = true
						end
					end
				end
			end
			if not has then
				Props.tool(item).Parent = backpack
			end
		end
	end
end

function Wearables.start()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("Humanoid", 10)
			task.wait(0.5)
			if player.Character == character then
				Wearables.apply(player)
				Wearables.giveTools(player)
			end
		end)
		if player.Character then
			Wearables.apply(player)
			Wearables.giveTools(player)
		end
	end
	PlayerData.onReady(hook)
end

return Wearables
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="32">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="33">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">160</float>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="34">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="35">
        <Properties>
          <string name="Name">BentonClient</string>
          <string name="Source"><![CDATA[-- Benton Diesel World - client entry point.
-- Starts the Benton App UI, ride animation, ride crews, queue lines, shows,
-- ambience and guidance once the server has built the park.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Net = require(Shared.Net)
local Clock = require(Shared.Clock)

local App = require(script.App)
local Guide = require(script.Guide)
local RideAnimator = require(script.RideAnimator)
local ShowPlayer = require(script.ShowPlayer)
local Ambience = require(script.Ambience)
local QueueView = require(script.QueueView)
local SoundPlayer = require(script.SoundPlayer)
local RideStaff = require(script.RideStaff)

local state = Net.state()
while not state:GetAttribute("ParkReady") do
	state:GetAttributeChangedSignal("ParkReady"):Wait()
end
local epoch = state:GetAttribute("ClockEpoch")
if type(epoch) == "number" then
	Clock.setEpoch(epoch)
end

local root = workspace:WaitForChild("BentonDieselWorld")

local function safe(name: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn("[BentonDieselWorld] " .. name .. " failed to start: " .. tostring(err))
	end
end

safe("App", App.start)
safe("Guide", Guide.start)
safe("Ambience", function()
	Ambience.start(root)
end)
safe("Shows", ShowPlayer.start)
task.spawn(function()
	safe("Sounds", function()
		SoundPlayer.start(root)
	end)
end)
task.spawn(function()
	safe("Queues", QueueView.start)
end)
task.spawn(function()
	safe("Rides", function()
		RideAnimator.start(root)
	end)
end)
task.spawn(function()
	safe("Staff", function()
		RideStaff.start(root)
	end)
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Ambience</string>
            <string name="Source"><![CDATA[-- Day/night from the park clock, lamps at dusk, the spinning Benton Globe,
-- and a crowd of guests strolling the walkways (busier at peak hours).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Clock = require(Shared.Clock)
local Props = require(Shared.Props)

local Ambience = {}

local V = Vector3.new

-- Walkway lines guests stroll back and forth on.
local LINES: { { Vector3 } } = {
	{ V(-14, 0, 222), V(-14, 0, 6) },
	{ V(14, 0, 6), V(14, 0, 222) },
	{ V(-6, 0, 210), V(-6, 0, 20) },
	{ V(-45, 0, 252), V(45, 0, 252) },
	{ V(-30, 0, 15), V(-158, 0, 15) },
	{ V(-62, 0, 240), V(-150, 0, 232) },
	{ V(-38, 0, -100), V(-160, 0, -184) },
	{ V(0, 0, -118), V(0, 0, -290) },
	{ V(38, 0, -100), V(126, 0, -150) },
	{ V(130, 0, -120), V(215, 0, -180) },
	{ V(26, 0, 60), V(112, 0, 60) },
	{ V(112, 0, 60), V(112, 0, 246) },
	{ V(112, 0, 246), V(300, 0, 246) },
	{ V(300, 0, 60), V(300, 0, 246) },
	{ V(112, 0, 60), V(300, 0, 60) },
	{ V(-152, 0, 50), V(-152, 0, 190) },
	{ V(-200, 0, -20), V(-180, 0, 40) },
	{ V(-240, 0, -200), V(-160, 0, -175) },
}

type Walker = {
	model: Model,
	line: { Vector3 },
	s: number,
	speed: number,
	dir: number,
	offset: number,
	phase: number,
	index: number,
	hub: boolean,
}

local walkers: { Walker } = {}
local folder: Folder

local function makeWalkers(count: number)
	local rng = Random.new(77)
	for i = 1, count do
		local hub = i % 6 == 0
		local line = LINES[(i - 1) % #LINES + 1]
		local m = Props.guest(500 + i * 13, "stand")
		m.Name = "Guest"
		m.Parent = folder
		table.insert(walkers, {
			model = m,
			line = line,
			s = rng:NextNumber(0, 1),
			speed = rng:NextNumber(4.5, 6.5),
			dir = if rng:NextNumber() < 0.5 then 1 else -1,
			offset = rng:NextNumber(-4, 4),
			phase = rng:NextNumber(0, 6),
			index = i,
			hub = hub,
		})
	end
end

local HIDDEN = CFrame.new(0, -500, 0)

local function updateWalkers(dt: number, crowd: number)
	local now = os.clock()
	local visible = math.floor(#walkers * math.clamp(crowd, 0.1, 1))
	for i, w in walkers do
		if i > visible then
			w.model:PivotTo(HIDDEN)
			continue
		end
		local pos: Vector3
		local facing: Vector3
		if w.hub then
			w.s = (w.s + dt * w.speed / (2 * math.pi * 50) * w.dir) % 1
			local a = w.s * math.pi * 2
			local r = 46 + w.offset
			pos = V(math.cos(a) * r, 0, -60 + math.sin(a) * r)
			facing = V(-math.sin(a), 0, math.cos(a)) * w.dir
		else
			local a, b = w.line[1], w.line[2]
			local len = (b - a).Magnitude
			w.s += dt * w.speed / len * w.dir
			if w.s > 1 then
				w.s = 1
				w.dir = -1
			elseif w.s < 0 then
				w.s = 0
				w.dir = 1
			end
			local along = (b - a).Unit
			local side = along:Cross(Vector3.yAxis)
			pos = a:Lerp(b, w.s) + side * w.offset
			facing = along * w.dir
		end
		local bob = math.abs(math.sin(now * 7 + w.phase)) * 0.35
		w.model:PivotTo(CFrame.lookAt(pos + V(0, 3.3 + bob, 0), pos + V(0, 3.3 + bob, 0) + facing))
	end
end

function Ambience.start(root: Instance)
	folder = Instance.new("Folder")
	folder.Name = "BentonCrowd"
	folder.Parent = workspace
	makeWalkers(54)
	-- everything tagged "Spinner" turns: the globe, windmill, gears, film
	-- reels, show cars and the lighthouse lamp
	type Spin = { model: Model, base: CFrame, speed: number, axis: Vector3 }
	local spinners: { Spin } = {}
	local axes: { [string]: Vector3 } = { X = Vector3.xAxis, Y = Vector3.yAxis, Z = Vector3.zAxis }
	for _, inst in CollectionService:GetTagged("Spinner") do
		if inst:IsA("Model") and inst:IsDescendantOf(root) then
			local model = inst :: Model
			local speed = model:GetAttribute("SpinSpeed")
			local axis = model:GetAttribute("SpinAxis")
			table.insert(spinners, {
				model = model,
				base = model:GetPivot(),
				speed = if type(speed) == "number" then speed else 0.15,
				axis = if type(axis) == "string" and axes[axis] then axes[axis] else Vector3.yAxis,
			})
		end
	end
	local spinTime = 0
	local lampTimer = 0
	local lampsOn: boolean? = nil
	RunService.RenderStepped:Connect(function(dt)
		local minute = Clock.minutes()
		Lighting.ClockTime = Clock.clockTime(minute)
		spinTime += dt
		local camera = workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		for _, sp in spinners do
			if (sp.base.Position - camPos).Magnitude < 600 then
				sp.model:PivotTo(sp.base * CFrame.fromAxisAngle(sp.axis, spinTime * sp.speed))
			end
		end
		updateWalkers(dt, Clock.crowd(minute))
		lampTimer += dt
		if lampTimer > 2 then
			lampTimer = 0
			local hour = minute / 60
			local night = hour < 6.8 or hour >= 18.6
			if night ~= lampsOn then
				lampsOn = night
				for _, bulb in CollectionService:GetTagged("ParkLamp") do
					local light = bulb:FindFirstChildOfClass("PointLight")
					if light then
						light.Enabled = night
					end
				end
				-- searchlights and the lighthouse beam
				for _, p in CollectionService:GetTagged("NightLight") do
					for _, light in p:GetChildren() do
						if light:IsA("Light") then
							(light :: Light).Enabled = night
						end
					end
				end
			end
		end
	end)
end

return Ambience
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">App</string>
            <string name="Source"><![CDATA[-- The Benton App: the park's on-screen companion. Top bar (clock, Benton
-- Bucks, Express Passes, hunger), a dock of tabs (Wait Times, Map, Shows,
-- Dining, Shops, Passport, Bag), the queue/ride status pill, toasts, land
-- welcome banners and the shop/restaurant counters.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Props = require(Shared.Props)

local UI = require(script.Parent.UI)
local Guide = require(script.Parent.Guide)
local SoundPlayer = require(script.Parent.SoundPlayer)

local App = {}

local C = UI.Colors
local F = UI.Fonts
local player = Players.LocalPlayer

type Profile = {
	Bucks: number,
	Passes: number,
	Owned: { string },
	Equipped: { [string]: string },
	Stamps: { string },
	Stats: { [string]: number },
}

local profile: Profile = { Bucks = 0, Passes = 0, Owned = {}, Equipped = {}, Stamps = {}, Stats = {} }

local gui: ScreenGui
local panel: Frame
local panelTitle: TextLabel
local content: ScrollingFrame
local currentTab: string? = nil
local live: { () -> () } = {}
local dockButtons: { [string]: TextButton } = {}
local toastHolder: Frame
local bannerFrame: Frame
local venueModal: Frame? = nil
local openVenueId: string? = nil

local rideState: Folder
local showState: Folder

local function owns(id: string): boolean
	return table.find(profile.Owned, id) ~= nil
end

local function action(payload: { [string]: any })
	Net.remote("Action"):FireServer(payload)
end

---------------------------------------------------------------------------
-- Toasts and banners
---------------------------------------------------------------------------
local KIND_COLORS = {
	reward = C.Green,
	warn = C.Orange,
	show = Color3.fromRGB(190, 130, 255),
	info = C.Blue,
}

function App.toast(text: string, kind: string?, amount: number?)
	SoundPlayer.cue(if kind == "reward" then "Reward" elseif kind == "warn" then "Warn" else "Info", 0.4)
	local color = KIND_COLORS[kind or "info"] or C.Blue
	local frame = UI.make("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = toastHolder,
	}, { UI.corner(10), UI.stroke(color, 1.5, 0.3), UI.padding(10) })
	UI.make("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 4, 1, 0),
		Position = UDim2.new(0, -6, 0, 0),
		Parent = frame,
	}, { UI.corner(2) })
	local msg = text
	if amount and amount ~= 0 then
		msg = string.format("+%d %s  %s", amount, Config.CurrencyShort, text)
	end
	UI.label(msg, 15, C.Cream, F.Bold, { Parent = frame })
	local children = toastHolder:GetChildren()
	local frames = {}
	for _, c in children do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	if #frames > 4 then
		table.sort(frames, function(a, b)
			return (a :: Frame).LayoutOrder > (b :: Frame).LayoutOrder
		end)
		for i = 5, #frames do
			frames[i]:Destroy()
		end
	end
	task.delay(5.5, function()
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

local function banner(title: string, subtitle: string, color: Color3)
	bannerFrame.Visible = true
	local titleLabel = bannerFrame:FindFirstChild("Title") :: TextLabel
	local subLabel = bannerFrame:FindFirstChild("Subtitle") :: TextLabel
	local bar = bannerFrame:FindFirstChild("Bar") :: Frame
	titleLabel.Text = string.upper(title)
	titleLabel.TextColor3 = C.Cream
	subLabel.Text = subtitle
	bar.BackgroundColor3 = color
	bannerFrame.Position = UDim2.new(0.5, 0, 0, 40)
	local tween = TweenService:Create(bannerFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 70) })
	tween:Play()
	local token = os.clock()
	bannerFrame:SetAttribute("Token", token)
	task.delay(3.5, function()
		if bannerFrame:GetAttribute("Token") == token then
			bannerFrame.Visible = false
		end
	end)
end

---------------------------------------------------------------------------
-- Panel helpers
---------------------------------------------------------------------------
local function clearContent()
	live = {}
	for _, c in content:GetChildren() do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	content.CanvasPosition = Vector2.zero
end

local order = 0
local function nextOrder(): number
	order += 1
	return order
end

local function header(text: string, color: Color3?)
	UI.label(text, 18, color or C.Gold, F.Black, { Parent = content, LayoutOrder = nextOrder() })
end

local function note(text: string)
	UI.label(text, 13, C.Muted, F.Medium, { Parent = content, LayoutOrder = nextOrder() })
end

local function guideButton(position: Vector3, name: string, parent: Instance): TextButton
	return UI.button("Guide me", C.Gold, function()
		Guide.set(position, name)
		App.toast("Follow the glowing path to " .. name .. "!", "info")
	end, { Parent = parent, Size = UDim2.new(0, 86, 0, 28), TextSize = 13 })
end

-- A card with a title, subtitle and a right-aligned area.
local function rowCard(title: string, subtitle: string, accent: Color3): (Frame, Frame)
	local card = UI.card({ Parent = content, LayoutOrder = nextOrder() })
	UI.make("Frame", {
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 4, 1, 0),
		Position = UDim2.new(0, -10, 0, 0),
		Parent = card,
	})
	local left = UI.make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -110, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	}, { UI.list(2) })
	UI.label(title, 16, C.Cream, F.Black, { Parent = left, LayoutOrder = 1 })
	UI.label(subtitle, 12, C.Muted, F.Medium, { Parent = left, LayoutOrder = 2 })
	local right = UI.make("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 100, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	}, { UI.list(4, false, Enum.HorizontalAlignment.Right) })
	return card, right
end

---------------------------------------------------------------------------
-- Tabs
---------------------------------------------------------------------------
local function waitText(folder: Instance?): (string, Color3)
	if not folder then
		return "--", C.Muted
	end
	local wait = folder:GetAttribute("Wait")
	local status = folder:GetAttribute("Status")
	if status == "Closed" or wait == -1 then
		return "CLOSED", C.Red
	end
	if type(wait) ~= "number" then
		return "--", C.Muted
	end
	return wait .. " min", UI.waitColor(wait)
end

local function renderWaits()
	note("Posted waits update live. One park minute is one real second, so a 20 min wait is about 20 seconds. Use an Express Pass [F] to skip the line!")
	local sortBy = panel:GetAttribute("SortWaits") == true
	local sortRow = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = nextOrder(), Parent = content }, { UI.list(6, true) })
	UI.button(if sortBy then "Sort: shortest wait" else "Sort: by land", C.Card, function()
		panel:SetAttribute("SortWaits", not sortBy)
		App.open("Waits")
	end, { Parent = sortRow, Size = UDim2.new(0, 170, 0, 28), TextSize = 13, TextColor3 = C.Cream })
	local rides = table.clone(Config.Rides)
	if sortBy then
		table.sort(rides, function(a, b)
			local fa, fb = rideState:FindFirstChild(a.id), rideState:FindFirstChild(b.id)
			local wa = if fa then fa:GetAttribute("Wait") else 999
			local wb = if fb then fb:GetAttribute("Wait") else 999
			wa = if type(wa) == "number" and wa >= 0 then wa else 999
			wb = if type(wb) == "number" and wb >= 0 then wb else 999
			return wa < wb
		end)
	end
	local lastLand = ""
	for _, ride in rides do
		local land = Config.landById(ride.land) :: Config.Land
		if not sortBy and ride.land ~= lastLand then
			lastLand = ride.land
			header(land.name, land.color)
		end
		local subtitle = string.format("%s  %s  |  %s", ride.category, UI.stars(ride.thrill), if sortBy then land.name else ride.kind)
		local _, right = rowCard(ride.name, subtitle, land.color)
		local waitLabel = UI.label("--", 20, C.Cream, F.Black, { Parent = right, LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Right })
		guideButton(ride.entrance, ride.name, right).LayoutOrder = 2
		local folder = rideState:FindFirstChild(ride.id)
		table.insert(live, function()
			local text, color = waitText(folder)
			waitLabel.Text = text
			waitLabel.TextColor3 = color
		end)
	end
end

local MAP_W = Config.Bounds.maxX - Config.Bounds.minX
local MAP_H = Config.Bounds.maxZ - Config.Bounds.minZ

local function mapPos(x: number, z: number): UDim2
	return UDim2.fromScale((x - Config.Bounds.minX) / MAP_W, (z - Config.Bounds.minZ) / MAP_H)
end

local function renderMap()
	note("Tap a ride, show or restaurant to get directions.")
	local holder = UI.make("Frame", {
		BackgroundColor3 = Color3.fromRGB(70, 130, 70),
		Size = UDim2.fromOffset(392, math.floor(392 * MAP_H / MAP_W)),
		LayoutOrder = nextOrder(),
		Parent = content,
		ClipsDescendants = true,
	}, { UI.corner(10) })
	-- lands
	for _, land in Config.Lands do
		for _, r in land.regions do
			UI.make("Frame", {
				BackgroundColor3 = land.color,
				BackgroundTransparency = 0.45,
				BorderSizePixel = 0,
				Position = mapPos(r[1], r[2]),
				Size = UDim2.fromScale((r[3] - r[1]) / MAP_W, (r[4] - r[2]) / MAP_H),
				Parent = holder,
			})
		end
		UI.make("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = mapPos(land.center.X, land.center.Z),
			Size = UDim2.new(0.3, 0, 0, 16),
			Text = string.upper(land.name),
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 0.15,
			FontFace = F.Black,
			ZIndex = 2,
			Parent = holder,
		}, { UI.stroke(Color3.new(0, 0, 0), 1.5, 0.4) })
	end
	-- main street, hub and lake
	UI.make("Frame", { BackgroundColor3 = Config.Colors.Paver, BorderSizePixel = 0, Position = mapPos(-26, -4), Size = UDim2.fromScale(52 / MAP_W, 230 / MAP_H), Parent = holder })
	UI.make("Frame", { BackgroundColor3 = Config.Colors.Paver, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = mapPos(0, -60), Size = UDim2.fromScale(124 / MAP_W, 124 / MAP_H), Parent = holder }, { UI.corner(999) })
	UI.make("Frame", { BackgroundColor3 = Color3.fromRGB(60, 130, 200), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = mapPos(235, 125), Size = UDim2.fromScale(100 / MAP_W, 100 / MAP_H), Parent = holder }, { UI.corner(999) })
	local function pin(pos: Vector3, color: Color3, name: string, size: number, round: boolean)
		local b = UI.make("TextButton", {
			Text = "",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = mapPos(pos.X, pos.Z),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = color,
			ZIndex = 3,
			Parent = holder,
		}, { UI.corner(if round then 999 else 3), UI.stroke(Color3.new(1, 1, 1), 1.5, 0) })
		b.Activated:Connect(function()
			Guide.set(pos, name)
			App.toast("Directions to " .. name .. " - follow the glowing path!", "info")
		end)
		UI.make("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(1, 2, 0, -2),
			Size = UDim2.fromOffset(120, 12),
			Text = name,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.new(1, 1, 1),
			FontFace = F.Bold,
			ZIndex = 4,
			Parent = b,
		}, { UI.stroke(Color3.new(0, 0, 0), 1, 0.3) })
	end
	for _, ride in Config.Rides do
		pin(ride.entrance, C.Orange, ride.name, 11, true)
	end
	for _, venue in Config.Venues do
		pin(venue.position, if venue.kind == "restaurant" then C.Red else C.Blue, venue.name, 8, false)
	end
	for _, show in Config.Shows do
		if show.id == "BigDreams" or show.id == "StuntSpectacular" then
			pin(show.viewing, Color3.fromRGB(190, 130, 255), show.venue, 9, true)
		end
	end
	local me = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
		Parent = holder,
	}, { UI.corner(999), UI.stroke(C.Navy, 3, 0) })
	local legend = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = nextOrder(), Parent = content }, { UI.list(12, true) })
	for _, l in { { "Rides", C.Orange }, { "Food", C.Red }, { "Shops", C.Blue }, { "Shows", Color3.fromRGB(190, 130, 255) }, { "You", Color3.new(1, 1, 1) } } do
		UI.label("● " .. (l[1] :: string), 12, l[2] :: Color3, F.Bold, { Parent = legend, Size = UDim2.new(0, 60, 0, 16), AutomaticSize = Enum.AutomaticSize.X })
	end
	table.insert(live, function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			me.Position = mapPos(root.Position.X, root.Position.Z)
		end
	end)
end

local function showStatus(show: Config.Show): (string, Color3)
	local folder = showState:FindFirstChild(show.id)
	if folder and folder:GetAttribute("Running") then
		return "NOW PLAYING!", C.Green
	end
	local best, bestTime = math.huge, 0
	for _, t in show.times do
		local s = Clock.secondsUntil(t)
		if s < best then
			best, bestTime = s, t
		end
	end
	return string.format("Next show %s  (in %d min)", Clock.format(bestTime), math.ceil(best)), C.Gold
end

local function renderShows()
	note("Watch a show from the audience area to earn " .. Config.Economy.ShowReward .. " " .. Config.Currency .. ".")
	for _, show in Config.Shows do
		local land = Config.landById(show.land) :: Config.Land
		local _, right = rowCard(show.name, show.venue .. "  |  " .. show.description, land.color)
		local status = UI.label("", 12, C.Gold, F.Black, { Parent = right, LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Right })
		guideButton(show.viewing, show.name, right).LayoutOrder = 2
		local times = {}
		for _, t in show.times do
			table.insert(times, Clock.format(t))
		end
		UI.label("Showtimes: " .. table.concat(times, ", "), 12, C.Muted, F.Medium, { Parent = content, LayoutOrder = nextOrder() })
		table.insert(live, function()
			local text, color = showStatus(show)
			status.Text = text
			status.TextColor3 = color
		end)
	end
end

local function itemLine(item: Items.Item): string
	local extra = ""
	if item.kind == "food" then
		extra = string.format("  |  +%d hunger", item.hunger or 0)
		if item.buff then
			extra ..= if item.buff.kind == "speed" then "  |  SPEED BOOST" else "  |  JUMP BOOST"
		end
	elseif owns(item.id) then
		extra = "  |  OWNED"
	end
	return string.format("%s  -  %s%d%s", item.name, Config.CurrencyShort, item.price, extra)
end

local function renderVenues(kind: string)
	note(if kind == "restaurant"
		then "Hungry guests walk slower. Eat at any restaurant to fill up - some treats give speed or jump boosts!"
		else "Souvenirs are saved to your Bag. Wear hats, shades and balloons, and carry toys around the park.")
	for _, venue in Config.Venues do
		if venue.kind == kind then
			local land = Config.landById(venue.land) :: Config.Land
			local _, right = rowCard(venue.name, land.name .. "  |  " .. venue.description, land.color)
			guideButton(venue.position + Config.facingVector(venue.facing) * (venue.size.Z / 2 + 6), venue.name, right)
			for _, id in venue.items do
				local item = Items.get(id)
				if item then
					UI.label("  " .. itemLine(item), 12, C.Cream, F.Medium, { Parent = content, LayoutOrder = nextOrder() })
				end
			end
		end
	end
end

local function renderPassport()
	local stamped = 0
	for _, ride in Config.Rides do
		if table.find(profile.Stamps, ride.id) then
			stamped += 1
		end
	end
	header(string.format("Park Passport  %d / %d", stamped, #Config.Rides))
	note(string.format("Ride every attraction to collect its stamp (+%d bonus). Finish a whole land for +%d!", Config.Economy.FirstRideBonus, Config.Economy.LandCompleteBonus))
	local grid = UI.make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	UI.make("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 64), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, ride in Config.Rides do
		local land = Config.landById(ride.land) :: Config.Land
		local has = table.find(profile.Stamps, ride.id) ~= nil
		local tile = UI.make("Frame", {
			BackgroundColor3 = if has then land.color else C.Card,
			BackgroundTransparency = if has then 0.1 else 0,
			LayoutOrder = i,
			Parent = grid,
		}, { UI.corner(10), UI.padding(8), UI.stroke(if has then C.Gold else C.Muted, 2, if has then 0 else 0.7) })
		UI.label((if has then "✔ " else "") .. ride.name, 13, if has then Color3.new(1, 1, 1) else C.Muted, F.Black, { Parent = tile })
		UI.label(land.name, 11, if has then C.Cream else C.Muted, F.Medium, { Parent = tile, Position = UDim2.new(0, 0, 1, -14) })
	end
	local stats = profile.Stats
	header("Your day so far")
	note(string.format("Rides taken: %d   |   Shows watched: %d   |   Meals eaten: %d", stats.Rides or 0, stats.Shows or 0, stats.Meals or 0))
end

local SLOT_NAMES = { hat = "Hats", face = "Shades", balloon = "Balloons" }

local function renderBag()
	header(string.format("%s %d   |   Express Passes: %d", Config.CurrencyShort, profile.Bucks, profile.Passes))
	note("Earn Benton Bucks by riding rides, watching shows and spending time in the park.")
	for _, slot in { "hat", "face", "balloon" } do
		header(SLOT_NAMES[slot], C.Cream)
		local any = false
		for _, id in profile.Owned do
			local item = Items.get(id)
			if item and Items.slot(item) == slot then
				any = true
				local equipped = profile.Equipped[slot] == id
				local _, right = rowCard(item.name, item.description, item.colors[1])
				UI.button(if equipped then "Take off" else "Wear", if equipped then C.Card else C.Orange, function()
					action({ type = "Equip", slot = slot, item = if equipped then "" else id })
				end, { Parent = right, Size = UDim2.new(0, 90, 0, 30), TextColor3 = if equipped then C.Cream else C.Navy })
			end
		end
		if not any then
			note("None yet - check the shops!")
		end
	end
	header("Toys & tools", C.Cream)
	local anyHeld = false
	for _, id in profile.Owned do
		local item = Items.get(id)
		if item and item.kind == "held" then
			anyHeld = true
			note("• " .. item.name .. " (in your backpack)")
		end
	end
	if not anyHeld then
		note("None yet.")
	end
end

local RENDER: { [string]: () -> () } = {
	Waits = renderWaits,
	Map = renderMap,
	Shows = renderShows,
	Dining = function()
		renderVenues("restaurant")
	end,
	Shops = function()
		renderVenues("shop")
	end,
	Passport = renderPassport,
	Bag = renderBag,
}

local TABS = {
	{ id = "Waits", icon = "⏱", label = "Wait Times" },
	{ id = "Map", icon = "🗺", label = "Park Map" },
	{ id = "Shows", icon = "🎭", label = "Shows" },
	{ id = "Dining", icon = "🍔", label = "Dining" },
	{ id = "Shops", icon = "🛍", label = "Shops" },
	{ id = "Passport", icon = "📘", label = "Passport" },
	{ id = "Bag", icon = "🎒", label = "My Bag" },
}

function App.open(tab: string?)
	if tab == nil then
		panel.Visible = false
		currentTab = nil
	else
		currentTab = tab
		panel.Visible = true
		for _, t in TABS do
			if t.id == tab then
				panelTitle.Text = t.icon .. "  " .. t.label
			end
		end
		clearContent()
		order = 0
		RENDER[tab]()
		for _, fn in live do
			fn()
		end
	end
	for id, b in dockButtons do
		b.BackgroundColor3 = if id == currentTab then C.Orange else C.Panel
	end
end

---------------------------------------------------------------------------
-- Shop / restaurant counter
---------------------------------------------------------------------------
local function preview(item: Items.Item, parent: Instance)
	local vp = UI.make("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(44, 58, 92),
		Size = UDim2.new(1, 0, 0, 92),
		Ambient = Color3.fromRGB(170, 170, 180),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -2, -1),
		LayoutOrder = 1,
		Parent = parent,
	}, { UI.corner(8) })
	local ok, model = pcall(Props.preview, item)
	if not ok then
		return
	end
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local center, size = model:GetBoundingBox()
	local dist = math.max(size.Magnitude, 1) * 1.5
	cam.CFrame = CFrame.lookAt(center.Position + Vector3.new(0.7, 0.55, -1).Unit * dist, center.Position)
end

local function closeVenue()
	if venueModal then
		venueModal:Destroy()
		venueModal = nil
	end
	openVenueId = nil
end

local function openVenue(venueId: string)
	closeVenue()
	local venue = Config.VenueById[venueId]
	if not venue then
		return
	end
	openVenueId = venueId
	local land = Config.landById(venue.land) :: Config.Land
	local modal = UI.make("Frame", {
		Name = "VenueModal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.92, 0, 0.78, 0),
		BackgroundColor3 = C.Navy,
		ZIndex = 20,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(land.color, 3, 0), UI.padding(14) })
	UI.make("UISizeConstraint", { MaxSize = Vector2.new(760, 520), Parent = modal })
	venueModal = modal
	UI.label(venue.name, 24, C.Cream, F.Black, { Parent = modal, Size = UDim2.new(1, -50, 0, 28), AutomaticSize = Enum.AutomaticSize.None })
	UI.label(venue.description .. "   |   You have " .. Config.CurrencyShort .. profile.Bucks, 13, C.Muted, F.Medium, {
		Parent = modal,
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, -50, 0, 18),
		AutomaticSize = Enum.AutomaticSize.None,
	})
	UI.button("X", C.Red, closeVenue, { Parent = modal, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(36, 36), TextColor3 = Color3.new(1, 1, 1) })
	local scroller = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 56),
		Size = UDim2.new(1, 0, 1, -56),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		BorderSizePixel = 0,
		Parent = modal,
	})
	UI.make("UIGridLayout", { CellSize = UDim2.fromOffset(170, 232), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroller })
	for i, id in venue.items do
		local item = Items.get(id)
		if item then
			local card = UI.make("Frame", { BackgroundColor3 = C.Card, LayoutOrder = i, Parent = scroller }, { UI.corner(12), UI.padding(8), UI.list(4) })
			preview(item, card)
			UI.label(item.name, 14, C.Cream, F.Black, { Parent = card, LayoutOrder = 2 })
			UI.label(item.description, 11, C.Muted, F.Medium, { Parent = card, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 40), AutomaticSize = Enum.AutomaticSize.None })
			local owned = (Items.slot(item) ~= nil or item.kind == "held") and owns(item.id)
			local text = if owned then "Owned" else string.format("Buy  %s%d", Config.CurrencyShort, item.price)
			UI.button(text, if owned then C.Card else C.Orange, function()
				if owned then
					App.open("Bag")
					closeVenue()
					return
				end
				action({ type = "Buy", venue = venue.id, item = item.id })
			end, { Parent = card, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 30), TextColor3 = if owned then C.Cream else C.Navy })
		end
	end
end

---------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------
local function buildTopBar(): (TextLabel, TextLabel, TextLabel, Frame, TextLabel)
	local bar = UI.make("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(0, 0, 0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { UI.corner(20), UI.stroke(C.Orange, 1.5, 0.4), UI.padding(14, 0), UI.list(14, true) })
	UI.label("⚙ BENTON DIESEL WORLD", 14, C.Orange, F.Black, { Parent = bar, LayoutOrder = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false })
	local clock = UI.label("9:00 AM", 15, C.Cream, F.Bold, { Parent = bar, LayoutOrder = 2, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false })
	local bucks = UI.label(Config.CurrencyShort .. "0", 16, C.Gold, F.Black, { Parent = bar, LayoutOrder = 3, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false })
	local passes = UI.label("🎫 0", 15, C.Cream, F.Bold, { Parent = bar, LayoutOrder = 4, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false })
	local hungerHolder = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 110, 1, 0), LayoutOrder = 5, Parent = bar })
	UI.label("🍔", 15, C.Cream, F.Bold, { Parent = hungerHolder, Size = UDim2.new(0, 20, 1, 0), AutomaticSize = Enum.AutomaticSize.None })
	local track = UI.make("Frame", { BackgroundColor3 = Color3.fromRGB(50, 56, 70), Position = UDim2.new(0, 24, 0.5, -5), Size = UDim2.new(1, -24, 0, 10), Parent = hungerHolder }, { UI.corner(5) })
	local fill = UI.make("Frame", { BackgroundColor3 = C.Green, Size = UDim2.fromScale(1, 1), Parent = track }, { UI.corner(5) })
	local boost = UI.label("", 15, C.Yellow, F.Black, { Parent = bar, LayoutOrder = 6, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false })
	return clock, bucks, passes, fill, boost
end

local function buildDock()
	local dock = UI.make("Frame", {
		Name = "Dock",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.42, 0),
		Size = UDim2.new(0, 64, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	}, { UI.list(6) })
	for i, t in TABS do
		local b = UI.make("TextButton", {
			Name = t.id,
			Text = "",
			LayoutOrder = i,
			Size = UDim2.fromOffset(64, 54),
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = 0.05,
			AutoButtonColor = true,
			Parent = dock,
		}, { UI.corner(12), UI.stroke(C.Orange, 1, 0.6) })
		UI.make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 4), Text = t.icon, TextSize = 24, FontFace = F.Bold, TextColor3 = Color3.new(1, 1, 1), Parent = b })
		UI.make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -17), Text = t.label, TextSize = 10, FontFace = F.Bold, TextColor3 = C.Cream, Parent = b })
		b.Activated:Connect(function()
			if currentTab == t.id then
				App.open(nil)
			else
				App.open(t.id)
			end
		end)
		dockButtons[t.id] = b
	end
end

local function buildPanel()
	panel = UI.make("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.54, 0),
		Size = UDim2.new(0, 420, 0.78, 0),
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(C.Orange, 1.5, 0.5) })
	panelTitle = UI.label("", 20, C.Cream, F.Black, { Parent = panel, Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -70, 0, 26), AutomaticSize = Enum.AutomaticSize.None })
	UI.button("X", C.Red, function()
		App.open(nil)
	end, { Parent = panel, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(32, 32), TextColor3 = Color3.new(1, 1, 1) })
	content = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 46),
		Size = UDim2.new(1, 0, 1, -50),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = panel,
	}, { UI.list(8), UI.padding(12, 4) })
end

local function buildQueuePill(): (Frame, TextLabel, TextButton)
	local pill = UI.make("Frame", {
		Name = "QueuePill",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(0, 0, 0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = gui,
	}, { UI.corner(22), UI.stroke(C.Gold, 2, 0.2), UI.padding(16, 0), UI.list(12, true) })
	local label = UI.label("", 15, C.Cream, F.Bold, { Parent = pill, LayoutOrder = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false })
	local leave = UI.button("Leave line", C.Red, function()
		action({ type = "LeaveQueue" })
	end, { Parent = pill, LayoutOrder = 2, Size = UDim2.fromOffset(100, 30), TextColor3 = Color3.new(1, 1, 1), TextSize = 13 })
	return pill, label, leave
end

local function buildBanner()
	bannerFrame = UI.make("Frame", {
		Name = "LandBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0, 460, 0, 74),
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = gui,
	}, { UI.corner(14) })
	UI.label("WELCOME TO", 12, C.Muted, F.Bold, { Name = "Small", Parent = bannerFrame, Position = UDim2.new(0, 0, 0, 6), TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.None })
	UI.label("", 26, C.Cream, F.Black, { Name = "Title", Parent = bannerFrame, Position = UDim2.new(0, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.None })
	UI.label("", 13, C.Gold, F.Medium, { Name = "Subtitle", Parent = bannerFrame, Position = UDim2.new(0, 0, 0, 50), TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.None })
	UI.make("Frame", { Name = "Bar", BackgroundColor3 = C.Orange, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0.6, 0, 0, 4), Parent = bannerFrame })
end

function App.start()
	rideState = Net.state():WaitForChild("Rides") :: Folder
	showState = Net.state():WaitForChild("Shows") :: Folder
	gui = UI.make("ScreenGui", {
		Name = "BentonApp",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale = UI.make("UIScale", { Parent = gui })
	local function rescale()
		local cam = workspace.CurrentCamera
		if cam then
			local v = cam.ViewportSize
			scale.Scale = math.clamp(math.min(v.X / 1280, v.Y / 760), 0.55, 1.1)
		end
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	local clock, bucks, passes, hungerFill, boostLabel = buildTopBar()
	buildDock()
	buildPanel()
	local pill, pillLabel, leaveButton = buildQueuePill()
	buildBanner()
	toastHolder = UI.make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -80),
		Size = UDim2.new(0, 330, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	}, { UI.list(6) })
	local toastList = toastHolder:FindFirstChildOfClass("UIListLayout")
	if toastList then
		toastList.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end

	local function refreshStats()
		local b = player:GetAttribute("Bucks")
		bucks.Text = Config.CurrencyShort .. tostring(if type(b) == "number" then b else profile.Bucks)
		local p = player:GetAttribute("Passes")
		passes.Text = "🎫 " .. tostring(if type(p) == "number" then p else 0)
		local h = player:GetAttribute("Hunger")
		local frac = math.clamp((if type(h) == "number" then h else Config.Hunger.Max) / Config.Hunger.Max, 0, 1)
		hungerFill.Size = UDim2.fromScale(frac, 1)
		hungerFill.BackgroundColor3 = if frac > 0.5 then C.Green elseif frac > 0.25 then C.Yellow else C.Red
		local boost = player:GetAttribute("Boost")
		boostLabel.Text = if boost == "speed" then "⚡ SPEED" elseif boost == "jump" then "🦘 JUMP" else ""
	end
	for _, attr in { "Bucks", "Passes", "Hunger", "Boost" } do
		player:GetAttributeChangedSignal(attr):Connect(refreshStats)
	end
	refreshStats()

	Net.remote("Profile").OnClientEvent:Connect(function(data)
		if type(data) == "table" then
			profile = data :: any
			profile.Owned = profile.Owned or {}
			profile.Equipped = profile.Equipped or {}
			profile.Stamps = profile.Stamps or {}
			profile.Stats = profile.Stats or {}
			if currentTab == "Bag" or currentTab == "Passport" or currentTab == "Shops" then
				App.open(currentTab)
			end
			if openVenueId then
				openVenue(openVenueId)
			end
		end
	end)
	Net.remote("Notify").OnClientEvent:Connect(function(data)
		if type(data) == "table" and type(data.text) == "string" then
			App.toast(data.text, data.kind, data.amount)
		end
	end)
	Net.remote("OpenVenue").OnClientEvent:Connect(function(id)
		if type(id) == "string" then
			openVenue(id)
		end
	end)
	Guide.onArrive(function(name)
		App.toast("You've arrived at " .. name .. "!", "info")
	end)

	-- live updates: clock, queue pill, land banner, open tab
	local lastLand: string? = nil
	local etaDeadline = 0
	local function refreshQueue()
		local riding = player:GetAttribute("Riding")
		local queueRide = player:GetAttribute("QueueRide")
		if type(riding) == "string" and riding ~= "" then
			local ride = Config.RideById[riding]
			pill.Visible = true
			leaveButton.Visible = false
			pillLabel.Text = "🎢  Enjoy " .. (if ride then ride.name else "the ride") .. "!  Keep your hands inside."
		elseif type(queueRide) == "string" and queueRide ~= "" then
			local ride = Config.RideById[queueRide]
			local pos = player:GetAttribute("QueuePos")
			local remaining = math.max(0, math.ceil(etaDeadline - os.clock()))
			pill.Visible = true
			leaveButton.Visible = true
			pillLabel.Text = string.format("🎟  In line for %s  |  #%s in line  |  about %d min", if ride then ride.name else queueRide, tostring(pos or "?"), math.max(1, remaining))
		else
			pill.Visible = false
		end
	end
	player:GetAttributeChangedSignal("QueueEta"):Connect(function()
		local eta = player:GetAttribute("QueueEta")
		etaDeadline = os.clock() + (if type(eta) == "number" then eta else 0)
		refreshQueue()
	end)
	for _, attr in { "Riding", "QueueRide", "QueuePos" } do
		player:GetAttributeChangedSignal(attr):Connect(refreshQueue)
	end

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then
			return
		end
		acc = 0
		local minute = Clock.minutes()
		clock.Text = "🕒 " .. Clock.format(minute)
		refreshQueue()
		for _, fn in live do
			fn()
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local land = Config.landAt(root.Position)
			local id = if land then land.id else nil
			if id ~= lastLand then
				lastLand = id
				if land then
					banner(land.name, land.tagline, land.color)
				end
			end
		end
	end)

	task.delay(2, function()
		App.toast("Welcome to Benton Diesel World! Open the Wait Times tab to plan your day.", "info")
	end)
end

return App
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Guide</string>
            <string name="Source"><![CDATA[-- "Guide me" navigation: a glowing beam from the player to a destination
-- plus a floating marker with the distance.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Guide = {}

local player = Players.LocalPlayer
local target: Vector3? = nil
local targetName = ""
local marker: Part? = nil
local beam: Beam? = nil
local fromAttachment: Attachment? = nil
local distanceLabel: TextLabel? = nil
local onArrive: ((string) -> ())? = nil

function Guide.onArrive(fn: (string) -> ())
	onArrive = fn
end

function Guide.clear()
	target = nil
	if marker then
		marker:Destroy()
		marker = nil
	end
	if fromAttachment then
		fromAttachment:Destroy()
		fromAttachment = nil
	end
	beam = nil
	distanceLabel = nil
end

local function attachToCharacter()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not marker then
		return
	end
	if fromAttachment then
		fromAttachment:Destroy()
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "GuideFrom"
	a0.Position = Vector3.new(0, -1.5, 0)
	a0.Parent = root
	fromAttachment = a0
	local m = marker :: Part
	local b = m:FindFirstChildOfClass("Beam")
	if b then
		b.Attachment0 = a0
	end
end

function Guide.set(position: Vector3, name: string)
	Guide.clear()
	target = position
	targetName = name
	local m = Instance.new("Part")
	m.Name = "BentonGuideMarker"
	m.Anchored = true
	m.CanCollide = false
	m.CanQuery = false
	m.CanTouch = false
	m.Transparency = 1
	m.Size = Vector3.new(1, 1, 1)
	m.CFrame = CFrame.new(position + Vector3.new(0, 1, 0))
	m.Parent = workspace
	marker = m
	local a1 = Instance.new("Attachment")
	a1.Parent = m
	local b = Instance.new("Beam")
	b.Attachment1 = a1
	b.Width0 = 1.2
	b.Width1 = 1.2
	b.FaceCamera = true
	b.LightEmission = 1
	b.LightInfluence = 0
	b.Color = ColorSequence.new(Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 230, 120))
	b.Transparency = NumberSequence.new(0.2, 0.5)
	b.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	b.TextureMode = Enum.TextureMode.Wrap
	b.TextureLength = 4
	b.TextureSpeed = 2
	b.Segments = 20
	b.CurveSize0 = 0
	b.CurveSize1 = 0
	b.Parent = m
	beam = b
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 56)
	gui.StudsOffset = Vector3.new(0, 8, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = m
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 120)
	label.FontFace = Font.fromEnum(Enum.Font.GothamBlack)
	label.Text = name
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	distanceLabel = label
	attachToCharacter()
end

function Guide.current(): (Vector3?, string)
	return target, targetName
end

function Guide.start()
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if target then
			attachToCharacter()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if not target then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end
		local d = ((root.Position - target) * Vector3.new(1, 0, 1)).Magnitude
		if distanceLabel then
			distanceLabel.Text = string.format("%s\n%d studs", targetName, math.floor(d))
		end
		if d < 16 then
			local name = targetName
			Guide.clear()
			if onArrive then
				onArrive(name)
			end
		end
	end)
	local _ = beam
end

return Guide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">QueueView</string>
            <string name="Source"><![CDATA[-- Queue lines on the client: draws the simulated guests standing in each
-- ride's queue maze from the line order the server publishes, and walks the
-- local player forward with the line while they aren't steering.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Props = require(Shared.Props)
local QueueLine = require(Shared.QueueLine)

local QueueView = {}

local FLOOR = 0.55 -- top of the queue floor
local WALK = 7 -- how fast guests shuffle forward (studs/s)
local SHOW_WITHIN = 360 -- draw lines this close to the camera
local HIDE_BEYOND = 420

type Token = { key: string, seed: number, player: boolean }
type Visual = { model: Model, s: number, lift: number, moving: boolean }
type LineState = {
	id: string,
	line: QueueLine.Line,
	folder: Instance,
	tokens: { Token },
	visuals: { [string]: Visual },
	shown: boolean,
	snap: boolean,
}

local lines: { LineState } = {}
local localPlayer = Players.LocalPlayer
local container: Folder

local function parse(value: any): { Token }
	local out: { Token } = {}
	if type(value) ~= "string" or value == "" then
		return out
	end
	for tok in string.gmatch(value, "[^,]+") do
		if string.sub(tok, 1, 1) == "p" then
			table.insert(out, { key = tok, seed = 0, player = true })
		else
			local seed = tonumber(string.match(tok, ":(%d+)$")) or 1
			table.insert(out, { key = tok, seed = seed, player = false })
		end
	end
	return out
end

local function place(v: Visual, line: QueueLine.Line, bob: number)
	local pos, facing = QueueLine.pointAt(line, v.s)
	local at = pos + Vector3.new(0, FLOOR + v.lift + bob, 0)
	v.model:PivotTo(CFrame.lookAt(at, at + facing))
end

local function makeGuest(seed: number): (Model, number)
	local model = Props.guest(seed, "stand")
	model.Name = "QueueGuest"
	model.Parent = container
	-- how far the pivot sits above the guest's feet
	local cf, size = model:GetBoundingBox()
	local lift = model:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
	return model, lift
end

local function clear(ls: LineState)
	for key, v in ls.visuals do
		v.model:Destroy()
		ls.visuals[key] = nil
	end
end

local function updateLine(ls: LineState, dt: number, now: number)
	local seen: { [string]: boolean } = {}
	for index, tok in ls.tokens do
		if tok.player then
			continue
		end
		seen[tok.key] = true
		local target = QueueLine.slot(index)
		local v = ls.visuals[tok.key]
		if not v then
			local model, lift = makeGuest(tok.seed)
			-- newcomers walk in from outside the entrance sign
			local start = if ls.snap then target else math.max(target, math.min(ls.line.length, ls.line.signAt + 4))
			v = { model = model, s = start, lift = lift, moving = true }
			ls.visuals[tok.key] = v
		end
		local visual = v :: Visual
		local gap = target - visual.s
		if math.abs(gap) > 0.05 then
			visual.s += math.clamp(gap, -WALK * dt, WALK * dt)
			visual.moving = true
			place(visual, ls.line, math.abs(math.sin(now * 9 + tok.seed)) * 0.35)
		elseif visual.moving then
			visual.moving = false
			place(visual, ls.line, 0)
		end
	end
	for key, v in ls.visuals do
		if not seen[key] then
			v.model:Destroy()
			ls.visuals[key] = nil
		end
	end
	ls.snap = false
end

-- Next point for the local player to walk to, or nil when in their spot.
local function lineTarget(root: BasePart): Vector3?
	local rideId = localPlayer:GetAttribute("QueueRide")
	local pos = localPlayer:GetAttribute("QueuePos")
	if type(rideId) ~= "string" or rideId == "" or type(pos) ~= "number" or pos < 1 then
		return nil
	end
	local riding = localPlayer:GetAttribute("Riding")
	if type(riding) == "string" and riding ~= "" then
		return nil
	end
	local line = QueueLine.get(rideId)
	if not line then
		return nil
	end
	local slot = QueueLine.slot(pos)
	local along, off = QueueLine.project(line, root.Position)
	if off > 1.5 then
		return (QueueLine.pointAt(line, along))
	end
	if math.abs(along - slot) < 0.6 then
		return nil
	end
	-- walk to the next bend between here and our spot
	local cum = line.cum
	if slot < along then
		for i = #cum, 1, -1 do
			if cum[i] < along - 0.05 and cum[i] > slot then
				return line.points[i]
			end
		end
	else
		for i = 1, #cum do
			if cum[i] > along + 0.05 and cum[i] < slot then
				return line.points[i]
			end
		end
	end
	return (QueueLine.pointAt(line, slot))
end

local shuffleTimer = 0
local function shuffle(dt: number)
	shuffleTimer += dt
	if shuffleTimer < 0.2 then
		return
	end
	shuffleTimer = 0
	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end
	-- the player is steering themselves
	if hum.MoveDirection.Magnitude > 0.1 then
		return
	end
	local target = lineTarget(root)
	if target then
		hum:MoveTo(Vector3.new(target.X, root.Position.Y, target.Z))
	end
end

function QueueView.start()
	container = Instance.new("Folder")
	container.Name = "BentonQueueGuests"
	container.Parent = workspace
	local rideState = Net.state():WaitForChild("Rides")
	for _, ride in Config.Rides do
		local line = QueueLine.get(ride.id)
		local folder = rideState:WaitForChild(ride.id, 10)
		if line and folder then
			local ls: LineState = {
				id = ride.id,
				line = line,
				folder = folder,
				tokens = parse(folder:GetAttribute("Line")),
				visuals = {},
				shown = false,
				snap = true,
			}
			folder:GetAttributeChangedSignal("Line"):Connect(function()
				ls.tokens = parse(folder:GetAttribute("Line"))
			end)
			table.insert(lines, ls)
		end
	end
	RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		local now = os.clock()
		for _, ls in lines do
			local d = (Vector3.new(camPos.X, 0, camPos.Z) - ls.line.gate).Magnitude
			if ls.shown and d > HIDE_BEYOND then
				ls.shown = false
				clear(ls)
			elseif not ls.shown and d < SHOW_WITHIN then
				ls.shown = true
				ls.snap = true
			end
			if ls.shown then
				updateLine(ls, dt, now)
			end
		end
		shuffle(dt)
	end)
end

return QueueView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">RideAnimator</string>
            <string name="Source"><![CDATA[-- Animates every ride locally, in sync with server time, and keeps riders
-- (players and simulated guests) in their seats. Also plays the special
-- effects on the Studio Backlot Tram Tour.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Net = require(Shared.Net)
local Props = require(Shared.Props)
local RideMotion = require(Shared.RideMotion)

local RideAnimator = {}

type RiderData = { c: number, s: number, u: number, n: number }

type Animated = {
	ride: Config.Ride,
	motion: RideMotion.Motion,
	folder: Instance,
	cars: { Model },
	extras: { [string]: Model },
	riders: { RiderData },
	guests: { Model },
	cycleId: number,
	atRest: boolean,
	firedCues: { [number]: boolean },
	frame: number,
}

local animated: { Animated } = {}
local localPlayer = Players.LocalPlayer

local function decodeRiders(s: any): { RiderData }
	if type(s) ~= "string" or s == "" then
		return {}
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(s)
	end)
	if ok and type(data) == "table" then
		return data :: any
	end
	return {}
end

local function clearGuests(a: Animated)
	for _, g in a.guests do
		g:Destroy()
	end
	a.guests = {}
end

-- Build guest figures for simulated riders, attached to their cars.
local function refreshRiders(a: Animated)
	clearGuests(a)
	a.riders = decodeRiders(a.folder:GetAttribute("Riders"))
	local cycle = a.folder:GetAttribute("CycleId")
	a.cycleId = if type(cycle) == "number" then cycle else 0
	a.firedCues = {}
	local thrill = a.ride.thrill >= 4
	for _, r in a.riders do
		if r.u == 0 and r.c > 0 then
			local car = a.cars[r.c]
			local seat = a.motion.seats[r.c] and a.motion.seats[r.c][r.s]
			if car and seat then
				local pose = if thrill and r.n % 2 == 0 then "cheer" else "sit"
				local g = Props.guest(r.n, pose)
				g:PivotTo(car:GetPivot() * seat)
				g.Parent = car
				table.insert(a.guests, g)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Tram tour special effects
---------------------------------------------------------------------------
local function effect(kind: string, at: Vector3)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(4, 1, 4)
	holder.CFrame = CFrame.new(at)
	holder.Parent = workspace
	if kind == "fire" then
		for i = -1, 1 do
			local p = holder:Clone() :: Part
			p.CFrame = CFrame.new(at + Vector3.new(0, 0, i * 6))
			p.Parent = holder
			local fire = Instance.new("Fire")
			fire.Size = 12
			fire.Heat = 20
			fire.Parent = p
		end
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 140, 40)
		light.Range = 30
		light.Brightness = 3
		light.Parent = holder
	elseif kind == "flood" then
		local water = Instance.new("Part")
		water.Anchored = true
		water.CanCollide = false
		water.Material = Enum.Material.Glass
		water.Color = Color3.fromRGB(80, 150, 220)
		water.Transparency = 0.3
		water.Size = Vector3.new(4, 1, 30)
		water.CFrame = CFrame.new(at + Vector3.new(0, 16, 0))
		water.Parent = holder
		local mist = Instance.new("ParticleEmitter")
		mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
		mist.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
		mist.Size = NumberSequence.new(4, 10)
		mist.Transparency = NumberSequence.new(0.4, 1)
		mist.Rate = 40
		mist.Speed = NumberRange.new(6, 12)
		mist.Lifetime = NumberRange.new(1, 2)
		mist.Parent = water
		task.spawn(function()
			for i = 1, 30 do
				water.Size = Vector3.new(4 + i * 0.5, 1 + i, 30)
				water.CFrame = CFrame.new(at + Vector3.new(0, 16 - i * 0.5, 0))
				task.wait(0.05)
			end
		end)
	elseif kind == "explosion" then
		local boom = Instance.new("Explosion")
		boom.Position = at + Vector3.new(0, 6, 0)
		boom.BlastPressure = 0
		boom.BlastRadius = 0
		boom.DestroyJointRadiusPercent = 0
		boom.ExplosionType = Enum.ExplosionType.NoCraters
		boom.Parent = workspace
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 180, 80)
		light.Range = 40
		light.Brightness = 5
		light.Parent = holder
	else
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120))
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new(0.6, 0)
		sparks.Speed = NumberRange.new(20, 30)
		sparks.SpreadAngle = Vector2.new(60, 60)
		sparks.Lifetime = NumberRange.new(0.6, 1)
		sparks.Acceleration = Vector3.new(0, -60, 0)
		sparks.Rate = 200
		sparks.Parent = holder
	end
	Debris:AddItem(holder, 4)
end

---------------------------------------------------------------------------
-- Per-frame update
---------------------------------------------------------------------------
local function placeRiders(a: Animated, cars: { CFrame })
	for _, r in a.riders do
		if r.u ~= 0 and r.c > 0 then
			local player = Players:GetPlayerByUserId(r.u)
			local character = player and player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local seat = a.motion.seats[r.c] and a.motion.seats[r.c][r.s]
			if root and root.Anchored and seat and cars[r.c] then
				root.CFrame = cars[r.c] * seat
			end
		end
	end
end

local function update()
	local now = Clock.now()
	local camera = workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	for _, a in animated do
		a.frame += 1
		local start = a.folder:GetAttribute("CycleStart")
		local t = 0
		if type(start) == "number" and start > 0 and now >= start and now <= start + a.motion.duration then
			t = now - start
		end
		local hasRiders = #a.riders > 0
		if t == 0 and a.atRest and not hasRiders then
			continue
		end
		-- far-away rides update at a lower rate (but never ones you ride)
		local far = (a.ride.origin - camPos).Magnitude > 500
		local mine = localPlayer:GetAttribute("Riding") == a.ride.id
		if far and not mine and a.frame % 3 ~= 0 then
			continue
		end
		local cars, extras = a.motion.pose(t)
		for i, cf in cars do
			local car = a.cars[i]
			if car then
				car:PivotTo(cf)
			end
		end
		for name, cf in extras do
			local m = a.extras[name]
			if m then
				m:PivotTo(cf)
			end
		end
		placeRiders(a, cars)
		a.atRest = t == 0
		-- tram tour effects
		local cues = a.ride.cues
		if cues and t > 0 then
			for i, cue in cues do
				local at = (cue[1] :: number) * a.motion.duration
				if t >= at and t < at + 1 and not a.firedCues[i] then
					a.firedCues[i] = true
					local side = cue[3] :: Vector3
					effect(cue[2] :: string, (cars[1] * CFrame.new(side)).Position)
				end
			end
		end
	end
end

-- Keep the local player from jumping out of a moving ride.
local function watchRiding()
	local wasRiding = false
	local function apply()
		local character = localPlayer.Character
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		local riding = localPlayer:GetAttribute("Riding")
		local onRide = type(riding) == "string" and riding ~= ""
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, not onRide)
		if onRide then
			hum.Sit = true
		elseif wasRiding then
			-- stand up when the ride lets us off (benches are unaffected)
			hum.Sit = false
		end
		wasRiding = onRide
	end
	localPlayer:GetAttributeChangedSignal("Riding"):Connect(apply)
	localPlayer.CharacterAdded:Connect(function()
		task.wait(0.5)
		apply()
	end)
end

-- Only show the Express Pass prompt to guests who have passes.
local function watchPasses()
	local function apply()
		local passes = localPlayer:GetAttribute("Passes")
		local has = type(passes) == "number" and passes > 0
		for _, a in animated do
			local carsFolder = a.cars[1] and a.cars[1].Parent
			local model = carsFolder and carsFolder.Parent
			local queue = model and model:FindFirstChild("Queue")
			local point = queue and queue:FindFirstChild("QueuePoint")
			local prompt = point and point:FindFirstChild("ExpressPrompt") :: ProximityPrompt?
			if prompt then
				prompt.Enabled = has
				prompt.ActionText = string.format("Use Express Pass (%d left)", if type(passes) == "number" then passes else 0)
			end
		end
	end
	localPlayer:GetAttributeChangedSignal("Passes"):Connect(apply)
	apply()
end

function RideAnimator.start(root: Instance)
	local rides = root:WaitForChild("Rides")
	local stateRides = Net.state():WaitForChild("Rides")
	for _, ride in Config.Rides do
		local model = rides:WaitForChild(ride.id, 30)
		local folder = stateRides:WaitForChild(ride.id, 30)
		if model and folder then
			local motion = RideMotion.get(ride.id)
			local carsFolder = model:WaitForChild("Cars")
			local cars = {}
			for i = 1, motion.carCount do
				cars[i] = carsFolder:WaitForChild("Car" .. i) :: Model
			end
			local extras = {}
			local moving = model:WaitForChild("Moving")
			for _, name in motion.extras do
				extras[name] = moving:WaitForChild(name) :: Model
			end
			local a: Animated = {
				ride = ride,
				motion = motion,
				folder = folder,
				cars = cars,
				extras = extras,
				riders = {},
				guests = {},
				cycleId = 0,
				atRest = false,
				firedCues = {},
				frame = 0,
			}
			table.insert(animated, a)
			refreshRiders(a)
			folder:GetAttributeChangedSignal("Riders"):Connect(function()
				refreshRiders(a)
			end)
		end
	end
	watchRiding()
	watchPasses()
	RunService:BindToRenderStep("BentonRides", Enum.RenderPriority.Camera.Value - 1, update)
end

return RideAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">RideStaff</string>
            <string name="Source"><![CDATA[-- Ride crews and park staff on the client. While a train boards, the
-- attendants walk the loading platform car by car and push every lap bar
-- or harness down (riders pull most of their own first), give the operator
-- a thumbs up, and wave the train off; restraints lift again at unload.
-- Staff at shops, carts and the gate say hello as you come by, and
-- sweepers work the walkways. Speech shows as bubbles over their heads.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Net = require(Shared.Net)
local Props = require(Shared.Props)
local RideMotion = require(Shared.RideMotion)
local Staff = require(Shared.Staff)

local RideStaff = {}

local localPlayer = Players.LocalPlayer
local HIDDEN = CFrame.new(0, -500, 0)
local STAND = Props.STAND_HEIGHT

-- hinge (seat space) and opening angle of each restraint type
type Hinge = { at: CFrame, open: number }
local HINGE: { [string]: Hinge } = {
	lapbar = { at = CFrame.new(0, -1.9, -1.5), open = math.rad(-60) },
	harness = { at = CFrame.new(0, 1.6, 0.5), open = math.rad(100) },
}

type Bar = { part: BasePart, car: number, seat: number, closedRel: CFrame, hinge: CFrame, open: number, angle: number, target: number }
type Task = { kind: string, to: Vector3?, yaw: number?, stop: number?, dur: number?, time: number, done: boolean, speed: number? }
type Person = { models: { [string]: Model }, shown: string, pos: Vector3, yaw: number, homePos: Vector3, homeYaw: number, route: { number }, tasks: { Task }, bob: number }
type CrewState = {
	ride: Config.Ride,
	crew: Staff.Crew,
	folder: Instance,
	cars: { Model },
	seats: { { CFrame } },
	bars: { Bar },
	attendants: { Person },
	operator: Model?,
	cycle: number,
	status: string,
	said: { [string]: boolean },
	pulls: { { car: number, seat: number, at: number, done: boolean } },
	runSince: number,
	chatter: number,
}

local crews: { CrewState } = {}
local holder: Folder

local function pick(list: { string }?): string
	if not list or #list == 0 then
		return ""
	end
	return list[math.random(1, #list)]
end

local function yawCFrame(pos: Vector3, yaw: number): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

---------------------------------------------------------------------------
-- Speech bubbles
---------------------------------------------------------------------------
local function say(model: Model?, text: string)
	if not model or text == "" then
		return
	end
	local root = model.PrimaryPart
	if not root then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - root.Position).Magnitude > 80 then
		return
	end
	local old = root:FindFirstChild("Speech")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Speech"
	gui.Size = UDim2.fromOffset(240, 44)
	gui.StudsOffset = Vector3.new(0, 3.6, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = root
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	label.BackgroundTransparency = 0.05
	label.TextColor3 = Color3.fromRGB(27, 34, 51)
	label.FontFace = Font.fromEnum(Enum.Font.GothamBold)
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.4, 0)
	corner.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = label
	task.delay(2.8, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- Attendants
---------------------------------------------------------------------------
local POSES = { "stand", "check", "thumbs", "wave" }

local function newPerson(seed: number, land: string, at: CFrame): Person
	local models = {}
	for _, pose in POSES do
		local m = Staff.figure(seed, land, pose)
		m.Name = "Attendant"
		m:PivotTo(HIDDEN)
		m.Parent = holder
		models[pose] = m
	end
	return {
		models = models,
		shown = "",
		pos = at.Position,
		yaw = yawOf(at),
		homePos = at.Position,
		homeYaw = yawOf(at),
		route = {},
		tasks = {},
		bob = 0,
	}
end

local function show(p: Person, pose: string)
	if p.shown ~= pose then
		local old = p.models[p.shown]
		if old then
			old:PivotTo(HIDDEN)
		end
		p.shown = pose
	end
	local lift = math.abs(math.sin(p.bob)) * 0.25
	p.models[pose]:PivotTo(yawCFrame(p.pos + Vector3.new(0, STAND + lift, 0), p.yaw))
end

local function turn(from: number, to: number, k: number): number
	local d = math.atan2(math.sin(to - from), math.cos(to - from))
	return from + d * math.min(1, k)
end

---------------------------------------------------------------------------
-- Restraints
---------------------------------------------------------------------------
local function collectBars(c: CrewState)
	local hinge = HINGE[c.crew.restraint]
	if not hinge then
		return
	end
	for ci, car in c.cars do
		local seats = c.seats[ci] or {}
		local n = 0
		for _, d in car:GetDescendants() do
			if d.Name == "Restraint" and d:IsA("BasePart") then
				local part = d :: BasePart
				n += 1
				local seat = seats[n]
				if seat then
					local pivot = car:GetPivot()
					table.insert(c.bars, {
						part = part,
						car = ci,
						seat = n,
						closedRel = pivot:Inverse() * part.CFrame,
						hinge = seat * hinge.at,
						open = hinge.open,
						angle = 0,
						target = hinge.open,
					})
				end
			end
		end
	end
end

local function poseBar(c: CrewState, b: Bar)
	local car = c.cars[b.car]
	-- rotate the closed position about the hinge (all in car space)
	local rel = b.hinge * CFrame.Angles(b.angle, 0, 0) * b.hinge:Inverse() * b.closedRel
	b.part.CFrame = car:GetPivot() * rel
end

local function setBar(c: CrewState, car: number, seat: number, closed: boolean): boolean
	for _, b in c.bars do
		if b.car == car and b.seat == seat then
			local target = if closed then 0 else b.open
			if b.target == target then
				return false
			end
			b.target = target
			return true
		end
	end
	return false
end

local function setAll(c: CrewState, closed: boolean)
	for _, b in c.bars do
		b.target = if closed then 0 else b.open
	end
end

---------------------------------------------------------------------------
-- Boarding
---------------------------------------------------------------------------
type Rider = { c: number, s: number, u: number, n: number }

local function riders(c: CrewState): { Rider }
	local raw = c.folder:GetAttribute("Riders")
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return if ok and type(data) == "table" then data :: any else {}
end

local function plan(c: CrewState, p: Person, e: number)
	local B = Config.BoardingTime
	local start = math.max(e, Staff.CHECK_FROM)
	local avail = math.max(1.2, B - Staff.ALL_CLEAR - start - 0.2)
	local pts = { p.pos }
	for _, i in p.route do
		table.insert(pts, c.crew.stops[i].Position)
	end
	local flat = c.ride.kind == "carousel" or c.ride.kind == "spinner" or c.ride.kind == "pendulum" or c.ride.kind == "droptower"
	if flat then
		table.insert(pts, p.homePos)
	end
	local dist = 0
	for i = 2, #pts do
		dist += (pts[i] - pts[i - 1]).Magnitude
	end
	local n = #p.route
	local dwell, speed = Staff.CHECK_TIME, Staff.WALK
	if dist / speed + n * dwell > avail then
		dwell = math.max(0.3, math.min(Staff.CHECK_TIME, avail * 0.3 / math.max(1, n)))
		speed = math.min(18, dist / math.max(0.4, avail - n * dwell))
	end
	p.tasks = {}
	if e < Staff.CHECK_FROM then
		table.insert(p.tasks, { kind = "wait", dur = Staff.CHECK_FROM - e, time = 0, done = false })
	end
	for _, i in p.route do
		local stop = c.crew.stops[i]
		table.insert(p.tasks, { kind = "walk", to = stop.Position, time = 0, done = false, speed = speed })
		table.insert(p.tasks, { kind = "check", stop = i, yaw = yawOf(stop), dur = dwell, time = 0, done = false })
	end
	if flat then
		table.insert(p.tasks, { kind = "walk", to = p.homePos, yaw = p.homeYaw, time = 0, done = false, speed = speed })
	end
end

-- an attendant reaches a car: push down every restraint there
local function check(c: CrewState, p: Person, stop: number, list: { Rider })
	local car = c.crew.stopCars[stop]
	local seats = c.seats[car] or {}
	-- one big car checked from several stops: split its seats between them
	local same = {}
	for i, cc in c.crew.stopCars do
		if cc == car then
			table.insert(same, i)
		end
	end
	local first, last = 1, #seats
	if #same > 1 then
		local k = (table.find(same, stop) or 1) :: number
		local per = math.ceil(#seats / #same)
		first = (k - 1) * per + 1
		last = math.min(#seats, k * per) :: number
	end
	local mine = false
	for s = first, last :: number do
		for _, r in list do
			if r.c == car and r.s == s and r.u == localPlayer.UserId then
				mine = true
			end
		end
		setBar(c, car, s, true)
	end
	if mine then
		say(p.models[p.shown], pick(Staff.LINES.check))
	elseif math.random() < 0.3 then
		say(p.models[p.shown], pick(if c.crew.restraint == "none" then Staff.LINES.checkNone else Staff.LINES.check))
	end
end

local function step(c: CrewState, p: Person, dt: number, list: { Rider })
	local t = p.tasks[1]
	if not t then
		return "stand"
	end
	if t.kind == "walk" then
		local to = t.to :: Vector3
		local d = Vector3.new(to.X - p.pos.X, 0, to.Z - p.pos.Z)
		local move = (t.speed or Staff.WALK) * dt
		if d.Magnitude <= move or d.Magnitude < 0.05 then
			p.pos = to
			table.remove(p.tasks, 1)
			if t.yaw then
				p.yaw = t.yaw
			end
		else
			local u = d.Unit
			p.pos = Vector3.new(p.pos.X + u.X * move, p.pos.Y + (to.Y - p.pos.Y) * math.min(1, dt * 6), p.pos.Z + u.Z * move)
			p.yaw = turn(p.yaw, math.atan2(-u.X, -u.Z), dt * 10)
			p.bob += dt * 9
		end
		return "stand"
	elseif t.kind == "check" then
		t.time += dt
		p.yaw = turn(p.yaw, t.yaw or p.yaw, dt * 10)
		if not t.done and t.time >= (t.dur or 0.5) * 0.55 then
			t.done = true
			check(c, p, t.stop or 1, list)
		end
		if t.time >= (t.dur or 0.5) then
			table.remove(p.tasks, 1)
		end
		return "check"
	else
		t.time += dt
		if t.time >= (t.dur or 0) then
			table.remove(p.tasks, 1)
		end
		return if t.kind == "wave" then "wave" else "stand"
	end
end

local function finish(c: CrewState, p: Person, list: { Rider })
	for _, t in p.tasks do
		if t.kind == "check" and not t.done then
			t.done = true
			check(c, p, t.stop or 1, list)
		elseif t.kind == "walk" then
			p.pos = t.to :: Vector3
		end
	end
	p.tasks = {}
end

local function updateCrew(c: CrewState, dt: number)
	local status = c.folder:GetAttribute("Status")
	if type(status) ~= "string" then
		return
	end
	local cycle = c.folder:GetAttribute("CycleId")
	local start = c.folder:GetAttribute("CycleStart")
	local now = Clock.now()
	local B = Config.BoardingTime
	local list = riders(c)
	local opModel = c.operator
	if status == "Boarding" and type(start) == "number" then
		local e = math.clamp(now - (start - B), 0, B)
		if cycle ~= c.cycle or c.status ~= "Boarding" then
			c.cycle = if type(cycle) == "number" then cycle else c.cycle + 1
			c.said = {}
			setAll(c, false)
			c.pulls = {}
			for _, r in list do
				if r.u == 0 and r.c > 0 and math.random() > 0.18 then
					table.insert(c.pulls, { car = r.c, seat = r.s, at = 0.6 + math.random() * (Staff.PULL_BY - 0.6), done = false })
				end
			end
			for _, p in c.attendants do
				plan(c, p, e)
			end
		end
		for _, pull in c.pulls do
			if not pull.done and e >= pull.at then
				pull.done = true
				setBar(c, pull.car, pull.seat, true)
			end
		end
		if e < 2.5 and not c.said.pull then
			c.said.pull = true
			local r = c.crew.restraint
			say(opModel, pick(if r == "harness" then Staff.LINES.pullHarness elseif r == "belt" then Staff.LINES.belt elseif r == "lapbar" then Staff.LINES.pull else Staff.LINES.checkNone))
		end
		if e >= B - Staff.DISPATCH and not c.said.dispatch then
			c.said.dispatch = true
			say(opModel, pick(Staff.LINES.dispatch))
		end
		for k, p in c.attendants do
			local pose = step(c, p, dt, list)
			if e >= B - Staff.ALL_CLEAR and #p.tasks > 0 then
				finish(c, p, list)
			end
			if #p.tasks == 0 and e >= B - Staff.ALL_CLEAR then
				pose = "thumbs"
				if k == 1 and not c.said.clear then
					c.said.clear = true
					say(p.models.thumbs, pick(Staff.LINES.clear))
				end
			end
			show(p, pose)
		end
	elseif status == "Running" then
		if c.status ~= "Running" then
			-- every restraint locks as the train leaves the station
			for _, b in c.bars do
				b.angle, b.target = 0, 0
				poseBar(c, b)
			end
			for _, p in c.attendants do
				p.tasks = {
					{ kind = "wave", dur = 2.4, time = 0, done = false },
					{ kind = "walk", to = p.homePos, yaw = p.homeYaw, time = 0, done = false, speed = Staff.WALK * 0.7 },
				}
			end
		end
		for _, p in c.attendants do
			show(p, step(c, p, dt, list))
		end
	else
		if status == "Unloading" and c.status ~= "Unloading" then
			setAll(c, false)
			say(opModel, pick(Staff.LINES.unload))
		elseif status ~= c.status then
			setAll(c, false)
		end
		for _, p in c.attendants do
			show(p, step(c, p, dt, list))
		end
		c.chatter -= dt
		if c.chatter <= 0 then
			c.chatter = 20 + math.random() * 25
			local character = localPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if status == "Open" and root and opModel and opModel.PrimaryPart and (root.Position - opModel.PrimaryPart.Position).Magnitude < 30 then
				say(opModel, pick(Staff.LINES.wait))
			end
		end
	end
	c.status = status
	-- swing restraints (only while the cars sit in the station)
	if status ~= "Running" then
		for _, b in c.bars do
			if b.angle ~= b.target then
				local stepA = dt * 3
				local d = b.target - b.angle
				b.angle = if math.abs(d) <= stepA then b.target else b.angle + math.sign(d) * stepA
				poseBar(c, b)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Park staff: greetings, and sweepers on the walkways
---------------------------------------------------------------------------
type Greeter = { model: Model, role: string, kind: string, greeted: boolean }
local greeters: { Greeter } = {}

local SWEEP_LINES = {
	{ Vector3.new(-14, 0.4, 222), Vector3.new(-14, 0.4, 6) },
	{ Vector3.new(-30, 0.4, 15), Vector3.new(-158, 0.4, 15) },
	{ Vector3.new(0, 0.4, -118), Vector3.new(0, 0.4, -290) },
	{ Vector3.new(112, 0.4, 60), Vector3.new(112, 0.4, 246) },
	{ Vector3.new(130, 0.4, -120), Vector3.new(215, 0.4, -180) },
}
type Sweeper = { model: Model, a: Vector3, b: Vector3, s: number, dir: number, pause: number }
local sweepers: { Sweeper } = {}

local function broom(m: Model)
	local root = m.PrimaryPart :: BasePart
	local function bit(size: Vector3, offset: CFrame, color: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Size = size
		p.Color = color
		p.Material = material
		p.CFrame = root.CFrame * offset
		p.Parent = m
	end
	bit(Vector3.new(0.2, 4.4, 0.2), CFrame.new(0.9, -1.3, -1.3) * CFrame.Angles(math.rad(-30), 0, 0), Color3.fromRGB(110, 76, 44), Enum.Material.Wood)
	bit(Vector3.new(1.6, 0.4, 0.4), CFrame.new(0.9, -2.8, -2.35), Color3.fromRGB(170, 130, 70), Enum.Material.Fabric)
end

local function updatePark(dt: number)
	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		for _, g in greeters do
			local pp = g.model.PrimaryPart
			if pp then
				local d = (pp.Position - root.Position).Magnitude
				local range = if g.role == "greeter" then 22 else 15
				if d < range and not g.greeted then
					g.greeted = true
					local key = if g.role == "cashier" then (if g.kind == "restaurant" then "food" else "shop") elseif g.role == "vendor" then g.kind else g.role
					say(g.model, pick((Staff.LINES :: any)[key]))
				elseif d > 30 then
					g.greeted = false
				end
			end
		end
	end
	for _, s in sweepers do
		local len = (s.b - s.a).Magnitude
		if s.pause > 0 then
			s.pause -= dt
		else
			s.s += dt * 0.9 * s.dir / len
			if s.s > 1 or s.s < 0 then
				s.dir = -s.dir
				s.s = math.clamp(s.s, 0, 1)
				s.pause = 3
			end
		end
		local p = s.a:Lerp(s.b, s.s) + (s.b - s.a).Unit:Cross(Vector3.yAxis) * 6
		local look = (s.b - s.a).Unit * s.dir
		s.model:PivotTo(CFrame.lookAt(p + Vector3.new(0, STAND, 0), p + Vector3.new(0, STAND, 0) + look))
	end
end

---------------------------------------------------------------------------
-- The player's own restraint
---------------------------------------------------------------------------
local function pullMine()
	local riding = localPlayer:GetAttribute("Riding")
	if type(riding) ~= "string" or riding == "" then
		return
	end
	for _, c in crews do
		if c.ride.id == riding and c.status == "Boarding" then
			for _, r in riders(c) do
				if r.u == localPlayer.UserId then
					setBar(c, r.c, r.s, true)
				end
			end
		end
	end
end

function RideStaff.start(root: Instance)
	holder = Instance.new("Folder")
	holder.Name = "RideStaff"
	holder.Parent = workspace
	local rides = root:WaitForChild("Rides")
	local stateRides = Net.state():WaitForChild("Rides")
	for _, ride in Config.Rides do
		local crew = Staff.crew(ride.id)
		local model = rides:WaitForChild(ride.id, 30)
		local folder = stateRides:WaitForChild(ride.id, 30)
		if crew and model and folder then
			local motion = RideMotion.get(ride.id)
			local carsFolder = model:WaitForChild("Cars")
			local cars = {}
			for i = 1, motion.carCount do
				cars[i] = carsFolder:WaitForChild("Car" .. i) :: Model
			end
			local c: CrewState = {
				ride = ride,
				crew = crew,
				folder = folder,
				cars = cars,
				seats = motion.seats,
				bars = {},
				attendants = {},
				operator = nil,
				cycle = -1,
				status = "",
				said = {},
				pulls = {},
				runSince = 0,
				chatter = 10 + math.random() * 20,
			}
			for _, m in CollectionService:GetTagged("StaffSpot") do
				if m:GetAttribute("RideId") == ride.id and m:IsA("Model") then
					c.operator = m :: Model
				end
			end
			collectBars(c)
			for k = 1, crew.attendants do
				local p = newPerson(#ride.id * 53 + k * 7, ride.land, crew.homes[k])
				p.route = Staff.route(crew, k)
				show(p, "stand")
				table.insert(c.attendants, p)
			end
			table.insert(crews, c)
		end
	end
	for _, m in CollectionService:GetTagged("StaffSpot") do
		local role = m:GetAttribute("Role")
		if m:IsA("Model") and type(role) == "string" and role ~= "operator" then
			local kind = m:GetAttribute("Kind")
			table.insert(greeters, { model = m :: Model, role = role, kind = if type(kind) == "string" then kind else "", greeted = false })
		end
	end
	for i, line in SWEEP_LINES do
		local m = Staff.figure(7700 + i * 13, "Plaza", "check")
		m.Name = "Sweeper"
		m.Parent = holder
		broom(m)
		table.insert(sweepers, { model = m, a = line[1], b = line[2], s = i * 0.17, dir = if i % 2 == 0 then 1 else -1, pause = 0 })
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.E then
			pullMine()
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		for _, c in crews do
			updateCrew(c, math.min(dt, 0.25))
		end
		updatePark(dt)
	end)
end

return RideStaff
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ShowPlayer</string>
            <string name="Source"><![CDATA[-- Plays the park's shows locally, in sync with the start time the server
-- publishes. Each show is a function of time t, so guests who arrive late
-- see the show from the right moment.

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Net = require(Shared.Net)
local Props = require(Shared.Props)
local SoundPlayer = require(script.Parent.SoundPlayer)

local ShowPlayer = {}

type Instance_ = {
	folder: Folder,
	stage: Model,
	update: Updater,
	cleanup: Cleanup,
}

type Updater = (t: number) -> ()
type Cleanup = () -> ()
type ShowImpl = (stage: Model) -> (Updater, Cleanup)

local TAU = math.pi * 2
local M = Enum.Material

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Caption board floating over a show.
local function captions(parent: Instance, at: Vector3, lines: { { any } }): (t: number) -> ()
	local anchor = part(parent, Vector3.new(1, 1, 1), CFrame.new(at), Color3.new(1, 1, 1))
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(520, 70)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 260
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 240, 200)
	label.FontFace = Font.fromEnum(Enum.Font.GothamBlack)
	label.Text = ""
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 20, 30)
	stroke.Parent = label
	return function(t: number)
		local text = ""
		for _, line in lines do
			if t >= (line[1] :: number) then
				text = line[2] :: string
			end
		end
		label.Text = text
	end
end

local function confetti(parent: Instance, at: Vector3, area: Vector3): ParticleEmitter
	local p = part(parent, area, CFrame.new(at), Color3.new(1, 1, 1))
	p.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 230, 120)),
	})
	e.Size = NumberSequence.new(0.5, 0.3)
	e.Speed = NumberRange.new(4, 10)
	e.SpreadAngle = Vector2.new(70, 70)
	e.Lifetime = NumberRange.new(3, 5)
	e.Acceleration = Vector3.new(0, -8, 0)
	e.RotSpeed = NumberRange.new(-200, 200)
	e.Rate = 0
	e.LightEmission = 0.3
	e.Parent = p
	return e
end

---------------------------------------------------------------------------
-- Big Dreams Live! (Lakeside Stage)
---------------------------------------------------------------------------
local function bigDreams(stage: Model): (Updater, Cleanup)
	local center = Vector3.new(225, 4.4, 186)
	local dancers = {}
	for i = 1, 7 do
		local g = Props.guest(9000 + i * 17, if i == 4 then "cheer" else "stand")
		g.Parent = stage
		table.insert(dancers, g)
	end
	-- lead singer's microphone stand
	part(stage, Vector3.new(0.3, 5, 0.3), CFrame.new(center + Vector3.new(0, 2.5, 4)), Color3.fromRGB(40, 40, 44), M.Metal)
	local lights = CollectionService:GetTagged("StageLight")
	local fountains = CollectionService:GetTagged("LakeFountain")
	local burst = confetti(stage, center + Vector3.new(0, 22, 4), Vector3.new(44, 1, 14))
	local caption = captions(stage, center + Vector3.new(0, 26, 8), {
		{ 0, "BIG DREAMS LIVE!" },
		{ 4, "♪ Wheels keep turning, engines hum... ♪" },
		{ 14, "♪ Every dreamer, here we come! ♪" },
		{ 24, "♪ Big dreams, big rigs, brighter days ♪" },
		{ 34, "♪ Benton lights the lakeside haze ♪" },
		{ 44, "♪ Hand in hand and gear to gear... ♪" },
		{ 54, "♪ BIG DREAMS START RIGHT HERE! ♪" },
		{ 64, "Thank you, Benton Diesel World!" },
	})
	local confettiFired = false
	local function update(t: number)
		caption(t)
		-- formations: line -> V -> circle -> line
		local phase = math.floor(t / 15) % 4
		local blend = smooth((t % 15) / 2)
		for i, g in dancers do
			local k = i - 4
			local line = Vector3.new(k * 5, 0, 2)
			local vee = Vector3.new(k * 4.5, 0, 6 - math.abs(k) * 2.4)
			local a = TAU * i / #dancers + t * 0.8
			local circle = Vector3.new(math.cos(a) * 11, 0, 4 + math.sin(a) * 5)
			local shapes = { line, vee, circle, line }
			local from = shapes[(phase + 3) % 4 + 1]
			local to = shapes[phase + 1]
			local p = from:Lerp(to, blend)
			if i == 4 then
				p = Vector3.new(0, 0, 4.2)
			end
			local bounce = math.abs(math.sin(t * 4 + i)) * 1.4
			local yaw = math.sin(t * 2 + i) * 0.5
			g:PivotTo(CFrame.new(center + p + Vector3.new(0, 2.9 + bounce, 0)) * CFrame.Angles(0, math.pi + yaw, 0))
		end
		for i, l in lights do
			local spot = l:FindFirstChildOfClass("SpotLight")
			if spot then
				spot.Brightness = 3 + math.sin(t * 3 + i) * 2
				spot.Color = Color3.fromHSV((t * 0.08 + i * 0.13) % 1, 0.7, 1)
			end
		end
		local fountainsOn = t > 8 and t < 66
		for i, f in fountains do
			local spray = f:FindFirstChildOfClass("ParticleEmitter")
			if spray then
				spray.Enabled = fountainsOn and ((math.floor(t / 2) + i) % 3 ~= 0 or t > 54)
				spray.Color = ColorSequence.new(Color3.fromHSV((t * 0.05 + i * 0.1) % 1, 0.35, 1))
			end
		end
		if t > 56 and not confettiFired then
			confettiFired = true
			burst:Emit(400)
		end
	end
	local function cleanup()
		for _, l in lights do
			local spot = l:FindFirstChildOfClass("SpotLight")
			if spot then
				spot.Brightness = 0
			end
		end
		for _, f in fountains do
			local spray = f:FindFirstChildOfClass("ParticleEmitter")
			if spray then
				spray.Enabled = false
			end
		end
	end
	return update, cleanup
end

---------------------------------------------------------------------------
-- Diesel Stunt Spectacular (Backlot Stunt Arena)
---------------------------------------------------------------------------
local function stuntTruck(parent: Instance, color: Color3): Model
	local m = Instance.new("Model")
	m.Name = "StuntTruck"
	local base = part(m, Vector3.new(0.5, 0.5, 0.5), CFrame.new(), Color3.new(1, 1, 1))
	base.Transparency = 1
	m.PrimaryPart = base
	part(m, Vector3.new(6, 2.4, 9), CFrame.new(0, 4.2, 0), color, M.SmoothPlastic)
	part(m, Vector3.new(5.4, 2.4, 4), CFrame.new(0, 6.6, 0.8), color, M.SmoothPlastic)
	part(m, Vector3.new(5, 1.6, 0.2), CFrame.new(0, 6.8, -1.25), Color3.fromRGB(150, 200, 230), M.Glass)
	for _, sx in { -1, 1 } do
		for _, sz in { -3.2, 3.2 } do
			part(m, Vector3.new(2.2, 4.4, 4.4), CFrame.new(sx * 3.6, 2.2, sz), Color3.fromRGB(25, 25, 25), M.Rubber, Enum.PartType.Cylinder)
		end
	end
	part(m, Vector3.new(6.2, 0.6, 1), CFrame.new(0, 3.4, -4.6), Color3.fromRGB(200, 200, 205), M.Metal)
	m.Parent = parent
	return m
end

-- Ramp jump from west (x=36) to east (x=104) along z, starting at time t0.
local function jumpPose(t: number, t0: number, z: number, roll: boolean): CFrame?
	local d = t - t0
	if d < 0 or d > 4 then
		return nil
	end
	local x = 30 + d * 20
	local y = 0
	if x >= 47 and x < 60 then
		y = (x - 47) / 13 * 6.4
	elseif x >= 60 and x < 80 then
		local u = (x - 60) / 20
		y = 6.4 + u * (-0.6) + 30 * u * (1 - u)
	elseif x >= 80 and x < 93 then
		y = 5.8 * (1 - (x - 80) / 13)
	end
	local pitch = 0
	if x >= 47 and x < 60 then
		pitch = 0.45
	elseif x >= 60 and x < 80 then
		pitch = 0.45 - (x - 60) / 20 * 0.9
	elseif x >= 80 and x < 93 then
		pitch = -0.4
	end
	local spin = if roll and x >= 60 and x < 80 then (x - 60) / 20 * TAU else 0
	return CFrame.new(x, 0.5 + y, z) * CFrame.Angles(0, -math.pi / 2, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, spin)
end

local function stunts(stage: Model): (Updater, Cleanup)
	local trucks = {
		stuntTruck(stage, Color3.fromRGB(196, 40, 40)),
		stuntTruck(stage, Color3.fromRGB(30, 110, 230)),
		stuntTruck(stage, Color3.fromRGB(255, 140, 26)),
	}
	local center = Vector3.new(70, 0.5, -246)
	local pots = CollectionService:GetTagged("StuntFirePot")
	local fires: { Fire } = {}
	local booms: { [string]: boolean } = {}
	local caption = captions(stage, Vector3.new(70, 30, -250), {
		{ 0, "LADIES AND GENTLEMEN... START YOUR ENGINES!" },
		{ 12, "The Benton Stunt Team!" },
		{ 16, "First up: the RED RIG ramp jump!" },
		{ 28, "Double trouble - BLUE and ORANGE!" },
		{ 40, "Through the WALL OF FIRE!" },
		{ 54, "And now... the BARREL ROLL!" },
		{ 66, "Give it up for the Benton Stunt Team!" },
	})
	local function boom(key: string, at: Vector3)
		if booms[key] then
			return
		end
		booms[key] = true
		local e = Instance.new("Explosion")
		e.Position = at
		e.BlastPressure = 0
		e.BlastRadius = 0
		e.DestroyJointRadiusPercent = 0
		e.ExplosionType = Enum.ExplosionType.NoCraters
		e.Parent = workspace
	end
	local function circle(t: number, i: number, radius: number): CFrame
		local a = t * 0.9 + i * TAU / 3
		local p = center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius * 0.8)
		local tangent = Vector3.new(-math.sin(a), 0, math.cos(a) * 0.8)
		return CFrame.lookAt(p, p + tangent)
	end
	local parked = {
		CFrame.new(44, 0.5, -270) * CFrame.Angles(0, math.rad(30), 0),
		CFrame.new(96, 0.5, -270) * CFrame.Angles(0, math.rad(-30), 0),
		CFrame.new(70, 0.5, -275),
	}
	local function update(t: number)
		caption(t)
		for i, truck in trucks do
			local cf: CFrame
			if t < 14 then
				cf = circle(t, i, 22)
			elseif i == 1 and t >= 16 and t < 20 then
				cf = jumpPose(t, 16, -250, false) :: CFrame
			elseif i == 2 and t >= 28 and t < 32 then
				cf = jumpPose(t, 28, -252, false) :: CFrame
			elseif i == 3 and t >= 30 and t < 34 then
				cf = jumpPose(t, 30, -248, false) :: CFrame
			elseif i == 1 and t >= 42 and t < 50 then
				local u = (t - 42) / 8
				local x = 36 + u * 68
				cf = CFrame.new(x, 0.5, -256) * CFrame.Angles(0, -math.pi / 2, 0)
			elseif i == 3 and t >= 56 and t < 60 then
				cf = jumpPose(t, 56, -250, true) :: CFrame
			elseif t >= 64 then
				cf = CFrame.new(54 + i * 8, 0.5, -232) * CFrame.Angles(0, math.pi + math.sin(t * 6 + i) * 0.1, 0)
			else
				cf = parked[i]
			end
			truck:PivotTo(cf)
		end
		if t > 19 then
			boom("a", Vector3.new(96, 4, -250))
		end
		if t > 33 then
			boom("b", Vector3.new(96, 4, -252))
			boom("c", Vector3.new(60, 6, -276))
		end
		if t > 59.5 then
			boom("d", Vector3.new(100, 4, -250))
			boom("e", Vector3.new(40, 6, -276))
		end
		-- wall of fire
		local fireOn = t > 38 and t < 52
		if fireOn and #fires == 0 then
			for _, pot in pots do
				local f = Instance.new("Fire")
				f.Size = 14
				f.Heat = 25
				f.Parent = pot
				table.insert(fires, f)
			end
			for z = -276, -236, 8 do
				local holder = part(stage, Vector3.new(2, 1, 2), CFrame.new(70, 1, z), Color3.new(0, 0, 0))
				holder.Transparency = 1
				local f = Instance.new("Fire")
				f.Size = 10
				f.Heat = 18
				f.Parent = holder
				table.insert(fires, f)
			end
		elseif not fireOn and #fires > 0 then
			for _, f in fires do
				f:Destroy()
			end
			fires = {}
		end
	end
	local function cleanup()
		for _, f in fires do
			f:Destroy()
		end
	end
	return update, cleanup
end

---------------------------------------------------------------------------
-- Big Rig Parade (Hub and Main Street)
---------------------------------------------------------------------------
local ROUTE = {
	Vector3.new(-120, 0.5, -60),
	Vector3.new(-62, 0.5, -60),
	Vector3.new(-50, 0.5, -28),
	Vector3.new(-30, 0.5, -10),
	Vector3.new(0, 0.5, 0),
	Vector3.new(0, 0.5, 120),
	Vector3.new(0, 0.5, 225),
	Vector3.new(-30, 0.5, 248),
	Vector3.new(-90, 0.5, 240),
	Vector3.new(-150, 0.5, 232),
}

local routeLen = 0
local routeCum = { 0 }
for i = 2, #ROUTE do
	routeLen += (ROUTE[i] - ROUTE[i - 1]).Magnitude
	routeCum[i] = routeLen
end

local function routeAt(s: number): CFrame
	s = math.clamp(s, 0, routeLen - 0.01)
	for i = 2, #ROUTE do
		if s <= routeCum[i] then
			local a, b = ROUTE[i - 1], ROUTE[i]
			local u = (s - routeCum[i - 1]) / (routeCum[i] - routeCum[i - 1])
			return CFrame.lookAt(a:Lerp(b, u), b)
		end
	end
	return CFrame.new(ROUTE[#ROUTE])
end

local function float(parent: Instance, theme: number): (Model, { Model })
	local m = Instance.new("Model")
	m.Name = "Float" .. theme
	local base = part(m, Vector3.new(0.5, 0.5, 0.5), CFrame.new(), Color3.new(1, 1, 1))
	base.Transparency = 1
	m.PrimaryPart = base
	local colors = { Color3.fromRGB(196, 40, 40), Color3.fromRGB(30, 110, 230), Color3.fromRGB(120, 84, 52), Color3.fromRGB(70, 170, 120) }
	local c = colors[theme]
	-- cab
	part(m, Vector3.new(8, 7, 7), CFrame.new(0, 4.5, -10), c, M.SmoothPlastic)
	part(m, Vector3.new(7, 2.4, 0.3), CFrame.new(0, 6.5, -13.6), Color3.fromRGB(150, 200, 230), M.Glass)
	part(m, Vector3.new(7.6, 3, 4), CFrame.new(0, 3, -15), c, M.SmoothPlastic)
	-- flatbed
	part(m, Vector3.new(9, 1.4, 20), CFrame.new(0, 2.6, 4), Color3.fromRGB(240, 240, 236), M.SmoothPlastic)
	part(m, Vector3.new(9.4, 1, 20.4), CFrame.new(0, 1.8, 4), Color3.fromRGB(240, 196, 64), M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		for _, sz in { -11, 0, 10 } do
			part(m, Vector3.new(1.4, 3, 3), CFrame.new(sx * 4.2, 1.5, sz), Color3.fromRGB(25, 25, 25), M.Rubber, Enum.PartType.Cylinder)
		end
	end
	if theme == 1 then
		part(m, Vector3.new(10, 10, 10), CFrame.new(0, 9, 5), Color3.fromRGB(40, 110, 210), M.SmoothPlastic, Enum.PartType.Ball)
		for k = 0, 11 do
			local a = k * TAU / 12
			part(m, Vector3.new(2.2, 1.2, 1.2), CFrame.new(0, 9, 5) * CFrame.Angles(0, 0, a) * CFrame.new(0, 7, 0), Color3.fromRGB(240, 196, 64), M.Metal)
		end
	elseif theme == 2 then
		part(m, Vector3.new(5, 1.6, 11), CFrame.new(0, 4.2, 4), Color3.fromRGB(30, 110, 230), M.SmoothPlastic)
		part(m, Vector3.new(2.4, 1.4, 3), CFrame.new(0, 5.4, 4.5), Color3.fromRGB(20, 20, 26), M.Glass)
		part(m, Vector3.new(0.3, 8, 6), CFrame.new(0, 8, 12), Color3.new(1, 1, 1), M.Fabric)
	elseif theme == 3 then
		for k = 0, 2 do
			part(m, Vector3.new(4 - k, 3, 4 - k), CFrame.new(-2.5, 5 + k * 2.4, 9), Color3.fromRGB(40, 100, 56), M.Grass, Enum.PartType.Cylinder)
			part(m, Vector3.new(4 - k, 3, 4 - k), CFrame.new(2.5, 5 + k * 2.4, 0), Color3.fromRGB(40, 100, 56), M.Grass, Enum.PartType.Cylinder)
		end
		part(m, Vector3.new(4, 3, 6), CFrame.new(0, 4.8, 4), Color3.fromRGB(200, 120, 40), M.CorrodedMetal)
	else
		for k = 0, 2 do
			part(m, Vector3.new(1, 9 - k * 2.6, 9 - k * 2.6), CFrame.new(0, 4 + k * 1.2, 4) * CFrame.Angles(0, 0, math.pi / 2), if k % 2 == 0 then Color3.fromRGB(196, 40, 40) else Color3.fromRGB(250, 243, 224), M.Fabric, Enum.PartType.Cylinder)
		end
		part(m, Vector3.new(0.6, 9, 0.6), CFrame.new(0, 8, 4), Color3.fromRGB(240, 196, 64), M.Metal)
	end
	local riders = {}
	for k = 1, 3 do
		local g = Props.guest(7000 + theme * 10 + k, "cheer")
		g.Parent = m
		table.insert(riders, g)
	end
	m.Parent = parent
	return m, riders
end

local function parade(stage: Model): (Updater, Cleanup)
	local floats = {}
	for theme = 1, 4 do
		local m, riders = float(stage, theme)
		table.insert(floats, { model = m, riders = riders })
	end
	local walkers = {}
	for k = 1, 8 do
		local g = Props.guest(8100 + k * 3, if k % 2 == 0 then "cheer" else "stand")
		g.Parent = stage
		table.insert(walkers, g)
	end
	local speed = 5
	local gap = 34
	local caption = captions(stage, Vector3.new(0, 30, 120), {
		{ 0, "The BIG RIG PARADE is rolling down Main Street!" },
		{ 25, "Wave to the Benton Globe float!" },
		{ 50, "Here comes Velocity City and Old Rusty!" },
		{ 80, "And the Big Dreams carousel float!" },
	})
	local function update(t: number)
		caption(t)
		for i, f in floats do
			local s = t * speed - (i - 1) * gap
			local visible = s > 0 and s < routeLen - 1
			local cf = if visible then routeAt(s) else CFrame.new(0, -200, 0)
			f.model:PivotTo(cf)
			for k, g in f.riders do
				local bounce = math.abs(math.sin(t * 3 + k + i)) * 0.8
				g:PivotTo(cf * CFrame.new((k - 2) * 2.8, 6.2 + bounce, 6 + k) * CFrame.Angles(0, math.sin(t + k) * 0.6, 0))
			end
		end
		for k, g in walkers do
			local s = t * speed - (k - 1) * 9 + 12
			local visible = s > 0 and s < routeLen - 1
			local cf = if visible then routeAt(s) else CFrame.new(0, -200, 0)
			local side = if k % 2 == 0 then 7 else -7
			local bounce = math.abs(math.sin(t * 5 + k)) * 0.9
			g:PivotTo(cf * CFrame.new(side, 3.4 + bounce, 0) * CFrame.Angles(0, math.sin(t * 2 + k) * 0.8, 0))
		end
	end
	return update, function() end
end

---------------------------------------------------------------------------
-- Benton Nights fireworks
---------------------------------------------------------------------------
local function fireworks(stage: Model): (Updater, Cleanup)
	local rng = Random.new(2024)
	local sites = { Vector3.new(-60, 2, -230), Vector3.new(0, 2, -250), Vector3.new(60, 2, -230), Vector3.new(-30, 2, -300), Vector3.new(30, 2, -300) }
	type Firework = { at: number, from: Vector3, to: Vector3, color: Color3, size: number, fired: boolean, burst: boolean, rocket: Part? }
	local schedule: { Firework } = {}
	local t = 2
	while t < 92 do
		local finale = t > 76
		local site = sites[rng:NextInteger(1, #sites)]
		table.insert(schedule, {
			at = t,
			from = site,
			to = site + Vector3.new(rng:NextNumber(-40, 40), rng:NextNumber(130, 220), rng:NextNumber(-30, 60)),
			color = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.5, 0.9), 1),
			size = rng:NextNumber(0.8, 1.4),
			fired = false,
			burst = false,
			rocket = nil,
		})
		t += if finale then rng:NextNumber(0.12, 0.3) else rng:NextNumber(0.5, 1.4)
	end
	local caption = captions(stage, Vector3.new(0, 40, -40), {
		{ 0, "BENTON NIGHTS" },
		{ 10, "" },
		{ 76, "GOODNIGHT FROM BENTON DIESEL WORLD!" },
	})
	local function burst(item: Firework)
		local holder = part(stage, Vector3.new(1, 1, 1), CFrame.new(item.to), item.color, M.Neon, Enum.PartType.Ball)
		holder.Transparency = 1
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(item.color, Color3.new(1, 1, 1))
		e.LightEmission = 1
		e.LightInfluence = 0
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.4 * item.size), NumberSequenceKeypoint.new(1, 0) })
		e.Speed = NumberRange.new(40 * item.size, 55 * item.size)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Lifetime = NumberRange.new(1.4, 2.2)
		e.Acceleration = Vector3.new(0, -14, 0)
		e.Drag = 1.5
		e.Rate = 0
		e.Parent = holder
		e:Emit(140)
		local light = Instance.new("PointLight")
		light.Color = item.color
		light.Range = 60
		light.Brightness = 6
		light.Shadows = false
		light.Parent = holder
		task.delay(0.4, function()
			light.Brightness = 2
		end)
		Debris:AddItem(holder, 3)
	end
	local function update(time_: number)
		caption(time_)
		for _, item in schedule do
			if not item.fired and time_ >= item.at then
				item.fired = true
				local rocket = part(stage, Vector3.new(0.8, 0.8, 0.8), CFrame.new(item.from), Color3.fromRGB(255, 220, 160), M.Neon, Enum.PartType.Ball)
				local a0 = Instance.new("Attachment")
				a0.Position = Vector3.new(0, 0.3, 0)
				a0.Parent = rocket
				local a1 = Instance.new("Attachment")
				a1.Position = Vector3.new(0, -0.3, 0)
				a1.Parent = rocket
				local trail = Instance.new("Trail")
				trail.Attachment0 = a0
				trail.Attachment1 = a1
				trail.Lifetime = 0.5
				trail.Color = ColorSequence.new(Color3.fromRGB(255, 200, 120))
				trail.LightEmission = 1
				trail.Parent = rocket
				item.rocket = rocket
				SoundPlayer.at(item.from, "Launch", 0.6)
			end
			local rocket = item.rocket
			if rocket and not item.burst then
				local u = (time_ - item.at) / 1.1
				if u >= 1 then
					item.burst = true
					rocket:Destroy()
					item.rocket = nil
					burst(item)
				else
					rocket.CFrame = CFrame.new(item.from:Lerp(item.to, 1 - (1 - u) ^ 2))
				end
			end
		end
	end
	return update, function() end
end

local IMPLS: { [string]: ShowImpl } = {
	BigDreams = bigDreams,
	StuntSpectacular = stunts,
	BigRigParade = parade,
	BentonNights = fireworks,
}

---------------------------------------------------------------------------
-- Driver
---------------------------------------------------------------------------
local running: { [string]: Instance_ } = {}

function ShowPlayer.start()
	local folders = Net.state():WaitForChild("Shows")
	local container = Instance.new("Folder")
	container.Name = "BentonShowProps"
	container.Parent = workspace
	RunService.RenderStepped:Connect(function()
		local now = Clock.now()
		for _, show in Config.Shows do
			local folder = folders:FindFirstChild(show.id) :: Folder?
			if folder then
				local start = folder:GetAttribute("Start")
				local isRunning = folder:GetAttribute("Running") == true
				local t = if type(start) == "number" then now - start else -1
				local active = running[show.id]
				if isRunning and t >= 0 and t <= show.duration then
					if not active then
						local stage = Instance.new("Model")
						stage.Name = show.id
						stage.Parent = container
						local ok, update, cleanup = pcall(IMPLS[show.id], stage)
						if ok then
							active = { folder = folder, stage = stage, update = update, cleanup = cleanup }
							running[show.id] = active
						else
							warn("[BentonDieselWorld] show failed to start:", update)
							stage:Destroy()
						end
					end
					if active then
						local ok, err = pcall(active.update, t)
						if not ok then
							warn("[BentonDieselWorld] show error:", err)
						end
					end
				elseif active then
					pcall(active.cleanup)
					active.stage:Destroy()
					running[show.id] = nil
				end
			end
		end
	end)
end

return ShowPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">SoundPlayer</string>
            <string name="Source"><![CDATA[-- Plays the park's sounds on each client: land music that crossfades as you
-- walk, show music at the venues, ride loops on the lead vehicles, screams
-- on big drops, the log flume splash and short UI cues. Which sounds play
-- is set in ReplicatedStorage.BentonShared.Sounds.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)

local SoundPlayer = {}

local localPlayer = Players.LocalPlayer
local music: { [string]: Sound } = {}
local currentLand = ""
local holder: Folder? = nil

local function newSound(id: string, parent: Instance, volume: number, looped: boolean): Sound
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.Looped = looped
	s.RollOffMaxDistance = 260
	s.RollOffMinDistance = 12
	s.Parent = parent
	return s
end

-- A short sound everyone nearby hears from a point in the world.
function SoundPlayer.at(position: Vector3, cue: string, volume: number?)
	local id = Sounds.Cues[cue]
	if not id or id == "" or not holder then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = position
	p.Parent = holder
	local s = newSound(id, p, volume or 0.8, false)
	s:Play()
	task.delay(4, function()
		p:Destroy()
	end)
end

-- A UI cue (not positional).
function SoundPlayer.cue(cue: string, volume: number?)
	local id = Sounds.Cues[cue]
	if not id or id == "" then
		return
	end
	local s = newSound(id, SoundService, volume or 0.5, false)
	s:Play()
	task.delay(3, function()
		s:Destroy()
	end)
end

local function setLand(id: string)
	if id == currentLand then
		return
	end
	currentLand = id
	for land, s in music do
		local target = if land == id then Sounds.MusicVolume else 0
		TweenService:Create(s, TweenInfo.new(2.5), { Volume = target }):Play()
	end
end

type RideSound = { ride: Config.Ride, folder: Instance, loop: Sound?, lastY: number?, cool: number }

function SoundPlayer.start(root: Instance)
	local h = Instance.new("Folder")
	h.Name = "BentonSounds"
	h.Parent = workspace
	holder = h
	-- land music
	for land, id in Sounds.Music do
		if id ~= "" then
			local s = newSound(id, SoundService, 0, true)
			s:Play()
			music[land] = s
		end
	end
	-- show music at each venue
	local shows = Net.state():WaitForChild("Shows")
	for _, show in Config.Shows do
		local id = Sounds.Shows[show.id]
		local folder = shows:FindFirstChild(show.id)
		if id and id ~= "" and folder then
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.Transparency = 1
			p.Position = show.center + Vector3.new(0, 8, 0)
			p.Parent = h
			local s = newSound(id, p, 0.8, true)
			s.RollOffMaxDistance = 400
			local function sync()
				if folder:GetAttribute("Running") then
					s:Play()
				else
					s:Stop()
				end
			end
			folder:GetAttributeChangedSignal("Running"):Connect(sync)
			sync()
		end
	end
	-- rides
	local rideState = Net.state():WaitForChild("Rides")
	local rides: { RideSound } = {}
	for _, ride in Config.Rides do
		local folder = rideState:FindFirstChild(ride.id)
		if folder then
			table.insert(rides, { ride = ride, folder = folder, loop = nil, lastY = nil, cool = 0 })
		end
	end
	local function leadPart(ride: Config.Ride): BasePart?
		local ridesFolder = root:FindFirstChild("Rides")
		local model = if ridesFolder then ridesFolder:FindFirstChild(ride.id) else nil
		local cars = if model then model:FindFirstChild("Cars") else nil
		local car = if cars then cars:FindFirstChild("Car1") :: Model? else nil
		return if car then car.PrimaryPart else nil
	end
	localPlayer:GetAttributeChangedSignal("Riding"):Connect(function()
		local riding = localPlayer:GetAttribute("Riding")
		if type(riding) == "string" and riding ~= "" then
			SoundPlayer.cue("Info", 0.6)
		end
	end)
	local timer = 0
	RunService.RenderStepped:Connect(function(dt)
		timer += dt
		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if timer > 0.5 then
			timer = 0
			if hrp then
				local land = Config.landAt(hrp.Position)
				if land then
					setLand(land.id)
				end
			end
		end
		for _, rs in rides do
			local part = leadPart(rs.ride)
			if not part then
				continue
			end
			local running = rs.folder:GetAttribute("Status") == "Running"
			local id = Sounds.Rides[rs.ride.kind]
			if id and id ~= "" then
				if not rs.loop then
					rs.loop = newSound(id, part, 0.7, true)
				end
				local loop = rs.loop :: Sound
				if running and not loop.IsPlaying then
					loop:Play()
				elseif not running and loop.IsPlaying then
					loop:Stop()
				end
			end
			-- screams on big drops, and the flume splash at the bottom
			local y = part.Position.Y
			local last = rs.lastY
			rs.lastY = y
			rs.cool -= dt
			if last and dt > 0 and running then
				local vy = (y - last) / dt
				local drop = rs.ride.kind == "coaster" or rs.ride.kind == "droptower" or rs.ride.kind == "pendulum"
				if drop and vy < -40 and rs.cool <= 0 and Sounds.Screams ~= "" then
					rs.cool = 6
					local s = newSound(Sounds.Screams, part, 0.8, false)
					s:Play()
					task.delay(5, function()
						s:Destroy()
					end)
				elseif rs.ride.kind == "flume" and vy < -25 and rs.cool <= 0 then
					rs.cool = 6
					task.delay(1, function()
						SoundPlayer.at(part.Position, "Splash", 1)
					end)
				end
			end
		end
	end)
end

return SoundPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Tiny UI toolkit + the Benton App look (navy panels, orange accents).

local SoundPlayer = require(script.Parent.SoundPlayer)

local UI = {}

UI.Colors = {
	Navy = Color3.fromRGB(18, 26, 44),
	Panel = Color3.fromRGB(26, 36, 60),
	Card = Color3.fromRGB(36, 48, 78),
	CardHover = Color3.fromRGB(48, 62, 98),
	Orange = Color3.fromRGB(255, 140, 26),
	Gold = Color3.fromRGB(240, 196, 64),
	Cream = Color3.fromRGB(250, 243, 224),
	Muted = Color3.fromRGB(160, 172, 196),
	Green = Color3.fromRGB(90, 220, 110),
	Yellow = Color3.fromRGB(250, 210, 60),
	Red = Color3.fromRGB(240, 70, 60),
	Blue = Color3.fromRGB(60, 140, 240),
}

UI.Fonts = {
	Black = Font.fromEnum(Enum.Font.GothamBlack),
	Bold = Font.fromEnum(Enum.Font.GothamBold),
	Medium = Font.fromEnum(Enum.Font.GothamMedium),
	Regular = Font.fromEnum(Enum.Font.Gotham),
}

-- Create an instance, set properties, and parent children.
function UI.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className :: any) :: any
	if props then
		local parent = nil
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
		if children then
			for _, c in children do
				c.Parent = inst
			end
		end
		if parent then
			inst.Parent = parent
		end
	elseif children then
		for _, c in children do
			c.Parent = inst
		end
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	return c
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(1, 1, 1)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.75
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

function UI.padding(all: number, top: number?): UIPadding
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, all)
	p.PaddingRight = UDim.new(0, all)
	p.PaddingTop = UDim.new(0, top or all)
	p.PaddingBottom = UDim.new(0, top or all)
	return p
end

function UI.list(padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	if align then
		l.HorizontalAlignment = align
	end
	if horizontal then
		l.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	return l
end

function UI.label(text: string, size: number, color: Color3?, font: Font?, props: { [string]: any }?): TextLabel
	local l = UI.make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color or UI.Colors.Cream,
		FontFace = font or UI.Fonts.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, size + 4),
	})
	if props then
		for k, v in props do
			(l :: any)[k] = v
		end
	end
	return l
end

function UI.button(text: string, color: Color3?, onClick: () -> (), props: { [string]: any }?): TextButton
	local b = UI.make("TextButton", {
		Text = text,
		TextSize = 15,
		TextColor3 = UI.Colors.Navy,
		FontFace = UI.Fonts.Black,
		BackgroundColor3 = color or UI.Colors.Orange,
		AutoButtonColor = true,
		Size = UDim2.new(0, 96, 0, 32),
	}, { UI.corner(8) })
	b.Activated:Connect(function()
		SoundPlayer.cue("Click", 0.35)
	end)
	if props then
		for k, v in props do
			(b :: any)[k] = v
		end
	end
	b.Activated:Connect(onClick)
	return b
end

function UI.card(props: { [string]: any }?): Frame
	local f = UI.make("Frame", {
		BackgroundColor3 = UI.Colors.Card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { UI.corner(10), UI.padding(10) })
	if props then
		for k, v in props do
			(f :: any)[k] = v
		end
	end
	return f
end

function UI.waitColor(minutes: number): Color3
	if minutes < 0 then
		return UI.Colors.Red
	elseif minutes <= 15 then
		return UI.Colors.Green
	elseif minutes <= 30 then
		return UI.Colors.Yellow
	elseif minutes <= 45 then
		return UI.Colors.Orange
	end
	return UI.Colors.Red
end

function UI.stars(n: number): string
	return string.rep("★", n) .. string.rep("☆", 5 - n)
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
