      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- RemoteEvents shared by the server and clients, plus the replicated state
-- folder (ReplicatedStorage.BentonState) that holds ride and show status.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Names = {
	"Notify", -- server -> client: toast { text, kind, amount? }
	"Profile", -- server -> client: full profile snapshot
	"OpenVenue", -- server -> client: venue id (shop / restaurant prompt)
	"Action", -- client -> server: { type = "...", ... }
}

-- Server: create the remotes and state folders.
function Net.setup(): Folder
	local remotes = ReplicatedStorage:FindFirstChild("BentonRemotes")
	if not remotes then
		local f = Instance.new("Folder")
		f.Name = "BentonRemotes"
		f.Parent = ReplicatedStorage
		remotes = f
	end
	for _, name in Net.Names do
		if not (remotes :: Folder):FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = remotes
		end
	end
	local state = ReplicatedStorage:FindFirstChild("BentonState")
	if not state then
		local f = Instance.new("Folder")
		f.Name = "BentonState"
		f.Parent = ReplicatedStorage
		state = f
	end
	for _, name in { "Rides", "Shows" } do
		if not (state :: Folder):FindFirstChild(name) then
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = state
		end
	end
	return state :: Folder
end

function Net.remote(name: string): RemoteEvent
	local remotes = ReplicatedStorage:WaitForChild("BentonRemotes")
	return remotes:WaitForChild(name) :: RemoteEvent
end

function Net.state(): Folder
	return ReplicatedStorage:WaitForChild("BentonState") :: Folder
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- Part-built visuals shared by server and client: hats, balloons, held
-- souvenirs, food, and the simple guest figures that ride along with
-- players and walk around the park. No uploaded assets are needed.

local Items = require(script.Parent.Items)

local Props = {}

local HALF_PI = math.pi / 2

export type Piece = {
	shape: string, -- block | ball | cyl | disc | wedge | ellipsoid | round
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	name: string?,
}

local function piece(shape: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Piece
	return { shape = shape, size = size, cf = cf, color = color, material = material, transparency = transparency }
end

-- A flat disc lying in the XZ plane (cylinder axis pointing up).
local function disc(diameter: number, thickness: number, cf: CFrame, color: Color3, material: Enum.Material?): Piece
	return piece("cyl", Vector3.new(thickness, diameter, diameter), cf * CFrame.Angles(0, 0, HALF_PI), color, material)
end

-- A disc standing up and facing forward (-Z), like a wheel seen from the side.
local function wheel(diameter: number, thickness: number, cf: CFrame, color: Color3): Piece
	return piece("cyl", Vector3.new(thickness, diameter, diameter), cf, color, Enum.Material.SmoothPlastic)
end

local function makePart(p: Piece): BasePart
	local part: BasePart
	if p.shape == "wedge" then
		part = Instance.new("WedgePart")
	else
		local block = Instance.new("Part")
		if p.shape == "ball" then
			block.Shape = Enum.PartType.Ball
		elseif p.shape == "cyl" then
			block.Shape = Enum.PartType.Cylinder
		end
		part = block
	end
	part.Name = p.name or "Piece"
	part.Size = p.size
	part.Color = p.color
	part.Material = p.material or Enum.Material.SmoothPlastic
	part.Transparency = p.transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if p.shape == "ellipsoid" or p.shape == "round" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = if p.shape == "ellipsoid" then Enum.MeshType.Sphere else Enum.MeshType.Head
		mesh.Parent = part
	end
	return part
end
Props.makePart = makePart

-- Assemble pieces into a model. The first piece becomes the root ("Handle"
-- for tools/accessories). Loose = unanchored + welded + massless.
local function assemble(pieces: { Piece }, rootName: string, loose: boolean, at: CFrame?): (BasePart, { BasePart })
	local base = at or CFrame.new()
	local parts: { BasePart } = {}
	local root: BasePart? = nil
	for i, p in pieces do
		local part = makePart(p)
		part.CFrame = base * p.cf
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		if loose then
			part.Anchored = false
			part.Massless = true
		else
			part.Anchored = true
		end
		if i == 1 then
			part.Name = rootName
			root = part
		elseif loose and root then
			local weld = Instance.new("Weld")
			weld.Part0 = root
			weld.Part1 = part
			weld.C0 = p.cf
			weld.Parent = part
		end
		table.insert(parts, part)
	end
	assert(root, "assemble needs at least one piece")
	for i = 2, #parts do
		parts[i].Parent = root
	end
	return root, parts
end
Props.assemble = assemble

---------------------------------------------------------------------------
-- Hats
---------------------------------------------------------------------------
local gold = Color3.fromRGB(240, 196, 64)

local function gearPieces(cf: CFrame, size: number, color: Color3): { Piece }
	local out = { wheel(size, size * 0.18, cf * CFrame.Angles(0, HALF_PI, 0), color) }
	for k = 0, 5 do
		local a = k * math.pi / 3
		table.insert(out, piece("block", Vector3.new(size * 0.22, size * 0.22, size * 0.16), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, size * 0.5, 0), color))
	end
	return out
end
Props.gearPieces = gearPieces

-- Returns pieces relative to the hat's root, and the root's offset above
-- the head's HatAttachment.
local function hatPieces(item: Items.Item): ({ Piece }, CFrame)
	local c1, c2 = item.colors[1], item.colors[2] or item.colors[1]
	local id = CFrame.new()
	if item.shape == "ears" then
		local p = {
			piece("block", Vector3.new(1.5, 0.22, 0.3), id, c1),
			wheel(1.05, 0.14, CFrame.new(-0.72, 0.55, 0) * CFrame.Angles(0, HALF_PI, 0), c1),
			wheel(1.05, 0.14, CFrame.new(0.72, 0.55, 0) * CFrame.Angles(0, HALF_PI, 0), c1),
		}
		for _, g in gearPieces(CFrame.new(0, 0.35, -0.2), 0.45, c2) do
			table.insert(p, g)
		end
		return p, CFrame.new(0, 0.05, 0)
	elseif item.shape == "cap" then
		return {
			piece("ellipsoid", Vector3.new(1.4, 0.9, 1.45), id, c1),
			piece("block", Vector3.new(1.15, 0.1, 0.75), CFrame.new(0, -0.18, -0.85) * CFrame.Angles(math.rad(-8), 0, 0), c1),
			wheel(0.42, 0.06, CFrame.new(0, 0.12, -0.66) * CFrame.Angles(math.rad(-25), HALF_PI, 0), c2),
			piece("ball", Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 0.45, 0), c2),
		}, CFrame.new(0, -0.15, 0.05)
	elseif item.shape == "hardhat" then
		return {
			piece("ellipsoid", Vector3.new(1.45, 1.05, 1.55), id, c1, Enum.Material.Plastic),
			disc(1.95, 0.1, CFrame.new(0, -0.3, -0.05), c1, Enum.Material.Plastic),
			piece("block", Vector3.new(0.22, 0.25, 1.5), CFrame.new(0, 0.42, 0), c1, Enum.Material.Plastic),
		}, CFrame.new(0, -0.1, 0)
	elseif item.shape == "cone" then
		return {
			disc(1.4, 0.18, id, c2),
			disc(1.0, 0.45, CFrame.new(0, 0.3, 0), c1),
			disc(0.78, 0.4, CFrame.new(0, 0.7, 0), c2),
			disc(0.56, 0.45, CFrame.new(0, 1.1, 0), c1),
			disc(0.32, 0.35, CFrame.new(0, 1.45, 0), c1),
		}, CFrame.new(0, 0.1, 0)
	elseif item.shape == "cowboy" then
		return {
			piece("round", Vector3.new(1.25, 0.85, 1.35), id, c1),
			disc(2.7, 0.08, CFrame.new(0, -0.35, 0), c1),
			disc(1.32, 0.18, CFrame.new(0, -0.2, 0), c2),
		}, CFrame.new(0, 0.2, 0)
	elseif item.shape == "beret" then
		return {
			piece("ellipsoid", Vector3.new(1.55, 0.45, 1.55), CFrame.Angles(0, 0, math.rad(-10)), c1),
			piece("block", Vector3.new(0.1, 0.22, 0.1), CFrame.new(0, 0.25, 0), c1),
			piece("block", Vector3.new(0.5, 0.06, 0.04), CFrame.new(0.3, 0.02, -0.74), c2),
		}, CFrame.new(0, 0, 0)
	elseif item.shape == "helmet" then
		return {
			piece("ellipsoid", Vector3.new(1.75, 1.75, 1.85), id, c1, Enum.Material.SmoothPlastic),
			piece("ellipsoid", Vector3.new(1.3, 0.6, 0.6), CFrame.new(0, -0.1, -0.68), c2, Enum.Material.Glass, 0.15),
			piece("block", Vector3.new(0.28, 0.06, 1.7), CFrame.new(0, 0.86, 0), Color3.fromRGB(250, 250, 250)),
		}, CFrame.new(0, -0.55, 0)
	elseif item.shape == "captain" then
		return {
			disc(1.35, 0.55, id, c1),
			disc(1.38, 0.16, CFrame.new(0, -0.18, 0), c2),
			piece("block", Vector3.new(1.05, 0.08, 0.6), CFrame.new(0, -0.3, -0.72) * CFrame.Angles(math.rad(-10), 0, 0), Color3.fromRGB(20, 20, 24)),
			wheel(0.3, 0.06, CFrame.new(0, 0.02, -0.7) * CFrame.Angles(0, HALF_PI, 0), gold),
		}, CFrame.new(0, 0.12, 0)
	elseif item.shape == "shades" then
		return {
			piece("block", Vector3.new(0.35, 0.08, 0.06), id, c1),
			piece("block", Vector3.new(0.48, 0.36, 0.06), CFrame.new(-0.42, 0, 0), c1),
			piece("block", Vector3.new(0.48, 0.36, 0.06), CFrame.new(0.42, 0, 0), c1),
			piece("block", Vector3.new(0.4, 0.28, 0.04), CFrame.new(-0.42, 0, -0.04), c2, Enum.Material.Glass),
			piece("block", Vector3.new(0.4, 0.28, 0.04), CFrame.new(0.42, 0, -0.04), c2, Enum.Material.Glass),
		}, CFrame.new(0, 0.15, -0.05)
	end
	return { piece("block", Vector3.new(1, 0.5, 1), id, c1) }, CFrame.new()
end

-- An Accessory a Humanoid can wear (Humanoid:AddAccessory).
function Props.accessory(item: Items.Item): Accessory
	local pieces, offset = hatPieces(item)
	local acc = Instance.new("Accessory")
	acc.Name = item.id
	local handle = assemble(pieces, "Handle", true)
	local att = Instance.new("Attachment")
	att.Name = if item.kind == "face" then "FaceFrontAttachment" else "HatAttachment"
	-- the attachment marks where the head attachment should line up
	att.CFrame = offset:Inverse()
	att.Parent = handle
	handle.Parent = acc
	return acc
end

-- Anchored hat model for previews and guest figures, placed at `at`
-- (which should be the HatAttachment world CFrame).
function Props.hatModel(item: Items.Item, at: CFrame): Model
	local pieces, offset = hatPieces(item)
	local model = Instance.new("Model")
	model.Name = item.id
	local root = assemble(pieces, "Root", false, at * offset)
	root.Parent = model
	model.PrimaryPart = root
	return model
end

---------------------------------------------------------------------------
-- Balloons
---------------------------------------------------------------------------
function Props.balloon(item: Items.Item): Model
	local c1, c2 = item.colors[1], item.colors[2] or item.colors[1]
	local pieces: { Piece } = {
		piece("ball", Vector3.new(2.6, 2.6, 2.6), CFrame.new(), c1, Enum.Material.SmoothPlastic),
		piece("ball", Vector3.new(0.35, 0.35, 0.35), CFrame.new(0, -1.35, 0), c1),
	}
	if item.shape == "globe" then
		table.insert(pieces, piece("ellipsoid", Vector3.new(1.2, 0.9, 0.5), CFrame.new(0.3, 0.3, -1.05), c2))
		table.insert(pieces, piece("ellipsoid", Vector3.new(0.9, 1.1, 0.5), CFrame.new(-0.6, -0.3, -0.95), c2))
		table.insert(pieces, piece("ellipsoid", Vector3.new(0.5, 1.2, 0.9), CFrame.new(1.05, -0.1, 0.4), c2))
	elseif item.shape == "duck" then
		table.insert(pieces, piece("ball", Vector3.new(1.5, 1.5, 1.5), CFrame.new(0, 1.5, -0.6), c1))
		table.insert(pieces, piece("ellipsoid", Vector3.new(0.7, 0.3, 0.7), CFrame.new(0, 1.4, -1.45), c2))
		table.insert(pieces, piece("ball", Vector3.new(0.25, 0.25, 0.25), CFrame.new(-0.4, 1.75, -1.2), Color3.fromRGB(20, 20, 20)))
		table.insert(pieces, piece("ball", Vector3.new(0.25, 0.25, 0.25), CFrame.new(0.4, 1.75, -1.2), Color3.fromRGB(20, 20, 20)))
	else
		for _, g in gearPieces(CFrame.new(0, 0, -1.25), 1.2, c2) do
			table.insert(pieces, g)
		end
	end
	local model = Instance.new("Model")
	model.Name = item.id
	local root = assemble(pieces, "Balloon", true)
	root.Massless = false
	root.Parent = model
	model.PrimaryPart = root
	local bottom = Instance.new("Attachment")
	bottom.Name = "StringAttachment"
	bottom.Position = Vector3.new(0, -1.5, 0)
	bottom.Parent = root
	return model
end

---------------------------------------------------------------------------
-- Held items and food (Tools)
---------------------------------------------------------------------------
local function heldPieces(item: Items.Item): { Piece }
	local c1, c2 = item.colors[1], item.colors[2] or item.colors[1]
	local id = CFrame.new()
	local s = item.shape
	if s == "wrench" then
		return {
			piece("block", Vector3.new(0.3, 0.3, 2.6), id, c1, Enum.Material.Metal),
			piece("block", Vector3.new(0.9, 0.3, 0.3), CFrame.new(0, 0, -1.3), c1, Enum.Material.Metal),
			piece("block", Vector3.new(0.25, 0.3, 0.55), CFrame.new(-0.35, 0, -1.6), c1, Enum.Material.Metal),
			piece("block", Vector3.new(0.25, 0.3, 0.55), CFrame.new(0.35, 0, -1.6), c1, Enum.Material.Metal),
			disc(0.7, 0.3, CFrame.new(0, 0, 1.35) * CFrame.Angles(HALF_PI, 0, 0), c1, Enum.Material.Metal),
		}
	elseif s == "toytruck" then
		return {
			piece("block", Vector3.new(0.6, 0.5, 1.6), id, c2),
			piece("block", Vector3.new(0.62, 0.65, 0.6), CFrame.new(0, 0.1, -1.0), c1),
			piece("block", Vector3.new(0.5, 0.25, 0.05), CFrame.new(0, 0.25, -1.31), Color3.fromRGB(150, 200, 230), Enum.Material.Glass),
			wheel(0.38, 0.1, CFrame.new(-0.33, -0.3, -0.9), Color3.fromRGB(20, 20, 20)),
			wheel(0.38, 0.1, CFrame.new(0.33, -0.3, -0.9), Color3.fromRGB(20, 20, 20)),
			wheel(0.38, 0.1, CFrame.new(-0.33, -0.3, 0.55), Color3.fromRGB(20, 20, 20)),
			wheel(0.38, 0.1, CFrame.new(0.33, -0.3, 0.55), Color3.fromRGB(20, 20, 20)),
		}
	elseif s == "lantern" then
		return {
			piece("block", Vector3.new(0.7, 0.12, 0.7), id, c1, Enum.Material.Metal),
			piece("block", Vector3.new(0.55, 0.8, 0.55), CFrame.new(0, 0.48, 0), c2, Enum.Material.Neon, 0.1),
			piece("block", Vector3.new(0.7, 0.12, 0.7), CFrame.new(0, 0.94, 0), c1, Enum.Material.Metal),
			piece("block", Vector3.new(0.08, 0.45, 0.08), CFrame.new(0, 1.2, 0), c1, Enum.Material.Metal),
		}
	elseif s == "clapper" then
		local p = {
			piece("block", Vector3.new(1.4, 1.0, 0.1), id, c1),
			piece("block", Vector3.new(1.4, 0.25, 0.1), CFrame.new(0, 0.66, 0) * CFrame.Angles(0, 0, math.rad(-12)), c2),
		}
		for k = 0, 3 do
			table.insert(p, piece("block", Vector3.new(0.16, 0.26, 0.12), CFrame.new(-0.5 + k * 0.34, 0.68 - k * 0.07, 0) * CFrame.Angles(0, 0, math.rad(-12)), c1))
		end
		return p
	elseif s == "flag" then
		local p = { piece("cyl", Vector3.new(3.2, 0.14, 0.14), CFrame.Angles(0, 0, HALF_PI), Color3.fromRGB(200, 200, 205), Enum.Material.Metal) }
		for row = 0, 2 do
			for col = 0, 3 do
				local color = if (row + col) % 2 == 0 then c1 else c2
				table.insert(p, piece("block", Vector3.new(0.05, 0.35, 0.35), CFrame.new(0, 1.35 - row * 0.35, -0.25 - col * 0.35), color, Enum.Material.Fabric))
			end
		end
		return p
	end
	-- food ---------------------------------------------------------------
	if s == "donut" then
		local p = { disc(1.0, 0.32, id, c1) }
		table.insert(p, disc(0.95, 0.1, CFrame.new(0, 0.18, 0), c2))
		table.insert(p, disc(0.35, 0.36, CFrame.new(0, 0.02, 0), Color3.fromRGB(245, 240, 230)))
		return p
	elseif s == "roll" then
		return {
			disc(1.1, 0.45, id, c1),
			disc(0.8, 0.1, CFrame.new(0, 0.26, 0), c2),
			disc(0.4, 0.12, CFrame.new(0, 0.3, 0), c1),
		}
	elseif s == "cup" then
		return {
			disc(0.65, 1.1, id, c1),
			disc(0.55, 0.06, CFrame.new(0, 0.5, 0), c2),
			disc(0.7, 0.08, CFrame.new(0, 0.58, 0), Color3.fromRGB(250, 250, 250)),
			piece("cyl", Vector3.new(0.6, 0.08, 0.08), CFrame.new(0.1, 0.85, 0) * CFrame.Angles(0, 0, math.rad(80)), Color3.fromRGB(230, 60, 60)),
		}
	elseif s == "hotdog" then
		return {
			piece("ellipsoid", Vector3.new(0.6, 0.4, 2.0), id, c1),
			piece("ellipsoid", Vector3.new(0.35, 0.35, 2.3), CFrame.new(0, 0.15, 0), c2),
			piece("block", Vector3.new(0.08, 0.05, 1.8), CFrame.new(0, 0.33, 0), Color3.fromRGB(250, 210, 40)),
		}
	elseif s == "pretzel" then
		return {
			disc(0.75, 0.2, CFrame.new(-0.3, 0, 0) * CFrame.Angles(HALF_PI, 0, 0), c1),
			disc(0.75, 0.2, CFrame.new(0.3, 0, 0) * CFrame.Angles(HALF_PI, 0, 0), c1),
			piece("block", Vector3.new(1.2, 0.18, 0.2), CFrame.new(0, -0.32, 0), c1),
		}
	elseif s == "shake" then
		return {
			disc(0.7, 1.2, id, c2, Enum.Material.Glass),
			disc(0.62, 1.0, CFrame.new(0, -0.05, 0), c1),
			piece("ball", Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, 0.7, 0), Color3.fromRGB(255, 250, 245)),
			piece("ball", Vector3.new(0.22, 0.22, 0.22), CFrame.new(0, 1.07, 0), Color3.fromRGB(200, 20, 40)),
		}
	elseif s == "platter" then
		return {
			disc(1.8, 0.1, id, c1),
			piece("ellipsoid", Vector3.new(0.9, 0.3, 0.7), CFrame.new(-0.2, 0.18, 0.1), c2),
			piece("block", Vector3.new(0.45, 0.25, 0.45), CFrame.new(0.5, 0.15, -0.3), Color3.fromRGB(240, 200, 90)),
			piece("ellipsoid", Vector3.new(0.5, 0.2, 0.5), CFrame.new(0.4, 0.12, 0.45), Color3.fromRGB(150, 70, 40)),
		}
	elseif s == "sandwich" then
		return {
			piece("ellipsoid", Vector3.new(1.2, 0.35, 1.2), id, c1),
			piece("block", Vector3.new(1.1, 0.2, 1.1), CFrame.new(0, 0.2, 0), c2),
			piece("ellipsoid", Vector3.new(1.2, 0.55, 1.2), CFrame.new(0, 0.42, 0), c1),
		}
	elseif s == "popcorn" then
		local p = { disc(0.9, 1.2, id, Color3.fromRGB(250, 250, 250)) }
		for k = 0, 3 do
			local a = k * HALF_PI
			table.insert(p, piece("block", Vector3.new(0.12, 1.21, 0.2), CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -0.41), c1))
		end
		for k = 0, 6 do
			local a = k * 0.9
			table.insert(p, piece("ball", Vector3.new(0.3, 0.3, 0.3), CFrame.new(math.cos(a) * 0.25, 0.65 + (k % 3) * 0.08, math.sin(a) * 0.25), c2))
		end
		return p
	elseif s == "taco" then
		return {
			piece("cyl", Vector3.new(0.5, 1.2, 1.2), CFrame.Angles(0, HALF_PI, 0), c1),
			piece("block", Vector3.new(0.35, 0.3, 1.0), CFrame.new(0, 0.4, 0), c2),
		}
	elseif s == "nachos" then
		local p = { piece("block", Vector3.new(1.4, 0.2, 1.0), id, Color3.fromRGB(250, 250, 250)) }
		for k = 0, 4 do
			table.insert(p, piece("wedge", Vector3.new(0.1, 0.4, 0.45), CFrame.new(-0.5 + k * 0.25, 0.25, (k % 2) * 0.2 - 0.1) * CFrame.Angles(0, k, 0.4), c1))
		end
		table.insert(p, piece("ellipsoid", Vector3.new(1.0, 0.15, 0.7), CFrame.new(0, 0.32, 0), c2))
		return p
	elseif s == "slice" then
		return {
			piece("wedge", Vector3.new(0.12, 1.6, 1.0), CFrame.Angles(HALF_PI, 0, 0) * CFrame.Angles(0, 0, HALF_PI), c1),
			disc(0.3, 0.06, CFrame.new(0, 0.08, -0.1), c2),
			disc(0.3, 0.06, CFrame.new(0.2, 0.08, 0.35), c2),
			disc(0.3, 0.06, CFrame.new(-0.15, 0.08, 0.5), c2),
		}
	elseif s == "knots" then
		local p = { disc(1.2, 0.08, id, Color3.fromRGB(250, 250, 250)) }
		for k = 0, 5 do
			local a = k * math.pi / 3
			table.insert(p, piece("ball", Vector3.new(0.38, 0.38, 0.38), CFrame.new(math.cos(a) * 0.35, 0.18, math.sin(a) * 0.35), c1))
		end
		return p
	elseif s == "burger" then
		return {
			disc(1.1, 0.25, id, c1),
			disc(1.15, 0.2, CFrame.new(0, 0.22, 0), c2),
			piece("block", Vector3.new(1.05, 0.06, 1.05), CFrame.new(0, 0.34, 0) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(250, 200, 40)),
			disc(1.15, 0.2, CFrame.new(0, 0.45, 0), c2),
			disc(1.2, 0.08, CFrame.new(0, 0.58, 0), Color3.fromRGB(90, 170, 60)),
			piece("ellipsoid", Vector3.new(1.15, 0.6, 1.15), CFrame.new(0, 0.78, 0), c1),
		}
	elseif s == "fries" then
		local p = { piece("block", Vector3.new(0.9, 0.6, 0.6), id, c1) }
		for k = 0, 6 do
			table.insert(p, piece("block", Vector3.new(0.12, 0.7, 0.12), CFrame.new(-0.33 + k * 0.11, 0.45 + (k % 2) * 0.1, (k % 3) * 0.12 - 0.12) * CFrame.Angles(0, 0, (k - 3) * 0.08), c2))
		end
		return p
	elseif s == "pass" then
		return {
			piece("block", Vector3.new(1.2, 0.05, 0.8), id, c1),
		}
	end
	return { piece("block", Vector3.new(0.8, 0.8, 0.8), id, c1) }
end

function Props.itemPieces(item: Items.Item): { Piece }
	if item.kind == "hat" or item.kind == "face" then
		local p = hatPieces(item)
		return p
	end
	return heldPieces(item)
end

-- A Tool with a Handle, for held souvenirs and food.
function Props.tool(item: Items.Item): Tool
	local tool = Instance.new("Tool")
	tool.Name = item.name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = item.description
	tool:SetAttribute("ItemId", item.id)
	local handle = assemble(heldPieces(item), "Handle", true)
	handle.Massless = false
	handle.Parent = tool
	if item.shape == "lantern" then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 200, 120)
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = handle
	end
	return tool
end

-- Anchored preview model of any item (for shop ViewportFrames).
function Props.preview(item: Items.Item): Model
	local model = Instance.new("Model")
	model.Name = item.id
	if item.kind == "balloon" then
		local b = Props.balloon(item)
		for _, d in b:GetDescendants() do
			if d:IsA("BasePart") then
				(d :: BasePart).Anchored = true
			end
		end
		b.Parent = model
		model.PrimaryPart = b.PrimaryPart
		return model
	end
	local root = assemble(Props.itemPieces(item), "Root", false)
	root.Parent = model
	model.PrimaryPart = root
	return model
end

---------------------------------------------------------------------------
-- Guest figures (no Humanoid; cheap anchored parts)
---------------------------------------------------------------------------
local SKIN = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(240, 190, 150),
	Color3.fromRGB(200, 140, 100),
	Color3.fromRGB(150, 100, 70),
	Color3.fromRGB(100, 66, 46),
	Color3.fromRGB(250, 205, 70), -- classic yellow
}
local SHIRTS = {
	Color3.fromRGB(196, 40, 40),
	Color3.fromRGB(30, 110, 230),
	Color3.fromRGB(255, 140, 26),
	Color3.fromRGB(64, 160, 72),
	Color3.fromRGB(240, 240, 240),
	Color3.fromRGB(150, 110, 200),
	Color3.fromRGB(250, 210, 40),
	Color3.fromRGB(40, 40, 46),
	Color3.fromRGB(240, 120, 170),
	Color3.fromRGB(60, 200, 200),
}
local PANTS = {
	Color3.fromRGB(40, 60, 110),
	Color3.fromRGB(30, 30, 34),
	Color3.fromRGB(110, 90, 70),
	Color3.fromRGB(70, 70, 76),
	Color3.fromRGB(180, 160, 120),
}
local GUEST_HATS = { "GearEars", "TruckerCap", "CowboyHat", "HardHat", "CaptainHat", "RacingHelmet" }

export type Uniform = { shirt: Color3, pants: Color3, cap: Color3? }

-- Build a guest figure. The root sits where a player's HumanoidRootPart
-- would be. pose = "sit" | "stand" | "cheer", and for staff also "check"
-- (reaching down to a lap bar), "operate" (hands on a console), "thumbs"
-- (thumbs up) and "wave". A uniform dresses the figure as park staff.
function Props.guest(seed: number, pose: string, uniform: Uniform?): Model
	local rng = Random.new(seed)
	local skin = SKIN[rng:NextInteger(1, #SKIN)]
	local shirt = SHIRTS[rng:NextInteger(1, #SHIRTS)]
	local pants = PANTS[rng:NextInteger(1, #PANTS)]
	local scale = rng:NextNumber(0.75, 1.0)
	if uniform then
		shirt, pants, scale = uniform.shirt, uniform.pants, 1
	end
	local pieces: { Piece } = {
		piece("block", Vector3.new(1.9, 1.9, 1) * scale, CFrame.new(0, 0, 0), shirt), -- torso / root
		piece("round", Vector3.new(1.15, 1.15, 1.15) * scale, CFrame.new(0, 1.55 * scale, 0), skin),
	}
	local armUp = pose == "cheer"
	for _, side in { -1, 1 } do
		local armCF = if armUp
			then CFrame.new(side * 1.45 * scale, 1.2 * scale, 0) * CFrame.Angles(0, 0, side * math.rad(-20))
			else CFrame.new(side * 1.45 * scale, -0.05 * scale, 0)
		-- staff poses swing the arms about the shoulder
		local swing = if pose == "check" then 65 elseif pose == "operate" then 45 else 0
		if pose == "thumbs" and side == 1 then
			swing = 150
		elseif pose == "wave" and side == 1 then
			swing = 0
			armCF = CFrame.new(side * 1.45 * scale, 1.2 * scale, 0) * CFrame.Angles(0, 0, math.rad(25))
		end
		if swing ~= 0 then
			armCF = CFrame.new(side * 1.45 * scale, 0.9 * scale, 0) * CFrame.Angles(math.rad(swing), 0, 0) * CFrame.new(0, -0.95 * scale, 0)
		end
		table.insert(pieces, piece("block", Vector3.new(0.9, 1.9, 0.9) * scale, armCF, shirt))
		if pose == "sit" then
			table.insert(pieces, piece("block", Vector3.new(0.9, 0.9, 1.9) * scale, CFrame.new(side * 0.48 * scale, -1.4 * scale, -0.5 * scale), pants))
			table.insert(pieces, piece("block", Vector3.new(0.9, 1.4, 0.9) * scale, CFrame.new(side * 0.48 * scale, -2.0 * scale, -1.0 * scale), pants))
		else
			table.insert(pieces, piece("block", Vector3.new(0.9, 1.9, 0.9) * scale, CFrame.new(side * 0.48 * scale, -1.9 * scale, 0), pants))
		end
	end
	-- eyes
	table.insert(pieces, piece("block", Vector3.new(0.14, 0.2, 0.05) * scale, CFrame.new(-0.22 * scale, 1.62 * scale, -0.56 * scale), Color3.fromRGB(20, 20, 20)))
	table.insert(pieces, piece("block", Vector3.new(0.14, 0.2, 0.05) * scale, CFrame.new(0.22 * scale, 1.62 * scale, -0.56 * scale), Color3.fromRGB(20, 20, 20)))
	if uniform then
		-- name badge and a cap
		table.insert(pieces, piece("block", Vector3.new(0.45, 0.25, 0.06), CFrame.new(-0.45, 0.5, -0.52), Color3.fromRGB(245, 245, 240)))
		if uniform.cap then
			table.insert(pieces, piece("round", Vector3.new(1.25, 0.55, 1.25), CFrame.new(0, 2.0, 0), uniform.cap))
			table.insert(pieces, piece("block", Vector3.new(1.0, 0.1, 0.6), CFrame.new(0, 1.9, -0.75), uniform.cap))
		end
	end
	local model = Instance.new("Model")
	model.Name = if uniform then "Staff" else "Guest"
	local root, parts = assemble(pieces, "Root", false)
	root.Parent = model
	model.PrimaryPart = root
	for _, p in parts do
		p.CastShadow = false
	end
	if not uniform and rng:NextNumber() < 0.35 then
		local hat = Items.ById[GUEST_HATS[rng:NextInteger(1, #GUEST_HATS)]]
		local hatModel = Props.hatModel(hat, CFrame.new(0, 2.1 * scale, 0))
		hatModel.Parent = model
	end
	return model
end

-- Distance from a standing figure's root down to its feet.
Props.STAND_HEIGHT = 2.85

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">QueueLine</string>
          <string name="Source"><![CDATA[--!strict
-- Physical queue lines. Every ride has a switchback queue maze near its
-- entrance sign. Guests stand along one path in queue order: the front of
-- the line is the boarding gate (distance 0) and the path runs back through
-- the switchbacks, out under the entrance sign and, if the line ever gets
-- that long, out onto the walkway.
--
-- Shared by the park builder (rails and floors), the server (who is in
-- line, stepping out of line) and the client (guests standing in line).

local Config = require(script.Parent.Config)

local QueueLine = {}

QueueLine.LANE = 4 -- lane width between rails (studs)
QueueLine.SPACING = 2.5 -- distance between guests standing in line
QueueLine.OVERFLOW = 60 -- extra path past the sign for very long lines

-- Maze placement for each ride, found by searching the park for clear
-- ground near each entrance (rows run along the maze's local X axis).
export type Layout = {
	center: Vector3,
	yaw: number, -- degrees
	width: number, -- length of each row, rail to rail
	lanes: number, -- number of rows
	mirror: boolean,
	entry: string, -- "side" or "back": where the path leaves the maze
	corner: Vector3?, -- bend in the walkway between the maze and the sign
}

local V = Vector3.new

QueueLine.LAYOUTS = {
	DieselThunder = { center = V(-258, 0, -42), yaw = 180, width = 28, lanes = 4, mirror = false, entry = "side" },
	PistonPounder = { center = V(-172, 0, 62), yaw = 180, width = 20, lanes = 4, mirror = true, entry = "side", corner = V(-145.27, 0, 56) },
	TruckTrek = { center = V(-207, 0, 250), yaw = 180, width = 36, lanes = 2, mirror = false, entry = "back" },
	BackwoodsRapids = { center = V(-294, 0, -214), yaw = 90, width = 20, lanes = 2, mirror = false, entry = "back" },
	RunawayTowTruck = { center = V(-114, 0, -236), yaw = 180, width = 24, lanes = 4, mirror = false, entry = "side" },
	BacklotTram = { center = V(36, 0, -298), yaw = 270, width = 24, lanes = 4, mirror = true, entry = "back" },
	VelocityViper = { center = V(252, 0, -216), yaw = 270, width = 24, lanes = 4, mirror = true, entry = "back" },
	NitroLoop = { center = V(228, 0, -140), yaw = 90, width = 32, lanes = 4, mirror = true, entry = "side", corner = V(234, 0, -113.62) },
	TowerDrop = { center = V(178, 0, -228), yaw = 180, width = 36, lanes = 2, mirror = false, entry = "side" },
	VelocitySpeedway = { center = V(232, 0, -68), yaw = 0, width = 20, lanes = 3, mirror = false, entry = "side" },
	LakesideExpress = { center = V(268, 0, 224), yaw = 270, width = 36, lanes = 2, mirror = false, entry = "side" },
	GearwheelCarousel = { center = V(122, 0, 206), yaw = 270, width = 36, lanes = 2, mirror = false, entry = "side" },
	SpinningPistons = { center = V(168, 0, 164), yaw = 270, width = 20, lanes = 6, mirror = true, entry = "back", corner = V(154.5, 0, 148.01) },
} :: { [string]: Layout }

export type Line = {
	ride: string,
	points: { Vector3 }, -- gate -> back of the line (y = 0)
	cum: { number }, -- distance along the path at each point
	length: number, -- total path length (including overflow)
	signAt: number, -- distance from the gate to the entrance sign
	mazeCFrame: CFrame,
	mazeSize: Vector3, -- width x 0 x depth
	walls: { { Vector3 } }, -- rail runs {a, b}
	walkway: { Vector3 }, -- maze entry -> just inside the sign (railed both sides)
	gate: Vector3, -- front of the line
	gateDir: Vector3, -- direction the front guest faces (toward the station)
	entrance: Vector3,
	outward: Vector3, -- direction from the ride out through the sign
}

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-6 then f.Unit else Vector3.new(0, 0, 1)
end

-- Path and rails in maze-local coordinates (x along the rows).
local function localPath(width: number, lanes: number, entry: string): { Vector2 }
	local lane = QueueLine.LANE
	local depth = lanes * lane
	local xa, xb = -width / 2 + lane / 2, width / 2 - lane / 2
	local pts = { Vector2.new(width / 2 + 1, -depth / 2 + lane / 2) }
	for i = 0, lanes - 1 do
		local z = -depth / 2 + lane / 2 + i * lane
		local a, b = xb, xa
		if i % 2 == 1 then
			a, b = xa, xb
		end
		table.insert(pts, Vector2.new(a, z))
		table.insert(pts, Vector2.new(b, z))
	end
	local last = pts[#pts]
	if entry == "side" then
		table.insert(pts, Vector2.new(if last.X < 0 then -width / 2 - 1.5 else width / 2 + 1.5, last.Y))
	else
		table.insert(pts, Vector2.new(last.X, depth / 2 + 1.5))
	end
	local out = { pts[1] }
	for i = 2, #pts do
		if (pts[i] - out[#out]).Magnitude > 1e-6 then
			table.insert(out, pts[i])
		end
	end
	return out
end

local function localWalls(width: number, lanes: number, entry: string): { { Vector2 } }
	local lane = QueueLine.LANE
	local hw, hd = width / 2, lanes * lane / 2
	local walls: { { Vector2 } } = {}
	local function add(ax: number, az: number, bx: number, bz: number)
		table.insert(walls, { Vector2.new(ax, az), Vector2.new(bx, bz) })
	end
	-- separators between rows, open at the end where the path turns
	for i = 0, lanes - 2 do
		local z = -hd + lane * (i + 1)
		if i % 2 == 0 then
			add(-hw + lane, z, hw, z)
		else
			add(-hw, z, hw - lane, z)
		end
	end
	add(-hw, -hd, hw, -hd) -- front
	local endsLeft = (lanes - 1) % 2 == 0
	if entry == "back" then
		if endsLeft then
			add(-hw + lane, hd, hw, hd)
		else
			add(-hw, hd, hw - lane, hd)
		end
	else
		add(-hw, hd, hw, hd)
	end
	if entry == "side" and endsLeft then
		add(-hw, -hd, -hw, hd - lane)
	else
		add(-hw, -hd, -hw, hd)
	end
	-- right side: the boarding gate opens from the first row
	if entry == "side" and not endsLeft then
		add(hw, -hd + lane, hw, hd - lane)
	else
		add(hw, -hd + lane, hw, hd)
	end
	local out = {}
	for _, w in walls do
		if (w[2] - w[1]).Magnitude > 0.01 then
			table.insert(out, w)
		end
	end
	return out
end

local cache: { [string]: Line } = {}

function QueueLine.get(rideId: string): Line?
	local hit = cache[rideId]
	if hit then
		return hit
	end
	local layout = QueueLine.LAYOUTS[rideId]
	local found: Config.Ride? = nil
	for _, r in Config.Rides do
		if r.id == rideId then
			found = r
		end
	end
	if not layout or not found then
		return nil
	end
	local ride = found :: Config.Ride
	local mazeCF = CFrame.new(layout.center.X, 0, layout.center.Z) * CFrame.Angles(0, math.rad(layout.yaw), 0)
	local sx = if layout.mirror then -1 else 1
	local function toWorld(p: Vector2): Vector3
		local w = mazeCF * Vector3.new(p.X * sx, 0, p.Y)
		return Vector3.new(w.X, 0, w.Z)
	end
	local points: { Vector3 } = {}
	for _, p in localPath(layout.width, layout.lanes, layout.entry) do
		table.insert(points, toWorld(p))
	end
	local outward = flat(ride.entrance - ride.origin)
	local sign = Vector3.new(ride.entrance.X, 0, ride.entrance.Z)
	local inside = sign - outward * 4
	-- the walkway starts at the gap in the maze rail, 1.5 studs back
	local entryPt = points[#points]
	local walkway = { entryPt + flat(points[#points - 1] - entryPt) * 1.5, entryPt }
	local corner = layout.corner
	if corner then
		local c = Vector3.new(corner.X, 0, corner.Z)
		table.insert(points, c)
		table.insert(walkway, c)
	end
	table.insert(points, inside)
	table.insert(walkway, inside)
	local signIndex = #points + 1
	table.insert(points, sign)
	table.insert(points, sign + outward * QueueLine.OVERFLOW)
	local cum = { 0 }
	for i = 2, #points do
		cum[i] = cum[i - 1] + (points[i] - points[i - 1]).Magnitude
	end
	local walls = {}
	for _, w in localWalls(layout.width, layout.lanes, layout.entry) do
		table.insert(walls, { toWorld(w[1]), toWorld(w[2]) })
	end
	local line: Line = {
		ride = rideId,
		points = points,
		cum = cum,
		length = cum[#cum],
		signAt = cum[signIndex],
		mazeCFrame = mazeCF,
		mazeSize = Vector3.new(layout.width, 0, layout.lanes * QueueLine.LANE),
		walls = walls,
		walkway = walkway,
		gate = points[1],
		gateDir = flat(points[1] - points[2]),
		entrance = sign,
		outward = outward,
	}
	cache[rideId] = line
	return line
end

-- Position on the path `s` studs back from the gate, and the direction a
-- guest standing there faces (toward the front of the line).
function QueueLine.pointAt(line: Line, s: number): (Vector3, Vector3)
	local pts, cum = line.points, line.cum
	s = math.clamp(s, 0, line.length)
	for i = 2, #pts do
		if s <= cum[i] or i == #pts then
			local seg = cum[i] - cum[i - 1]
			local u = if seg > 0 then (s - cum[i - 1]) / seg else 0
			local a, b = pts[i - 1], pts[i]
			return a:Lerp(b, math.clamp(u, 0, 1)), flat(a - b)
		end
	end
	return pts[1], line.gateDir
end

-- Closest point on the path to `pos`: distance along the path and how far
-- away (flat) the position is.
function QueueLine.project(line: Line, pos: Vector3): (number, number)
	local p = Vector3.new(pos.X, 0, pos.Z)
	local bestS, bestD = 0, math.huge
	local pts, cum = line.points, line.cum
	for i = 2, #pts do
		local a, b = pts[i - 1], pts[i]
		local ab = b - a
		local len2 = ab:Dot(ab)
		local u = if len2 > 0 then math.clamp((p - a):Dot(ab) / len2, 0, 1) else 0
		local q = a + ab * u
		local d = (p - q).Magnitude
		if d < bestD then
			bestD = d
			bestS = cum[i - 1] + (cum[i] - cum[i - 1]) * u
		end
	end
	return bestS, bestD
end

-- Distance along the path where the guest at queue index `index`
-- (1 = next to board) stands.
function QueueLine.slot(index: number): number
	return (index - 1) * QueueLine.SPACING
end

-- How many guests fit between the gate and the entrance sign.
function QueueLine.capacity(line: Line): number
	return math.floor(line.signAt / QueueLine.SPACING) + 1
end

return QueueLine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">RideMotion</string>
          <string name="Source"><![CDATA[-- Deterministic ride motion. Given a ride and the seconds since dispatch,
-- returns the world CFrame of every car (and of moving scenery such as a
-- carousel platform or a pendulum arm). The server uses it for seat
-- positions and cycle length; every client uses it to animate the ride
-- smoothly in sync with server time.

local Config = require(script.Parent.Config)
local Track = require(script.Parent.Track)
local Layouts = require(script.Parent.Layouts)

type Ride = Config.Ride

export type Motion = {
	ride: Ride,
	duration: number,
	carCount: number,
	seats: { { CFrame } }, -- seats[car][n] = rider root CFrame in car space
	capacity: number,
	originCF: CFrame,
	sampler: Track.Sampler?,
	timing: Track.Timing?,
	extras: { string },
	pose: (t: number) -> ({ CFrame }, { [string]: CFrame }),
}

local RideMotion = {}

local TAU = math.pi * 2

local function smoothstep(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Angle swept by something that ramps up to `omega`, holds, and ramps down.
local function rampAngle(t: number, T: number, ramp: number, omega: number): number
	if t <= 0 then
		return 0
	end
	local total = omega * (T - ramp)
	if t >= T then
		return total
	elseif t < ramp then
		return 0.5 * omega / ramp * t * t
	elseif t < T - ramp then
		return 0.5 * omega * ramp + omega * (t - ramp)
	end
	local r = T - t
	return total - 0.5 * omega / ramp * r * r
end

RideMotion.rampAngle = rampAngle

-- Seat layouts (rider HumanoidRootPart targets) per vehicle style.
local SeatStyles: { [string]: { CFrame } } = {
	coaster = {
		CFrame.new(-1.25, 2.1, -1.3),
		CFrame.new(1.25, 2.1, -1.3),
		CFrame.new(-1.25, 2.1, 1.5),
		CFrame.new(1.25, 2.1, 1.5),
	},
	mine = {
		CFrame.new(-1.2, 2.1, -1.3),
		CFrame.new(1.2, 2.1, -1.3),
		CFrame.new(-1.2, 2.1, 1.5),
		CFrame.new(1.2, 2.1, 1.5),
	},
	log = {
		CFrame.new(0, 1.9, -3),
		CFrame.new(0, 1.9, -1),
		CFrame.new(0, 1.9, 1),
		CFrame.new(0, 1.9, 3),
	},
	coach = {
		CFrame.new(-1.4, 3.3, -2.4),
		CFrame.new(1.4, 3.3, -2.4),
		CFrame.new(-1.4, 3.3, 2.2),
		CFrame.new(1.4, 3.3, 2.2),
	},
	tram = {
		CFrame.new(-1.5, 3.1, -3.6),
		CFrame.new(1.5, 3.1, -3.6),
		CFrame.new(-1.5, 3.1, 0),
		CFrame.new(1.5, 3.1, 0),
		CFrame.new(-1.5, 3.1, 3.6),
		CFrame.new(1.5, 3.1, 3.6),
	},
	truck = {
		CFrame.new(-0.9, 2.4, -1.6),
		CFrame.new(0.9, 2.4, -1.6),
	},
	kart = {
		CFrame.new(0, 1.7, 0.4),
	},
}

local function ring(count: number, radius: number, height: number, inward: boolean?): { CFrame }
	local out = {}
	for k = 0, count - 1 do
		local a = TAU * k / count
		if inward then
			table.insert(out, CFrame.Angles(0, a, 0) * CFrame.new(0, height, radius))
		else
			table.insert(out, CFrame.Angles(0, a, 0) * CFrame.new(0, height, -radius))
		end
	end
	return out
end

local function originOf(ride: Ride): CFrame
	return CFrame.new(ride.origin) * CFrame.Angles(0, math.rad(ride.yaw), 0)
end

local function trackMotion(ride: Ride): Motion
	local layoutFn = (Layouts :: any)[ride.layout :: string] :: (() -> Layouts.Layout)?
	assert(layoutFn, "missing layout for " .. ride.id)
	local layout = layoutFn()
	local originCF = originOf(ride)
	local sampler = Track.new(Track.transform(layout.points, originCF), layout.spacing)
	local timing = Track.timing(sampler, {
		zones = layout.zones,
		gravity = layout.gravity,
		drag = layout.drag,
		minSpeed = layout.minSpeed,
	})
	local cars = ride.cars or 1
	local spacing = ride.carSpacing or 8
	local style = SeatStyles[ride.carStyle or "coaster"] or SeatStyles.coaster
	local seats = {}
	local capacity = 0
	for i = 1, cars do
		if i == 1 and ride.firstCarSeats == 0 then
			seats[i] = {}
		else
			seats[i] = style
			capacity += #style
		end
	end

	local pose: (t: number) -> ({ CFrame }, { [string]: CFrame })
	local duration: number
	if ride.kind == "karts" then
		duration = ride.duration or 34
		local L = sampler.length
		local rng = Random.new(42)
		local amp, freq, phase = {}, {}, {}
		for i = 1, cars do
			amp[i] = rng:NextNumber(5, 15)
			freq[i] = rng:NextInteger(1, 3)
			phase[i] = rng:NextNumber(0, TAU)
		end
		pose = function(t: number): ({ CFrame }, { [string]: CFrame })
			local u = math.clamp(t / duration, 0, 1)
			local base = 2 * L * (u - math.sin(TAU * u) / TAU)
			local env = math.sin(math.pi * u) ^ 2
			local out: { CFrame } = {}
			for i = 1, cars do
				local s = -(i - 1) * spacing + base + amp[i] * env * math.sin(TAU * freq[i] * u + phase[i]) - amp[i] * env * math.sin(phase[i])
				local lane = (if i % 2 == 0 then 3 else -3) + 1.2 * env * math.sin(TAU * 3 * u + i)
				out[i] = sampler:cframeAt(s) * CFrame.new(lane, 0, 0)
			end
			return out, {}
		end
	else
		duration = timing.duration
		pose = function(t: number): ({ CFrame }, { [string]: CFrame })
			local s = timing:distanceAt(t)
			local out: { CFrame } = {}
			for i = 1, cars do
				out[i] = sampler:cframeAt(s - (i - 1) * spacing)
			end
			return out, {}
		end
	end

	return {
		ride = ride,
		duration = duration,
		carCount = cars,
		seats = seats,
		capacity = capacity,
		originCF = originCF,
		sampler = sampler,
		timing = timing,
		extras = {},
		pose = pose,
	}
end

local function dropTowerMotion(ride: Ride): Motion
	local originCF = originOf(ride)
	local T = ride.duration or 46
	local H = 150
	local g = 45
	local fallTo = 60
	local tFall = math.sqrt(2 * (H - fallTo) / g)
	local vFall = g * tFall
	local brakeDist = fallTo - 3
	local decel = vFall * vFall / (2 * brakeDist)
	local tBrake = vFall / decel
	local tTop, tHold = 30, 34
	local tLand = tHold + tFall + tBrake
	local function height(t: number): number
		if t < 3 then
			return 0
		elseif t < tTop then
			return H * smoothstep((t - 3) / (tTop - 3))
		elseif t < tHold then
			return H
		elseif t < tHold + tFall then
			local tau = t - tHold
			return H - 0.5 * g * tau * tau
		elseif t < tLand then
			local tau = t - tHold - tFall
			return fallTo - (vFall * tau - 0.5 * decel * tau * tau)
		elseif t < tLand + 3 then
			return 3 * (1 - smoothstep((t - tLand) / 3))
		end
		return 0
	end
	local seats = { ring(12, 8.6, 1.6) }
	return {
		ride = ride,
		duration = T,
		carCount = 1,
		seats = seats,
		capacity = 12,
		originCF = originCF,
		extras = {},
		pose = function(t: number): ({ CFrame }, { [string]: CFrame })
			local rot = TAU * smoothstep((t - 3) / (tTop - 3))
			return { originCF * CFrame.new(0, 4 + height(t), 0) * CFrame.Angles(0, rot, 0) }, {}
		end,
	}
end

local function carouselMotion(ride: Ride): Motion
	local originCF = originOf(ride)
	local T = ride.duration or 48
	local ramp = 6
	local omega = TAU * 3 / (T - ramp) -- exactly three turns per cycle
	local count = 12
	local seats = {}
	for i = 1, count do
		seats[i] = { CFrame.new(0, 2.2, 0.3) }
	end
	return {
		ride = ride,
		duration = T,
		carCount = count,
		seats = seats,
		capacity = count,
		originCF = originCF,
		extras = { "Platform" },
		pose = function(t: number): ({ CFrame }, { [string]: CFrame })
			local theta = rampAngle(t, T, ramp, omega)
			local out: { CFrame } = {}
			for i = 1, count do
				local phi = TAU * (i - 1) / count
				local bob = 1.1 * math.sin(3 * theta + i * 1.7)
				local r = if i % 2 == 0 then 10 else 14
				out[i] = originCF * CFrame.Angles(0, theta + phi, 0) * CFrame.new(r, 4.6 + bob, 0)
			end
			return out, { Platform = originCF * CFrame.Angles(0, theta, 0) }
		end,
	}
end

local function spinnerMotion(ride: Ride): Motion
	local originCF = originOf(ride)
	local T = ride.duration or 44
	local ramp = 5
	local omegaP = TAU * 2 / (T - ramp)
	local omegaC = TAU * 9 / (T - ramp)
	local count = 6
	local seats = {}
	for i = 1, count do
		seats[i] = ring(3, 2.3, 1.9, true)
	end
	return {
		ride = ride,
		duration = T,
		carCount = count,
		seats = seats,
		capacity = count * 3,
		originCF = originCF,
		extras = { "Platform" },
		pose = function(t: number): ({ CFrame }, { [string]: CFrame })
			local theta = rampAngle(t, T, ramp, omegaP)
			local spin = rampAngle(t, T, ramp, omegaC)
			local out: { CFrame } = {}
			for i = 1, count do
				local phi = TAU * (i - 1) / count
				local dir = if i % 2 == 0 then 1 else -1
				out[i] = originCF * CFrame.Angles(0, theta + phi, 0) * CFrame.new(11, 2, 0) * CFrame.Angles(0, spin * dir, 0)
			end
			return out, { Platform = originCF * CFrame.Angles(0, theta, 0) }
		end,
	}
end

local function pendulumMotion(ride: Ride): Motion
	local originCF = originOf(ride)
	local T = ride.duration or 46
	local pivotCF = originCF * CFrame.new(0, 34, 0)
	local period = 6.4
	local maxA = math.rad(115)
	local spinOmega = TAU * 3 / (T - 2 - 6)
	return {
		ride = ride,
		duration = T,
		carCount = 1,
		seats = { ring(12, 5, 1.6) },
		capacity = 12,
		originCF = originCF,
		extras = { "Arm" },
		pose = function(t: number): ({ CFrame }, { [string]: CFrame })
			local env
			if t < 2 then
				env = 0
			elseif t < 20 then
				env = (t - 2) / 18
			elseif t < 34 then
				env = 1
			elseif t < 44 then
				env = 1 - (t - 34) / 10
			else
				env = 0
			end
			local phi = maxA * env * math.sin(TAU * math.max(t - 2, 0) / period)
			local spin = rampAngle(t - 2, T - 2, 6, spinOmega)
			local arm = pivotCF * CFrame.Angles(0, 0, phi)
			return { arm * CFrame.new(0, -28, 0) * CFrame.Angles(0, spin, 0) }, { Arm = arm }
		end,
	}
end

local cache: { [string]: Motion } = {}

function RideMotion.get(rideId: string): Motion
	local cached = cache[rideId]
	if cached then
		return cached
	end
	local ride = Config.RideById[rideId]
	assert(ride, "unknown ride " .. rideId)
	local motion: Motion
	if ride.kind == "droptower" then
		motion = dropTowerMotion(ride)
	elseif ride.kind == "carousel" then
		motion = carouselMotion(ride)
	elseif ride.kind == "spinner" then
		motion = spinnerMotion(ride)
	elseif ride.kind == "pendulum" then
		motion = pendulumMotion(ride)
	else
		motion = trackMotion(ride)
	end
	cache[rideId] = motion
	return motion
end

-- Flattened seat list: { {car, seatIndex}, ... } in boarding order.
function RideMotion.seatList(motion: Motion): { { number } }
	local out = {}
	for car = 1, motion.carCount do
		for s = 1, #motion.seats[car] do
			table.insert(out, { car, s })
		end
	end
	return out
end

return RideMotion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--!strict
-- Sounds for the Roblox version.
--
-- Roblox plays audio from asset ids. The rbxasset:// sounds below ship with
-- every Roblox client, so they always work. The empty slots are for music
-- and ride sounds: paste the id of an audio asset you own, or a public one
-- from the Creator Store (Audio), as "rbxassetid://123456" and it plays in
-- that spot. Empty slots stay silent. (The browser edition synthesizes all
-- of its own music and sounds and doesn't use this file.)

local Sounds = {}

-- Background music for each land; crossfades as you walk between lands.
Sounds.Music = {
	Plaza = "", -- a sunny Main Street rag
	Diesel = "", -- garage blues / rock
	Haulers = "", -- playful toy-box tune
	Backwoods = "", -- bluegrass banjo
	Studios = "", -- big-band swing
	Velocity = "", -- synthwave / racing
	Family = "", -- gentle lakeside waltz
} :: { [string]: string }
Sounds.MusicVolume = 0.3

-- Music played at the show venue while each show runs.
Sounds.Shows = {
	BigDreams = "",
	StuntSpectacular = "",
	BigRigParade = "",
	BentonNights = "",
} :: { [string]: string }

-- Looped on the lead vehicle while a ride runs, by ride kind.
Sounds.Rides = {
	coaster = "",
	flume = "",
	train = "",
	tram = "",
	trucks = "",
	karts = "",
	droptower = "",
	carousel = "", -- band organ music
	spinner = "",
	pendulum = "",
} :: { [string]: string }

-- Riders screaming on big drops.
Sounds.Screams = ""

-- Short cues (built into the Roblox client).
Sounds.Cues = {
	Click = "rbxasset://sounds/clickfast.wav",
	Info = "rbxasset://sounds/electronicpingshort.wav",
	Reward = "rbxasset://sounds/electronicpingshort.wav",
	Warn = "rbxasset://sounds/clickfast.wav",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Launch = "rbxasset://sounds/Rocket whoosh 01.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
} :: { [string]: string }

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Staff</string>
          <string name="Source"><![CDATA[--!strict
-- Park staff. Every ride has a crew: an operator at the control console
-- and one or two attendants who walk the loading platform during boarding,
-- checking every lap bar, harness or seatbelt before giving the operator a
-- thumbs up to dispatch. This module works out where they stand (shared by
-- the park builder, the Roblox client and the browser export), what kind of
-- restraint each ride has, the staff uniform and what the staff say.

local Config = require(script.Parent.Config)
local RideMotion = require(script.Parent.RideMotion)
local QueueLine = require(script.Parent.QueueLine)
local Props = require(script.Parent.Props)

local Staff = {}

-- Boarding timeline (seconds after the riders sit down; Config.BoardingTime
-- is the whole boarding window)
Staff.PULL_BY = 3.5 -- riders pull their own restraints down by now
Staff.CHECK_FROM = 2.5 -- attendants start walking the train
Staff.ALL_CLEAR = 1.6 -- seconds before dispatch: thumbs up to the operator
Staff.DISPATCH = 0.6 -- seconds before dispatch: the operator presses the button
Staff.WALK = 7 -- attendant walking speed (studs/s)
Staff.CHECK_TIME = 0.55 -- seconds spent at each car

export type Crew = {
	ride: string,
	restraint: string, -- "lapbar" | "harness" | "belt" | "none"
	console: CFrame, -- the control console (base center, facing the operator)
	operator: CFrame, -- where the operator stands (feet), facing the console
	stops: { CFrame }, -- where an attendant stands to check each car (feet, facing it)
	stopCars: { number }, -- which car each stop checks
	homes: { CFrame }, -- where attendants wait while the ride runs
	exit: CFrame, -- an attendant at the exit side waving riders off
	attendants: number,
}

local RESTRAINT = {
	coaster = "lapbar",
	spinner = "lapbar",
	droptower = "harness",
	pendulum = "harness",
	trucks = "belt",
	karts = "belt",
}

function Staff.restraint(ride: Config.Ride): string
	return RESTRAINT[ride.kind] or "none"
end

-- floor height and rim radius of each flat ride's loading area
type FlatSpec = { floor: number, rim: number }
local FLAT: { [string]: FlatSpec } = {
	carousel = { floor = 2.2, rim = 20 },
	spinner = { floor = 2.0, rim = 24 },
	pendulum = { floor = 4.6, rim = 10 },
	droptower = { floor = 2.4, rim = 12 },
}
Staff.FLAT = FLAT

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-6 then f.Unit else Vector3.new(0, 0, -1)
end

local function facing(p: Vector3, toward: Vector3): CFrame
	local d = flat(toward - p)
	return CFrame.lookAt(p, p + d)
end

-- Station platform frame shared with the ride builder's station().
export type StationFrame = { frame: CFrame, length: number, platformTop: number, halfGap: number }

function Staff.stationFrame(ride: Config.Ride, rest: { CFrame }): StationFrame
	local first, last = rest[1], rest[#rest]
	local trackY = first.Y
	local dir = flat(first.Position - last.Position)
	if #rest == 1 then
		dir = flat(first.LookVector)
	end
	local center = (first.Position + last.Position) / 2
	local length = (first.Position - last.Position).Magnitude + 12
	local frame = CFrame.lookAt(Vector3.new(center.X, 0, center.Z), Vector3.new(center.X, 0, center.Z) + dir)
	local platformTop = math.max(1.2, trackY + (if ride.kind == "train" then -0.4 elseif ride.kind == "tram" then 0.6 else 0.6))
	local halfGap = if ride.kind == "train" or ride.kind == "tram" then 5.2 else 4.6
	return { frame = frame, length = length, platformTop = platformTop, halfGap = halfGap }
end

local cache: { [string]: Crew } = {}

function Staff.crew(rideId: string): Crew?
	if cache[rideId] then
		return cache[rideId]
	end
	local ride: Config.Ride? = nil
	for _, r in Config.Rides do
		if r.id == rideId then
			ride = r
		end
	end
	if not ride then
		return nil
	end
	local found = ride :: Config.Ride
	local motion = RideMotion.get(found.id)
	local rest = motion.pose(0)
	local line = QueueLine.get(found.id)
	local gate = if line then line.gate else found.entrance
	local crew: Crew
	if motion.sampler then
		-- track rides: along the loading platform beside the train
		local sf = Staff.stationFrame(found, rest)
		local frame, length = sf.frame, sf.length
		local floor = sf.platformTop
		local edge = sf.halfGap
		if found.kind == "karts" or found.kind == "trucks" then
			-- no station: the crew stands beside the cars on the road edge
			local drop = if found.kind == "karts" then 0.5 else 1.35
			local width = if found.kind == "karts" then 15 else 8
			floor = math.max(0.05, rest[1].Y - drop + 0.5)
			edge = width / 2 + 0.8
		end
		local localGate = frame:PointToObjectSpace(gate)
		local side = if localGate.X < 0 then -1 else 1
		local stops, stopCars = {}, {}
		for i, cf in rest do
			if #(motion.seats[i] or {}) > 0 then
				local z = frame:PointToObjectSpace(cf.Position).Z
				local p = (frame * CFrame.new(side * (edge + 1.0), 0, z)).Position
				p = Vector3.new(p.X, floor, p.Z)
				table.insert(stops, facing(p, p - frame.RightVector * side))
				table.insert(stopCars, i)
			end
		end
		local consoleP = (frame * CFrame.new(side * (edge + 1.5), 0, -length / 2 + 2.4)).Position
		local operatorP = (frame * CFrame.new(side * (edge + 3.0), 0, -length / 2 + 2.4)).Position
		consoleP = Vector3.new(consoleP.X, floor, consoleP.Z)
		operatorP = Vector3.new(operatorP.X, floor, operatorP.Z)
		local homes = {}
		local attendants = if #stops > 3 then 2 else 1
		for k = 1, attendants do
			local z = if k == 1 then length / 2 - 4 else 0
			local p = (frame * CFrame.new(side * (edge + 1.6), 0, z)).Position
			p = Vector3.new(p.X, floor, p.Z)
			table.insert(homes, facing(p, p - frame.RightVector * side))
		end
		local exitP = (frame * CFrame.new(-side * (edge + 1.6), 0, 0)).Position
		exitP = Vector3.new(exitP.X, floor, exitP.Z)
		crew = {
			ride = found.id,
			restraint = Staff.restraint(found),
			console = facing(consoleP, operatorP),
			operator = facing(operatorP, consoleP),
			stops = stops,
			stopCars = stopCars,
			homes = homes,
			exit = facing(exitP, exitP + frame.RightVector * side),
			attendants = attendants,
		}
	else
		-- flat rides: around the ring of cars on the loading floor
		local o = found.origin
		local spec: FlatSpec = FLAT[found.kind] or { floor = 0.4, rim = 14 }
		local floor = o.Y + spec.floor
		local stops, stopCars = {}, {}
		for i, cf in rest do
			local seats = motion.seats[i] or {}
			if #rest == 1 and #seats > 4 then
				-- one big car with seats all round: stop by every third seat
				for s = 2, #seats, 3 do
					local sp = (cf * seats[s]).Position
					local u = flat(sp - o)
					local r = (Vector3.new(sp.X, 0, sp.Z) - Vector3.new(o.X, 0, o.Z)).Magnitude
					local p = Vector3.new(o.X, floor, o.Z) + u * (r + 2.4)
					table.insert(stops, facing(p, Vector3.new(sp.X, floor, sp.Z)))
					table.insert(stopCars, i)
				end
			elseif #seats > 0 then
				local u = flat(cf.Position - o)
				local r = (Vector3.new(cf.X, 0, cf.Z) - Vector3.new(o.X, 0, o.Z)).Magnitude
				local p = Vector3.new(o.X, floor, o.Z) + u * (r + 3.2)
				table.insert(stops, facing(p, Vector3.new(cf.X, floor, cf.Z)))
				table.insert(stopCars, i)
			end
		end
		local toGate = flat(gate - o)
		local side = CFrame.Angles(0, math.rad(35), 0):VectorToWorldSpace(toGate)
		local consoleP = Vector3.new(o.X, 0.4, o.Z) + side * (spec.rim + 1.6)
		local operatorP = Vector3.new(o.X, 0.4, o.Z) + side * (spec.rim + 3.1)
		local homes = {}
		local attendants = if #stops > 3 then 2 else 1
		for k = 1, attendants do
			local a = CFrame.Angles(0, math.rad(if k == 1 then -12 else 12), 0):VectorToWorldSpace(toGate)
			local p = Vector3.new(o.X, 0.4, o.Z) + a * (spec.rim + 1.8)
			table.insert(homes, facing(p, o))
		end
		local exitP = Vector3.new(o.X, 0.4, o.Z) - toGate * (spec.rim + 1.8)
		crew = {
			ride = found.id,
			restraint = Staff.restraint(found),
			console = facing(consoleP, operatorP),
			operator = facing(operatorP, consoleP),
			stops = stops,
			stopCars = stopCars,
			homes = homes,
			exit = facing(exitP, o),
			attendants = attendants,
		}
	end
	cache[rideId] = crew
	return crew
end

-- Which stops each attendant covers (front half / back half).
function Staff.route(crew: Crew, k: number): { number }
	local n = #crew.stops
	local out = {}
	if crew.attendants == 1 then
		for i = 1, n do
			table.insert(out, i)
		end
	else
		local half = math.ceil(n / 2)
		if k == 1 then
			for i = 1, half do
				table.insert(out, i)
			end
		else
			for i = n, half + 1, -1 do
				table.insert(out, i)
			end
		end
	end
	return out
end

-- Uniform: a polo in the land's color, navy trousers, a name badge.
Staff.PANTS = Color3.fromRGB(34, 44, 72)
Staff.CAP = Color3.fromRGB(28, 34, 52)

function Staff.shirt(landId: string): Color3
	local land = Config.landById(landId)
	return if land then land.color else Color3.fromRGB(196, 40, 40)
end

-- A staff member in uniform (a part-built figure; see Props.guest).
function Staff.figure(seed: number, landId: string, pose: string): Model
	local rng = Random.new(seed + 17)
	local cap = if rng:NextNumber() < 0.45 then Staff.CAP else nil
	return Props.guest(seed, pose, { shirt = Staff.shirt(landId), pants = Staff.PANTS, cap = cap })
end

-- Place a standing staff figure with its feet at `at` and tag it, so other
-- renderers (the browser edition) can draw their own person there.
function Staff.place(parent: Instance, role: string, landId: string, seed: number, at: CFrame, rideId: string?, pose: string?): Model
	local m = Staff.figure(seed, landId, pose or "stand")
	m:PivotTo(at * CFrame.new(0, Props.STAND_HEIGHT, 0))
	m:SetAttribute("Role", role)
	m:SetAttribute("Land", landId)
	m:SetAttribute("Seed", seed)
	if rideId then
		m:SetAttribute("RideId", rideId)
	end
	m:AddTag("StaffSpot")
	m.Parent = parent
	return m
end

-- Things the staff say (speech bubbles).
Staff.LINES = {
	pull = { "Pull down on your lap bar, please!", "Lap bars down, folks!", "Push your restraint down until it clicks!" },
	pullHarness = { "Pull your harness down over your shoulders!", "Harnesses down, please!" },
	belt = { "Buckle up, please!", "Seatbelts on, everyone!" },
	check = { "You're all set!", "Nice and snug!", "Good to go!", "Have a great ride!" },
	checkNone = { "Keep your hands inside!", "Have fun out there!", "Enjoy the ride!" },
	clear = { "All clear!", "Clear!", "Good to go!" },
	dispatch = { "Clear to dispatch!", "Here we go!", "Enjoy your ride!" },
	unload = { "Welcome back!", "Thanks for riding!", "Exit to your right, please!", "Watch your step!" },
	wait = { "Step right up!", "Next train in just a moment!", "Line moves fast today!" },
	shop = { "Welcome in!", "Hi there! Take a look around!", "Let me know if you need anything!" },
	food = { "Hungry? We've got you covered!", "Welcome! What can I get you?", "Fresh and hot!" },
	greeter = { "Welcome to Benton Diesel World!", "Have a great day at the park!", "Grab a map and have fun!" },
	popcorn_cart = { "Popcorn! Fresh popcorn!", "Hot buttered popcorn here!", "Get it while it's warm!" },
	balloon_cart = { "Balloons! Get your balloons!", "Pick a color, any color!", "Don't let it float away!" },
	sweeper = { "Morning!", "Enjoy the park!", "Watch your step there!" },
}

return Staff
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Track</string>
          <string name="Source"><![CDATA[-- Track geometry and timing shared by the server (which builds rails and
-- knows how long a ride cycle lasts) and the clients (which animate the
-- vehicles along the exact same curve, in sync with server time).
--
-- A track is a closed centripetal Catmull-Rom spline through control points.
-- Each control point may carry an explicit "up" vector (used for loops and
-- rolls) or a bank angle in degrees (positive banks to the right).

local Track = {}

export type ControlPoint = {
	p: Vector3,
	up: Vector3?,
	bank: number?,
}

export type Zone = {
	from: number, -- control point index where the zone starts
	to: number, -- control point index where it ends (#points + 1 = end of track)
	mode: string, -- "drive" (powered: tires, chain lift, launch, current) or "brake"
	speed: number,
	accel: number,
}

export type Profile = {
	zones: { Zone },
	gravity: number?,
	drag: number?,
	minSpeed: number?,
}

export type Sampler = {
	length: number,
	pointS: { number },
	positions: { Vector3 },
	tangents: { Vector3 },
	ups: { Vector3 },
	cum: { number },
	count: number,
	cframeAt: (self: Sampler, s: number) -> CFrame,
	positionAt: (self: Sampler, s: number) -> Vector3,
}

export type Timing = {
	duration: number,
	times: { number },
	sampler: Sampler,
	distanceAt: (self: Timing, t: number) -> number,
	speedAt: (self: Timing, t: number) -> number,
}

local Y = Vector3.yAxis

local function catmullRom(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, u: number): Vector3
	-- centripetal parameterisation (alpha = 0.5) avoids cusps and overshoot
	local function knot(a: Vector3, b: Vector3): number
		return math.max((b - a).Magnitude ^ 0.5, 1e-4)
	end
	local t0 = 0
	local t1 = t0 + knot(p0, p1)
	local t2 = t1 + knot(p1, p2)
	local t3 = t2 + knot(p2, p3)
	local t = t1 + (t2 - t1) * u
	local a1 = p0 * ((t1 - t) / (t1 - t0)) + p1 * ((t - t0) / (t1 - t0))
	local a2 = p1 * ((t2 - t) / (t2 - t1)) + p2 * ((t - t1) / (t2 - t1))
	local a3 = p2 * ((t3 - t) / (t3 - t2)) + p3 * ((t - t2) / (t3 - t2))
	local b1 = a1 * ((t2 - t) / (t2 - t0)) + a2 * ((t - t0) / (t2 - t0))
	local b2 = a2 * ((t3 - t) / (t3 - t1)) + a3 * ((t - t1) / (t3 - t1))
	return b1 * ((t2 - t) / (t2 - t1)) + b2 * ((t - t1) / (t2 - t1))
end

-- Rotate vector v around unit axis k by angle (radians), Rodrigues' formula.
function Track.rotate(v: Vector3, k: Vector3, angle: number): Vector3
	local c, s = math.cos(angle), math.sin(angle)
	return v * c + k:Cross(v) * s + k * (k:Dot(v) * (1 - c))
end

local function orthoUp(hint: Vector3, tangent: Vector3): Vector3
	local up = hint - tangent * hint:Dot(tangent)
	if up.Magnitude < 1e-3 then
		-- hint parallel to the tangent: fall back to any perpendicular
		up = tangent:Cross(Vector3.xAxis)
		if up.Magnitude < 1e-3 then
			up = tangent:Cross(Vector3.zAxis)
		end
	end
	return up.Unit
end

local SamplerMethods = {}
SamplerMethods.__index = SamplerMethods

local function locate(self: Sampler, s: number): (number, number)
	local L = self.length
	s = s % L
	local cum = self.cum
	local lo, hi = 1, self.count
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local seg = cum[hi] - cum[lo]
	local a = if seg > 0 then (s - cum[lo]) / seg else 0
	return lo, a
end

function SamplerMethods.positionAt(self: Sampler, s: number): Vector3
	local i, a = locate(self, s)
	return self.positions[i]:Lerp(self.positions[i + 1], a)
end

function SamplerMethods.cframeAt(self: Sampler, s: number): CFrame
	local i, a = locate(self, s)
	local pos = self.positions[i]:Lerp(self.positions[i + 1], a)
	local tangent = self.tangents[i]:Lerp(self.tangents[i + 1], a)
	if tangent.Magnitude < 1e-4 then
		tangent = self.tangents[i]
	end
	tangent = tangent.Unit
	local up = orthoUp(self.ups[i]:Lerp(self.ups[i + 1], a), tangent)
	local right = tangent:Cross(up)
	return CFrame.fromMatrix(pos, right, up)
end

-- Build a sampler for a closed track. `spacing` is the approximate distance
-- between dense samples in studs.
function Track.new(points: { ControlPoint }, spacing: number?): Sampler
	local step = spacing or 1.5
	local n = #points
	assert(n >= 4, "a track needs at least 4 control points")
	local function P(i: number): Vector3
		return points[(i - 1) % n + 1].p
	end

	-- resolve an up hint for every control point
	local hints = table.create(n) :: { Vector3 }
	for i = 1, n do
		local cp = points[i]
		local tangent = (P(i + 1) - P(i - 1)).Unit
		local hint: Vector3
		if cp.up then
			hint = cp.up.Unit
		else
			hint = Y
			if cp.bank and cp.bank ~= 0 then
				local flat = Vector3.new(tangent.X, 0, tangent.Z)
				local axis = if flat.Magnitude > 1e-3 then flat.Unit else tangent
				hint = Track.rotate(Y, axis, math.rad(cp.bank))
			end
		end
		hints[i] = hint
	end

	local positions: { Vector3 } = {}
	local ups: { Vector3 } = {}
	local pointS: { number } = {}
	for i = 1, n do
		local p0, p1, p2, p3 = P(i - 1), P(i), P(i + 1), P(i + 2)
		local h1, h2 = hints[i], hints[i % n + 1]
		local segLen = (p2 - p1).Magnitude
		local steps = math.max(2, math.ceil(segLen / step))
		pointS[i] = #positions + 1 -- index for now, converted to distance below
		for k = 0, steps - 1 do
			local u = k / steps
			table.insert(positions, catmullRom(p0, p1, p2, p3, u))
			local w = u * u * (3 - 2 * u)
			local h = h1:Lerp(h2, w)
			if h.Magnitude < 1e-3 then
				h = h1
			end
			table.insert(ups, h.Unit)
		end
	end
	-- close the loop by repeating the first sample
	table.insert(positions, positions[1])
	table.insert(ups, ups[1])

	local count = #positions
	local cum = table.create(count, 0) :: { number }
	for i = 2, count do
		cum[i] = cum[i - 1] + (positions[i] - positions[i - 1]).Magnitude
	end
	local tangents = table.create(count) :: { Vector3 }
	for i = 1, count do
		local prev = if i == 1 then positions[count - 1] else positions[i - 1]
		local nxt = if i == count then positions[2] else positions[i + 1]
		local d = nxt - prev
		tangents[i] = if d.Magnitude > 1e-6 then d.Unit else Vector3.zAxis
	end
	for i = 1, n do
		pointS[i] = cum[pointS[i]]
	end
	table.insert(pointS, cum[count]) -- index n + 1 = end of track

	local self = {
		length = cum[count],
		pointS = pointS,
		positions = positions,
		tangents = tangents,
		ups = ups,
		cum = cum,
		count = count,
	}
	return (setmetatable(self, SamplerMethods) :: any) :: Sampler
end

local TimingMethods = {}
TimingMethods.__index = TimingMethods

function TimingMethods.distanceAt(self: Timing, t: number): number
	local times = self.times
	local count = #times
	if t <= 0 then
		return 0
	end
	if t >= times[count] then
		return self.sampler.length
	end
	local lo, hi = 1, count
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if times[mid] <= t then
			lo = mid
		else
			hi = mid
		end
	end
	local cum = self.sampler.cum
	local dt = times[hi] - times[lo]
	local a = if dt > 0 then (t - times[lo]) / dt else 0
	return cum[lo] + (cum[hi] - cum[lo]) * a
end

function TimingMethods.speedAt(self: Timing, t: number): number
	local d1 = self:distanceAt(t - 0.05)
	local d2 = self:distanceAt(t + 0.05)
	return (d2 - d1) / 0.1
end

-- Integrate the train's speed around the track: gravity and drag everywhere,
-- overridden by powered zones (station tires, lift chains, launches, water
-- current) and brake zones. Returns a lookup from elapsed time to distance.
function Track.timing(sampler: Sampler, profile: Profile): Timing
	local g = profile.gravity or 40
	local drag = profile.drag or 0.0006
	local minSpeed = profile.minSpeed or 5
	local zones = {}
	for _, z in profile.zones do
		table.insert(zones, {
			a = sampler.pointS[z.from],
			b = sampler.pointS[z.to],
			mode = z.mode,
			speed = z.speed,
			accel = z.accel,
		})
	end
	local positions, cum = sampler.positions, sampler.cum
	local times = table.create(sampler.count, 0) :: { number }
	local v = 0
	for i = 1, sampler.count - 1 do
		local ds = cum[i + 1] - cum[i]
		local mid = cum[i] + ds * 0.5
		local zone = nil
		for _, z in zones do
			if mid >= z.a and mid < z.b then
				zone = z
				break
			end
		end
		local v2 = v * v
		if zone and zone.mode == "drive" then
			local target2 = zone.speed * zone.speed
			if v2 < target2 then
				v2 = math.min(target2, v2 + 2 * zone.accel * ds)
			else
				v2 = math.max(target2, v2 - 2 * zone.accel * ds)
			end
		else
			local dh = positions[i + 1].Y - positions[i].Y
			v2 = v2 - 2 * g * dh - drag * v2 * ds
			if zone and zone.mode == "brake" then
				local target2 = zone.speed * zone.speed
				if v2 > target2 then
					v2 = math.max(target2, v2 - 2 * zone.accel * ds)
				end
			end
			v2 = math.max(v2, minSpeed * minSpeed)
		end
		local vNew = math.sqrt(v2)
		local avg = math.max((v + vNew) * 0.5, 0.25)
		times[i + 1] = times[i] + ds / avg
		v = vNew
	end
	local self = {
		duration = times[sampler.count],
		times = times,
		sampler = sampler,
	}
	return (setmetatable(self, TimingMethods) :: any) :: Timing
end

---------------------------------------------------------------------------
-- Layout helpers (used by Layouts.luau)
---------------------------------------------------------------------------

function Track.P(x: number, y: number, z: number, bank: number?): ControlPoint
	return { p = Vector3.new(x, y, z), bank = bank }
end

-- Points strictly inside a vertical loop (or part of one). `dir` is the
-- horizontal travel direction at the entry, `lateral` the side the loop
-- drifts toward so the exit clears the entry. Angles in degrees, 0 = bottom.
function Track.loop(
	entry: Vector3,
	dir: Vector3,
	radius: number,
	lateral: Vector3,
	shift: number,
	steps: number,
	fromDeg: number?,
	toDeg: number?
): { ControlPoint }
	local a0 = math.rad(fromDeg or 0)
	local a1 = math.rad(toDeg or 360)
	local out = {}
	for k = 1, steps - 1 do
		local f = k / steps
		local th = a0 + (a1 - a0) * f
		local frac = (th - a0) / (math.rad(360))
		local p = entry + dir * (radius * math.sin(th)) + Y * (radius * (1 - math.cos(th))) + lateral * (shift * frac)
		local up = (-dir * math.sin(th) + Y * math.cos(th)).Unit
		table.insert(out, { p = p, up = up })
	end
	return out
end

-- Points along a circular arc (optionally climbing/descending). Angles in
-- degrees measured from +X toward +Z; increasing angle is a right turn.
function Track.arc(
	center: Vector3,
	radius: number,
	fromDeg: number,
	toDeg: number,
	y0: number,
	y1: number,
	steps: number,
	bank: number?
): { ControlPoint }
	local out = {}
	local sign = if toDeg >= fromDeg then 1 else -1
	for k = 0, steps do
		local f = k / steps
		local a = math.rad(fromDeg + (toDeg - fromDeg) * f)
		local y = y0 + (y1 - y0) * f
		local p = Vector3.new(center.X + math.cos(a) * radius, y, center.Z + math.sin(a) * radius)
		local b = (bank or 0) * sign
		-- ease the bank in and out at the ends of the arc
		local ease = math.sin(math.pi * math.clamp(f, 0, 1))
		if steps >= 2 then
			b *= 0.35 + 0.65 * ease
		end
		table.insert(out, { p = p, bank = b })
	end
	return out
end

-- A rounded rectangle centered on the origin, traversed clockwise when seen
-- from above with north (-Z) up: east along the north edge, south along the
-- east edge, and so on. Starts at the middle of the south edge heading west.
function Track.roundedRect(hx: number, hz: number, r: number, y: number, cornerSteps: number): { ControlPoint }
	local out: { ControlPoint } = {}
	local function add(x: number, z: number)
		table.insert(out, { p = Vector3.new(x, y, z) })
	end
	local function corner(cx: number, cz: number, fromDeg: number)
		for k = 0, cornerSteps do
			local a = math.rad(fromDeg + 90 * k / cornerSteps)
			add(cx + math.cos(a) * r, cz + math.sin(a) * r)
		end
	end
	-- south edge heading west (x decreasing at z = +hz)
	add(0, hz)
	add(-(hx - r) * 0.5, hz)
	corner(-(hx - r), hz - r, 90) -- south-west corner, turning north
	add(-hx, 0)
	corner(-(hx - r), -(hz - r), 180) -- north-west corner, turning east
	add(0, -hz)
	corner(hx - r, -(hz - r), 270) -- north-east corner, turning south
	add(hx, 0)
	corner(hx - r, hz - r, 0) -- south-east corner, turning west
	add((hx - r) * 0.5, hz)
	return out
end

-- Rotate a list so that index `start` comes first.
function Track.rotateList(points: { ControlPoint }, start: number): { ControlPoint }
	local out = {}
	local n = #points
	for i = 0, n - 1 do
		table.insert(out, points[(start - 1 + i) % n + 1])
	end
	return out
end

function Track.concat(...: { ControlPoint } | ControlPoint): { ControlPoint }
	local out: { ControlPoint } = {}
	for _, item in { ... } do
		local t = item :: any
		if t.p then
			table.insert(out, t :: ControlPoint)
		else
			for _, cp in t :: { ControlPoint } do
				table.insert(out, cp)
			end
		end
	end
	return out
end

-- Transform local control points into world space.
function Track.transform(points: { ControlPoint }, cf: CFrame): { ControlPoint }
	local out = {}
	for _, cp in points do
		local up = cp.up
		table.insert(out, {
			p = cf:PointToWorldSpace(cp.p),
			up = if up then cf:VectorToWorldSpace(up) else nil,
			bank = cp.bank,
		})
	end
	return out
end

return Track
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">BentonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Benton Diesel World - server entry point.
--
-- Builds the park, starts the park clock, and runs the ride, show, shop and
-- player-data services. Everything in the park is generated by code, so the
-- place only needs this script (plus the shared and client folders).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Clock = require(Shared.Clock)
local Net = require(Shared.Net)

local ParkBuilder = require(script.Build.ParkBuilder)
local PlayerData = require(script.PlayerData)
local Wearables = require(script.Wearables)
local RideService = require(script.RideService)
local ShowService = require(script.ShowService)
local ShopService = require(script.ShopService)

local function setupLighting()
	Lighting.Ambient = Color3.fromRGB(90, 90, 100)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 136)
	Lighting.Brightness = 2.5
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 34
	local function ensure(className: string, name: string): Instance
		local existing = Lighting:FindFirstChild(name)
		if existing then
			return existing
		end
		local inst = Instance.new(className :: any)
		inst.Name = name
		inst.Parent = Lighting
		return inst
	end
	local atmosphere = ensure("Atmosphere", "BentonAtmosphere") :: Atmosphere
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(200, 214, 230)
	atmosphere.Decay = Color3.fromRGB(110, 120, 140)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	local bloom = ensure("BloomEffect", "BentonBloom") :: BloomEffect
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	local color = ensure("ColorCorrectionEffect", "BentonColor") :: ColorCorrectionEffect
	color.Saturation = 0.12
	color.Contrast = 0.06
	color.Brightness = 0.02
	local rays = ensure("SunRaysEffect", "BentonSunRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.6
	ensure("Sky", "BentonSky")
end

local function startClock(state: Folder)
	-- start every server at 9:00 AM, one park-minute per real second
	local epoch = Clock.now() - (Clock.OPEN - Clock.DAY_START)
	state:SetAttribute("ClockEpoch", epoch)
	Clock.setEpoch(epoch)
	task.spawn(function()
		while true do
			Lighting.ClockTime = Clock.clockTime(Clock.minutes())
			task.wait(1)
		end
	end)
end

-- guests spawn once the park exists (see spawnGuests below)
Players.CharacterAutoLoads = false

local state = Net.setup()
setupLighting()
startClock(state)

local t0 = os.clock()
local park = ParkBuilder.build()
print(string.format("[BentonDieselWorld] park built in %.2fs", os.clock() - t0))

PlayerData.start()
Wearables.start()
RideService.start(park.rides, park.boards)
ShowService.start()
ShopService.start(park.venues, function(player: Player, payload: any)
	if payload.type == "LeaveQueue" then
		RideService.leave(player)
	end
end)

-- Studio helper: set the attribute "StartShow" on this script to a show id
-- (BigDreams, StuntSpectacular, BigRigParade, BentonNights) to run it now.
script:GetAttributeChangedSignal("StartShow"):Connect(function()
	local id = script:GetAttribute("StartShow")
	if type(id) == "string" and Config.ShowById[id] then
		ShowService.startNow(id)
	end
end)

-- Studio helper: set the attribute "CloseRide" on this script to a ride id
-- to take that ride out of service for 90 seconds.
script:GetAttributeChangedSignal("CloseRide"):Connect(function()
	local id = script:GetAttribute("CloseRide")
	if type(id) == "string" then
		RideService.closeFor(id, 90)
	end
end)

-- Spawn guests at the front gate now that the park is built, and respawn
-- them after a fall. Riders who reset never stay anchored on a ride.
local function spawnCharacter(player: Player)
	local ok = pcall(function()
		(player :: any):LoadCharacterAsync()
	end)
	if not ok and player.Parent then
		-- older engines: fall back to the classic call
		pcall(function()
			(player :: any).LoadCharacter(player)
		end)
	end
end

local function spawnGuests(player: Player)
	player.CharacterAdded:Connect(function(character)
		player:SetAttribute("Riding", "")
		local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if root then
			root.Anchored = false
		end
		local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if hum then
			hum.Died:Connect(function()
				task.wait(math.max(Players.RespawnTime, 2))
				if player.Parent and player.Character == character then
					spawnCharacter(player)
				end
			end)
		end
	end)
	if not player.Character then
		spawnCharacter(player)
	end
end
Players.PlayerAdded:Connect(spawnGuests)
for _, player in Players:GetPlayers() do
	task.spawn(spawnGuests, player)
end

state:SetAttribute("ParkReady", true)
if RunService:IsStudio() then
	print("[BentonDieselWorld] ready. Welcome to " .. Config.ParkName .. "!")
end
]]></string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Build</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Ground</string>
            <string name="Source"><![CDATA[-- Terrain, perimeter wall, parking lot, front gate and the spawn.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Kit = require(script.Parent.Kit)
local Staff = require(Shared.Staff)

local M = Enum.Material
local C = Config.Colors

local Ground = {}

local function terrain()
	local t = workspace.Terrain
	-- grass everywhere, surface at y = 0 (filled in tiles to keep each
	-- terrain write small)
	for x = -550, 450, 200 do
		for z = -590, 410, 200 do
			t:FillBlock(CFrame.new(x + 100, -6, z + 100), Vector3.new(200, 12, 200), M.Grass)
		end
	end
	-- rolling hills outside the walls
	local rng = Random.new(7)
	for _ = 1, 26 do
		local side = rng:NextInteger(1, 3)
		local x: number, z: number
		if side == 1 then
			x, z = rng:NextNumber(-540, -420), rng:NextNumber(-520, 420)
		elseif side == 2 then
			x, z = rng:NextNumber(420, 540), rng:NextNumber(-520, 420)
		else
			x, z = rng:NextNumber(-500, 500), rng:NextNumber(-560, -450)
		end
		t:FillBall(Vector3.new(x, -20, z), rng:NextNumber(40, 70), M.Grass)
	end
	-- the lake at Benton Family Landing
	t:FillCylinder(CFrame.new(235, -4, 125), 10, 52, M.Air)
	t:FillCylinder(CFrame.new(235, -6, 125), 9, 54, M.Sand)
	t:FillCylinder(CFrame.new(235, -2.5, 125), 4, 50, M.Water)
	-- Splashdown pool and river basin at Backwoods Rapids
	t:FillBlock(CFrame.new(-264, -2, -296), Vector3.new(16, 6, 28), M.Water)
	-- Backwoods ridge (behind the flume and the tow-truck coaster)
	local rocks = {
		{ -345, -8, -392, 34 },
		{ -315, -12, -398, 32 },
		{ -285, -14, -400, 28 },
		{ -362, -10, -330, 22 },
		{ -250, -16, -398, 24 },
		{ -215, -18, -400, 22 },
		{ -365, -14, -270, 18 },
	}
	for _, r in rocks do
		t:FillBall(Vector3.new(r[1], r[2], r[3]), r[4], M.Rock)
	end
	t:FillBall(Vector3.new(-300, -6, -330), 16, M.Rock)
	t:FillBall(Vector3.new(-312, -4, -305), 12, M.Ground)
end

local function wall(parent: Instance)
	local b = Config.Bounds
	local h = 14
	local stone = Color3.fromRGB(150, 146, 140)
	local cap = Color3.fromRGB(196, 190, 180)
	local function segment(a: Vector3, c: Vector3)
		local d = c - a
		local len = d.Magnitude
		local mid = (a + c) / 2
		Kit.block(parent, Vector3.new(2.5, h, len), CFrame.lookAt(mid + Vector3.new(0, h / 2, 0), c + Vector3.new(0, h / 2, 0)), stone, M.Concrete)
		Kit.block(parent, Vector3.new(3.4, 1, len + 1), CFrame.lookAt(mid + Vector3.new(0, h + 0.5, 0), c + Vector3.new(0, h + 0.5, 0)), cap, M.Concrete)
		local n = math.floor(len / 40)
		for i = 0, n do
			local p = a + d * (i / math.max(n, 1))
			Kit.box(parent, Vector3.new(4.5, h + 3, 4.5), p, cap, M.Concrete)
		end
	end
	local sw = Vector3.new(b.minX, 0, b.maxZ)
	local se = Vector3.new(b.maxX, 0, b.maxZ)
	local nw = Vector3.new(b.minX, 0, b.minZ)
	local ne = Vector3.new(b.maxX, 0, b.minZ)
	segment(nw, ne)
	segment(nw, sw)
	segment(ne, se)
	-- south wall with a gap for the gate (x -42..42)
	segment(sw, Vector3.new(-42, 0, b.maxZ))
	segment(Vector3.new(42, 0, b.maxZ), se)
	-- slogan panels on the outside of the south wall (as on the park map)
	local slogans = {
		{ x = -220, text = "WORKSHOPS - MOVIES - THRILLS - FAMILIES - A BRIGHTER TOMORROW" },
		{ x = -120, text = "BUILT TO KEEP THE WORLD MOVING" },
		{ x = 120, text = "SPEED FUELS PEOPLE TOGETHER" },
		{ x = 220, text = "DIESEL FANS - BRIGHTER TOMORROWS" },
	}
	for _, s in slogans do
		local cf = CFrame.new(s.x, 8, b.maxZ + 1.4) * CFrame.Angles(0, math.pi, 0)
		Kit.sign(parent, s.text, Vector3.new(70, 7, 0.4), cf, { bg = Color3.fromRGB(70, 72, 80), fg = C.Cream, font = Enum.Font.GothamBold })
		Kit.gear(parent, CFrame.new(s.x - 42, 8, b.maxZ + 1.6) * CFrame.Angles(0, math.pi, 0), 6, Color3.fromRGB(40, 40, 46))
	end
end

local function parking(parent: Instance)
	local asphalt = Color3.fromRGB(70, 72, 76)
	Kit.pad(parent, -320, 296, 320, 470, asphalt, M.Asphalt, 0.3)
	-- forecourt between the lot and the gate
	Kit.pad(parent, -70, 281, 70, 345, C.Paver, M.Brick, 0.42)
	-- parking stripes and cars
	local carColors = { C.Red, C.Blue, Color3.fromRGB(240, 240, 240), Color3.fromRGB(30, 30, 34), C.Gold, Color3.fromRGB(120, 130, 140), C.Green }
	local rng = Random.new(99)
	for row = 0, 3 do
		local z = 370 + row * 26
		for col = -14, 14 do
			local x = col * 20
			if math.abs(x) > 80 then
				Kit.block(parent, Vector3.new(0.4, 0.05, 12), CFrame.new(x - 10, 0.33, z), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
				if rng:NextNumber() < 0.55 then
					local car = Kit.model("Car", parent)
					local color = carColors[rng:NextInteger(1, #carColors)]
					local base = Vector3.new(x, 0.3, z)
					Kit.box(car, Vector3.new(6.5, 2.4, 11), base + Vector3.new(0, 0.9, 0), color, M.SmoothPlastic)
					Kit.box(car, Vector3.new(6, 2.2, 6), base + Vector3.new(0, 3.3, 0.5), Color3.fromRGB(160, 200, 230), M.Glass)
					for _, wx in { -3.2, 3.2 } do
						for _, wz in { -3.6, 3.6 } do
							Kit.cyl(car, 0.8, 2.6, CFrame.new(base + Vector3.new(wx, 1.3, wz)), Color3.fromRGB(25, 25, 25), M.SmoothPlastic)
						end
					end
				end
			end
		end
	end
	-- coach buses along the east side
	for i = 0, 2 do
		local base = Vector3.new(250, 0.3, 365 + i * 22)
		local bus = Kit.model("Bus", parent)
		Kit.box(bus, Vector3.new(36, 11, 9), base + Vector3.new(0, 1.5, 0), Color3.fromRGB(240, 240, 236), M.SmoothPlastic)
		Kit.box(bus, Vector3.new(34, 3, 9.2), base + Vector3.new(0, 7, 0), Color3.fromRGB(30, 60, 120), M.Glass)
		Kit.box(bus, Vector3.new(36.2, 1.5, 9.2), base + Vector3.new(0, 3, 0), C.Orange, M.SmoothPlastic)
		for _, wx in { -12, 12 } do
			for _, wz in { -4.6, 4.6 } do
				Kit.cyl(bus, 1, 3.4, CFrame.new(base + Vector3.new(wx, 1.7, wz)) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(25, 25, 25), M.SmoothPlastic)
			end
		end
	end
	for _, x in { -200, -120, 120, 200 } do
		for _, z in { 340, 420 } do
			Kit.lamp(parent, Vector3.new(x, 0.3, z))
		end
	end
end

local function gate(parent: Instance)
	local z = Config.Bounds.maxZ
	local stone = Color3.fromRGB(222, 214, 196)
	local dark = C.Navy
	-- two towers
	for _, sx in { -1, 1 } do
		local x = sx * 34
		Kit.box(parent, Vector3.new(14, 30, 16), Vector3.new(x, 0, z), stone, M.Concrete)
		Kit.box(parent, Vector3.new(16, 2, 18), Vector3.new(x, 30, z), dark, M.Concrete)
		local banner = Kit.block(parent, Vector3.new(7, 14, 0.3), CFrame.new(x, 15, z + 8.3), C.Red, M.Fabric)
		banner.CastShadow = false
		Kit.gear(parent, CFrame.new(x, 17, z + 8.6) * CFrame.Angles(0, math.pi, 0), 4.5, C.Cream, M.SmoothPlastic)
		-- ticket windows on the outside
		local booth = Kit.block(parent, Vector3.new(8, 4, 0.3), CFrame.new(x, 5, z + 8.2), Color3.fromRGB(150, 200, 230), M.Glass)
		booth.Transparency = 0.3
		Kit.sign(parent, "TICKETS", Vector3.new(8, 2, 0.3), CFrame.new(x, 8.2, z + 8.3) * CFrame.Angles(0, math.pi, 0), { bg = dark, fg = C.Gold, font = Enum.Font.GothamBlack, glow = true })
		Kit.flag(parent, Vector3.new(x, 32, z), if sx < 0 then C.Red else C.Blue, 12)
	end
	-- the arch with the park name
	Kit.block(parent, Vector3.new(56, 10, 12), CFrame.new(0, 27, z), stone, M.Concrete)
	Kit.block(parent, Vector3.new(58, 1.6, 14), CFrame.new(0, 32.8, z), dark, M.Concrete)
	Kit.sign(parent, "BENTON DIESEL WORLD", Vector3.new(50, 6, 0.4), CFrame.new(0, 26.5, z + 6.2) * CFrame.Angles(0, math.pi, 0), {
		bg = dark,
		fg = C.Cream,
		font = Enum.Font.GothamBlack,
		glow = true,
	})
	Kit.sign(parent, "WELCOME BACK - HAVE A GREAT DAY!", Vector3.new(44, 3.5, 0.4), CFrame.new(0, 26.5, z - 6.2), {
		bg = dark,
		fg = C.Gold,
		font = Enum.Font.GothamBold,
		glow = true,
	})
	Kit.gear(parent, CFrame.new(0, 37, z) * CFrame.Angles(0, math.pi, 0), 8, C.Gold)
	-- turnstiles (walk-through)
	for i = -3, 3 do
		local x = i * 6
		local post = Kit.box(parent, Vector3.new(1.2, 3.6, 3), Vector3.new(x - 2.4, 0.4, z), Color3.fromRGB(180, 184, 190), M.Metal)
		post.CanCollide = false
		local top = Kit.block(parent, Vector3.new(0.6, 0.6, 0.6), CFrame.new(x - 2.4, 4.3, z - 1), C.Green, M.Neon)
		top.CanCollide = false
	end
	-- greeters just inside the gate, welcoming guests in
	for i, x in { -24, 24 } do
		Staff.place(parent, "greeter", "Plaza", 4100 + i * 13, CFrame.lookAt(Vector3.new(x, 0.4, z - 10), Vector3.new(x * 0.6, 0.4, z + 10)))
	end
	-- palms and planters on the forecourt
	for _, x in { -60, -48, 48, 60 } do
		Kit.tree(parent, Vector3.new(x, 0.4, 300), "palm", 1)
	end
	Kit.flowerBed(parent, Vector3.new(-30, 0.4, 312), 18, 8)
	Kit.flowerBed(parent, Vector3.new(30, 0.4, 312), 18, 8)
	-- big welcome sign facing the parking lot
	Kit.postSign(parent, "BENTON DIESEL WORLD\nWorkshops - Movies - Thrills - Families", Vector3.new(0, 0.4, 352), Vector3.new(0, 0, 1), 34, 9, {
		bg = dark,
		fg = C.Cream,
		font = Enum.Font.GothamBlack,
		glow = true,
		both = true,
	})
end

local function spawn(parent: Instance)
	local s = Instance.new("SpawnLocation")
	s.Name = "MainGateSpawn"
	s.Size = Vector3.new(30, 1, 16)
	s.CFrame = CFrame.new(Config.Spawn - Vector3.new(0, 2.6, 0))
	s.Anchored = true
	s.Neutral = true
	s.Duration = 0
	s.Color = C.Paver
	s.Material = M.Brick
	s.TopSurface = Enum.SurfaceType.Smooth
	s.Transparency = 0
	s.Parent = parent
	local decal = s:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
end

function Ground.build(root: Instance)
	terrain()
	local folder = Kit.folder("Grounds", root)
	wall(folder)
	parking(folder)
	gate(folder)
	spawn(folder)
end

return Ground
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[-- Building kit: small helpers the land builders use to put the park
-- together out of plain parts.

local Kit = {}

local HALF_PI = math.pi / 2
local M = Enum.Material

Kit.rng = Random.new(20240601)

export type SignOptions = {
	bg: Color3?,
	fg: Color3?,
	font: Enum.Font?,
	both: boolean?,
	stroke: Color3?,
	glow: boolean?,
	material: Enum.Material?,
	transparentBg: boolean?,
}

function Kit.folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.model(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function finish(part: BasePart, parent: Instance, color: Color3, material: Enum.Material?)
	part.Anchored = true
	part.Color = color
	part.Material = material or M.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
end

-- Box part centered at cf.
function Kit.block(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	finish(p, parent, color, material)
	return p
end

-- Box sitting on the ground: `pos` is the bottom-center.
function Kit.box(parent: Instance, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material?, yaw: number?): Part
	local cf = CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	return Kit.block(parent, size, cf, color, material)
end

-- Cylinder whose axis runs along cf's X axis.
function Kit.cyl(parent: Instance, length: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = cf
	finish(p, parent, color, material)
	return p
end

-- Upright cylinder standing on `base` (bottom center).
function Kit.post(parent: Instance, height: number, diameter: number, base: Vector3, color: Color3, material: Enum.Material?): Part
	return Kit.cyl(parent, height, diameter, CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, HALF_PI), color, material)
end

-- Flat disc lying on the ground, top at `top`.
function Kit.disc(parent: Instance, diameter: number, thickness: number, center: Vector3, color: Color3, material: Enum.Material?): Part
	return Kit.cyl(parent, thickness, diameter, CFrame.new(center - Vector3.new(0, thickness / 2, 0)) * CFrame.Angles(0, 0, HALF_PI), color, material)
end

function Kit.ball(parent: Instance, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.CFrame = CFrame.new(pos)
	finish(p, parent, color, material)
	return p
end

function Kit.ellipsoid(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Kit.block(parent, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

function Kit.wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	finish(p, parent, color, material)
	return p
end

-- A bar from a to b (block or round).
function Kit.beam(parent: Instance, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?, round: boolean?): Part
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	if round then
		local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, HALF_PI, 0)
		return Kit.cyl(parent, len, thickness, cf, color, material)
	end
	return Kit.block(parent, Vector3.new(thickness, thickness, len), CFrame.lookAt(mid, b), color, material)
end

-- Flat ground strip from a to b (y ignored), top surface at y = top.
function Kit.path(parent: Instance, a: Vector3, b: Vector3, width: number, color: Color3, material: Enum.Material?, top: number?): Part
	local y = (top or 0.4) - 0.5
	local A = Vector3.new(a.X, y, a.Z)
	local B = Vector3.new(b.X, y, b.Z)
	local len = (B - A).Magnitude
	local p = Kit.block(parent, Vector3.new(width, 1, len + width * 0.5), CFrame.lookAt((A + B) / 2, B), color, material or M.Pavement)
	p.CastShadow = false
	return p
end

-- Rectangular ground pad: x1,z1 - x2,z2.
function Kit.pad(parent: Instance, x1: number, z1: number, x2: number, z2: number, color: Color3, material: Enum.Material?, top: number?): Part
	local y = (top or 0.4) - 0.5
	local p = Kit.block(parent, Vector3.new(math.abs(x2 - x1), 1, math.abs(z2 - z1)), CFrame.new((x1 + x2) / 2, y, (z1 + z2) / 2), color, material or M.Pavement)
	p.CastShadow = false
	return p
end

-- Round ground pad.
function Kit.roundPad(parent: Instance, center: Vector3, diameter: number, color: Color3, material: Enum.Material?, top: number?): Part
	local p = Kit.disc(parent, diameter, 1, Vector3.new(center.X, top or 0.42, center.Z), color, material or M.Pavement)
	p.CastShadow = false
	return p
end

---------------------------------------------------------------------------
-- Signs and text
---------------------------------------------------------------------------
function Kit.label(part: BasePart, face: Enum.NormalId, text: string, opts: SignOptions?): TextLabel
	local o: SignOptions = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	-- keep sign textures small: big signs get fewer pixels per stud
	local area = part.Size.X * part.Size.Y
	gui.PixelsPerStud = if area > 200 then 14 elseif area > 60 then 22 else 32
	gui.LightInfluence = if o.glow then 0 else 0.4
	gui.Brightness = if o.glow then 1.4 else 1
	gui.MaxDistance = 450
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = o.fg or Color3.new(1, 1, 1)
	label.FontFace = Font.fromEnum(o.font or Enum.Font.GothamBlack)
	label.TextWrapped = true
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = label
	if o.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = o.stroke
		stroke.Thickness = 3
		stroke.Parent = label
	end
	return label
end

-- A sign board. `cf` faces the reader along its LookVector.
function Kit.sign(parent: Instance, text: string, size: Vector3, cf: CFrame, opts: SignOptions?): Part
	local o: SignOptions = opts or {}
	local board = Kit.block(parent, size, cf, o.bg or Color3.fromRGB(22, 34, 58), o.material or M.SmoothPlastic)
	board.Name = "Sign"
	if o.transparentBg then
		board.Transparency = 1
	end
	Kit.label(board, Enum.NormalId.Front, text, o)
	if o.both then
		Kit.label(board, Enum.NormalId.Back, text, o)
	end
	return board
end

-- Sign on two posts, bottom of posts at `base`, facing `facing` (unit).
function Kit.postSign(parent: Instance, text: string, base: Vector3, facing: Vector3, width: number, height: number, opts: SignOptions?): Part
	local cf = CFrame.lookAt(base, base + facing)
	local postColor = Color3.fromRGB(60, 60, 66)
	for _, sx in { -1, 1 } do
		local p = cf * Vector3.new(sx * (width / 2 - 0.4), 0, 0)
		Kit.post(parent, 4 + height, 0.5, p, postColor, M.Metal)
	end
	return Kit.sign(parent, text, Vector3.new(width, height, 0.5), cf * CFrame.new(0, 4 + height / 2, 0), opts)
end

---------------------------------------------------------------------------
-- Scenery
---------------------------------------------------------------------------
local LEAF = {
	Color3.fromRGB(58, 125, 52),
	Color3.fromRGB(72, 140, 60),
	Color3.fromRGB(46, 110, 58),
	Color3.fromRGB(90, 150, 64),
}

function Kit.tree(folder: Instance, pos: Vector3, kind: string?, scale: number?)
	local rng = Kit.rng
	local s = scale or rng:NextNumber(0.8, 1.25)
	local k = kind or (if rng:NextNumber() < 0.5 then "round" else "pine")
	local trunk = Color3.fromRGB(110, 78, 50)
	-- each tree is its own tagged model so other renderers can swap in
	-- their own trees (the browser edition does)
	local parent = Kit.model("Tree", folder)
	parent:SetAttribute("TreeKind", k)
	parent:SetAttribute("TreeScale", s)
	parent:SetAttribute("Base", pos)
	parent:AddTag("Tree")
	if k == "pine" then
		Kit.post(parent, 6 * s, 1.4 * s, pos, trunk, M.Wood)
		local leaf = Color3.fromRGB(40, 100, 56)
		for i = 0, 3 do
			local d = (11 - i * 2.6) * s
			Kit.post(parent, 3.6 * s, d, pos + Vector3.new(0, (4.5 + i * 3.2) * s, 0), leaf, M.Grass)
		end
	elseif k == "palm" then
		local top = pos + Vector3.new(0, 16 * s, 0)
		Kit.beam(parent, pos, top, 1.3 * s, trunk, M.Wood, true)
		for i = 0, 5 do
			local a = i * math.pi / 3
			local tip = top + Vector3.new(math.cos(a) * 7 * s, -2.5 * s, math.sin(a) * 7 * s)
			local leaf = Kit.beam(parent, top, tip, 1, Color3.fromRGB(60, 140, 60), M.Grass)
			leaf.Size = Vector3.new(2.4 * s, 0.3, leaf.Size.Z)
		end
	else
		Kit.post(parent, 7 * s, 1.6 * s, pos, trunk, M.Wood)
		local color = LEAF[rng:NextInteger(1, #LEAF)]
		Kit.ball(parent, 9 * s, pos + Vector3.new(0, 9.5 * s, 0), color, M.Grass)
		Kit.ball(parent, 6 * s, pos + Vector3.new(2.5 * s, 8 * s, 1 * s), color, M.Grass)
		Kit.ball(parent, 6 * s, pos + Vector3.new(-2 * s, 8.5 * s, -1.5 * s), color, M.Grass)
	end
end

function Kit.bush(parent: Instance, pos: Vector3, size: number?)
	local s = size or Kit.rng:NextNumber(2.5, 4)
	local b = Kit.ball(parent, s, pos + Vector3.new(0, s * 0.35, 0), LEAF[Kit.rng:NextInteger(1, #LEAF)], M.Grass)
	b.CastShadow = false
	b:AddTag("Bush")
end

-- Flower bed: low box of soil with colorful blooms.
function Kit.flowerBed(parent: Instance, center: Vector3, sx: number, sz: number)
	Kit.box(parent, Vector3.new(sx, 1.2, sz), center, Color3.fromRGB(150, 140, 130), M.Brick)
	Kit.box(parent, Vector3.new(sx - 0.8, 1.3, sz - 0.8), center, Color3.fromRGB(80, 56, 40), M.Ground)
	local colors = { Color3.fromRGB(230, 60, 80), Color3.fromRGB(250, 210, 60), Color3.fromRGB(240, 130, 200), Color3.fromRGB(250, 250, 250), Color3.fromRGB(150, 90, 220) }
	local n = math.floor(sx * sz / 7)
	for _ = 1, math.min(n, 24) do
		local p = center + Vector3.new(Kit.rng:NextNumber(-sx / 2 + 1, sx / 2 - 1), 1.6, Kit.rng:NextNumber(-sz / 2 + 1, sz / 2 - 1))
		local f = Kit.ball(parent, 0.9, p, colors[Kit.rng:NextInteger(1, #colors)], M.SmoothPlastic)
		f.CastShadow = false
	end
end

function Kit.lamp(parent: Instance, pos: Vector3, color: Color3?)
	local poleColor = Color3.fromRGB(30, 34, 44)
	Kit.post(parent, 1, 1.4, pos, poleColor, M.Metal)
	Kit.post(parent, 11, 0.5, pos, poleColor, M.Metal)
	local bulb = Kit.ball(parent, 1.6, pos + Vector3.new(0, 11.6, 0), Color3.fromRGB(255, 236, 190), M.Neon)
	bulb.CastShadow = false
	Kit.disc(parent, 2.2, 0.3, pos + Vector3.new(0, 12.6, 0), poleColor, M.Metal)
	local light = Instance.new("PointLight")
	light.Color = color or Color3.fromRGB(255, 214, 160)
	light.Range = 22
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = bulb
	bulb:AddTag("ParkLamp")
end

-- Bench facing along cf.LookVector, cf at ground under its center.
function Kit.bench(parent: Instance, cf: CFrame)
	local wood = Color3.fromRGB(150, 100, 60)
	local iron = Color3.fromRGB(40, 40, 46)
	local seat = Instance.new("Seat")
	seat.Size = Vector3.new(5, 0.4, 1.6)
	seat.CFrame = cf * CFrame.new(0, 1.6, 0)
	finish(seat, parent, wood, M.WoodPlanks)
	Kit.block(parent, Vector3.new(5, 1.4, 0.3), cf * CFrame.new(0, 2.6, 0.75) * CFrame.Angles(math.rad(-10), 0, 0), wood, M.WoodPlanks)
	for _, sx in { -2.2, 2.2 } do
		Kit.block(parent, Vector3.new(0.3, 1.6, 1.4), cf * CFrame.new(sx, 0.8, 0), iron, M.Metal)
	end
end

-- Café table with umbrella and two seats.
function Kit.cafeTable(parent: Instance, pos: Vector3, umbrella: Color3)
	local white = Color3.fromRGB(240, 240, 236)
	Kit.post(parent, 3, 0.4, pos, Color3.fromRGB(60, 60, 66), M.Metal)
	Kit.disc(parent, 3.4, 0.2, pos + Vector3.new(0, 3.1, 0), white, M.SmoothPlastic)
	Kit.post(parent, 8, 0.25, pos + Vector3.new(0, 3, 0), white, M.Metal)
	Kit.cyl(parent, 1.4, 8, CFrame.new(pos + Vector3.new(0, 10.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), umbrella, M.Fabric)
	for _, sx in { -1, 1 } do
		local seat = Instance.new("Seat")
		seat.Size = Vector3.new(1.8, 0.4, 1.8)
		seat.CFrame = CFrame.lookAt(pos + Vector3.new(sx * 2.8, 1.8, 0), pos + Vector3.new(0, 1.8, 0))
		finish(seat, parent, white, M.SmoothPlastic)
		Kit.post(parent, 1.6, 0.3, pos + Vector3.new(sx * 2.8, 0, 0), Color3.fromRGB(60, 60, 66), M.Metal)
	end
end

function Kit.fence(parent: Instance, a: Vector3, b: Vector3, height: number?, color: Color3?)
	local h = height or 3
	local c = color or Color3.fromRGB(40, 44, 54)
	local d = b - a
	local len = d.Magnitude
	local n = math.max(1, math.floor(len / 8))
	for i = 0, n do
		Kit.post(parent, h, 0.35, a + d * (i / n), c, M.Metal)
	end
	Kit.beam(parent, a + Vector3.new(0, h - 0.2, 0), b + Vector3.new(0, h - 0.2, 0), 0.25, c, M.Metal, true)
	Kit.beam(parent, a + Vector3.new(0, h * 0.45, 0), b + Vector3.new(0, h * 0.45, 0), 0.2, c, M.Metal, true)
end

function Kit.flag(parent: Instance, base: Vector3, color: Color3, height: number?)
	local h = height or 22
	Kit.post(parent, h, 0.4, base, Color3.fromRGB(220, 220, 225), M.Metal)
	local f = Kit.block(parent, Vector3.new(0.1, 3, 5), CFrame.new(base + Vector3.new(0, h - 2, 2.6)), color, M.Fabric)
	f.CastShadow = false
	Kit.ball(parent, 0.8, base + Vector3.new(0, h + 0.3, 0), Color3.fromRGB(240, 196, 64), M.Metal)
end

-- Hanging banner on a lamp-style pole (Main Street).
function Kit.bannerPole(parent: Instance, base: Vector3, color: Color3, facing: Vector3)
	Kit.post(parent, 16, 0.5, base, Color3.fromRGB(30, 34, 44), M.Metal)
	local cf = CFrame.lookAt(base, base + facing)
	local banner = Kit.block(parent, Vector3.new(2.6, 6, 0.15), cf * CFrame.new(1.5, 11, 0), color, M.Fabric)
	banner.CastShadow = false
	local white = Kit.block(parent, Vector3.new(1.4, 1.4, 0.2), cf * CFrame.new(1.5, 12, 0), Color3.fromRGB(250, 243, 224), M.SmoothPlastic)
	white.CastShadow = false
end

function Kit.waterTower(parent: Instance, base: Vector3, text: string, tank: Color3, legs: Color3?)
	local legColor = legs or Color3.fromRGB(70, 60, 54)
	for i = 0, 3 do
		local a = i * HALF_PI + math.pi / 4
		local foot = base + Vector3.new(math.cos(a) * 6, 0, math.sin(a) * 6)
		local top = base + Vector3.new(math.cos(a) * 4.5, 28, math.sin(a) * 4.5)
		Kit.beam(parent, foot, top, 1, legColor, M.Metal, true)
	end
	local body = Kit.cyl(parent, 14, 13, CFrame.new(base + Vector3.new(0, 35, 0)) * CFrame.Angles(0, 0, HALF_PI), tank, M.Metal)
	Kit.cyl(parent, 3, 14, CFrame.new(base + Vector3.new(0, 43, 0)) * CFrame.Angles(0, 0, HALF_PI), legColor, M.Metal)
	Kit.ball(parent, 2, base + Vector3.new(0, 45, 0), legColor, M.Metal)
	-- text panels around the tank
	for i = 0, 3 do
		local a = i * HALF_PI
		local cf = CFrame.new(base + Vector3.new(0, 35, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -6.6)
		Kit.sign(parent, text, Vector3.new(8, 5, 0.2), cf, { transparentBg = true, fg = Color3.fromRGB(250, 243, 224), font = Enum.Font.GothamBlack })
	end
	local _ = body
end

-- Land entrance arch spanning a path. cf: center of the path at ground
-- level, looking toward the land (visitors read the front from outside).
function Kit.arch(parent: Instance, cf: CFrame, width: number, text: string, colors: { Color3 })
	local main, trim = colors[1], colors[2] or Color3.fromRGB(250, 243, 224)
	local h = 24
	for _, sx in { -1, 1 } do
		local x = sx * (width / 2 + 2)
		Kit.block(parent, Vector3.new(4.5, h, 4.5), cf * CFrame.new(x, h / 2, 0), main, M.Brick)
		Kit.block(parent, Vector3.new(5.5, 1.2, 5.5), cf * CFrame.new(x, h + 0.6, 0), trim, M.Concrete)
		Kit.block(parent, Vector3.new(5.5, 1.5, 5.5), cf * CFrame.new(x, 0.75, 0), trim, M.Concrete)
		local lantern = Kit.ball(parent, 2, (cf * CFrame.new(x, h + 2.4, 0)).Position, Color3.fromRGB(255, 230, 170), M.Neon)
		local light = Instance.new("PointLight")
		light.Range = 18
		light.Color = Color3.fromRGB(255, 210, 150)
		light.Parent = lantern
	end
	local beamCF = cf * CFrame.new(0, h - 3, 0)
	Kit.block(parent, Vector3.new(width + 11, 6.5, 3.2), beamCF, main, M.SmoothPlastic)
	-- outside face (visitors arriving) and inside face (visitors leaving)
	local outside = beamCF * CFrame.new(0, 0, 1.75) * CFrame.Angles(0, math.pi, 0)
	Kit.sign(parent, text, Vector3.new(width + 9, 5, 0.3), outside, { bg = trim, fg = main, font = Enum.Font.GothamBlack, glow = true })
	local inside = beamCF * CFrame.new(0, 0, -1.75)
	Kit.sign(parent, text, Vector3.new(width + 9, 5, 0.3), inside, { bg = trim, fg = main, font = Enum.Font.GothamBlack, glow = true })
end

function Kit.light(part: BasePart, color: Color3, range: number, brightness: number?): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Parent = part
	return l
end

function Kit.prompt(part: BasePart, action: string, object: string, key: Enum.KeyCode?, distance: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = key or Enum.KeyCode.E
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.Parent = part
	return p
end

-- Simple building: box with roof slab, trim, windows and an optional
-- awning on the front (cf LookVector = front).
export type BuildingOptions = {
	size: Vector3,
	wall: Color3,
	trim: Color3?,
	roof: Color3?,
	material: Enum.Material?,
	windows: boolean?,
	awning: Color3?,
	sign: string?,
	signColors: { Color3 }?,
	open: boolean?, -- open front (counter) instead of a solid wall
}

function Kit.building(parent: Instance, cf: CFrame, o: BuildingOptions): Model
	local model = Kit.model("Building", parent)
	local size = o.size
	local trim = o.trim or Color3.fromRGB(250, 243, 224)
	local roof = o.roof or Color3.fromRGB(60, 60, 66)
	local mat = o.material or M.Brick
	local hx, hz = size.X / 2, size.Z / 2
	-- walls: back + sides, and front (solid or open)
	Kit.block(model, Vector3.new(size.X, size.Y, 1), cf * CFrame.new(0, size.Y / 2, hz - 0.5), o.wall, mat)
	Kit.block(model, Vector3.new(1, size.Y, size.Z), cf * CFrame.new(-hx + 0.5, size.Y / 2, 0), o.wall, mat)
	Kit.block(model, Vector3.new(1, size.Y, size.Z), cf * CFrame.new(hx - 0.5, size.Y / 2, 0), o.wall, mat)
	if o.open then
		local openH = math.min(12, size.Y - 4)
		Kit.block(model, Vector3.new(size.X, size.Y - openH, 1), cf * CFrame.new(0, openH + (size.Y - openH) / 2, -hz + 0.5), o.wall, mat)
		-- counter
		local counter = Kit.block(model, Vector3.new(size.X - 6, 3.6, 2.4), cf * CFrame.new(0, 1.8, -hz + 3), trim, M.Wood)
		counter.Name = "Counter"
		-- interior floor/back shelves
		Kit.block(model, Vector3.new(size.X - 2, 0.4, size.Z - 2), cf * CFrame.new(0, 0.2, 0), Color3.fromRGB(190, 170, 150), M.WoodPlanks)
		for i = -1, 1 do
			Kit.block(model, Vector3.new(size.X / 4, 7, 1.6), cf * CFrame.new(i * size.X / 3.2, 3.5, hz - 2), Color3.fromRGB(120, 90, 60), M.Wood)
		end
	else
		Kit.block(model, Vector3.new(size.X, size.Y, 1), cf * CFrame.new(0, size.Y / 2, -hz + 0.5), o.wall, mat)
		local door = Kit.block(model, Vector3.new(6, 9, 0.4), cf * CFrame.new(0, 4.5, -hz - 0.1), Color3.fromRGB(70, 46, 30), M.Wood)
		door.Name = "Door"
	end
	-- roof and trim
	Kit.block(model, Vector3.new(size.X + 2, 1.4, size.Z + 2), cf * CFrame.new(0, size.Y + 0.7, 0), roof, M.Slate)
	Kit.block(model, Vector3.new(size.X + 0.6, 1.2, size.Z + 0.6), cf * CFrame.new(0, size.Y - 0.6, 0), trim, M.Concrete)
	if o.windows ~= false then
		local floors = math.max(1, math.floor((size.Y - 4) / 9))
		local cols = math.max(1, math.floor(size.X / 9))
		for f = 1, floors do
			for c = 1, cols do
				local x = -hx + (c - 0.5) * size.X / cols
				local y = 6 + (f - 1) * 9 + (if o.open then 9 else 0)
				if y < size.Y - 3 and not (not o.open and f == 1 and math.abs(x) < 5) then
					local w = Kit.block(model, Vector3.new(3.2, 4.2, 0.3), cf * CFrame.new(x, y, -hz - 0.05), Color3.fromRGB(150, 196, 220), M.Glass)
					w.Transparency = 0.2
					Kit.block(model, Vector3.new(3.8, 0.4, 0.5), cf * CFrame.new(x, y - 2.3, -hz - 0.1), trim, M.Concrete)
				end
			end
		end
	end
	if o.awning then
		local depth = 6
		local awn = Kit.wedge(model, Vector3.new(size.X - 2, 1.6, depth), cf * CFrame.new(0, 13.2, -hz - depth / 2), o.awning, M.Fabric)
		awn.CastShadow = true
		-- stripes
		for i = 0, math.floor((size.X - 2) / 4) - 1, 2 do
			local x = -((size.X - 2) / 2) + i * 4 + 2
			local s = Kit.wedge(model, Vector3.new(4, 1.62, depth + 0.02), cf * CFrame.new(x, 13.2, -hz - depth / 2), trim, M.Fabric)
			s.CastShadow = false
		end
	end
	if o.sign then
		local colors = o.signColors or { Color3.fromRGB(22, 34, 58), trim }
		Kit.sign(model, o.sign, Vector3.new(math.min(size.X - 2, 40), 4.5, 0.6), cf * CFrame.new(0, size.Y - 3.6, -hz - 0.4), {
			bg = colors[1],
			fg = colors[2],
			font = Enum.Font.GothamBlack,
			glow = true,
		})
	end
	return model
end

-- Gear emblem (decorative), facing cf.LookVector.
function Kit.gear(parent: Instance, cf: CFrame, diameter: number, color: Color3, material: Enum.Material?)
	local mat = material or M.Metal
	Kit.cyl(parent, diameter * 0.18, diameter, cf * CFrame.Angles(0, HALF_PI, 0), color, mat)
	for k = 0, 7 do
		local a = k * math.pi / 4
		Kit.block(parent, Vector3.new(diameter * 0.2, diameter * 0.22, diameter * 0.16), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, diameter * 0.52, 0), color, mat)
	end
	Kit.cyl(parent, diameter * 0.2, diameter * 0.32, cf * CFrame.Angles(0, HALF_PI, 0), Color3.fromRGB(30, 30, 36), mat)
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Lands</string>
            <string name="Source"><![CDATA[-- Themed scenery for each land, the two show venues (Lakeside Stage and
-- the Backlot Stunt Arena), and trees scattered wherever there is room.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local QueueLine = require(Shared.QueueLine)
local Kit = require(script.Parent.Kit)
local Theming = require(script.Parent.Theming)

local M = Enum.Material
local C = Config.Colors
local HALF_PI = math.pi / 2

local Lands = {}

local function look(pos: Vector3, dir: Vector3): CFrame
	return CFrame.lookAt(pos, pos + dir)
end

-- Rectangles (x1, z1, x2, z2) where trees must not grow.
local blocked: { { number } } = {}
local function block(x1: number, z1: number, x2: number, z2: number)
	table.insert(blocked, { math.min(x1, x2), math.min(z1, z2), math.max(x1, x2), math.max(z1, z2) })
end
local function blockCircle(x: number, z: number, r: number)
	block(x - r, z - r, x + r, z + r)
end

local function isFree(x: number, z: number, margin: number): boolean
	for _, r in blocked do
		if x > r[1] - margin and x < r[3] + margin and z > r[2] - margin and z < r[4] + margin then
			return false
		end
	end
	return true
end

-- Big vintage truck statue ("Old No. 1"), facing cf.LookVector.
local function truckStatue(parent: Instance, cf: CFrame, color: Color3, scale: number)
	local s = scale
	Kit.block(parent, Vector3.new(14, 3, 26) * s, cf * CFrame.new(0, 1.5 * s, 0), Color3.fromRGB(150, 146, 140), M.Concrete)
	local base = cf * CFrame.new(0, 3 * s, 0)
	Kit.block(parent, Vector3.new(9, 1.5, 22) * s, base * CFrame.new(0, 2.2 * s, 0), Color3.fromRGB(40, 40, 44), M.Metal)
	Kit.block(parent, Vector3.new(9, 6, 7) * s, base * CFrame.new(0, 5.5 * s, -5 * s), color, M.SmoothPlastic)
	Kit.block(parent, Vector3.new(8, 4, 6) * s, base * CFrame.new(0, 4.5 * s, -10.5 * s), color, M.SmoothPlastic)
	Kit.block(parent, Vector3.new(6.6, 3, 0.4) * s, base * CFrame.new(0, 4.5 * s, -13.6 * s), Color3.fromRGB(200, 200, 205), M.Metal)
	local glass = Kit.block(parent, Vector3.new(7, 2.4, 0.3) * s, base * CFrame.new(0, 7 * s, -8.6 * s), Color3.fromRGB(150, 200, 230), M.Glass)
	glass.Transparency = 0.2
	Kit.block(parent, Vector3.new(9, 4, 9) * s, base * CFrame.new(0, 4.5 * s, 5.5 * s), Color3.fromRGB(240, 240, 236), M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		Kit.post(parent, 7 * s, 0.9 * s, (base * CFrame.new(sx * 4.8 * s, 5 * s, -2.6 * s)).Position, Color3.fromRGB(200, 200, 205), M.Metal)
		for _, sz in { -9, 2, 7.5 } do
			Kit.cyl(parent, 1.6 * s, 4.4 * s, base * CFrame.new(sx * 4.4 * s, 2.2 * s, sz * s), Color3.fromRGB(25, 25, 25), M.SmoothPlastic)
		end
		Kit.ball(parent, 1.4 * s, (base * CFrame.new(sx * 3 * s, 4.2 * s, -13.8 * s)).Position, Color3.fromRGB(255, 240, 200), M.Neon)
	end
end

---------------------------------------------------------------------------
-- Diesel District
---------------------------------------------------------------------------
local function diesel(parent: Instance)
	local f = Kit.folder("DieselDistrict", parent)
	local land = Config.landById("Diesel") :: Config.Land
	Kit.arch(f, look(Vector3.new(-88, 0.4, 15), Vector3.new(-1, 0, 0)), 22, "DIESEL DISTRICT", { land.color, C.Cream })
	-- Benton Garage rooftop sign and slogan (the shop building is in Venues)
	local roof = CFrame.new(-250, 32.4, 12) * CFrame.Angles(0, math.rad(-90), 0)
	Kit.sign(f, "BENTON GARAGE", Vector3.new(44, 8, 0.6), roof * CFrame.new(0, 5, 0), { bg = C.Navy, fg = C.Cream, font = Enum.Font.GothamBlack, glow = true })
	Kit.gear(f, roof * CFrame.new(-27, 5, 0), 9, C.Gold)
	Kit.sign(f, "BUILT TO KEEP THE WORLD MOVING", Vector3.new(50, 6, 0.3), CFrame.new(-282, 18, -28.7), { transparentBg = true, fg = C.Cream, font = Enum.Font.GothamBlack })
	for _, z in { 30, 42 } do
		local stack = Kit.post(f, 20, 4, Vector3.new(-300, 32, z), C.Brick, M.Brick)
		local smoke = Instance.new("Smoke")
		smoke.Color = Color3.fromRGB(200, 200, 200)
		smoke.Opacity = 0.12
		smoke.RiseVelocity = 8
		smoke.Size = 4
		smoke.Parent = stack
	end
	-- fuel tanks
	for i, z in { 82, 106 } do
		local base = Vector3.new(-345, 0, z)
		Kit.post(f, 22, 18, base, Color3.fromRGB(210, 214, 220), M.Metal)
		Kit.disc(f, 19, 1, base + Vector3.new(0, 22.5, 0), C.Steel, M.Metal)
		Kit.sign(f, "BENTON FUEL " .. i, Vector3.new(12, 3, 0.2), CFrame.new(base + Vector3.new(9.15, 12, 0)) * CFrame.Angles(0, math.rad(-90), 0), { transparentBg = true, fg = C.Navy, font = Enum.Font.GothamBlack })
	end
	-- Old No. 1 on the district square
	truckStatue(f, CFrame.new(-192, 0.4, 10) * CFrame.Angles(0, math.rad(-120), 0), C.Red, 0.8)
	Kit.postSign(f, "OLD NO. 1\nThe first Benton diesel, 1952", Vector3.new(-178, 0.4, 30), Vector3.new(1, 0, 0.4).Unit, 10, 3.5, { bg = C.Navy, fg = C.Cream, font = Enum.Font.GothamBold })
	-- FUEL CITY billboard
	Kit.postSign(f, "FUEL. CITY. BLUE. REPEAT.", Vector3.new(-140, 0.4, -24), Vector3.new(1, 0, 1).Unit, 26, 8, { bg = Color3.fromRGB(30, 34, 44), fg = C.Orange, font = Enum.Font.GothamBlack, glow = true, both = true })
	-- crates and barrels
	local rng = Random.new(5)
	for _, center in { Vector3.new(-218, 0.4, -20), Vector3.new(-162, 0.4, 44), Vector3.new(-236, 0.4, 56) } do
		for _ = 1, 5 do
			local p = center + Vector3.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-5, 5))
			if rng:NextNumber() < 0.5 then
				Kit.box(f, Vector3.new(3, 3, 3), p, Color3.fromRGB(160, 120, 70), M.WoodPlanks, rng:NextNumber(0, 90))
			else
				Kit.post(f, 3.6, 2.4, p, if rng:NextNumber() < 0.5 then C.Blue else C.Red, M.Metal)
			end
		end
	end
	for _, p in { Vector3.new(-226, 0.4, -26), Vector3.new(-158, 0.4, -26), Vector3.new(-226, 0.4, 46), Vector3.new(-158, 0.4, 46) } do
		Kit.lamp(f, p)
	end
	for z = -14, 34, 16 do
		Kit.bench(f, CFrame.new(-160, 0.4, z) * CFrame.Angles(0, math.rad(90), 0))
	end
	block(-375, -140, -125, -40) -- Diesel Thunder
	block(-316, -30, -248, 54) -- Garage
	block(-222, 63, -165, 117) -- Canteen + patio
	block(-356, 70, -334, 116)
	blockCircle(-120, 78, 32) -- Piston Pounder
	block(-230, -30, -154, 50) -- square
end

---------------------------------------------------------------------------
-- Little Haulers
---------------------------------------------------------------------------
local function haulers(parent: Instance)
	local f = Kit.folder("LittleHaulers", parent)
	local land = Config.landById("Haulers") :: Config.Land
	Kit.arch(f, look(Vector3.new(-92, 0.4, 238), Vector3.new(-1, 0, 0)), 20, "LITTLE HAULERS", { C.Red, land.color })
	-- giant toy dump truck in the plaza
	local cf = CFrame.new(-175, 0.4, 215) * CFrame.Angles(0, math.rad(35), 0)
	Kit.block(f, Vector3.new(10, 1.6, 18), cf * CFrame.new(0, 3, 0), Color3.fromRGB(40, 40, 46), M.SmoothPlastic)
	Kit.block(f, Vector3.new(9, 6, 6), cf * CFrame.new(0, 6.6, -6), land.color, M.SmoothPlastic)
	local glass = Kit.block(f, Vector3.new(8, 2.5, 0.3), cf * CFrame.new(0, 8, -9.1), Color3.fromRGB(150, 200, 230), M.Glass)
	glass.Transparency = 0.2
	Kit.wedge(f, Vector3.new(10, 6, 12), cf * CFrame.new(0, 7, 4) * CFrame.Angles(math.rad(-15), math.pi, 0), C.Red, M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		for _, sz in { -6, 5 } do
			Kit.cyl(f, 2, 5, cf * CFrame.new(sx * 5, 2.5, sz), Color3.fromRGB(25, 25, 25), M.SmoothPlastic)
		end
	end
	-- cones, road signs and a stop sign
	for k = 0, 11 do
		local a = k * math.pi / 6
		local p = Vector3.new(-175 + math.cos(a) * 29, 0.4, 215 + math.sin(a) * 29)
		Kit.post(f, 0.4, 2, p, Color3.fromRGB(255, 110, 20), M.SmoothPlastic)
		Kit.post(f, 1.4, 1.2, p + Vector3.new(0, 0.4, 0), Color3.fromRGB(255, 110, 20), M.SmoothPlastic)
		Kit.post(f, 0.5, 0.7, p + Vector3.new(0, 1.8, 0), Color3.new(1, 1, 1), M.SmoothPlastic)
	end
	Kit.postSign(f, "SLOW\nLITTLE HAULERS AT WORK", Vector3.new(-120, 0.4, 250), Vector3.new(1, 0, 0), 9, 4, { bg = C.Gold, fg = Color3.fromRGB(20, 20, 20), font = Enum.Font.GothamBlack, both = true })
	Kit.postSign(f, "STOP", Vector3.new(-210, 0.4, 190), Vector3.new(1, 0, 0.3).Unit, 4, 4, { bg = C.Red, fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBlack, both = true })
	for _, p in { Vector3.new(-150, 0.4, 200), Vector3.new(-200, 0.4, 240), Vector3.new(-150, 0.4, 232) } do
		Kit.lamp(f, p)
	end
	block(-340, 155, -210, 255) -- Truck Trek
	block(-126, 176, -94, 224) -- Toy Garage
	blockCircle(-175, 215, 34)
end

---------------------------------------------------------------------------
-- Backwoods Junction
---------------------------------------------------------------------------
local function cabin(parent: Instance, cf: CFrame, w: number, d: number)
	local logColor = Color3.fromRGB(120, 84, 52)
	Kit.block(parent, Vector3.new(w, 10, d), cf * CFrame.new(0, 5, 0), logColor, M.Wood)
	for y = 1, 9, 2 do
		Kit.block(parent, Vector3.new(w + 0.6, 0.5, d + 0.6), cf * CFrame.new(0, y, 0), Color3.fromRGB(96, 66, 40), M.Wood)
	end
	Kit.wedge(parent, Vector3.new(w + 2, 5, d / 2 + 1), cf * CFrame.new(0, 12.5, -d / 4), Color3.fromRGB(70, 50, 40), M.WoodPlanks)
	Kit.wedge(parent, Vector3.new(w + 2, 5, d / 2 + 1), cf * CFrame.new(0, 12.5, d / 4) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(70, 50, 40), M.WoodPlanks)
	Kit.block(parent, Vector3.new(4, 7, 0.4), cf * CFrame.new(0, 3.5, -d / 2 - 0.1), Color3.fromRGB(70, 46, 30), M.Wood)
	Kit.post(parent, 6, 2, (cf * CFrame.new(w / 2 - 2, 10, d / 4)).Position, Color3.fromRGB(120, 110, 100), M.Cobblestone)
end

local function waterfall(parent: Instance, top: Vector3, height: number, width: number)
	local water = Kit.block(parent, Vector3.new(width, height, 1), CFrame.new(top - Vector3.new(0, height / 2, 0)), Color3.fromRGB(150, 200, 240), M.Glass)
	water.Transparency = 0.35
	water.CanCollide = false
	local foam = Kit.block(parent, Vector3.new(width + 4, 1, 6), CFrame.new(top - Vector3.new(0, height - 0.2, -2)), Color3.fromRGB(240, 250, 255), M.SmoothPlastic)
	foam.CanCollide = false
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(Color3.fromRGB(235, 245, 255))
	mist.Transparency = NumberSequence.new(0.5, 1)
	mist.Size = NumberSequence.new(2, 6)
	mist.Lifetime = NumberRange.new(1, 2)
	mist.Speed = NumberRange.new(2, 4)
	mist.Rate = 8
	mist.Parent = foam
end

local function backwoods(parent: Instance)
	local f = Kit.folder("BackwoodsJunction", parent)
	local land = Config.landById("Backwoods") :: Config.Land
	local dir = Vector3.new(-127, 0, -86).Unit
	Kit.arch(f, look(Vector3.new(-100, 0.4, -142), dir), 22, "BACKWOODS JUNCTION", { land.color, C.Cream })
	cabin(f, CFrame.new(-228, 0.4, -150), 16, 12)
	cabin(f, CFrame.new(-196, 0.4, -150), 14, 12)
	Kit.waterTower(f, Vector3.new(-340, 0, -165), "BACKWOODS", Color3.fromRGB(140, 100, 64), Color3.fromRGB(90, 66, 44))
	waterfall(f, Vector3.new(-300, 38, -394), 38, 10)
	waterfall(f, Vector3.new(-252, 30, -396), 30, 8)
	-- Old Rusty, the runaway tow truck, by the coaster queue
	truckStatue(f, CFrame.new(-190, 0.4, -238) * CFrame.Angles(0, math.rad(200), 0), Color3.fromRGB(200, 120, 40), 0.55)
	Kit.postSign(f, "OLD RUSTY\nHas anyone seen my brakes?", Vector3.new(-200, 0.4, -226), Vector3.new(0, 0, 1), 10, 3.5, { bg = Color3.fromRGB(90, 62, 40), fg = C.Cream, font = Enum.Font.GothamBold })
	-- mine carts and lanterns
	for i = 0, 2 do
		local p = Vector3.new(-232 + i * 6, 0.4, -212)
		Kit.box(f, Vector3.new(4, 3, 5), p + Vector3.new(0, 1, 0), Color3.fromRGB(90, 70, 50), M.CorrodedMetal)
		Kit.box(f, Vector3.new(3.4, 1, 4.4), p + Vector3.new(0, 4, 0), Color3.fromRGB(60, 60, 64), M.Slate)
	end
	for _, p in { Vector3.new(-244, 0.4, -160), Vector3.new(-152, 0.4, -160), Vector3.new(-244, 0.4, -220), Vector3.new(-152, 0.4, -220) } do
		Kit.lamp(f, p, Color3.fromRGB(255, 190, 120))
	end
	Kit.fence(f, Vector3.new(-245, 0.4, -224), Vector3.new(-150, 0.4, -224), 3, Color3.fromRGB(120, 84, 52))
	block(-358, -380, -232, -222) -- Backwoods Rapids
	block(-232, -380, -108, -232) -- Runaway Tow Truck
	block(-306, -202, -272, -158) -- Trading Post
	block(-148, -212, -112, -168) -- Pork Chop Diner
	block(-247, -224, -148, -156) -- plaza
	block(-238, -158, -186, -142) -- cabins
	blockCircle(-340, -165, 10)
end

---------------------------------------------------------------------------
-- Benton Movie Studios
---------------------------------------------------------------------------
local function studios(parent: Instance)
	local f = Kit.folder("MovieStudios", parent)
	local cream = Color3.fromRGB(236, 228, 210)
	local purple = Color3.fromRGB(150, 110, 200)
	-- studio gate facade
	for _, seg in { { -100, -36 }, { 36, 100 } } do
		local x1, x2 = seg[1], seg[2]
		Kit.block(f, Vector3.new(x2 - x1, 22, 4), CFrame.new((x1 + x2) / 2, 11.4, -140), cream, M.Concrete)
		Kit.block(f, Vector3.new(x2 - x1 + 1, 1.4, 5), CFrame.new((x1 + x2) / 2, 23, -140), purple, M.SmoothPlastic)
		for x = x1 + 8, x2 - 8, 14 do
			local w = Kit.block(f, Vector3.new(6, 9, 0.3), CFrame.new(x, 12, -137.9), Color3.fromRGB(150, 196, 220), M.Glass)
			w.Transparency = 0.2
		end
	end
	for _, sx in { -1, 1 } do
		Kit.box(f, Vector3.new(10, 34, 10), Vector3.new(sx * 31, 0.4, -140), cream, M.Concrete)
		Kit.box(f, Vector3.new(12, 2, 12), Vector3.new(sx * 31, 34.4, -140), purple, M.SmoothPlastic)
		local spot = Kit.block(f, Vector3.new(2, 2, 3), CFrame.new(sx * 31, 37.4, -140) * CFrame.Angles(math.rad(60), 0, 0), Color3.fromRGB(40, 40, 46), M.Metal)
		local beam = Instance.new("SpotLight")
		beam.Angle = 25
		beam.Range = 60
		beam.Brightness = 3
		beam.Face = Enum.NormalId.Front
		beam.Color = Color3.fromRGB(255, 240, 210)
		beam.Parent = spot
	end
	Kit.block(f, Vector3.new(72, 10, 8), CFrame.new(0, 30.4, -140), cream, M.Concrete)
	Kit.sign(f, "BENTON MOVIE STUDIOS", Vector3.new(62, 6.5, 0.4), CFrame.new(0, 30.4, -135.8) * CFrame.Angles(0, math.pi, 0), { bg = C.Navy, fg = C.Gold, font = Enum.Font.GothamBlack, glow = true })
	Kit.sign(f, "NOW FILMING", Vector3.new(30, 4, 0.4), CFrame.new(0, 30.4, -144.2), { bg = C.Navy, fg = C.Cream, font = Enum.Font.GothamBlack, glow = true })
	Kit.gear(f, CFrame.new(0, 42, -140) * CFrame.Angles(0, math.pi, 0), 13, C.Gold)
	-- soundstages 1-5
	for i = 1, 5 do
		local x = -78 + (i - 1) * 39
		Kit.box(f, Vector3.new(34, 36, 45), Vector3.new(x, 0, -357.5), Color3.fromRGB(150, 152, 158), M.Concrete)
		Kit.box(f, Vector3.new(35, 3, 46), Vector3.new(x, 36, -357.5), Color3.fromRGB(110, 112, 118), M.Metal)
		Kit.sign(f, tostring(i), Vector3.new(10, 12, 0.3), CFrame.new(x, 22, -334.8) * CFrame.Angles(0, math.pi, 0), { transparentBg = true, fg = Color3.fromRGB(50, 52, 58), font = Enum.Font.GothamBlack })
		local door = Kit.block(f, Vector3.new(14, 16, 0.4), CFrame.new(x, 8.4, -334.9), Color3.fromRGB(120, 122, 128), M.DiamondPlate)
		door.Name = "StageDoor" .. i
	end
	Kit.sign(f, "BACKSTAGE", Vector3.new(30, 4, 0.4), CFrame.new(0, 33, -334.6) * CFrame.Angles(0, math.pi, 0), { bg = C.Navy, fg = C.Cream, font = Enum.Font.GothamBlack })
	-- New York street facades on the backlot
	local fronts = { { "HOTEL BENTON", Color3.fromRGB(170, 90, 70) }, { "DINER", Color3.fromRGB(80, 120, 160) }, { "THEATRE", Color3.fromRGB(150, 60, 80) } }
	for i, fr in fronts do
		local z = -270 - (i - 1) * 11
		local cf = CFrame.lookAt(Vector3.new(-48, 0.4, z), Vector3.new(0, 0.4, z))
		Kit.building(f, cf, { size = Vector3.new(10, 20 + i * 4, 10), wall = fr[2] :: Color3, trim = cream, windows = true, sign = fr[1] :: string, signColors = { C.Navy, C.Gold } })
	end
	Kit.waterTower(f, Vector3.new(-92, 0, -305), "STUDIOS", Color3.fromRGB(230, 230, 230), Color3.fromRGB(120, 120, 126))
	for z = -160, -290, -26 do
		Kit.tree(f, Vector3.new(25, 0.4, z), "palm", 0.9)
		Kit.lamp(f, Vector3.new(-25, 0.4, z - 13))
	end
	block(-110, -400, 115, -318) -- tram + soundstages
	block(-80, -300, -30, -160) -- west buildings
	block(28, -290, 112, -182) -- arena
	blockCircle(-92, -305, 9)
end

-- The Backlot Stunt Arena (show venue).
local function stuntArena(parent: Instance)
	local f = Kit.folder("StuntArena", parent)
	local dirt = Color3.fromRGB(150, 120, 90)
	Kit.pad(f, 32, -282, 108, -214, dirt, M.Ground, 0.5)
	-- walls (north, east, west)
	Kit.box(f, Vector3.new(78, 6, 2), Vector3.new(70, 0.4, -283), Color3.fromRGB(70, 72, 80), M.Concrete)
	Kit.box(f, Vector3.new(2, 6, 70), Vector3.new(31, 0.4, -248), Color3.fromRGB(70, 72, 80), M.Concrete)
	Kit.box(f, Vector3.new(2, 6, 70), Vector3.new(109, 0.4, -248), Color3.fromRGB(70, 72, 80), M.Concrete)
	-- bleachers on the south side, facing north
	for step = 0, 4 do
		local z = -210 + step * 4
		local y = 1 + step * 2.2
		Kit.block(f, Vector3.new(76, y, 4), CFrame.new(70, y / 2 + 0.4, z), Color3.fromRGB(110, 114, 124), M.Concrete)
		for x = 36, 104, 6 do
			local seat = Instance.new("Seat")
			seat.Size = Vector3.new(4, 0.6, 2)
			seat.CFrame = CFrame.new(x, y + 0.7, z) * CFrame.Angles(0, 0, 0)
			seat.Anchored = true
			seat.Color = if step % 2 == 0 then C.Red else C.Navy
			seat.Material = M.SmoothPlastic
			seat.Parent = f
		end
	end
	Kit.box(f, Vector3.new(80, 1, 2), Vector3.new(70, 0.4, -212.5), C.Gold, M.Metal)
	-- ramps used by the stunt trucks
	local rampA = Kit.wedge(f, Vector3.new(10, 6, 16), CFrame.new(52, 3.5, -250) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(110, 110, 116), M.DiamondPlate)
	local rampB = Kit.wedge(f, Vector3.new(10, 6, 16), CFrame.new(88, 3.5, -250) * CFrame.Angles(0, math.rad(-90), 0), Color3.fromRGB(110, 110, 116), M.DiamondPlate)
	rampA.Name = "RampA"
	rampB.Name = "RampB"
	-- wrecked cars and fire pots as set dressing
	for _, p in { Vector3.new(40, 0.5, -274), Vector3.new(100, 0.5, -274) } do
		Kit.box(f, Vector3.new(6, 3, 10), p, Color3.fromRGB(90, 60, 50), M.CorrodedMetal, 25)
	end
	for _, p in { Vector3.new(36, 0.5, -220), Vector3.new(104, 0.5, -220), Vector3.new(36, 0.5, -278), Vector3.new(104, 0.5, -278) } do
		local pot = Kit.post(f, 3, 3, p, Color3.fromRGB(50, 50, 54), M.Metal)
		pot.Name = "FirePot"
		pot:AddTag("StuntFirePot")
	end
	-- marquee
	Kit.postSign(f, "DIESEL STUNT SPECTACULAR", Vector3.new(70, 0.4, -286), Vector3.new(0, 0, 1), 46, 7, { bg = C.Navy, fg = C.Orange, font = Enum.Font.GothamBlack, glow = true })
end

---------------------------------------------------------------------------
-- Velocity City
---------------------------------------------------------------------------
local function velocity(parent: Instance)
	local f = Kit.folder("VelocityCity", parent)
	local land = Config.landById("Velocity") :: Config.Land
	local dir = Vector3.new(90, 0, -50).Unit
	Kit.arch(f, look(Vector3.new(78, 0.4, -122), dir), 24, "VELOCITY CITY", { Color3.fromRGB(30, 34, 44), land.color })
	-- checkered stripes across the plaza
	for i = 0, 15 do
		for row = 0, 1 do
			local color = if (i + row) % 2 == 0 then Color3.new(1, 1, 1) else Color3.fromRGB(20, 20, 20)
			local tile = Kit.block(f, Vector3.new(4, 0.1, 4), CFrame.new(140 + i * 4, 0.46, -150 + row * 4), color, M.SmoothPlastic)
			tile.CastShadow = false
		end
	end
	-- the Velocity car on a turntable pedestal
	Kit.disc(f, 22, 2, Vector3.new(185, 2.4, -128), Color3.fromRGB(30, 34, 44), M.Metal)
	local carCF = CFrame.new(185, 2.4, -128) * CFrame.Angles(0, math.rad(30), 0)
	Kit.block(f, Vector3.new(7, 1.6, 16), carCF * CFrame.new(0, 1.6, 0), land.color, M.SmoothPlastic)
	Kit.wedge(f, Vector3.new(6, 1.6, 5), carCF * CFrame.new(0, 2.4, -6), land.color, M.SmoothPlastic)
	Kit.block(f, Vector3.new(3, 1.6, 4), carCF * CFrame.new(0, 3.2, 1), Color3.fromRGB(20, 20, 26), M.Glass)
	Kit.block(f, Vector3.new(8, 0.4, 2), carCF * CFrame.new(0, 4.2, 7), Color3.fromRGB(20, 20, 26), M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		for _, sz in { -5, 5 } do
			Kit.cyl(f, 1.4, 3, carCF * CFrame.new(sx * 3.8, 1.5, sz), Color3.fromRGB(20, 20, 20), M.SmoothPlastic)
		end
	end
	-- SPEED FUELS PEOPLE TOGETHER billboard
	Kit.postSign(f, "SPEED FUELS PEOPLE TOGETHER", Vector3.new(185, 0.4, -214), Vector3.new(0, 0, 1), 48, 10, { bg = Color3.fromRGB(20, 22, 30), fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBlack, glow = true, both = true })
	Kit.postSign(f, "RACE TODAY\nADMIRE TOMORROW", Vector3.new(214, 0.4, -84), Vector3.new(-0.5, 0, 1).Unit, 14, 6, { bg = Color3.fromRGB(20, 22, 30), fg = land.color, font = Enum.Font.GothamBlack, glow = true, both = true })
	-- start-light gantry over the plaza entrance
	for _, sx in { -1, 1 } do
		Kit.post(f, 16, 1, Vector3.new(128 + sx * 8, 0.4, -158), Color3.fromRGB(40, 40, 46), M.Metal)
	end
	Kit.block(f, Vector3.new(18, 2, 1.4), CFrame.new(128, 16.4, -158), Color3.fromRGB(40, 40, 46), M.Metal)
	for i = -3, 3 do
		local bulb = Kit.ball(f, 1.2, Vector3.new(128 + i * 2.2, 16.4, -157.1), if i < 2 then C.Red else C.Green, M.Neon)
		bulb.CastShadow = false
	end
	-- tire stacks
	for _, p in { Vector3.new(124, 0.4, -95), Vector3.new(222, 0.4, -95), Vector3.new(222, 0.4, -205) } do
		for k = 0, 3 do
			Kit.post(f, 1, 3, p + Vector3.new(0, k * 1, 0), Color3.fromRGB(20, 20, 20), M.Rubber)
		end
	end
	for _, p in { Vector3.new(124, 0.4, -120), Vector3.new(222, 0.4, -120), Vector3.new(124, 0.4, -205), Vector3.new(160, 0.4, -205) } do
		Kit.lamp(f, p, Color3.fromRGB(170, 200, 255))
	end
	block(150, -400, 360, -224) -- Velocity Viper
	block(228, -222, 360, -60) -- Nitro Loop
	blockCircle(140, -250, 18) -- Tower
	block(190, -60, 360, 18) -- Speedway
	block(116, -212, 230, -84) -- plaza
end

---------------------------------------------------------------------------
-- Benton Family Landing
---------------------------------------------------------------------------
local function lakesideStage(parent: Instance)
	local f = Kit.folder("LakesideStage", parent)
	local wood = Color3.fromRGB(170, 120, 80)
	Kit.box(f, Vector3.new(52, 4, 22), Vector3.new(225, 0.2, 187), wood, M.WoodPlanks)
	Kit.box(f, Vector3.new(56, 20, 2), Vector3.new(225, 4.2, 177), Color3.fromRGB(40, 60, 90), M.SmoothPlastic)
	Kit.sign(f, "LAKESIDE STAGE", Vector3.new(30, 4, 0.4), CFrame.new(225, 19, 178.3) * CFrame.Angles(0, math.pi, 0), { bg = C.Navy, fg = C.Gold, font = Enum.Font.GothamBlack, glow = true })
	Kit.sign(f, "BIG DREAMS LIVE!", Vector3.new(22, 3, 0.4), CFrame.new(225, 14, 178.3) * CFrame.Angles(0, math.pi, 0), { transparentBg = true, fg = C.Cream, font = Enum.Font.GothamBlack, glow = true })
	-- roof on posts
	for _, x in { 199, 251 } do
		for _, z in { 178, 197 } do
			Kit.post(f, 22, 1, Vector3.new(x, 4.2, z), Color3.fromRGB(60, 60, 66), M.Metal)
		end
	end
	Kit.block(f, Vector3.new(60, 1.2, 26), CFrame.new(225, 26.8, 187.5), Color3.fromRGB(240, 240, 236), M.Fabric)
	-- light rig the show animates
	for i = 0, 5 do
		local x = 205 + i * 8
		local can = Kit.block(f, Vector3.new(1.6, 1.6, 2.4), CFrame.new(x, 25.4, 196) * CFrame.Angles(math.rad(-50), 0, 0), Color3.fromRGB(30, 30, 34), M.Metal)
		can.Name = "StageLight" .. (i + 1)
		can:AddTag("StageLight")
		local spot = Instance.new("SpotLight")
		spot.Angle = 40
		spot.Range = 40
		spot.Brightness = 0
		spot.Face = Enum.NormalId.Front
		spot.Parent = can
	end
	for _, x in { 193, 257 } do
		Kit.box(f, Vector3.new(5, 12, 5), Vector3.new(x, 0.4, 194), Color3.fromRGB(30, 30, 34), M.SmoothPlastic)
	end
	-- audience benches
	for row = 0, 4 do
		local z = 210 + row * 7
		for _, x in { 207, 243 } do
			Kit.bench(f, CFrame.new(x - 6, 0.4, z) * CFrame.Angles(0, 0, 0))
			Kit.bench(f, CFrame.new(x + 6, 0.4, z) * CFrame.Angles(0, 0, 0))
		end
	end
	-- lake fountains (switched on by the show on each client)
	for k = 0, 6 do
		local a = math.rad(200 + k * 20)
		local p = Vector3.new(235 + math.cos(a) * 30, -1, 125 - math.sin(a) * 30)
		local jet = Kit.block(f, Vector3.new(1, 1, 1), CFrame.new(p), Color3.fromRGB(80, 80, 86), M.Metal)
		jet.Name = "Fountain" .. (k + 1)
		jet.Transparency = 1
		jet.CanCollide = false
		jet:AddTag("LakeFountain")
		local spray = Instance.new("ParticleEmitter")
		spray.Name = "Spray"
		spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		spray.Color = ColorSequence.new(Color3.fromRGB(200, 230, 255))
		spray.Size = NumberSequence.new(1.2, 0.4)
		spray.Speed = NumberRange.new(34, 40)
		spray.SpreadAngle = Vector2.new(5, 5)
		spray.Lifetime = NumberRange.new(1.6, 2)
		spray.Acceleration = Vector3.new(0, -40, 0)
		spray.Rate = 60
		spray.EmissionDirection = Enum.NormalId.Top
		spray.LightEmission = 0.6
		spray.Enabled = false
		spray.Parent = jet
	end
end

local function playground(parent: Instance, center: Vector3)
	local f = Kit.folder("Playground", parent)
	Kit.pad(f, center.X - 22, center.Z - 14, center.X + 22, center.Z + 14, Color3.fromRGB(80, 150, 200), M.Rubber, 0.5)
	local colors = { C.Red, C.Gold, C.Blue, C.Green }
	for i, dx in { -12, 0, 12 } do
		local base = center + Vector3.new(dx, 0.5, 0)
		Kit.box(f, Vector3.new(6, 8, 6), base, colors[i], M.SmoothPlastic)
		Kit.wedge(f, Vector3.new(6, 4, 6), CFrame.new(base + Vector3.new(0, 10, 0)), colors[i + 1], M.SmoothPlastic)
		Kit.wedge(f, Vector3.new(3, 8, 10), CFrame.new(base + Vector3.new(0, 4, 8)) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(220, 220, 225), M.Metal)
	end
	Kit.beam(f, center + Vector3.new(-12, 8.5, 0), center + Vector3.new(12, 8.5, 0), 1, C.Orange, M.Metal, true)
end

local function family(parent: Instance)
	local f = Kit.folder("FamilyLanding", parent)
	local land = Config.landById("Family") :: Config.Land
	Kit.arch(f, look(Vector3.new(92, 0.4, 60), Vector3.new(1, 0, 0)), 20, "BENTON FAMILY LANDING", { Color3.fromRGB(120, 84, 52), land.color })
	Kit.arch(f, look(Vector3.new(92, 0.4, 246), Vector3.new(1, 0, 0)), 20, "BENTON FAMILY LANDING", { Color3.fromRGB(120, 84, 52), land.color })
	lakesideStage(f)
	playground(f, Vector3.new(150, 0, 80))
	Kit.waterTower(f, Vector3.new(362, 0, 120), "BIG DREAMS", Color3.fromRGB(210, 214, 220), Color3.fromRGB(120, 120, 126))
	-- dock and rowboats on the east shore
	Kit.box(f, Vector3.new(26, 1, 6), Vector3.new(278, 0.2, 125), Color3.fromRGB(150, 110, 70), M.WoodPlanks)
	for i, z in { 115, 135 } do
		local boat = Kit.block(f, Vector3.new(4, 1.4, 9), CFrame.new(268, 0.2, z) * CFrame.Angles(0, math.rad(80 + i * 15), 0), if i == 1 then C.Red else C.Blue, M.Wood)
		boat.CanCollide = false
	end
	-- railroad crossings where walkways meet the Lakeside Express
	for _, z in { 60, 246 } do
		for _, dz in { -11, 11 } do
			local base = Vector3.new(103, 0.4, z + dz)
			Kit.post(f, 10, 0.5, base, Color3.new(1, 1, 1), M.Metal)
			for _, a in { 35, -35 } do
				local cross = Kit.block(f, Vector3.new(0.3, 1, 7), CFrame.new(base + Vector3.new(0, 9, 0)) * CFrame.Angles(math.rad(a), 0, 0), Color3.new(1, 1, 1), M.SmoothPlastic)
				Kit.label(cross, Enum.NormalId.Left, "RAILROAD", { fg = Color3.fromRGB(20, 20, 20), font = Enum.Font.GothamBlack })
				Kit.label(cross, Enum.NormalId.Right, "CROSSING", { fg = Color3.fromRGB(20, 20, 20), font = Enum.Font.GothamBlack })
			end
			Kit.ball(f, 1, base + Vector3.new(0, 7, 0.6), C.Red, M.Neon)
		end
	end
	Kit.postSign(f, "LAKESIDE DEPOT", Vector3.new(252, 0.4, 276), Vector3.new(0, 0, -1), 22, 4, { bg = Color3.fromRGB(30, 90, 60), fg = C.Gold, font = Enum.Font.GothamBlack, both = true })
	for _, p in { Vector3.new(120, 0.4, 100), Vector3.new(120, 0.4, 170), Vector3.new(300, 0.4, 90), Vector3.new(300, 0.4, 200), Vector3.new(180, 0.4, 246), Vector3.new(284, 0.4, 248) } do
		Kit.lamp(f, p)
	end
	for _, p in { Vector3.new(175, 0.4, 180), Vector3.new(290, 0.4, 175) } do
		Kit.flowerBed(f, p, 10, 6)
	end
	blockCircle(235, 125, 60) -- lake
	block(190, 170, 262, 248) -- stage + audience
	blockCircle(148, 205, 24) -- carousel
	blockCircle(150, 120, 28) -- spinner
	block(126, 64, 174, 96) -- playground
	block(300, 205, 340, 250) -- depot grill
	block(305, 95, 340, 135) -- gifts
	blockCircle(362, 120, 9)
end

---------------------------------------------------------------------------
-- Trees everywhere there is room
---------------------------------------------------------------------------
local function trees(parent: Instance)
	local f = Kit.folder("Trees", parent)
	-- walkways and main street
	block(-75, -125, 75, 285)
	block(-30, 5, -160, 25)
	block(-160, -200, -30, -95)
	block(25, -160, 140, -55)
	block(20, 50, 120, 70)
	block(55, 236, 120, 256)
	block(-160, 225, -55, 250)
	block(100, 40, 115, 265)
	block(100, 250, 350, 270) -- train south row
	block(100, 35, 350, 55) -- train north row
	block(340, 40, 352, 265) -- train east column
	block(-160, 40, -144, 195)
	block(-35, -320, 35, -110)
	local rng = Random.new(31)
	local placed = 0
	local tries = 0
	local b = Config.Bounds
	while placed < 260 and tries < 6000 do
		tries += 1
		local x = rng:NextNumber(b.minX + 6, b.maxX - 6)
		local z = rng:NextNumber(b.minZ + 6, b.maxZ - 6)
		if isFree(x, z, 5) then
			local land = Config.landAt(Vector3.new(x, 0, z))
			local kind = "round"
			if land and land.id == "Backwoods" then
				kind = "pine"
			elseif land and land.id == "Velocity" then
				kind = if rng:NextNumber() < 0.5 then "round" else "pine"
			elseif land and land.id == "Studios" then
				kind = "palm"
			else
				kind = if rng:NextNumber() < 0.7 then "round" else "pine"
			end
			Kit.tree(f, Vector3.new(x, 0, z), kind, nil)
			block(x - 3, z - 3, x + 3, z + 3)
			placed += 1
		end
	end
	-- a ring of trees outside the walls
	for i = 0, 70 do
		local t = i / 70
		local x, z
		if i % 2 == 0 then
			x = b.minX - 14 - rng:NextNumber(0, 30)
			z = b.minZ + (b.maxZ - b.minZ) * t
		else
			x = b.maxX + 14 + rng:NextNumber(0, 30)
			z = b.minZ + (b.maxZ - b.minZ) * t
		end
		Kit.tree(f, Vector3.new(x, 0, z), if rng:NextNumber() < 0.5 then "pine" else "round", rng:NextNumber(1.1, 1.6))
	end
	for i = 0, 40 do
		local x = b.minX + (b.maxX - b.minX) * (i / 40)
		Kit.tree(f, Vector3.new(x, 0, b.minZ - 16 - rng:NextNumber(0, 30)), "pine", rng:NextNumber(1.2, 1.8))
	end
end

function Lands.build(root: Instance)
	local f = Kit.folder("Lands", root)
	diesel(f)
	haulers(f)
	backwoods(f)
	studios(f)
	stuntArena(f)
	velocity(f)
	family(f)
	-- shops and restaurants are built by Venues; keep trees off them too
	for _, venue in Config.Venues do
		local p = venue.position
		local r = math.max(venue.size.X, venue.size.Z) / 2 + 8
		block(p.X - r, p.Z - r, p.X + r, p.Z + r)
	end
	for _, ride in Config.Rides do
		blockCircle(ride.entrance.X, ride.entrance.Z, 12)
		blockCircle(ride.exit.X, ride.exit.Z, 8)
		-- queue maze and its walkway
		local line = QueueLine.get(ride.id)
		if line then
			local cf, size = line.mazeCFrame, line.mazeSize
			local a = cf * Vector3.new(-size.X / 2 - 2, 0, -size.Z / 2 - 2)
			local b = cf * Vector3.new(size.X / 2 + 2, 0, size.Z / 2 + 2)
			block(a.X, a.Z, b.X, b.Z)
			for i = 2, #line.walkway do
				local p, q = line.walkway[i - 1], line.walkway[i]
				block(math.min(p.X, q.X) - 3, math.min(p.Z, q.Z) - 3, math.max(p.X, q.X) + 3, math.max(p.Z, q.Z) + 3)
			end
		end
	end
	-- themed set dressing (keep trees off it)
	for _, fp in Theming.build(f) do
		blockCircle(fp[1], fp[2], fp[3])
	end
	trees(f)
	local _ = HALF_PI
end

return Lands
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ParkBuilder</string>
            <string name="Source"><![CDATA[-- Builds the whole park into Workspace.BentonDieselWorld.

local Kit = require(script.Parent.Kit)
local Ground = require(script.Parent.Ground)
local Plaza = require(script.Parent.Plaza)
local Venues = require(script.Parent.Venues)
local RideBuilder = require(script.Parent.RideBuilder)
local Lands = require(script.Parent.Lands)

local ParkBuilder = {}

export type Built = {
	root: Model,
	rides: { [string]: RideBuilder.RideInfo },
	venues: { [string]: Venues.VenueInfo },
	boards: { Part },
}

function ParkBuilder.build(): Built
	local old = workspace:FindFirstChild("BentonDieselWorld")
	if old then
		old:Destroy()
	end
	for _, name in { "Baseplate", "PressPlay" } do
		local leftover = workspace:FindFirstChild(name)
		if leftover then
			leftover:Destroy()
		end
	end
	local root = Instance.new("Model")
	root.Name = "BentonDieselWorld"
	-- build off-world, then parent once (much faster replication)
	Ground.build(root)
	local boards = Plaza.build(root)
	local venues = Venues.build(root)
	local rides = RideBuilder.build(root)
	Lands.build(root)
	root.Parent = workspace
	local _ = Kit
	return { root = root, rides = rides, venues = venues, boards = boards }
end

return ParkBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Plaza</string>
            <string name="Source"><![CDATA[-- Benton Plaza: entry plaza, Main Street, the Hub with the Benton Globe,
-- the wait-times board, and the walkways that connect every land.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Kit = require(script.Parent.Kit)

local M = Enum.Material
local C = Config.Colors

local Plaza = {}

local PAVER = C.Paver
local WALK = Color3.fromRGB(205, 192, 176)

local function walkways(parent: Instance)
	local f = Kit.folder("Walkways", parent)
	-- entry plaza + Main Street + Hub
	Kit.pad(f, -62, 222, 62, 281, PAVER, M.Brick)
	Kit.pad(f, -26, -4, 26, 226, PAVER, M.Brick)
	Kit.pad(f, -30, -4, -26, 226, WALK, M.Pavement, 0.45)
	Kit.pad(f, 26, -4, 30, 226, WALK, M.Pavement, 0.45)
	Kit.roundPad(f, Vector3.new(0, 0, -60), 124, PAVER, M.Brick)
	-- Diesel District connector and square
	Kit.path(f, Vector3.new(-26, 0, 15), Vector3.new(-160, 0, 15), 22, WALK)
	Kit.pad(f, -228, -28, -156, 48, Color3.fromRGB(150, 140, 130), M.Concrete)
	Kit.path(f, Vector3.new(-200, 0, -28), Vector3.new(-292, 0, -40), 16, WALK)
	Kit.path(f, Vector3.new(-170, 0, 40), Vector3.new(-148, 0, 52), 14, WALK)
	Kit.path(f, Vector3.new(-152, 0, 48), Vector3.new(-152, 0, 192), 14, WALK)
	-- Little Haulers connector and plaza
	Kit.path(f, Vector3.new(-62, 0, 240), Vector3.new(-150, 0, 232), 20, WALK)
	Kit.roundPad(f, Vector3.new(-175, 0, 215), 64, Color3.fromRGB(240, 220, 150), M.Concrete)
	-- Backwoods Junction connector and plaza (packed dirt + planks)
	Kit.path(f, Vector3.new(-38, 0, -100), Vector3.new(-165, 0, -186), 22, WALK)
	Kit.pad(f, -245, -222, -150, -158, Color3.fromRGB(150, 118, 84), M.Ground)
	Kit.path(f, Vector3.new(-245, 0, -190), Vector3.new(-268, 0, -186), 12, Color3.fromRGB(150, 118, 84), M.Ground)
	-- Movie Studios connector, backlot street
	Kit.path(f, Vector3.new(0, 0, -118), Vector3.new(0, 0, -148), 30, WALK)
	Kit.pad(f, -22, -300, 22, -140, Color3.fromRGB(110, 110, 116), M.Asphalt)
	Kit.pad(f, -32, -300, -22, -140, WALK, M.Pavement, 0.45)
	Kit.pad(f, 22, -300, 30, -140, WALK, M.Pavement, 0.45)
	Kit.pad(f, -24, -318, 30, -300, WALK, M.Pavement)
	-- Velocity City connector and plaza
	Kit.path(f, Vector3.new(38, 0, -100), Vector3.new(128, 0, -150), 24, WALK)
	Kit.pad(f, 120, -210, 226, -86, Color3.fromRGB(90, 94, 104), M.Asphalt)
	Kit.path(f, Vector3.new(200, 0, -86), Vector3.new(205, 0, -62), 16, Color3.fromRGB(90, 94, 104), M.Asphalt)
	Kit.path(f, Vector3.new(58, 0, -60), Vector3.new(118, 0, -80), 18, WALK)
	-- Family Landing connectors and lakeside loop
	Kit.path(f, Vector3.new(26, 0, 60), Vector3.new(112, 0, 60), 20, WALK)
	Kit.path(f, Vector3.new(62, 0, 246), Vector3.new(112, 0, 246), 20, WALK)
	Kit.path(f, Vector3.new(112, 0, 46), Vector3.new(112, 0, 258), 18, WALK)
	Kit.path(f, Vector3.new(112, 0, 246), Vector3.new(300, 0, 246), 16, WALK)
	Kit.path(f, Vector3.new(112, 0, 60), Vector3.new(300, 0, 60), 14, WALK)
	Kit.path(f, Vector3.new(300, 0, 60), Vector3.new(300, 0, 246), 14, WALK)
	Kit.pad(f, 180, 202, 270, 244, Color3.fromRGB(196, 170, 130), M.WoodPlanks)
	-- Hub east spur to the Speedway / Pit Stop Pizza
	Kit.path(f, Vector3.new(118, 0, -80), Vector3.new(200, 0, -62), 14, Color3.fromRGB(90, 94, 104), M.Asphalt)
end

local function storefront(parent: Instance, x: number, z: number, width: number, depth: number, height: number, facing: string, wall: Color3, name: string)
	local yaw = if facing == "E" then -90 else 90
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(yaw), 0)
	Kit.building(parent, cf, {
		size = Vector3.new(width, height, depth),
		wall = wall,
		trim = C.Cream,
		roof = Color3.fromRGB(70, 60, 60),
		material = M.Brick,
		windows = true,
		awning = nil,
		sign = name,
		signColors = { C.Navy, C.Cream },
	})
end

local function mainStreet(parent: Instance)
	local f = Kit.folder("MainStreet", parent)
	local walls = {
		Color3.fromRGB(196, 90, 70),
		Color3.fromRGB(222, 196, 150),
		Color3.fromRGB(120, 140, 170),
		Color3.fromRGB(170, 110, 80),
		Color3.fromRGB(210, 170, 120),
	}
	local west = { { 112, "BENTON GAZETTE" }, { 80, "PHOTO DEPOT" }, { 48, "CANDY CO." }, { 212, "GUEST SERVICES" } }
	local east = { { 112, "GEARWORKS ARCADE" }, { 80, "BENTON BANK" }, { 48, "HAT & HUB" }, { 212, "LOCKERS" } }
	for i, w in west do
		storefront(f, -50, w[1] :: number, 30, 36, 22 + (i % 2) * 6, "E", walls[i], w[2] :: string)
	end
	for i, e in east do
		storefront(f, 50, e[1] :: number, 30, 36, 22 + ((i + 1) % 2) * 6, "W", walls[(i + 2) % #walls + 1], e[2] :: string)
	end
	-- banner poles and lamps down both sides of the street
	for z = 10, 220, 22 do
		Kit.bannerPole(f, Vector3.new(-23, 0.4, z), if (z // 22) % 2 == 0 then C.Red else C.Navy, Vector3.new(1, 0, 0))
		Kit.bannerPole(f, Vector3.new(23, 0.4, z + 11), if (z // 22) % 2 == 0 then C.Navy else C.Red, Vector3.new(-1, 0, 0))
		if z % 44 == 10 then
			Kit.tree(f, Vector3.new(-28, 0.4, z + 6), "round", 0.9)
			Kit.tree(f, Vector3.new(28, 0.4, z + 16), "round", 0.9)
		end
	end
	for z = 30, 210, 45 do
		Kit.bench(f, CFrame.new(-27, 0.4, z) * CFrame.Angles(0, math.rad(-90), 0))
		Kit.bench(f, CFrame.new(27, 0.4, z + 20) * CFrame.Angles(0, math.rad(90), 0))
	end
	-- BENTON PLAZA arch across the street
	Kit.arch(f, CFrame.new(0, 0.4, 132) * CFrame.Angles(0, 0, 0), 46, "BENTON PLAZA", { C.Red, C.Cream })
	-- entry plaza: flower beds, flags, the wait-times board
	Kit.flowerBed(f, Vector3.new(-40, 0.4, 262), 14, 8)
	Kit.flowerBed(f, Vector3.new(40, 0.4, 262), 14, 8)
	for _, x in { -55, 55 } do
		Kit.flag(f, Vector3.new(x, 0.4, 270), C.Red, 26)
	end
	for _, p in { Vector3.new(-58, 0.4, 230), Vector3.new(58, 0.4, 230), Vector3.new(-58, 0.4, 276), Vector3.new(58, 0.4, 276) } do
		Kit.lamp(f, p)
	end
end

-- The big wait-times board. Rows are filled in by RideService.
local function waitBoard(parent: Instance, cf: CFrame, name: string): Part
	local f = Kit.model(name, parent)
	local w, h = 30, 26
	local dark = Color3.fromRGB(16, 22, 36)
	for _, sx in { -1, 1 } do
		Kit.block(f, Vector3.new(1.4, h + 6, 1.4), cf * CFrame.new(sx * (w / 2 + 0.7), (h + 6) / 2, 0), C.Navy, M.Metal)
	end
	local board = Kit.block(f, Vector3.new(w, h, 1), cf * CFrame.new(0, 6 + h / 2, 0), dark, M.SmoothPlastic)
	board.Name = "Board"
	Kit.block(f, Vector3.new(w + 2, 3, 2), cf * CFrame.new(0, 6 + h + 1.5, 0), C.Orange, M.SmoothPlastic)
	local title = Kit.sign(f, "RIDE WAIT TIMES", Vector3.new(w, 2.6, 0.3), cf * CFrame.new(0, 6 + h + 1.5, -1.1), {
		bg = C.Orange,
		fg = C.Navy,
		font = Enum.Font.GothamBlack,
		glow = true,
	})
	title.Name = "Title"
	Kit.label(board, Enum.NormalId.Back, "BENTON DIESEL WORLD\nRide wait times on the other side", { fg = C.Cream, font = Enum.Font.GothamBlack })
	return board
end

local function hub(parent: Instance)
	local f = Kit.folder("Hub", parent)
	local center = Vector3.new(0, 0, -60)
	-- fountain basin
	Kit.disc(f, 48, 2.4, center + Vector3.new(0, 2.6, 0), Color3.fromRGB(196, 190, 180), M.Concrete)
	local water = Kit.disc(f, 44, 0.6, center + Vector3.new(0, 2.7, 0), Color3.fromRGB(60, 140, 200), M.Glass)
	water.Transparency = 0.25
	water.CanCollide = false
	Kit.disc(f, 14, 6, center + Vector3.new(0, 8, 0), Color3.fromRGB(196, 190, 180), M.Concrete)
	-- the Benton Globe (spun slowly by clients)
	local globe = Kit.model("BentonGlobe", f)
	local ball = Kit.ball(globe, 26, center + Vector3.new(0, 22, 0), Color3.fromRGB(40, 110, 210), M.SmoothPlastic)
	ball.Name = "Globe"
	globe.PrimaryPart = ball
	local land = Color3.fromRGB(70, 160, 80)
	local spots = { { 0.4, 0.3, 0.2 }, { -0.5, 0.1, 0.4 }, { 0.2, -0.4, -0.6 }, { -0.3, 0.5, -0.5 }, { 0.6, -0.2, 0.5 }, { -0.6, -0.4, -0.1 } }
	for _, s in spots do
		local dir = Vector3.new(s[1], s[2], s[3]).Unit
		local pos = center + Vector3.new(0, 22, 0) + dir * 12.6
		Kit.ellipsoid(globe, Vector3.new(9, 6, 2.4), CFrame.lookAt(pos, pos + dir), land, M.SmoothPlastic)
	end
	-- golden gear ring around the globe
	local ringCF = CFrame.new(center + Vector3.new(0, 22, 0)) * CFrame.Angles(0, math.rad(30), 0)
	for k = 0, 23 do
		local a = k * math.pi / 12
		local cf = ringCF * CFrame.Angles(0, 0, a) * CFrame.new(0, 17, 0)
		Kit.block(globe, Vector3.new(4.6, 2.2, 2.2), cf, C.Gold, M.Metal)
		if k % 2 == 0 then
			Kit.block(globe, Vector3.new(2.2, 2.4, 2.2), cf * CFrame.new(0, 1.6, 0), C.Gold, M.Metal)
		end
	end
	globe:SetAttribute("SpinSpeed", 0.12)
	globe:AddTag("Spinner")
	local glow = Kit.light(ball, Color3.fromRGB(150, 200, 255), 40, 1)
	glow.Shadows = false
	-- fountain jets
	for k = 0, 7 do
		local a = k * math.pi / 4
		local p = center + Vector3.new(math.cos(a) * 18, 3, math.sin(a) * 18)
		local jet = Kit.block(f, Vector3.new(1, 1, 1), CFrame.new(p), Color3.fromRGB(196, 190, 180), M.Concrete)
		local spray = Instance.new("ParticleEmitter")
		spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		spray.Color = ColorSequence.new(Color3.fromRGB(200, 230, 255))
		spray.Size = NumberSequence.new(0.6, 0.2)
		spray.Speed = NumberRange.new(16, 20)
		spray.SpreadAngle = Vector2.new(4, 4)
		spray.Lifetime = NumberRange.new(0.9, 1.1)
		spray.Acceleration = Vector3.new(0, -30, 0)
		spray.Rate = 40
		spray.EmissionDirection = Enum.NormalId.Top
		spray.LightEmission = 0.4
		spray.Parent = jet
	end
	-- flower ring, benches, lamps
	for k = 0, 7 do
		local a = k * math.pi / 4 + math.pi / 8
		local p = center + Vector3.new(math.cos(a) * 38, 0.4, math.sin(a) * 38)
		Kit.flowerBed(f, p, 8, 8)
		local lp = center + Vector3.new(math.cos(a + 0.35) * 54, 0.4, math.sin(a + 0.35) * 54)
		Kit.lamp(f, lp)
		local bp = center + Vector3.new(math.cos(a - 0.35) * 30, 0.4, math.sin(a - 0.35) * 30)
		Kit.bench(f, CFrame.lookAt(bp, center))
	end
	Kit.postSign(f, "THE HUB\nAll lands this way", center + Vector3.new(0, 0.4, 44), Vector3.new(0, 0, 1), 14, 5, {
		bg = C.Navy,
		fg = C.Cream,
		font = Enum.Font.GothamBold,
		both = true,
	})
end

-- Direction posts at the Hub pointing to each land.
local function signposts(parent: Instance)
	local f = Kit.folder("Signposts", parent)
	local base = Vector3.new(-14, 0.4, -6)
	Kit.post(f, 18, 0.8, base, C.Navy, M.Metal)
	local targets = {
		{ "Diesel District", Vector3.new(-190, 0, 10) },
		{ "Little Haulers", Vector3.new(-175, 0, 215) },
		{ "Backwoods Junction", Vector3.new(-200, 0, -190) },
		{ "Movie Studios", Vector3.new(0, 0, -150) },
		{ "Velocity City", Vector3.new(170, 0, -150) },
		{ "Family Landing", Vector3.new(200, 0, 140) },
	}
	for i, t in targets do
		local target = t[2] :: Vector3
		local dir = Vector3.new(target.X - base.X, 0, target.Z - base.Z).Unit
		local y = 6 + i * 1.8
		local mid = base + Vector3.new(0, y, 0) + dir * 4.5
		local land = Config.Lands[i + 1]
		local arrow = Kit.block(f, Vector3.new(0.3, 1.5, 8), CFrame.lookAt(mid, mid + dir), if land then land.color else C.Navy, M.SmoothPlastic)
		for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
			Kit.label(arrow, face, t[1] :: string, { fg = C.Cream, font = Enum.Font.GothamBold })
		end
	end
end

function Plaza.build(root: Instance): { Part }
	local f = Kit.folder("BentonPlaza", root)
	walkways(f)
	mainStreet(f)
	hub(f)
	signposts(f)
	local boards = {
		waitBoard(f, CFrame.new(-44, 0.4, 238) * CFrame.Angles(0, math.rad(-135), 0), "WaitTimesBoard"),
		waitBoard(f, CFrame.new(44, 0.4, -16) * CFrame.Angles(0, math.rad(45), 0), "HubWaitTimesBoard"),
	}
	return boards
end

return Plaza
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">RideBuilder</string>
            <string name="Source"><![CDATA[-- Builds every ride: track or structure, vehicles, station, and the queue
-- entrance with its live wait-time sign and prompts.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local RideMotion = require(Shared.RideMotion)
local Track = require(Shared.Track)
local Staff = require(Shared.Staff)
local QueueLine = require(Shared.QueueLine)
local Kit = require(script.Parent.Kit)
local Vehicles = require(script.Parent.Vehicles)

local M = Enum.Material
local C = Config.Colors
local HALF_PI = math.pi / 2

local RideBuilder = {}

type Ride = Config.Ride

export type RideInfo = {
	ride: Ride,
	model: Model,
	motion: RideMotion.Motion,
	nameLabel: TextLabel,
	waitLabel: TextLabel,
	statusLabel: TextLabel,
	joinPrompt: ProximityPrompt,
	expressPrompt: ProximityPrompt,
}

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-3 then
		return Vector3.new(0, 0, 1)
	end
	return f.Unit
end

-- Oriented block spanning a -> b using the track frame `frame` for roll.
local function strip(parent: Instance, a: Vector3, b: Vector3, frame: CFrame, width: number, height: number, color: Color3, material: Enum.Material): Part
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local fwd = (b - a).Unit
	local up = frame.UpVector
	local right = fwd:Cross(up)
	if right.Magnitude < 1e-3 then
		right = frame.RightVector
	end
	right = right.Unit
	up = right:Cross(fwd).Unit
	local part = Kit.block(parent, Vector3.new(width, height, len + 0.15), CFrame.fromMatrix(mid, right, up), color, material)
	return part
end

---------------------------------------------------------------------------
-- Tracks
---------------------------------------------------------------------------
local function steelTrack(parent: Instance, ride: Ride, sampler: Track.Sampler, wooden: boolean)
	local railColor = ride.colors[1]
	local supportColor = if wooden then Color3.fromRGB(120, 84, 52) else Color3.fromRGB(200, 204, 210)
	local L = sampler.length
	local step = 3
	local n = math.ceil(L / step)
	local f = Kit.folder("Track", parent)
	f:SetAttribute("Style", if wooden then "wood" else "steel")
	f:SetAttribute("Color", railColor)
	local supports = Kit.folder("Supports", parent)
	for i = 0, n - 1 do
		local s0 = i * step
		local s1 = math.min((i + 1) * step, L)
		local cf0 = sampler:cframeAt(s0)
		local cf1 = sampler:cframeAt(s1)
		local cfm = sampler:cframeAt((s0 + s1) / 2)
		for _, sx in { -1.6, 1.6 } do
			local a = (cf0 * CFrame.new(sx, -0.25, 0)).Position
			local b = (cf1 * CFrame.new(sx, -0.25, 0)).Position
			if wooden then
				strip(f, a, b, cfm, 0.5, 0.35, Color3.fromRGB(90, 90, 96), M.Metal)
			else
				local rail = Kit.beam(f, a, b, 0.7, railColor, M.Metal, true)
				rail.Size += Vector3.new(0.3, 0, 0)
			end
		end
		if wooden then
			Kit.block(f, Vector3.new(4.4, 0.45, 1.1), cf0 * CFrame.new(0, -0.7, 0), Color3.fromRGB(120, 84, 52), M.Wood)
		else
			local a = (cf0 * CFrame.new(0, -1.35, 0)).Position
			local b = (cf1 * CFrame.new(0, -1.35, 0)).Position
			strip(f, a, b, cfm, 1.1, 1.1, railColor, M.Metal)
			if i % 2 == 0 then
				Kit.block(f, Vector3.new(3.8, 0.35, 0.5), cf0 * CFrame.new(0, -0.75, 0), railColor, M.Metal)
			end
		end
		-- supports where the track is upright and off the ground
		local every = if wooden then 4 else 5
		if i % every == 0 and cf0.UpVector.Y > 0.7 then
			local top = (cf0 * CFrame.new(0, -1.9, 0)).Position
			if top.Y > 3 then
				if wooden then
					for _, sx in { -2.2, 2.2 } do
						local p = (cf0 * CFrame.new(sx, -1.0, 0)).Position
						Kit.box(supports, Vector3.new(0.9, p.Y, 0.9), Vector3.new(p.X, 0, p.Z), supportColor, M.Wood)
					end
					if top.Y > 8 then
						local l = (cf0 * CFrame.new(-2.2, -1.0, 0)).Position
						local r = (cf0 * CFrame.new(2.2, -1.0, 0)).Position
						Kit.beam(supports, Vector3.new(l.X, 1, l.Z), Vector3.new(r.X, r.Y - 1, r.Z), 0.5, supportColor, M.Wood)
						Kit.beam(supports, Vector3.new(r.X, 1, r.Z), Vector3.new(l.X, l.Y - 1, l.Z), 0.5, supportColor, M.Wood)
					end
				else
					Kit.post(supports, top.Y, 1.4, Vector3.new(top.X, 0, top.Z), supportColor, M.Metal)
					Kit.box(supports, Vector3.new(3, 1, 3), Vector3.new(top.X, 0, top.Z), C.Concrete, M.Concrete)
				end
			end
		end
	end
end

local function flumeTrack(parent: Instance, ride: Ride, sampler: Track.Sampler)
	local wood = Color3.fromRGB(120, 84, 52)
	local water = Color3.fromRGB(60, 140, 200)
	local L = sampler.length
	local step = 3
	local n = math.ceil(L / step)
	local f = Kit.folder("Channel", parent)
	f:SetAttribute("Style", "flume")
	local supports = Kit.folder("Supports", parent)
	local highest, highestS = -math.huge, 0
	for i = 0, n - 1 do
		local s0 = i * step
		local s1 = math.min((i + 1) * step, L)
		local cf0 = sampler:cframeAt(s0)
		local cf1 = sampler:cframeAt(s1)
		local cfm = sampler:cframeAt((s0 + s1) / 2)
		if cf0.Y > highest then
			highest, highestS = cf0.Y, s0
		end
		strip(f, (cf0 * CFrame.new(0, -1.3, 0)).Position, (cf1 * CFrame.new(0, -1.3, 0)).Position, cfm, 6.6, 0.6, wood, M.WoodPlanks)
		for _, sx in { -3.3, 3.3 } do
			strip(f, (cf0 * CFrame.new(sx, 0.2, 0)).Position, (cf1 * CFrame.new(sx, 0.2, 0)).Position, cfm, 0.6, 3.2, wood, M.WoodPlanks)
		end
		local w = strip(f, (cf0 * CFrame.new(0, 0.3, 0)).Position, (cf1 * CFrame.new(0, 0.3, 0)).Position, cfm, 6, 0.4, water, M.Glass)
		w.Transparency = 0.35
		w.CanCollide = false
		if i % 4 == 0 and cf0.Y > 5 then
			for _, sx in { -3.6, 3.6 } do
				local p = (cf0 * CFrame.new(sx, -1.6, 0)).Position
				Kit.box(supports, Vector3.new(1, p.Y, 1), Vector3.new(p.X, 0, p.Z), wood, M.Wood)
			end
		end
	end
	-- splashdown: first low point after the summit
	local s = highestS
	while s < L do
		local cf = sampler:cframeAt(s)
		if cf.Y < 4 then
			break
		end
		s += 1
	end
	local splashAt = sampler:cframeAt(s + 2).Position
	local splash = Kit.block(f, Vector3.new(4, 1, 4), CFrame.new(splashAt + Vector3.new(0, 1, 0)), water, M.Glass)
	splash.Name = "Splash"
	splash.Transparency = 1
	splash.CanCollide = false
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(Color3.fromRGB(230, 245, 255))
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.Size = NumberSequence.new(3, 8)
	mist.Lifetime = NumberRange.new(1.5, 2.5)
	mist.Speed = NumberRange.new(2, 5)
	mist.Rate = 6
	mist.Parent = splash
	splash:SetAttribute("Effect", "Splash")
end

local function groundStrip(parent: Instance, sampler: Track.Sampler, width: number, color: Color3, material: Enum.Material, drop: number, dash: Color3?, curbs: boolean?)
	local L = sampler.length
	local step = 4
	local n = math.ceil(L / step)
	local f = Kit.folder("Road", parent)
	f:SetAttribute("Style", "road")
	f:SetAttribute("Width", width)
	f:SetAttribute("Drop", drop)
	f:SetAttribute("Color", color)
	if dash then
		f:SetAttribute("Dash", dash)
	end
	f:SetAttribute("Curbs", curbs == true)
	for i = 0, n - 1 do
		local s0 = i * step
		local s1 = math.min((i + 1) * step, L)
		local cf0 = sampler:cframeAt(s0)
		local cf1 = sampler:cframeAt(s1)
		local a = cf0.Position - Vector3.new(0, drop, 0)
		local b = cf1.Position - Vector3.new(0, drop, 0)
		local flatFrame = CFrame.new(cf0.Position)
		local road = strip(f, a, b, flatFrame, width, 1, color, material)
		road.CastShadow = false
		if dash and i % 2 == 0 then
			local d = strip(f, a + Vector3.new(0, 0.52, 0), b + Vector3.new(0, 0.52, 0), flatFrame, 0.4, 0.05, dash, M.SmoothPlastic)
			d.Size = Vector3.new(d.Size.X, d.Size.Y, d.Size.Z * 0.5)
			d.CastShadow = false
		end
		if curbs then
			local right = (b - a).Unit:Cross(Vector3.yAxis).Unit
			for _, sx in { -1, 1 } do
				local off = right * (sx * (width / 2 + 0.6))
				local c = strip(f, a + off + Vector3.new(0, 0.25, 0), b + off + Vector3.new(0, 0.25, 0), flatFrame, 1.2, 1, if i % 2 == 0 then C.Red else Color3.new(1, 1, 1), M.SmoothPlastic)
				c.CastShadow = false
			end
		end
	end
end

local function railTrack(parent: Instance, sampler: Track.Sampler)
	local L = sampler.length
	local step = 3
	local n = math.ceil(L / step)
	local f = Kit.folder("Rails", parent)
	f:SetAttribute("Style", "rails")
	for i = 0, n - 1 do
		local s0 = i * step
		local s1 = math.min((i + 1) * step, L)
		local cf0 = sampler:cframeAt(s0)
		local cf1 = sampler:cframeAt(s1)
		local flatFrame = CFrame.new(cf0.Position)
		local a = cf0.Position
		local b = cf1.Position
		local bed = strip(f, Vector3.new(a.X, -0.1, a.Z), Vector3.new(b.X, -0.1, b.Z), flatFrame, 7, 1, Color3.fromRGB(120, 116, 110), M.Slate)
		bed.CastShadow = false
		Kit.block(f, Vector3.new(6.2, 0.35, 1), cf0 * CFrame.new(0, -1.75, 0), Color3.fromRGB(100, 70, 46), M.Wood)
		for _, sx in { -2, 2 } do
			strip(f, (cf0 * CFrame.new(sx, -1.45, 0)).Position, (cf1 * CFrame.new(sx, -1.45, 0)).Position, cf0, 0.4, 0.45, Color3.fromRGB(110, 110, 116), M.Metal)
		end
	end
end

---------------------------------------------------------------------------
-- Stations and queues
---------------------------------------------------------------------------
local function station(parent: Instance, ride: Ride, motion: RideMotion.Motion, rest: { CFrame })
	local f = Kit.folder("Station", parent)
	local landColor = (Config.landById(ride.land) :: Config.Land).color
	local sf = Staff.stationFrame(ride, rest)
	local frame, length, platformTop, halfGap = sf.frame, sf.length, sf.platformTop, sf.halfGap
	for _, sx in { -1, 1 } do
		Kit.block(f, Vector3.new(4, platformTop, length), frame * CFrame.new(sx * (halfGap + 2), platformTop / 2, 0), C.Concrete, M.Concrete)
		Kit.block(f, Vector3.new(0.5, 0.1, length), frame * CFrame.new(sx * (halfGap + 0.3), platformTop + 0.05, 0), Color3.fromRGB(250, 210, 40), M.SmoothPlastic)
	end
	local roofY = platformTop + 13
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.block(f, Vector3.new(0.8, roofY - platformTop, 0.8), frame * CFrame.new(sx * (halfGap + 3.2), (roofY + platformTop) / 2, sz * (length / 2 - 1)), C.Navy, M.Metal)
		end
	end
	Kit.block(f, Vector3.new(halfGap * 2 + 10, 1, length + 2), frame * CFrame.new(0, roofY, 0), landColor, M.Metal)
	Kit.block(f, Vector3.new(halfGap * 2 + 10.4, 0.4, length + 2.4), frame * CFrame.new(0, roofY + 0.7, 0), C.Cream, M.SmoothPlastic)
	-- name boards on both long sides of the canopy
	for _, sx in { -1, 1 } do
		local cf = frame * CFrame.new(sx * (halfGap + 5.2), roofY - 1.6, 0) * CFrame.Angles(0, sx * HALF_PI, 0) * CFrame.Angles(0, math.pi, 0)
		Kit.sign(f, ride.name, Vector3.new(math.min(length, 40), 2.6, 0.3), cf, { bg = C.Navy, fg = C.Cream, font = Enum.Font.GothamBlack, glow = true })
	end
	local lamp = Kit.block(f, Vector3.new(2, 0.3, length - 2), frame * CFrame.new(0, roofY - 0.65, 0), Color3.fromRGB(255, 240, 210), M.Neon)
	Kit.light(lamp, Color3.fromRGB(255, 236, 200), 18, 0.8)
	local _ = motion
end

local function stars(n: number): string
	return string.rep("*", n) .. string.rep("-", 5 - n)
end

---------------------------------------------------------------------------
-- Queue line: a railed switchback maze with room for well over an hour of
-- guests, a railed walkway to the entrance sign and a boarding gate
---------------------------------------------------------------------------
local QUEUE_FLOOR = Color3.fromRGB(196, 186, 170)
local QUEUE_TOP = 0.55

-- Posts every few studs and two rails between them, from a to b.
local function railRun(parent: Instance, a: Vector3, b: Vector3, railColor: Color3)
	local len = (b - a).Magnitude
	if len < 0.5 then
		return
	end
	local posts = math.max(1, math.ceil(len / 5))
	local postColor = Color3.fromRGB(70, 74, 84)
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		Kit.post(parent, 3.2, 0.4, Vector3.new(p.X, QUEUE_TOP, p.Z), postColor, M.Metal)
	end
	local lift = Vector3.new(0, QUEUE_TOP, 0)
	Kit.beam(parent, a + lift + Vector3.new(0, 3, 0), b + lift + Vector3.new(0, 3, 0), 0.3, railColor, M.Metal, true)
	Kit.beam(parent, a + lift + Vector3.new(0, 1.6, 0), b + lift + Vector3.new(0, 1.6, 0), 0.2, postColor, M.Metal, true)
end

-- Polyline offset sideways by `d` (positive = right of travel), mitred.
local function offsetLine(points: { Vector3 }, d: number): { Vector3 }
	local out = {}
	for i, p in points do
		local prev = points[math.max(1, i - 1)]
		local nxt = points[math.min(#points, i + 1)]
		local dirIn = flat(p - prev)
		local dirOut = flat(nxt - p)
		if i == 1 then
			dirIn = dirOut
		elseif i == #points then
			dirOut = dirIn
		end
		local nIn = Vector3.new(-dirIn.Z, 0, dirIn.X)
		local nOut = Vector3.new(-dirOut.Z, 0, dirOut.X)
		local n = nIn + nOut
		n = if n.Magnitude > 1e-3 then n.Unit else nIn
		local scale = 1 / math.max(0.35, n:Dot(nIn))
		table.insert(out, p + n * d * scale)
	end
	return out
end

local function queueLine(parent: Instance, ride: Ride, land: Config.Land)
	local line = QueueLine.get(ride.id)
	if not line then
		return
	end
	local f = Kit.folder("Line", parent)
	-- floor under the maze
	local floor = Kit.block(f, Vector3.new(line.mazeSize.X + 1.5, 1, line.mazeSize.Z + 1.5), line.mazeCFrame * CFrame.new(0, QUEUE_TOP - 0.5, 0), QUEUE_FLOOR, M.Concrete)
	floor.Name = "QueueFloor"
	floor.CastShadow = false
	-- walkway from the maze to the sign, and out the front of the sign
	local walk = line.walkway
	for i = 2, #walk do
		Kit.path(f, walk[i - 1], walk[i], QueueLine.LANE + 0.5, QUEUE_FLOOR, M.Concrete, QUEUE_TOP)
	end
	Kit.path(f, walk[#walk], line.entrance + line.outward * 3, QueueLine.LANE + 0.5, QUEUE_FLOOR, M.Concrete, QUEUE_TOP)
	-- rails
	for _, w in line.walls do
		railRun(f, w[1], w[2], land.color)
	end
	local half = QueueLine.LANE / 2
	for _, side in { -half, half } do
		local rail = offsetLine(walk, side)
		for i = 2, #rail do
			railRun(f, rail[i - 1], rail[i], land.color)
		end
	end
	-- boarding gate at the front of the line
	local g = line.gate
	local gcf = CFrame.lookAt(Vector3.new(g.X, QUEUE_TOP, g.Z), Vector3.new(g.X, QUEUE_TOP, g.Z) + line.gateDir)
	for _, sx in { -1, 1 } do
		Kit.block(f, Vector3.new(0.8, 8, 0.8), gcf * CFrame.new(sx * (half + 0.4), 4, 0), land.color, M.Metal)
	end
	Kit.block(f, Vector3.new(QueueLine.LANE + 2.4, 1, 1), gcf * CFrame.new(0, 8.4, 0), land.color, M.Metal)
	Kit.sign(f, "BOARDING", Vector3.new(QueueLine.LANE + 1.6, 1.4, 0.3), gcf * CFrame.new(0, 7, 0.1) * CFrame.Angles(0, math.pi, 0), { bg = C.Navy, fg = C.Cream, font = Enum.Font.GothamBlack, both = true })
	-- turnstile arm
	Kit.block(f, Vector3.new(QueueLine.LANE - 0.6, 0.25, 0.25), gcf * CFrame.new(0, 3, -0.6), Color3.fromRGB(220, 220, 225), M.Metal).CanCollide = false
end

local function queueEntrance(parent: Instance, ride: Ride): (TextLabel, TextLabel, TextLabel, ProximityPrompt, ProximityPrompt)
	local f = Kit.folder("Queue", parent)
	local land = Config.landById(ride.land) :: Config.Land
	local facing = flat(ride.entrance - ride.origin)
	local base = Vector3.new(ride.entrance.X, 0.4, ride.entrance.Z)
	local cf = CFrame.lookAt(base, base + facing)
	-- sign on two posts
	for _, sx in { -1, 1 } do
		Kit.block(f, Vector3.new(1, 19, 1), cf * CFrame.new(sx * 8, 9.5, 0), C.Navy, M.Metal)
	end
	local board = Kit.block(f, Vector3.new(16, 10, 0.8), cf * CFrame.new(0, 13, 0), Color3.fromRGB(16, 22, 36), M.SmoothPlastic)
	board.Name = "WaitSign"
	Kit.block(f, Vector3.new(17, 1.2, 1.2), cf * CFrame.new(0, 18.6, 0), land.color, M.SmoothPlastic)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.3
	gui.MaxDistance = 400
	gui.Parent = board
	local function text(name: string, y: number, h: number, value: string, color: Color3, font: Enum.Font): TextLabel
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0.04, y)
		l.Size = UDim2.fromScale(0.92, h)
		l.Text = value
		l.TextScaled = true
		l.TextColor3 = color
		l.FontFace = Font.fromEnum(font)
		l.Parent = gui
		return l
	end
	local nameLabel = text("RideName", 0.04, 0.24, ride.name, C.Cream, Enum.Font.GothamBlack)
	text("Info", 0.29, 0.1, string.upper(ride.category) .. "  |  THRILL " .. stars(ride.thrill) .. "  |  " .. land.name, land.color, Enum.Font.GothamBold)
	text("WaitCaption", 0.42, 0.1, "CURRENT WAIT", Color3.fromRGB(180, 190, 210), Enum.Font.GothamBold)
	local waitLabel = text("Wait", 0.52, 0.3, "5 MIN", C.Orange, Enum.Font.GothamBlack)
	local statusLabel = text("Status", 0.84, 0.12, "NOW BOARDING", C.Green, Enum.Font.GothamBold)
	-- back of the sign
	Kit.label(board, Enum.NormalId.Back, ride.name, { fg = C.Cream, font = Enum.Font.GothamBlack, glow = true })
	-- the queue maze, walkway and boarding gate
	queueLine(f, ride, land)
	-- prompt anchor
	local point = Kit.block(f, Vector3.new(2, 2, 2), cf * CFrame.new(0, 3, -1), Color3.new(1, 1, 1), M.SmoothPlastic)
	point.Name = "QueuePoint"
	point.Transparency = 1
	point.CanCollide = false
	local join = Kit.prompt(point, "Join Line", ride.name, Enum.KeyCode.E, 14)
	join.Name = "JoinPrompt"
	local express = Kit.prompt(point, "Use Express Pass", ride.name, Enum.KeyCode.F, 14)
	express.Name = "ExpressPrompt"
	express.UIOffset = Vector2.new(0, 70)
	-- exit sign
	local exitBase = Vector3.new(ride.exit.X, 0.4, ride.exit.Z)
	Kit.postSign(f, "EXIT", exitBase, facing, 5, 2, { bg = C.Red, fg = C.Cream, font = Enum.Font.GothamBlack, both = true })
	return nameLabel, waitLabel, statusLabel, join, express
end

---------------------------------------------------------------------------
-- Flat ride structures
---------------------------------------------------------------------------
local function pivotPart(model: Model, cf: CFrame): Part
	local p = Kit.block(model, Vector3.new(1, 1, 1), cf, Color3.new(1, 1, 1), M.SmoothPlastic)
	p.Name = "Pivot"
	p.Transparency = 1
	p.CanCollide = false
	model.PrimaryPart = p
	return p
end

local function dropTower(parent: Instance, ride: Ride, motion: RideMotion.Motion)
	local o = motion.originCF
	local blue, dark, orange = ride.colors[1], ride.colors[2] or Color3.fromRGB(28, 32, 44), ride.colors[3] or C.Orange
	local f = Kit.folder("Tower", parent)
	local H = 172
	Kit.block(f, Vector3.new(7, H, 7), o * CFrame.new(0, H / 2, 0), dark, M.Metal)
	-- loading deck around the tower, where the crew checks the harnesses
	Kit.disc(f, 24, 2.4, (o * CFrame.new(0, Staff.FLAT.droptower.floor, 0)).Position, C.Concrete, M.Concrete)
	Kit.disc(f, 24.6, 0.2, (o * CFrame.new(0, Staff.FLAT.droptower.floor + 0.05, 0)).Position, Color3.fromRGB(250, 210, 40), M.SmoothPlastic).CastShadow = false
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local strip_ = Kit.block(f, Vector3.new(0.5, H - 6, 0.5), o * CFrame.new(sx * 3.6, H / 2, sz * 3.6), blue, M.Neon)
			strip_.CastShadow = false
		end
	end
	Kit.block(f, Vector3.new(13, 9, 13), o * CFrame.new(0, H + 4.5, 0), dark, M.Metal)
	Kit.block(f, Vector3.new(14, 1, 14), o * CFrame.new(0, H + 9.5, 0), blue, M.Neon)
	for k = 0, 3 do
		local cf = o * CFrame.new(0, H + 4.5, 0) * CFrame.Angles(0, k * HALF_PI, 0) * CFrame.new(0, 0, -6.6)
		Kit.sign(f, "BENTON", Vector3.new(12, 6, 0.3), cf, { bg = dark, fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBlack, glow = true })
	end
	Kit.post(f, 14, 0.4, (o * CFrame.new(0, H + 10, 0)).Position, Color3.fromRGB(220, 220, 225), M.Metal)
	local flag = Kit.block(f, Vector3.new(0.2, 3, 5), o * CFrame.new(0, H + 22, 2.6), orange, M.Fabric)
	flag.CastShadow = false
	local beacon = Kit.ball(f, 1.6, (o * CFrame.new(0, H + 24.5, 0)).Position, Color3.fromRGB(255, 60, 60), M.Neon)
	Kit.light(beacon, Color3.fromRGB(255, 80, 80), 30, 2)
	-- base platform and fence
	Kit.disc(f, 30, 3, (o * CFrame.new(0, 3, 0)).Position, C.Concrete, M.Concrete)
	for k = 0, 15 do
		local a = k * math.pi / 8
		local p = (o * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -16)).Position
		Kit.post(f, 4, 0.4, Vector3.new(p.X, 0.4, p.Z), Color3.fromRGB(60, 60, 66), M.Metal)
	end
end

local function carouselStructure(parent: Instance, ride: Ride, motion: RideMotion.Motion)
	local o = motion.originCF
	local red, gold, cream = ride.colors[1], ride.colors[2] or C.Gold, ride.colors[3] or C.Cream
	local f = Kit.folder("Structure", parent)
	Kit.disc(f, 40, 1.6, (o * CFrame.new(0, 1.6, 0)).Position, Color3.fromRGB(150, 140, 130), M.Brick)
	local moving = parent:FindFirstChild("Moving") :: Folder
	local platform = Kit.model("Platform", moving)
	pivotPart(platform, o)
	Kit.disc(platform, 37, 0.6, (o * CFrame.new(0, 2.2, 0)).Position, Color3.fromRGB(150, 100, 60), M.WoodPlanks)
	Kit.cyl(platform, 16, 6, o * CFrame.new(0, 10, 0) * CFrame.Angles(0, 0, HALF_PI), cream, M.SmoothPlastic)
	for k = 0, 7 do
		local cf = o * CFrame.Angles(0, k * math.pi / 4, 0) * CFrame.new(0, 10, -3.05)
		Kit.block(platform, Vector3.new(1.8, 8, 0.2), cf, Color3.fromRGB(200, 220, 240), M.Glass)
	end
	-- poles for each horse
	for i = 1, motion.carCount do
		local phi = (i - 1) * 2 * math.pi / motion.carCount
		local r = if i % 2 == 0 then 10 else 14
		local p = o * CFrame.Angles(0, phi, 0) * CFrame.new(r, 9.2, 0)
		Kit.cyl(platform, 14, 0.45, p * CFrame.Angles(0, 0, HALF_PI), gold, M.Metal)
	end
	-- striped canopy
	local tiers = { { 40, 16.4 }, { 32, 17.6 }, { 22, 18.8 }, { 12, 20 } }
	for t, tier in tiers do
		Kit.disc(platform, tier[1], 1.4, (o * CFrame.new(0, tier[2], 0)).Position, if t % 2 == 1 then red else cream, M.Fabric)
	end
	for k = 0, 15 do
		local a = k * math.pi / 8
		local bulb = Kit.ball(platform, 0.8, (o * CFrame.Angles(0, a, 0) * CFrame.new(0, 15.4, -19.6)).Position, Color3.fromRGB(255, 230, 160), M.Neon)
		bulb.CastShadow = false
	end
	Kit.gear(platform, o * CFrame.new(0, 23, 0), 5, gold)
	local light = Kit.block(platform, Vector3.new(1, 1, 1), o * CFrame.new(0, 14, 0), Color3.new(1, 1, 1), M.SmoothPlastic)
	light.Transparency = 1
	Kit.light(light, Color3.fromRGB(255, 220, 160), 30, 1)
	for _, d in platform:GetDescendants() do
		if d:IsA("BasePart") then
			(d :: BasePart).CanCollide = false
		end
	end
end

local function spinnerStructure(parent: Instance, ride: Ride, motion: RideMotion.Motion)
	local o = motion.originCF
	local f = Kit.folder("Structure", parent)
	Kit.disc(f, 48, 1.2, (o * CFrame.new(0, 1.2, 0)).Position, Color3.fromRGB(150, 140, 130), M.Concrete)
	for k = 0, 19 do
		local a = k * math.pi / 10
		local p = (o * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -25)).Position
		Kit.post(f, 3.4, 0.4, Vector3.new(p.X, 0.4, p.Z), C.Gold, M.Metal)
	end
	local moving = parent:FindFirstChild("Moving") :: Folder
	local platform = Kit.model("Platform", moving)
	pivotPart(platform, o)
	Kit.disc(platform, 42, 0.8, (o * CFrame.new(0, 2, 0)).Position, Color3.fromRGB(60, 64, 76), M.DiamondPlate)
	for k = 0, 11 do
		local a = k * math.pi / 6
		Kit.block(platform, Vector3.new(3, 0.82, 4), o * CFrame.Angles(0, a, 0) * CFrame.new(0, 1.6, -20.5), C.Gold, M.Metal)
	end
	Kit.cyl(platform, 6, 5, o * CFrame.new(0, 5, 0) * CFrame.Angles(0, 0, HALF_PI), C.Gold, M.Metal)
	Kit.gear(platform, o * CFrame.new(0, 9, 0) * CFrame.Angles(HALF_PI, 0, 0), 7, C.Orange)
	for _, d in platform:GetDescendants() do
		if d:IsA("BasePart") then
			(d :: BasePart).CanCollide = false
		end
	end
	local _ = ride
end

local function pendulumStructure(parent: Instance, ride: Ride, motion: RideMotion.Motion)
	local o = motion.originCF
	local orange, dark, gold = ride.colors[1], ride.colors[2] or Color3.fromRGB(70, 70, 76), ride.colors[3] or C.Gold
	local f = Kit.folder("Structure", parent)
	local pivot = o * CFrame.new(0, 34, 0)
	for _, sz in { -1, 1 } do
		for _, sx in { -1, 1 } do
			local foot = (o * CFrame.new(sx * 15, 0, sz * 12)).Position
			local top = (pivot * CFrame.new(0, 0, sz * 9.5)).Position
			Kit.beam(f, foot, top, 2.2, dark, M.Metal, true)
			Kit.box(f, Vector3.new(4, 1.2, 4), foot, C.Concrete, M.Concrete)
		end
	end
	Kit.cyl(f, 20, 2.4, pivot * CFrame.Angles(0, HALF_PI, 0), gold, M.Metal)
	-- loading platform
	Kit.disc(f, 20, 4.6, (o * CFrame.new(0, 4.6, 0)).Position, C.Concrete, M.Concrete)
	local moving = parent:FindFirstChild("Moving") :: Folder
	local arm = Kit.model("Arm", moving)
	pivotPart(arm, pivot)
	Kit.cyl(arm, 6, 5, pivot * CFrame.Angles(0, HALF_PI, 0), orange, M.Metal)
	Kit.block(arm, Vector3.new(2.6, 27, 2.6), pivot * CFrame.new(0, -14.5, 0), orange, M.Metal)
	-- the "piston" counterweight
	Kit.cyl(arm, 9, 6, pivot * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, HALF_PI), Color3.fromRGB(200, 200, 205), M.Metal)
	Kit.cyl(arm, 1, 6.6, pivot * CFrame.new(0, 11.8, 0) * CFrame.Angles(0, 0, HALF_PI), dark, M.Metal)
	Kit.cyl(arm, 1, 6.6, pivot * CFrame.new(0, 2.6, 0) * CFrame.Angles(0, 0, HALF_PI), dark, M.Metal)
	local lights = Kit.block(arm, Vector3.new(0.6, 22, 0.6), pivot * CFrame.new(0, -14, -1.4), C.Gold, M.Neon)
	lights.CastShadow = false
	for _, d in arm:GetDescendants() do
		if d:IsA("BasePart") then
			(d :: BasePart).CanCollide = false
		end
	end
end

---------------------------------------------------------------------------
-- Ride crew: the control console and its operator (attendants are
-- animated by the clients)
---------------------------------------------------------------------------
local function crewPost(parent: Instance, ride: Ride)
	local crew = Staff.crew(ride.id)
	if not crew then
		return
	end
	local f = Kit.folder("Crew", parent)
	local cf = crew.console
	local cabinet = Color3.fromRGB(46, 52, 64)
	Kit.block(f, Vector3.new(2.8, 3.1, 1.3), cf * CFrame.new(0, 1.55, 0), cabinet, M.Metal)
	-- sloped control panel facing the operator, with its buttons
	local panel = cf * CFrame.new(0, 3.2, -0.1) * CFrame.Angles(math.rad(-22), 0, 0)
	Kit.block(f, Vector3.new(3.0, 0.3, 1.7), panel, Color3.fromRGB(30, 32, 38), M.Metal)
	local buttons = {
		{ -0.9, Color3.fromRGB(60, 220, 90) }, -- dispatch
		{ -0.3, Color3.fromRGB(250, 200, 40) },
		{ 0.3, Color3.fromRGB(60, 140, 240) },
		{ 0.95, Color3.fromRGB(230, 40, 40) }, -- emergency stop
	}
	for _, b in buttons do
		local p = (panel * CFrame.new(b[1] :: number, 0.2, 0.1)).Position
		Kit.disc(f, if b[1] == 0.95 then 0.55 else 0.38, 0.14, p + Vector3.new(0, 0.07, 0), b[2] :: Color3, M.Neon).CastShadow = false
	end
	local screen = Kit.block(f, Vector3.new(1.4, 0.8, 0.12), cf * CFrame.new(0, 4.0, 0.45) * CFrame.Angles(math.rad(-10), 0, 0), Color3.fromRGB(40, 120, 170), M.Neon)
	screen.CastShadow = false
	-- stack light: green / amber / red
	local pole = (cf * CFrame.new(1.25, 0, 0.45)).Position
	Kit.post(f, 5.6, 0.18, Vector3.new(pole.X, cf.Y + 3.1, pole.Z), cabinet, M.Metal)
	for i, c in { Color3.fromRGB(60, 220, 90), Color3.fromRGB(250, 190, 40), Color3.fromRGB(230, 50, 40) } do
		local lamp = Kit.block(f, Vector3.new(0.42, 0.36, 0.42), CFrame.new(pole + Vector3.new(0, cf.Y + 3.1 + 2.3 + i * 0.38, 0)), c, if i == 1 then M.Neon else M.SmoothPlastic)
		lamp.Name = "StackLight" .. i
		lamp.CastShadow = false
	end
	Staff.place(f, "operator", ride.land, #ride.id * 97 + 5, crew.operator, ride.id, "operate")
end

---------------------------------------------------------------------------
-- Entry point
---------------------------------------------------------------------------
function RideBuilder.build(root: Instance): { [string]: RideInfo }
	local ridesFolder = Kit.folder("Rides", root)
	local infos: { [string]: RideInfo } = {}
	for _, ride in Config.Rides do
		local motion = RideMotion.get(ride.id)
		local model = Kit.model(ride.id, ridesFolder)
		model:SetAttribute("RideId", ride.id)
		local carsFolder = Kit.folder("Cars", model)
		Kit.folder("Moving", model)
		local rest = motion.pose(0)
		local sampler = motion.sampler
		if sampler then
			if ride.kind == "coaster" then
				steelTrack(model, ride, sampler, ride.carStyle == "mine")
			elseif ride.kind == "flume" then
				flumeTrack(model, ride, sampler)
			elseif ride.kind == "train" then
				railTrack(model, sampler)
			elseif ride.kind == "tram" then
				groundStrip(model, sampler, 10, Color3.fromRGB(90, 90, 96), M.Asphalt, 1.0 + 0.55, Color3.fromRGB(250, 210, 40), false)
			elseif ride.kind == "trucks" then
				groundStrip(model, sampler, 8, Color3.fromRGB(80, 80, 86), M.Asphalt, 0.85 + 0.5, Color3.fromRGB(250, 210, 40), true)
			elseif ride.kind == "karts" then
				groundStrip(model, sampler, 15, Color3.fromRGB(60, 62, 68), M.Asphalt, 0.5, Color3.new(1, 1, 1), true)
			end
			if ride.kind ~= "karts" and ride.kind ~= "trucks" then
				station(model, ride, motion, rest)
			end
		elseif ride.kind == "droptower" then
			dropTower(model, ride, motion)
		elseif ride.kind == "carousel" then
			carouselStructure(model, ride, motion)
		elseif ride.kind == "spinner" then
			spinnerStructure(model, ride, motion)
		elseif ride.kind == "pendulum" then
			pendulumStructure(model, ride, motion)
		end
		for i = 1, motion.carCount do
			local car = Vehicles.build(ride, motion, i, rest[i], carsFolder)
			car.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
		end
		for _, m in (model:FindFirstChild("Moving") :: Folder):GetChildren() do
			(m :: Model).ModelStreamingMode = Enum.ModelStreamingMode.Persistent
		end
		crewPost(model, ride)
		local nameLabel, waitLabel, statusLabel, join, express = queueEntrance(model, ride)
		infos[ride.id] = {
			ride = ride,
			model = model,
			motion = motion,
			nameLabel = nameLabel,
			waitLabel = waitLabel,
			statusLabel = statusLabel,
			joinPrompt = join,
			expressPrompt = express,
		}
	end
	return infos
end

return RideBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Theming</string>
            <string name="Source"><![CDATA[-- Themed set dressing for every land: carts, signs, props, overhead lights
-- and a few moving pieces (windmill, gears, film reels, spinning show cars,
-- the lighthouse lamp). Spots come from a search of the built park for
-- clear ground near the walkways (see PROPS at the bottom of this file).
--
-- Tags used by the clients: "Spinner" (models that turn; attributes
-- SpinSpeed in rad/s and SpinAxis "X"/"Y"/"Z"), "SteamVent", "Campfire",
-- "Searchlight", "NightLight" (lights that only shine at night) and
-- "ParkLamp".

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BentonShared")
local Config = require(Shared.Config)
local Kit = require(script.Parent.Kit)
local Staff = require(Shared.Staff)

local M = Enum.Material
local C = Config.Colors
local HALF_PI = math.pi / 2

local Theming = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local DARK = rgb(30, 34, 44)
local WOOD = rgb(120, 84, 52)
local DARK_WOOD = rgb(90, 62, 40)
local STEEL = rgb(150, 154, 160)
local RUBBER = rgb(24, 24, 26)
local BRIGHT = { rgb(230, 60, 60), rgb(250, 200, 40), rgb(40, 130, 230), rgb(60, 180, 90), rgb(240, 130, 30), rgb(170, 90, 220) }

type Builder = (f: Instance, cf: CFrame, lc: Color3, rng: Random) -> ()

local function part(f: Instance, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	return Kit.block(f, size, cf, color, mat or M.SmoothPlastic)
end

-- upright cylinder whose base sits at cf (cf's up axis)
local function upright(f: Instance, height: number, diameter: number, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	return Kit.cyl(f, height, diameter, cf * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, HALF_PI), color, mat or M.SmoothPlastic)
end

local function spinner(f: Instance, name: string, pivot: CFrame, speed: number, axis: string): Model
	local m = Kit.model(name, f)
	local p = part(m, V(0.4, 0.4, 0.4), pivot, Color3.new(1, 1, 1))
	p.Transparency = 1
	p.CanCollide = false
	p.Name = "Pivot"
	m.PrimaryPart = p
	m:SetAttribute("SpinSpeed", speed)
	m:SetAttribute("SpinAxis", axis)
	m:AddTag("Spinner")
	return m
end

local function nightLight(p: BasePart, color: Color3, range: number, kind: string?)
	local light: Light
	if kind == "spot" then
		local s = Instance.new("SpotLight")
		s.Face = Enum.NormalId.Top
		s.Angle = 22
		s.Range = range
		light = s
	else
		local pl = Instance.new("PointLight")
		pl.Range = range
		light = pl
	end
	light.Color = color
	light.Brightness = 2
	light.Shadows = false
	light.Enabled = false
	light.Parent = p
	p:AddTag("NightLight")
end

---------------------------------------------------------------------------
-- Everywhere
---------------------------------------------------------------------------
local function trashCan(f: Instance, cf: CFrame, lc: Color3)
	upright(f, 3.2, 2.2, cf, rgb(46, 58, 54), M.Metal)
	upright(f, 0.6, 2.35, cf * CFrame.new(0, 2.1, 0), lc, M.Metal)
	upright(f, 0.35, 2.5, cf * CFrame.new(0, 3.2, 0), rgb(46, 58, 54), M.Metal)
	upright(f, 0.5, 0.9, cf * CFrame.new(0, 3.5, 0), rgb(46, 58, 54), M.Metal)
end

local function planter(f: Instance, cf: CFrame, lc: Color3, rng: Random)
	part(f, V(4, 1.6, 4), cf * CFrame.new(0, 0.8, 0), rgb(150, 140, 130), M.Brick)
	part(f, V(3.4, 0.2, 3.4), cf * CFrame.new(0, 1.65, 0), rgb(80, 56, 40), M.Ground)
	part(f, V(4.3, 0.3, 4.3), cf * CFrame.new(0, 1.5, 0), lc, M.SmoothPlastic)
	Kit.ball(f, 2.6, (cf * CFrame.new(0, 2.6, 0)).Position, rgb(60, 130, 60), M.Grass)
	for k = 0, 4 do
		local a = k * math.pi * 2 / 5
		Kit.ball(f, 0.8, (cf * CFrame.new(math.cos(a) * 1.3, 2.4 + (k % 2) * 0.6, math.sin(a) * 1.3)).Position, BRIGHT[rng:NextInteger(1, #BRIGHT)], M.SmoothPlastic).CastShadow = false
	end
end

local function flowerBed(f: Instance, cf: CFrame)
	Kit.flowerBed(f, cf.Position, 8, 6)
end

---------------------------------------------------------------------------
-- Benton Plaza
---------------------------------------------------------------------------
local function cartBase(f: Instance, cf: CFrame, body: Color3)
	part(f, V(5, 2.6, 3), cf * CFrame.new(0, 2.3, 0), body)
	part(f, V(5.3, 0.3, 3.3), cf * CFrame.new(0, 3.7, 0), C.Cream)
	for _, sx in { -1.8, 1.8 } do
		Kit.cyl(f, 0.4, 2, cf * CFrame.new(sx, 1, 1.6) * CFrame.Angles(0, HALF_PI, 0), RUBBER, M.Rubber)
		Kit.cyl(f, 0.4, 2, cf * CFrame.new(sx, 1, -1.6) * CFrame.Angles(0, HALF_PI, 0), RUBBER, M.Rubber)
	end
	Kit.beam(f, (cf * CFrame.new(2.6, 3, 0)).Position, (cf * CFrame.new(4, 3.6, 0)).Position, 0.25, STEEL, M.Metal, true)
end

local function popcornCart(f: Instance, cf: CFrame)
	cartBase(f, cf, rgb(200, 40, 40))
	local glass = part(f, V(4, 2.6, 2.4), cf * CFrame.new(0, 5.1, 0), rgb(220, 240, 250), M.Glass)
	glass.Transparency = 0.5
	part(f, V(3.6, 1.2, 2), cf * CFrame.new(0, 4.4, 0), rgb(250, 230, 150))
	for _, sx in { -2.2, 2.2 } do
		upright(f, 4.6, 0.25, cf * CFrame.new(sx, 3.8, 1.3), STEEL, M.Metal)
		upright(f, 4.6, 0.25, cf * CFrame.new(sx, 3.8, -1.3), STEEL, M.Metal)
	end
	for k = -2, 2 do
		part(f, V(1.1, 0.4, 3.8), cf * CFrame.new(k * 1.1, 8.6, 0), if k % 2 == 0 then rgb(220, 40, 40) else rgb(250, 250, 245)).CastShadow = false
	end
	Kit.sign(f, "POPCORN", V(4.4, 1.2, 0.2), cf * CFrame.new(0, 9.5, -0.5) * CFrame.Angles(0, math.pi, 0), { bg = rgb(220, 40, 40), fg = C.Gold, font = Enum.Font.GothamBlack, both = true })
end

local function balloonCart(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	cartBase(f, cf, rgb(40, 110, 200))
	upright(f, 7, 0.3, cf * CFrame.new(0, 3.8, 0), STEEL, M.Metal)
	local top = (cf * CFrame.new(0, 10.8, 0)).Position
	for k = 0, 8 do
		local a = k * 2.4
		local r = if k == 0 then 0 else 1.6 + (k % 3) * 0.5
		local p = top + V(math.cos(a) * r, 1 + (k % 3) * 1.1, math.sin(a) * r)
		Kit.ball(f, 2, p, BRIGHT[rng:NextInteger(1, #BRIGHT)], M.SmoothPlastic)
		Kit.beam(f, top, p - V(0, 1, 0), 0.06, rgb(240, 240, 240), M.SmoothPlastic)
	end
end

local function gasPump(f: Instance, cf: CFrame)
	part(f, V(2.6, 0.4, 2), cf * CFrame.new(0, 0.2, 0), rgb(150, 150, 150), M.Concrete)
	part(f, V(1.8, 5.6, 1.3), cf * CFrame.new(0, 3.2, 0), rgb(200, 40, 40))
	part(f, V(1.4, 1.2, 0.1), cf * CFrame.new(0, 4.6, -0.7), rgb(240, 240, 230)).CastShadow = false
	Kit.ball(f, 1.6, (cf * CFrame.new(0, 6.8, 0)).Position, rgb(255, 250, 230), M.Neon)
	Kit.beam(f, (cf * CFrame.new(1, 4, 0)).Position, (cf * CFrame.new(1.4, 1.6, -0.6)).Position, 0.3, RUBBER, M.Rubber, true)
	Kit.sign(f, "BENTON", V(1.7, 0.6, 0.1), cf * CFrame.new(0, 3, -0.7) * CFrame.Angles(0, math.pi, 0), { bg = C.Navy, fg = C.Gold, font = Enum.Font.GothamBlack })
end

local function clockPost(f: Instance, cf: CFrame)
	upright(f, 1, 1.6, cf, DARK, M.Metal)
	upright(f, 10, 0.6, cf, DARK, M.Metal)
	part(f, V(3.4, 3.4, 1.4), cf * CFrame.new(0, 11.6, 0), DARK, M.Metal)
	for _, side in { -1, 1 } do
		local face = Kit.cyl(f, 0.1, 2.8, cf * CFrame.new(0, 11.6, side * 0.72) * CFrame.Angles(0, HALF_PI, 0), rgb(250, 245, 230), M.SmoothPlastic)
		face.CastShadow = false
		part(f, V(0.18, 1.1, 0.06), cf * CFrame.new(0, 12.1, side * 0.8), DARK)
		part(f, V(0.8, 0.18, 0.06), cf * CFrame.new(0.35, 11.6, side * 0.8), DARK)
	end
	Kit.ball(f, 1, (cf * CFrame.new(0, 13.8, 0)).Position, C.Gold, M.Metal)
end

---------------------------------------------------------------------------
-- Diesel District
---------------------------------------------------------------------------
local CONTAINER_COLORS = { rgb(170, 50, 40), rgb(40, 90, 160), rgb(50, 120, 70), rgb(220, 130, 40), rgb(110, 110, 116) }

local function containerBox(f: Instance, cf: CFrame, color: Color3)
	part(f, V(8, 8.4, 20), cf * CFrame.new(0, 4.2, 0), color, M.CorrodedMetal)
	for k = -3, 3 do
		part(f, V(8.3, 7.6, 0.3), cf * CFrame.new(0, 4.2, k * 2.8), color:Lerp(Color3.new(0, 0, 0), 0.15), M.Metal)
	end
	part(f, V(7, 1.4, 0.1), cf * CFrame.new(0, 6.6, -10.05), rgb(240, 240, 235)).CastShadow = false
end

local function container(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	containerBox(f, cf, CONTAINER_COLORS[rng:NextInteger(1, #CONTAINER_COLORS)])
	if rng:NextNumber() < 0.5 then
		containerBox(f, cf * CFrame.new(0, 8.4, rng:NextNumber(-2, 2)) * CFrame.Angles(0, math.rad(rng:NextNumber(-8, 8)), 0), CONTAINER_COLORS[rng:NextInteger(1, #CONTAINER_COLORS)])
	end
end

local function crane(f: Instance, cf: CFrame)
	local yellow = rgb(240, 190, 40)
	part(f, V(8, 1, 8), cf * CFrame.new(0, 0.5, 0), rgb(120, 120, 126), M.Concrete)
	for _, sx in { -1.6, 1.6 } do
		for _, sz in { -1.6, 1.6 } do
			upright(f, 34, 0.5, cf * CFrame.new(sx, 1, sz), yellow, M.Metal)
		end
	end
	for y = 4, 32, 4 do
		part(f, V(3.6, 0.3, 0.3), cf * CFrame.new(0, y, -1.6), yellow, M.Metal)
		part(f, V(3.6, 0.3, 0.3), cf * CFrame.new(0, y, 1.6), yellow, M.Metal)
		part(f, V(0.3, 0.3, 3.6), cf * CFrame.new(-1.6, y + 2, 0), yellow, M.Metal)
		part(f, V(0.3, 0.3, 3.6), cf * CFrame.new(1.6, y + 2, 0), yellow, M.Metal)
	end
	part(f, V(3.6, 3, 4), cf * CFrame.new(0, 36.5, 0), yellow, M.Metal)
	part(f, V(2.6, 1.6, 0.1), cf * CFrame.new(0, 36.8, -2.05), rgb(150, 200, 230), M.Glass)
	part(f, V(2.4, 2, 30), cf * CFrame.new(0, 39, -10), yellow, M.Metal)
	part(f, V(3.4, 3.4, 4), cf * CFrame.new(0, 38, 7), rgb(110, 110, 116), M.Concrete)
	Kit.beam(f, (cf * CFrame.new(0, 38, -22)).Position, (cf * CFrame.new(0, 18, -22)).Position, 0.15, DARK, M.Metal)
	part(f, V(1.2, 1.6, 1.2), cf * CFrame.new(0, 17.4, -22), rgb(200, 60, 40), M.Metal)
	Kit.sign(f, "BENTON", V(6, 1.6, 0.2), cf * CFrame.new(0, 39, -2) * CFrame.Angles(0, HALF_PI, 0), { bg = yellow, fg = DARK, font = Enum.Font.GothamBlack, both = true })
end

local function pipeRun(f: Instance, cf: CFrame)
	for _, sz in { -6, 0, 6 } do
		part(f, V(5, 3.2, 0.8), cf * CFrame.new(0, 1.6, sz), rgb(110, 110, 116), M.Concrete)
	end
	Kit.cyl(f, 16, 1.4, cf * CFrame.new(-1.2, 3.9, 0) * CFrame.Angles(0, HALF_PI, 0), STEEL, M.Metal)
	Kit.cyl(f, 16, 1, cf * CFrame.new(1.3, 3.7, 0) * CFrame.Angles(0, HALF_PI, 0), rgb(200, 120, 40), M.Metal)
	upright(f, 4, 1, cf * CFrame.new(1.3, 3.7, 8), rgb(200, 120, 40), M.Metal)
	Kit.cyl(f, 0.3, 2.2, cf * CFrame.new(-1.2, 5.3, -3) * CFrame.Angles(0, 0, HALF_PI), C.Red, M.Metal)
	upright(f, 0.8, 0.3, cf * CFrame.new(-1.2, 4.5, -3), STEEL, M.Metal)
end

local function forklift(f: Instance, cf: CFrame)
	local yellow = rgb(240, 180, 30)
	part(f, V(4, 2.4, 6), cf * CFrame.new(0, 2, 0.5), yellow)
	part(f, V(4, 2.2, 1.6), cf * CFrame.new(0, 2.4, 3.6), rgb(60, 60, 64), M.Metal)
	for _, sx in { -1.7, 1.7 } do
		upright(f, 4, 0.25, cf * CFrame.new(sx, 3.2, -1.6), DARK, M.Metal)
		upright(f, 4, 0.25, cf * CFrame.new(sx, 3.2, 2.2), DARK, M.Metal)
		upright(f, 7, 0.4, cf * CFrame.new(sx * 0.7, 0.8, -2.8), DARK, M.Metal)
		part(f, V(0.4, 0.25, 4), cf * CFrame.new(sx * 0.7, 1.2, -4.8), DARK, M.Metal)
		Kit.cyl(f, 1, 2, cf * CFrame.new(sx * 1.1, 1, -1.6), RUBBER, M.Rubber)
		Kit.cyl(f, 1, 1.6, cf * CFrame.new(sx * 1.1, 0.8, 2.6), RUBBER, M.Rubber)
	end
	part(f, V(4, 0.3, 4), cf * CFrame.new(0, 7.3, 0.3), DARK, M.Metal)
	part(f, V(1.6, 0.8, 1.6), cf * CFrame.new(0, 3.6, 1.2), RUBBER)
end

local function gearSculpture(f: Instance, cf: CFrame, lc: Color3)
	part(f, V(4, 3, 4), cf * CFrame.new(0, 1.5, 0), rgb(110, 110, 116), M.Concrete)
	local pivot = cf * CFrame.new(0, 8.2, 0)
	local m = spinner(f, "GearSculpture", pivot, 0.5, "Z")
	Kit.gear(m, pivot, 9, C.Gold)
	upright(f, 3, 1, cf * CFrame.new(0, 3, 0), lc, M.Metal)
end

local function steamVent(f: Instance, cf: CFrame)
	part(f, V(3.4, 0.6, 3.4), cf * CFrame.new(0, 0.3, 0), rgb(90, 90, 96), M.DiamondPlate)
	upright(f, 4, 1.2, cf * CFrame.new(0, 0.6, 0), STEEL, M.Metal)
	local cap = upright(f, 0.5, 1.6, cf * CFrame.new(0, 4.6, 0), rgb(70, 70, 76), M.Metal)
	cap.Name = "SteamVent"
	cap:AddTag("SteamVent")
	local smoke = Instance.new("Smoke")
	smoke.Color = rgb(235, 235, 235)
	smoke.Opacity = 0.18
	smoke.RiseVelocity = 7
	smoke.Size = 3
	smoke.Parent = cap
	part(f, V(2.6, 0.4, 0.1), cf * CFrame.new(0, 2.2, -0.62), rgb(250, 200, 40)).CastShadow = false
end

local function oilDrums(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local colors = { rgb(30, 90, 170), rgb(190, 40, 40), rgb(240, 180, 30), rgb(60, 60, 64) }
	local n = rng:NextInteger(3, 5)
	for k = 1, n do
		local a = k * 2.1
		local c = colors[rng:NextInteger(1, #colors)]
		local base = cf * CFrame.new(math.cos(a) * 1.5, 0, math.sin(a) * 1.5)
		upright(f, 3.4, 2.2, base, c, M.Metal)
		upright(f, 0.15, 2.3, base * CFrame.new(0, 1.1, 0), c:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal)
		upright(f, 0.15, 2.3, base * CFrame.new(0, 2.3, 0), c:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal)
	end
	Kit.cyl(f, 3.4, 2.2, cf * CFrame.new(3, 1.1, 1) * CFrame.Angles(0, 0.4, 0), colors[1], M.Metal)
end

local function hazardBarrier(f: Instance, cf: CFrame)
	for _, sx in { -3.2, 3.2 } do
		local b = cf * CFrame.new(sx, 0, 0)
		part(f, V(6, 2.4, 1.6), b * CFrame.new(0, 1.2, 0), rgb(200, 200, 196), M.Concrete)
		for k = -2, 2 do
			part(f, V(0.6, 1.2, 0.05), b * CFrame.new(k * 1.2, 1.4, -0.82) * CFrame.Angles(0, 0, 0.6), if k % 2 == 0 then rgb(250, 200, 30) else rgb(30, 30, 30)).CastShadow = false
		end
	end
end

local function tireStack(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local n = rng:NextInteger(3, 5)
	for k = 0, n - 1 do
		upright(f, 1, 3, cf * CFrame.new(rng:NextNumber(-0.2, 0.2), k * 1, rng:NextNumber(-0.2, 0.2)), RUBBER, M.Rubber)
	end
	upright(f, 1.02, 1.4, cf * CFrame.new(0, (n - 1) * 1, 0), rgb(50, 50, 52), M.Rubber)
end

---------------------------------------------------------------------------
-- Little Haulers
---------------------------------------------------------------------------
local function digger(f: Instance, cf: CFrame)
	local yellow = rgb(250, 190, 30)
	for _, sx in { -2.2, 2.2 } do
		part(f, V(1.6, 1.6, 7), cf * CFrame.new(sx, 0.8, 0), RUBBER, M.Rubber)
	end
	part(f, V(5, 1, 5), cf * CFrame.new(0, 2.1, 0), DARK, M.Metal)
	part(f, V(5, 2.6, 5.4), cf * CFrame.new(0, 3.9, 0.6), yellow)
	part(f, V(2.6, 2.6, 2.6), cf * CFrame.new(-1, 6.5, 1), yellow)
	part(f, V(2.2, 1.6, 0.1), cf * CFrame.new(-1, 6.8, -0.31), rgb(150, 200, 230), M.Glass)
	local boom = cf * CFrame.new(1.2, 5, -2) * CFrame.Angles(math.rad(35), 0, 0)
	part(f, V(1, 1, 7), boom * CFrame.new(0, 0, -3.5), yellow)
	local stick = boom * CFrame.new(0, 0, -7) * CFrame.Angles(math.rad(-85), 0, 0)
	part(f, V(0.8, 0.8, 5), stick * CFrame.new(0, 0, -2.5), yellow)
	Kit.wedge(f, V(2.4, 1.6, 2), stick * CFrame.new(0, -0.4, -5.6) * CFrame.Angles(0, math.pi, 0), rgb(120, 120, 126), M.Metal)
end

local function toyBlocks(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local letters = { "B", "E", "N", "T", "O", "N" }
	local spots = { V(-3.2, 0, 0), V(0, 0, 0), V(3.2, 0, 0), V(-1.6, 3.2, 0), V(1.6, 3.2, 0), V(0, 6.4, 0) }
	local n = rng:NextInteger(4, 6)
	for k = 1, n do
		local s = spots[k]
		local b = part(f, V(3, 3, 3), cf * CFrame.new(s.X, 1.5 + s.Y, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(-10, 10)), 0), BRIGHT[(k - 1) % #BRIGHT + 1])
		Kit.label(b, Enum.NormalId.Front, letters[k], { fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBlack })
	end
end

local function miniTruck(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local c = BRIGHT[rng:NextInteger(1, #BRIGHT)]
	part(f, V(5, 2.2, 9), cf * CFrame.new(0, 2.4, 0), c)
	part(f, V(4.6, 2.2, 3.4), cf * CFrame.new(0, 4.6, -1.6), c)
	part(f, V(4.2, 1.4, 0.1), cf * CFrame.new(0, 4.8, -3.35), rgb(150, 200, 230), M.Glass)
	part(f, V(5.2, 0.6, 4), cf * CFrame.new(0, 3.8, 2.6), rgb(250, 250, 245))
	for _, sx in { -2.4, 2.4 } do
		for _, sz in { -3, 3 } do
			Kit.cyl(f, 1.2, 2.8, cf * CFrame.new(sx, 1.4, sz), RUBBER, M.Rubber)
			Kit.cyl(f, 1.25, 1.2, cf * CFrame.new(sx, 1.4, sz), rgb(220, 220, 225), M.Metal)
		end
	end
	Kit.ball(f, 0.8, (cf * CFrame.new(-1.6, 2.6, -4.55)).Position, rgb(255, 250, 220), M.Neon)
	Kit.ball(f, 0.8, (cf * CFrame.new(1.6, 2.6, -4.55)).Position, rgb(255, 250, 220), M.Neon)
end

local function cone(f: Instance, cf: CFrame)
	local orange = rgb(255, 110, 20)
	part(f, V(1.8, 0.3, 1.8), cf * CFrame.new(0, 0.15, 0), orange)
	upright(f, 0.9, 1.3, cf * CFrame.new(0, 0.3, 0), orange)
	upright(f, 0.5, 0.95, cf * CFrame.new(0, 1.2, 0), rgb(250, 250, 250))
	upright(f, 0.6, 0.6, cf * CFrame.new(0, 1.7, 0), orange)
end

local function coneCluster(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	for k = 1, rng:NextInteger(3, 4) do
		local a = k * 1.9
		cone(f, cf * CFrame.new(math.cos(a) * 1.8, 0, math.sin(a) * 1.8))
	end
end

local ROAD_SIGNS = {
	{ "SCHOOL\nZONE", rgb(250, 210, 40), rgb(20, 20, 20) },
	{ "TRUCK\nCROSSING", rgb(250, 210, 40), rgb(20, 20, 20) },
	{ "SPEED\nLIMIT 5", rgb(250, 250, 250), rgb(20, 20, 20) },
	{ "DIG SITE\nAHEAD", rgb(255, 130, 20), rgb(20, 20, 20) },
	{ "YIELD", rgb(220, 40, 40), rgb(250, 250, 250) },
	{ "ONE WAY", rgb(20, 20, 20), rgb(250, 250, 250) },
}
local signIndex = 0
local function roadSign(f: Instance, cf: CFrame)
	signIndex += 1
	local s = ROAD_SIGNS[(signIndex - 1) % #ROAD_SIGNS + 1]
	Kit.postSign(f, s[1] :: string, cf.Position, cf.LookVector, 3.6, 3, { bg = s[2] :: Color3, fg = s[3] :: Color3, font = Enum.Font.GothamBlack, both = true })
end

---------------------------------------------------------------------------
-- Backwoods Junction
---------------------------------------------------------------------------
local function windmill(f: Instance, cf: CFrame)
	local wood = rgb(110, 80, 56)
	local h = 24
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local a = (cf * CFrame.new(sx * 3.2, 0, sz * 3.2)).Position
			local b = (cf * CFrame.new(sx * 0.8, h, sz * 0.8)).Position
			Kit.beam(f, a, b, 0.5, wood, M.Wood)
		end
	end
	for y = 6, h - 4, 6 do
		local w = 3.2 - y / h * 2.4
		for _, sz in { -1, 1 } do
			part(f, V(w * 2, 0.3, 0.3), cf * CFrame.new(0, y, sz * w), wood, M.Wood)
			part(f, V(0.3, 0.3, w * 2), cf * CFrame.new(sz * w, y, 0), wood, M.Wood)
		end
	end
	part(f, V(2.4, 2, 3), cf * CFrame.new(0, h + 1, 0.4), rgb(140, 140, 146), M.Metal)
	part(f, V(0.2, 3, 5), cf * CFrame.new(0, h + 1.6, 4.4), rgb(200, 60, 40), M.Metal)
	local hub = cf * CFrame.new(0, h + 1, -1.4)
	local m = spinner(f, "Windmill", hub, 1.1, "Z")
	upright(m, 0.6, 1.4, hub * CFrame.Angles(HALF_PI, 0, 0), rgb(140, 140, 146), M.Metal)
	for k = 0, 11 do
		local a = k * math.pi / 6
		part(m, V(0.9, 5.5, 0.15), hub * CFrame.Angles(0, 0, a) * CFrame.new(0, 3.6, 0) * CFrame.Angles(0, 0.35, 0), rgb(230, 228, 220), M.Metal)
	end
	Kit.cyl(f, 0.3, 13, hub * CFrame.new(0, 0, 0.2) * CFrame.Angles(0, HALF_PI, 0), rgb(150, 150, 156), M.Metal).Transparency = 0.6
end

local function campfire(f: Instance, cf: CFrame)
	for k = 0, 9 do
		local a = k * math.pi / 5
		Kit.ball(f, 1.1, (cf * CFrame.new(math.cos(a) * 2, 0.3, math.sin(a) * 2)).Position, rgb(120, 116, 110), M.Slate)
	end
	for k = 0, 3 do
		Kit.cyl(f, 3, 0.6, cf * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, k * math.pi / 4, 0.5), DARK_WOOD, M.Wood)
	end
	local center = part(f, V(1, 1, 1), cf * CFrame.new(0, 1.2, 0), Color3.new(1, 0.5, 0))
	center.Transparency = 1
	center.CanCollide = false
	center.Name = "Campfire"
	center:AddTag("Campfire")
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 6
	fire.Parent = center
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 150, 60)
	light.Range = 18
	light.Brightness = 1.6
	light.Parent = center
	-- log benches
	for _, a in { 0, 2.1, 4.2 } do
		Kit.cyl(f, 4.4, 1.3, cf * CFrame.new(math.cos(a) * 5, 0.65, math.sin(a) * 5) * CFrame.Angles(0, -a + HALF_PI, 0), WOOD, M.Wood)
	end
end

local function logPile(f: Instance, cf: CFrame)
	local rows = { { -1.5, 0, 1.5 }, { -0.75, 0.75 }, { 0 } }
	for r, row in rows do
		for _, x in row do
			local log = Kit.cyl(f, 8, 1.5, cf * CFrame.new(x, 0.75 + (r - 1) * 1.3, 0) * CFrame.Angles(0, HALF_PI, 0), WOOD, M.Wood)
			log.Size = V(8, 1.5, 1.5)
			Kit.cyl(f, 0.1, 1.2, cf * CFrame.new(x, 0.75 + (r - 1) * 1.3, -4.02) * CFrame.Angles(0, HALF_PI, 0), rgb(200, 160, 110), M.Wood)
		end
	end
	upright(f, 3, 0.4, cf * CFrame.new(2.3, 0, 3), DARK_WOOD, M.Wood)
	part(f, V(0.2, 0.8, 1.6), cf * CFrame.new(2.6, 2.6, 3.4) * CFrame.Angles(0, 0, 0.3), STEEL, M.Metal)
end

local function rockPile(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	for k = 1, rng:NextInteger(3, 5) do
		local s = rng:NextNumber(1.8, 4.2)
		local p = cf * CFrame.new(rng:NextNumber(-2.4, 2.4), s * 0.3, rng:NextNumber(-2.4, 2.4)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0)
		Kit.block(f, V(s, s * 0.8, s * 1.1), p, rgb(120, 118, 112):Lerp(rgb(90, 86, 80), rng:NextNumber()), M.Slate)
	end
end

local function wagonWheel(f: Instance, cf: CFrame)
	upright(f, 4, 0.5, cf * CFrame.new(0, 0, 0.8), DARK_WOOD, M.Wood)
	local hubCF = cf * CFrame.new(0, 2.1, 0) * CFrame.Angles(math.rad(-12), 0, 0)
	Kit.cyl(f, 0.3, 4, hubCF * CFrame.Angles(0, HALF_PI, 0), DARK_WOOD, M.Wood)
	Kit.cyl(f, 0.32, 3.2, hubCF * CFrame.Angles(0, HALF_PI, 0), rgb(110, 150, 90), M.Grass).Transparency = 0
	Kit.cyl(f, 0.5, 0.8, hubCF * CFrame.Angles(0, HALF_PI, 0), STEEL, M.Metal)
	for k = 0, 5 do
		part(f, V(0.2, 3.4, 0.2), hubCF * CFrame.Angles(0, 0, k * math.pi / 6), DARK_WOOD, M.Wood)
	end
end

local function barrels(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	for k = 1, rng:NextInteger(2, 3) do
		local base = cf * CFrame.new((k - 2) * 2.6, 0, rng:NextNumber(-0.6, 0.6))
		upright(f, 3.4, 2.4, base, WOOD, M.Wood)
		upright(f, 0.2, 2.5, base * CFrame.new(0, 0.6, 0), rgb(70, 70, 74), M.Metal)
		upright(f, 0.2, 2.5, base * CFrame.new(0, 2.6, 0), rgb(70, 70, 74), M.Metal)
	end
end

local SIGNPOST = {
	{ "RAPIDS", "TOW TRUCK", "TRADING POST" },
	{ "PORK CHOP DINER", "WATER TOWER", "HUB" },
	{ "GOLD MINE", "FISHIN' HOLE", "BEAR CROSSING" },
	{ "BACKWOODS", "1 MILE", "YEEHAW!" },
}
local postIndex = 0
local function signpost(f: Instance, cf: CFrame)
	postIndex += 1
	local words = SIGNPOST[(postIndex - 1) % #SIGNPOST + 1]
	upright(f, 9, 0.6, cf, DARK_WOOD, M.Wood)
	for k, w in words do
		local yaw = (k - 2) * 0.9
		local board = part(f, V(5, 1.2, 0.3), cf * CFrame.new(0, 8 - k * 1.6, 0) * CFrame.Angles(0, yaw, 0) * CFrame.new(2.2, 0, 0), rgb(150, 110, 70), M.WoodPlanks)
		Kit.label(board, Enum.NormalId.Front, w, { fg = C.Cream, font = Enum.Font.GothamBold })
		Kit.label(board, Enum.NormalId.Back, w, { fg = C.Cream, font = Enum.Font.GothamBold })
	end
end

local function lanternPost(f: Instance, cf: CFrame)
	upright(f, 8, 0.6, cf, DARK_WOOD, M.Wood)
	part(f, V(0.4, 0.4, 2.4), cf * CFrame.new(0, 7.6, -1), DARK_WOOD, M.Wood)
	part(f, V(1.2, 0.3, 1.2), cf * CFrame.new(0, 7.1, -2), rgb(40, 40, 44), M.Metal)
	local glass = part(f, V(1, 1.4, 1), cf * CFrame.new(0, 6.2, -2), rgb(255, 220, 160), M.Glass)
	glass.Transparency = 0.4
	local flame = Kit.ball(f, 0.6, (cf * CFrame.new(0, 6.2, -2)).Position, rgb(255, 190, 110), M.Neon)
	flame.CastShadow = false
	flame:AddTag("ParkLamp")
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 180, 110)
	light.Range = 16
	light.Brightness = 1
	light.Shadows = false
	light.Enabled = false
	light.Parent = flame
end

---------------------------------------------------------------------------
-- Benton Movie Studios
---------------------------------------------------------------------------
local function stageCan(f: Instance, cf: CFrame, color: Color3)
	part(f, V(1.2, 1.2, 1.8), cf, rgb(36, 36, 40), M.Metal)
	Kit.cyl(f, 0.1, 1, cf * CFrame.new(0, 0, -0.95) * CFrame.Angles(0, HALF_PI, 0), color, M.Neon).CastShadow = false
end

local function spotTruss(f: Instance, cf: CFrame)
	local grey = rgb(170, 172, 178)
	for _, sx in { -6, 6 } do
		for _, dx in { -0.5, 0.5 } do
			for _, dz in { -0.5, 0.5 } do
				upright(f, 12, 0.2, cf * CFrame.new(sx + dx, 0, dz), grey, M.Metal)
			end
		end
		part(f, V(2, 0.4, 2), cf * CFrame.new(sx, 0.2, 0), DARK, M.Metal)
	end
	for _, dy in { -0.5, 0.5 } do
		for _, dz in { -0.5, 0.5 } do
			part(f, V(13, 0.2, 0.2), cf * CFrame.new(0, 12 + dy, dz), grey, M.Metal)
		end
	end
	for k = -1, 1 do
		stageCan(f, cf * CFrame.new(k * 3.5, 10.6, 0) * CFrame.Angles(math.rad(-35), 0, 0), BRIGHT[k + 2])
	end
end

local function clapper(f: Instance, cf: CFrame)
	part(f, V(4, 2, 3), cf * CFrame.new(0, 1, 0), rgb(110, 110, 116), M.Concrete)
	local board = part(f, V(8, 6, 0.8), cf * CFrame.new(0, 5.2, 0) * CFrame.Angles(math.rad(-6), 0, 0), rgb(26, 26, 30))
	Kit.label(board, Enum.NormalId.Front, "BENTON STUDIOS\nSCENE 1  TAKE 1", { fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBold })
	Kit.label(board, Enum.NormalId.Back, "QUIET ON SET!", { fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBold })
	local top = cf * CFrame.new(-4, 8.4, 0) * CFrame.Angles(0, 0, math.rad(18))
	for k = 0, 5 do
		part(f, V(1.35, 1, 0.8), top * CFrame.new(0.7 + k * 1.35, 0, 0), if k % 2 == 0 then Color3.new(1, 1, 1) else rgb(26, 26, 30))
	end
	for k = 0, 5 do
		part(f, V(1.35, 0.8, 0.8), cf * CFrame.new(-3.3 + k * 1.35, 8.4, 0) * CFrame.Angles(math.rad(-6), 0, 0), if k % 2 == 1 then Color3.new(1, 1, 1) else rgb(26, 26, 30))
	end
end

local function searchlight(f: Instance, cf: CFrame)
	part(f, V(4, 1.6, 6), cf * CFrame.new(0, 1.6, 0), rgb(60, 70, 60), M.Metal)
	for _, sx in { -2.2, 2.2 } do
		Kit.cyl(f, 0.6, 2.2, cf * CFrame.new(sx, 1.1, 0), RUBBER, M.Rubber)
	end
	for _, sx in { -1.4, 1.4 } do
		part(f, V(0.4, 2.4, 0.6), cf * CFrame.new(sx, 3.4, 0), rgb(60, 70, 60), M.Metal)
	end
	local head = cf * CFrame.new(0, 4.4, 0) * CFrame.Angles(math.rad(-12), 0, 0)
	local barrel = Kit.cyl(f, 3, 2.4, head * CFrame.Angles(0, 0, HALF_PI), rgb(70, 80, 70), M.Metal)
	local lens = Kit.cyl(f, 0.1, 2.2, head * CFrame.new(0, 1.55, 0) * CFrame.Angles(0, 0, HALF_PI), rgb(255, 250, 220), M.Neon)
	lens.CastShadow = false
	local beam = part(f, V(0.4, 0.4, 0.4), head * CFrame.new(0, 1.6, 0), Color3.new(1, 1, 1))
	beam.Transparency = 1
	beam.CanCollide = false
	beam.Name = "Searchlight"
	beam:AddTag("Searchlight")
	nightLight(beam, rgb(255, 245, 220), 60, "spot")
	local _ = barrel
end

local function filmReel(f: Instance, cf: CFrame)
	for _, sx in { -1.4, 1.4 } do
		upright(f, 5, 0.5, cf * CFrame.new(sx, 0, 0), DARK, M.Metal)
	end
	part(f, V(4, 0.6, 2), cf * CFrame.new(0, 0.3, 0), DARK, M.Metal)
	local hub = cf * CFrame.new(0, 5.6, 0)
	local m = spinner(f, "FilmReel", hub, 0.8, "X")
	Kit.cyl(m, 0.4, 6.4, hub, rgb(180, 182, 190), M.Metal)
	Kit.cyl(m, 0.5, 1.4, hub, rgb(40, 40, 44), M.Metal)
	for k = 0, 2 do
		local a = k * math.pi * 2 / 3
		Kit.cyl(m, 0.45, 1.6, hub * CFrame.Angles(a, 0, 0) * CFrame.new(0, 1.9, 0), rgb(40, 40, 44), M.Metal)
	end
end

local function movieCamera(f: Instance, cf: CFrame)
	local top = (cf * CFrame.new(0, 5, 0)).Position
	for k = 0, 2 do
		local a = k * math.pi * 2 / 3
		Kit.beam(f, (cf * CFrame.new(math.cos(a) * 1.8, 0, math.sin(a) * 1.8)).Position, top, 0.3, rgb(40, 40, 44), M.Metal)
	end
	part(f, V(2, 2.2, 3.4), cf * CFrame.new(0, 6.1, 0), rgb(40, 40, 44), M.Metal)
	Kit.cyl(f, 1.6, 1.2, cf * CFrame.new(0, 6.1, -2.4) * CFrame.Angles(0, HALF_PI, 0), rgb(30, 30, 34), M.Metal)
	for _, z in { -0.8, 1 } do
		Kit.cyl(f, 0.4, 2.2, cf * CFrame.new(0, 8.2, z), rgb(180, 182, 190), M.Metal)
	end
end

local function directorChair(f: Instance, cf: CFrame, color: Color3, label: string)
	for _, sx in { -1, 1 } do
		for _, sz in { -0.8, 0.8 } do
			upright(f, 2.4, 0.2, cf * CFrame.new(sx, 0, sz), WOOD, M.Wood)
		end
		upright(f, 2, 0.2, cf * CFrame.new(sx, 2.4, 0.8), WOOD, M.Wood)
	end
	part(f, V(2, 0.2, 1.6), cf * CFrame.new(0, 2.4, 0), color, M.Fabric)
	local back = part(f, V(2.2, 1, 0.1), cf * CFrame.new(0, 3.9, 0.85), color, M.Fabric)
	Kit.label(back, Enum.NormalId.Back, label, { fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBlack })
end

local function directorChairs(f: Instance, cf: CFrame)
	directorChair(f, cf * CFrame.new(-1.6, 0, 0), rgb(40, 40, 44), "DIRECTOR")
	directorChair(f, cf * CFrame.new(1.6, 0, 0), rgb(150, 40, 50), "STAR")
end

---------------------------------------------------------------------------
-- Velocity City
---------------------------------------------------------------------------
local function raceCar(f: Instance, cf: CFrame, lc: Color3, rng: Random)
	Kit.disc(f, 13, 0.8, (cf * CFrame.new(0, 0.8, 0)).Position, rgb(30, 34, 44), M.Metal)
	local colors = { lc, rgb(255, 140, 26), rgb(200, 40, 40), rgb(240, 240, 240) }
	local c = colors[rng:NextInteger(1, #colors)]
	local pivot = cf * CFrame.new(0, 0.8, 0)
	local m = spinner(f, "ShowCar", pivot, 0.25, "Y")
	part(m, V(4.4, 1.2, 10), pivot * CFrame.new(0, 1.2, 0), c)
	Kit.wedge(m, V(3.6, 1, 3), pivot * CFrame.new(0, 2, -3.6), c, M.SmoothPlastic)
	part(m, V(2, 1, 2.6), pivot * CFrame.new(0, 2.3, 0.6), rgb(20, 20, 26), M.Glass)
	part(m, V(5.6, 0.25, 1.2), pivot * CFrame.new(0, 3, 4.6), rgb(20, 20, 26))
	part(m, V(5.6, 0.2, 1.2), pivot * CFrame.new(0, 0.9, -5.2), rgb(20, 20, 26))
	for _, sx in { -2.4, 2.4 } do
		for _, sz in { -3.2, 3.4 } do
			Kit.cyl(m, 1, 2.2, pivot * CFrame.new(sx, 1.1, sz), RUBBER, M.Rubber)
		end
	end
	part(m, V(0.6, 0.6, 0.05), pivot * CFrame.new(0, 1.4, -5.02), Color3.new(1, 1, 1)).CastShadow = false
end

local BILLBOARDS = { "NITRO FUEL\nGO FURTHER", "BENTON RACING\nSINCE 1952", "FASTER THAN\nYOUR SHADOW", "PIT STOP PIZZA\nFUEL UP" }
local boardIndex = 0
local function billboard(f: Instance, cf: CFrame, lc: Color3)
	boardIndex += 1
	Kit.postSign(f, BILLBOARDS[(boardIndex - 1) % #BILLBOARDS + 1], cf.Position, cf.LookVector, 16, 7, { bg = rgb(20, 22, 30), fg = if boardIndex % 2 == 0 then C.Orange else lc, font = Enum.Font.GothamBlack, glow = true, both = true })
end

local function podium(f: Instance, cf: CFrame)
	local steps = { { 0, 4, "1", C.Gold }, { -4, 2.6, "2", rgb(200, 200, 210) }, { 4, 1.8, "3", rgb(200, 130, 70) } }
	for _, s in steps do
		local h = s[2] :: number
		local b = part(f, V(4, h, 4), cf * CFrame.new(s[1] :: number, h / 2, 0), rgb(240, 240, 240))
		Kit.label(b, Enum.NormalId.Front, s[3] :: string, { fg = s[4] :: Color3, font = Enum.Font.GothamBlack })
		part(f, V(4.1, 0.3, 4.1), cf * CFrame.new(s[1] :: number, h, 0), s[4] :: Color3, M.Metal)
	end
	upright(f, 1.4, 1.2, cf * CFrame.new(0, 4.1, 0), C.Gold, M.Metal)
	Kit.ball(f, 1.8, (cf * CFrame.new(0, 6.2, 0)).Position, C.Gold, M.Metal)
	Kit.cyl(f, 0.4, 2.6, cf * CFrame.new(0, 7.2, 0) * CFrame.Angles(0, HALF_PI, 0), C.Gold, M.Metal)
end

local function tireBarrier(f: Instance, cf: CFrame)
	for k = -2, 2 do
		for y = 0, 1 do
			upright(f, 1, 2.6, cf * CFrame.new(k * 2.6, y, 0), if (k + y) % 2 == 0 then rgb(220, 40, 40) else rgb(240, 240, 240), M.Rubber)
		end
	end
end

local function chevronSign(f: Instance, cf: CFrame)
	Kit.postSign(f, ">>>", cf.Position, cf.LookVector, 6, 2.2, { bg = rgb(220, 40, 40), fg = Color3.new(1, 1, 1), font = Enum.Font.GothamBlack, both = true })
end

local function checkerFlag(f: Instance, cf: CFrame)
	upright(f, 11, 0.3, cf, rgb(200, 200, 205), M.Metal)
	for i = 0, 3 do
		for j = 0, 2 do
			part(f, V(0.9, 0.9, 0.08), cf * CFrame.new(0.6 + i * 0.9, 9.9 - j * 0.9, 0), if (i + j) % 2 == 0 then Color3.new(1, 1, 1) else rgb(20, 20, 20)).CastShadow = false
		end
	end
end

local function neonPost(f: Instance, cf: CFrame, lc: Color3)
	upright(f, 9, 0.8, cf, rgb(30, 34, 44), M.Metal)
	part(f, V(0.25, 7, 0.25), cf * CFrame.new(0, 4.5, -0.42), lc, M.Neon).CastShadow = false
	part(f, V(0.25, 7, 0.25), cf * CFrame.new(0, 4.5, 0.42), rgb(255, 140, 26), M.Neon).CastShadow = false
	upright(f, 0.4, 1.2, cf * CFrame.new(0, 9, 0), rgb(30, 34, 44), M.Metal)
end

---------------------------------------------------------------------------
-- Benton Family Landing
---------------------------------------------------------------------------
local function lighthouse(f: Instance, cf: CFrame)
	upright(f, 1.2, 12, cf, rgb(150, 146, 140), M.Cobblestone)
	local y = 1.2
	for k = 0, 5 do
		local d = 7 - k * 0.6
		upright(f, 4, d, cf * CFrame.new(0, y, 0), if k % 2 == 0 then rgb(240, 240, 236) else rgb(200, 40, 40), M.SmoothPlastic)
		y += 4
	end
	upright(f, 0.6, 6.4, cf * CFrame.new(0, y, 0), DARK, M.Metal)
	local glass = upright(f, 3, 3.6, cf * CFrame.new(0, y + 0.6, 0), rgb(255, 250, 220), M.Glass)
	glass.Transparency = 0.5
	upright(f, 1, 4.4, cf * CFrame.new(0, y + 3.6, 0), rgb(200, 40, 40), M.Metal)
	upright(f, 1, 2.6, cf * CFrame.new(0, y + 4.6, 0), rgb(200, 40, 40), M.Metal)
	Kit.ball(f, 0.8, (cf * CFrame.new(0, y + 6, 0)).Position, DARK, M.Metal)
	local lampCF = cf * CFrame.new(0, y + 2.1, 0)
	local m = spinner(f, "LighthouseLamp", lampCF, 0.9, "Y")
	local lamp = Kit.ball(m, 1.4, lampCF.Position, rgb(255, 245, 200), M.Neon)
	lamp.CastShadow = false
	local beamPart = part(m, V(0.4, 0.4, 0.4), lampCF * CFrame.Angles(HALF_PI, 0, 0), Color3.new(1, 1, 1))
	beamPart.Transparency = 1
	beamPart.CanCollide = false
	beamPart.Name = "Lighthouse"
	beamPart:AddTag("Lighthouse")
	nightLight(beamPart, rgb(255, 245, 210), 120, "spot")
	-- door and a little railing
	part(f, V(2, 3.2, 0.3), cf * CFrame.new(0, 2.8, -3.4), DARK_WOOD, M.Wood)
end

local function gazebo(f: Instance, cf: CFrame)
	upright(f, 1.2, 16, cf, rgb(240, 236, 228), M.WoodPlanks)
	for k = 0, 7 do
		local a = k * math.pi / 4
		upright(f, 9, 0.6, cf * CFrame.new(math.cos(a) * 7, 1.2, math.sin(a) * 7), rgb(250, 250, 248), M.Wood)
		if k ~= 2 then
			local a2 = a + math.pi / 4
			local p1 = (cf * CFrame.new(math.cos(a) * 7, 3.6, math.sin(a) * 7)).Position
			local p2 = (cf * CFrame.new(math.cos(a2) * 7, 3.6, math.sin(a2) * 7)).Position
			Kit.beam(f, p1, p2, 0.3, rgb(250, 250, 248), M.Wood)
		end
	end
	upright(f, 0.8, 17, cf * CFrame.new(0, 10.2, 0), rgb(70, 140, 110), M.SmoothPlastic)
	upright(f, 1.6, 12, cf * CFrame.new(0, 11, 0), rgb(70, 140, 110), M.SmoothPlastic)
	upright(f, 1.6, 7, cf * CFrame.new(0, 12.6, 0), rgb(70, 140, 110), M.SmoothPlastic)
	upright(f, 1.4, 2.6, cf * CFrame.new(0, 14.2, 0), rgb(70, 140, 110), M.SmoothPlastic)
	Kit.ball(f, 1.2, (cf * CFrame.new(0, 16, 0)).Position, C.Gold, M.Metal)
	-- string of bulbs around the eaves
	for k = 0, 23 do
		local a = k * math.pi / 12
		Kit.ball(f, 0.45, (cf * CFrame.new(math.cos(a) * 8.2, 10, math.sin(a) * 8.2)).Position, rgb(255, 236, 190), M.Neon).CastShadow = false
	end
end

local function rowboat(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local colors = { rgb(200, 60, 50), rgb(40, 110, 200), rgb(240, 240, 236), rgb(60, 150, 90) }
	local c = colors[rng:NextInteger(1, #colors)]
	local base = cf * CFrame.new(0, -0.5, 0)
	part(f, V(3.4, 1.2, 7), base * CFrame.new(0, 0.6, 0), c, M.Wood)
	Kit.wedge(f, V(3.4, 1.2, 2.4), base * CFrame.new(0, 0.6, -4.7), c, M.Wood)
	part(f, V(3, 0.2, 6.6), base * CFrame.new(0, 1.05, 0), rgb(170, 130, 90), M.WoodPlanks)
	part(f, V(3.2, 0.3, 0.8), base * CFrame.new(0, 1.4, 1), rgb(150, 110, 70), M.Wood)
	for _, sx in { -1, 1 } do
		Kit.beam(f, (base * CFrame.new(sx * 1.6, 1.6, 0.6)).Position, (base * CFrame.new(sx * 4.2, 0, -0.6)).Position, 0.25, rgb(150, 110, 70), M.Wood)
	end
end

local function picnic(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local colors = { rgb(200, 40, 40), rgb(40, 110, 200), rgb(60, 150, 90) }
	local c = colors[rng:NextInteger(1, #colors)]
	for i = 0, 3 do
		for j = 0, 3 do
			part(f, V(1.5, 0.1, 1.5), cf * CFrame.new(-2.25 + i * 1.5, 0.15, -2.25 + j * 1.5), if (i + j) % 2 == 0 then c else rgb(250, 250, 245), M.Fabric).CastShadow = false
		end
	end
	part(f, V(1.8, 1, 1.2), cf * CFrame.new(1.4, 0.7, 1.2), rgb(170, 120, 70), M.Wood)
	Kit.beam(f, (cf * CFrame.new(0.7, 1.2, 1.2)).Position, (cf * CFrame.new(2.1, 1.2, 1.2)).Position, 0.15, rgb(140, 100, 60), M.Wood)
	Kit.disc(f, 1.2, 0.1, (cf * CFrame.new(-1, 0.3, -0.8)).Position, rgb(250, 250, 250), M.SmoothPlastic)
	Kit.ball(f, 0.7, (cf * CFrame.new(-1, 0.6, -0.8)).Position, rgb(220, 50, 50), M.SmoothPlastic)
end

local function beachUmbrella(f: Instance, cf: CFrame, _lc: Color3, rng: Random)
	local colors = { rgb(240, 80, 80), rgb(40, 150, 220), rgb(250, 200, 40), rgb(60, 170, 120) }
	local c = colors[rng:NextInteger(1, #colors)]
	upright(f, 7, 0.3, cf, rgb(240, 240, 240), M.Metal)
	upright(f, 0.5, 7, cf * CFrame.new(0, 6.4, 0), c, M.Fabric)
	upright(f, 0.6, 4.4, cf * CFrame.new(0, 6.9, 0), rgb(250, 250, 245), M.Fabric)
	upright(f, 0.5, 1.6, cf * CFrame.new(0, 7.4, 0), c, M.Fabric)
	for _, sx in { -1, 1 } do
		local lounger = cf * CFrame.new(sx * 2.6, 0, 1.4)
		part(f, V(1.8, 0.4, 4.4), lounger * CFrame.new(0, 0.9, 0.4), rgb(250, 250, 245), M.Fabric)
		part(f, V(1.8, 0.4, 2), lounger * CFrame.new(0, 1.5, -2.2) * CFrame.Angles(math.rad(50), 0, 0), rgb(250, 250, 245), M.Fabric)
		part(f, V(1.6, 0.6, 3.6), lounger * CFrame.new(0, 0.4, 0.4), rgb(200, 200, 205), M.Metal)
	end
end

local function duckStatue(f: Instance, cf: CFrame)
	local yellow = rgb(250, 210, 40)
	Kit.ellipsoid(f, V(3, 2.6, 4.2), cf * CFrame.new(0, 1.5, 0), yellow, M.SmoothPlastic)
	Kit.ball(f, 2.2, (cf * CFrame.new(0, 3.4, -1.3)).Position, yellow, M.SmoothPlastic)
	Kit.wedge(f, V(1.2, 0.5, 1), cf * CFrame.new(0, 3.2, -2.7) * CFrame.Angles(0, math.pi, 0), rgb(255, 140, 30), M.SmoothPlastic)
	for _, sx in { -0.6, 0.6 } do
		Kit.ball(f, 0.35, (cf * CFrame.new(sx, 3.8, -2.3)).Position, rgb(20, 20, 20), M.SmoothPlastic)
	end
	Kit.wedge(f, V(1.6, 1, 1.4), cf * CFrame.new(0, 2.6, 2.2), yellow, M.SmoothPlastic)
end

---------------------------------------------------------------------------
-- Overhead string lights and the studio walk of fame
---------------------------------------------------------------------------
local BULBS = { rgb(255, 236, 190), rgb(255, 120, 100), rgb(120, 200, 255), rgb(140, 240, 140), rgb(255, 220, 90) }

local function stringLights(f: Instance, a: Vector3, b: Vector3, sag: number, spacing: number)
	local len = (b - a).Magnitude
	local n = math.max(2, math.floor(len / spacing))
	local prev = a
	for k = 1, n do
		local t = k / n
		local p = a:Lerp(b, t) - Vector3.new(0, sag * 4 * t * (1 - t), 0)
		Kit.beam(f, prev, p, 0.08, rgb(40, 40, 44), M.SmoothPlastic).CastShadow = false
		if k < n then
			local bulb = Kit.ball(f, 0.6, p - Vector3.new(0, 0.35, 0), BULBS[(k - 1) % #BULBS + 1], M.Neon)
			bulb.CastShadow = false
			bulb.CanCollide = false
		end
		prev = p
	end
end

local function mainStreetLights(f: Instance)
	-- zig-zag between the banner poles on both sides of Main Street
	for z = 10, 208, 22 do
		local west = Vector3.new(-23, 16.2, z)
		local east = Vector3.new(23, 16.2, z + 11)
		local nextWest = Vector3.new(-23, 16.2, z + 22)
		if not (z + 11 > 118 and z < 146) then
			stringLights(f, west, east, 2.4, 2.6)
		end
		if z + 22 <= 208 and not (z + 22 > 118 and z + 11 < 146) then
			stringLights(f, east, nextWest, 2.4, 2.6)
		end
	end
end

local function backwoodsLights(f: Instance)
	local corners = { V(-244, 11.2, -160), V(-152, 11.2, -160), V(-152, 11.2, -220), V(-244, 11.2, -220) }
	for i = 1, 4 do
		stringLights(f, corners[i], corners[i % 4 + 1], 1.6, 3)
	end
	stringLights(f, corners[1], corners[3], 3, 3.2)
	stringLights(f, corners[2], corners[4], 3, 3.2)
end

local function walkOfFame(f: Instance)
	-- gold stars along both backlot sidewalks
	for _, x in { -26, 26 } do
		for z = -150, -290, -14 do
			local cf = CFrame.new(x, 0.47, z)
			Kit.disc(f, 2.2, 0.06, cf.Position + Vector3.new(0, 0.03, 0), rgb(200, 60, 80), M.SmoothPlastic).CastShadow = false
			for k = 0, 4 do
				local ray = part(f, V(0.7, 0.06, 1.6), cf * CFrame.Angles(0, k * math.pi * 2 / 5, 0) * CFrame.new(0, 0.06, -0.8), C.Gold, M.Metal)
				ray.CastShadow = false
				ray.CanCollide = false
			end
		end
	end
end

local function redCarpet(f: Instance)
	local carpet = Kit.block(f, V(8, 0.1, 30), CFrame.new(0, 0.5, -160), rgb(170, 30, 40), M.Fabric)
	carpet.CastShadow = false
	for _, sx in { -5, 5 } do
		local prev: Vector3? = nil
		for z = -146, -174, -4 do
			local base = Vector3.new(sx, 0.45, z)
			Kit.post(f, 0.3, 1.2, base, C.Gold, M.Metal)
			Kit.post(f, 3, 0.3, base, C.Gold, M.Metal)
			local top = base + Vector3.new(0, 2.8, 0)
			Kit.ball(f, 0.5, top + Vector3.new(0, 0.3, 0), C.Gold, M.Metal)
			if prev then
				local mid = (prev + top) / 2 - Vector3.new(0, 0.5, 0)
				Kit.beam(f, prev, mid, 0.25, rgb(150, 20, 40), M.Fabric, true).CanCollide = false
				Kit.beam(f, mid, top, 0.25, rgb(150, 20, 40), M.Fabric, true).CanCollide = false
			end
			prev = top
		end
	end
end

